{ ============================================================
  First-Person Ball Cam for Hamsterball — v2 (Fixed)
  ============================================================
  
  HOOK: Scene_SetCamera epilogue at 0x41A254
  JUMP-BACK: 0x41A2BF (ApplyCamera)
  Original bytes: 8B 44 24 14 8B
  
  CAMERA SYSTEM (orbit camera, NOT free-position):
  - Scene+0x87C = camera object pointer
  - vtable[2] (+0x8) = SetPosition(X, Y, Z) → sets LOOK-AT TARGET (not eye!)
  - vtable[3] (+0xC) = SetDirection(&vec3 dir, float dist) → direction FROM eye TO target + orbit distance
  - Actual eye position = target - direction * distance
  
  ORIGINAL camera:
  - Target = ball_pos + scene offsets + path follow + shake
  - Direction = (sin(orbit_angle), 0.9, cos(orbit_angle)) — slightly downward
  - Distance = ~700 (far back, high up)
  
  FIRST-PERSON BALL CAM:
  - Target = ball_pos + (vel_dir.xz * lookAhead, 0, vel_dir.xz * lookAhead)
    → look ahead in the horizontal travel direction
  - Direction = (vel_dir.x * lookAhead, -height, vel_dir.z * lookAhead)
    → from eye (above ball) to target (ahead of ball)
  - Distance = 1.0 (direction encodes full offset)
  
  Result: eye = target - direction = ball_pos + (0, height, 0)
  → Camera is directly above the ball, looking forward in travel direction
  
  Uses XZ velocity only (ignores Y) to prevent camera looking up/down when falling.
  
  Adjustable via CE address table:
  - fpCamHeight: height above ball (default 40.0, radius ~26 so just above surface)
  - fpCamLookAhead: how far ahead to look (default 150.0)
  ============================================================ }

[ENABLE]
alloc(fpCamData, 128)
alloc(newmem, 512)

label(dirX)
label(dirY)
label(dirZ)
label(camX)
label(camY)
label(camZ)
label(fpCamHeight)
label(fpCamLookAhead)
label(minVel)
label(useDefaultDir)
label(computeTarget)

registersymbol(fpCamHeight)
registersymbol(fpCamLookAhead)

// --- Data section ---
fpCamData:
  dirX: dd 0
  dirY: dd 0
  dirZ: dd 0
  camX: dd 0
  camY: dd 0
  camZ: dd 0
  fpCamHeight: dd 42200000      // 40.0f (just above ball surface, radius ~26)
  fpCamLookAhead: dd 43160000   // 150.0f (how far ahead to look)
  minVel: dd 3A83126F          // 0.001f

// --- Code cave ---
// At entry: ESI = Scene*, EDI = Ball*
newmem:
  push eax
  push ecx
  push edx

  // --- Compute horizontal velocity direction (XZ only, ignore Y) ---
  // len = sqrt(vx*vx + vz*vz)
  fld dword ptr [edi+0x20]     // st0 = vx
  fmul st(0), st(0)            // st0 = vx*vx
  fld dword ptr [edi+0x28]     // st0 = vz, st1 = vx*vx
  fmul st(0), st(0)            // st0 = vz*vz, st1 = vx*vx
  faddp                        // st0 = vx*vx + vz*vz
  fsqrt                        // st0 = horizontal speed

  // If speed <= minVel, use default direction (0, 0, 1)
  fcom dword ptr [minVel]      // compare st(0) with 0.001
  fstsw ax
  test ah, 0x41                // C0 (less than) or C3 (equal/unordered)
  jnz useDefaultDir

  // Normalize: dx = vx/speed, dz = vz/speed
  fld dword ptr [edi+0x20]     // st0 = vx, st1 = speed
  fdiv st(0), st(1)            // st0 = vx/speed = dx
  fstp dword ptr [dirX]        // store dx, pop → st0 = speed
  fld dword ptr [edi+0x28]     // st0 = vz, st1 = speed
  fdiv st(0), st(1)            // st0 = vz/speed = dz
  fstp dword ptr [dirZ]        // store dz, pop → st0 = speed
  fstp st(0)                   // pop speed, FPU empty
  jmp computeTarget

useDefaultDir:
  fstp st(0)                   // pop speed, FPU empty
  mov dword ptr [dirX], 0      // dx = 0
  mov dword ptr [dirZ], 3F800000  // dz = 1.0 (look forward +Z)

computeTarget:
  // --- Compute camera target (look-at point) ---
  // target = ball_pos + (dirX * lookAhead, 0, dirZ * lookAhead)
  // target.y = ball.y (no Y offset — look at ball's height level)
  
  // target.x = ball.x + dirX * lookAhead
  fld dword ptr [dirX]          // st0 = dirX
  fmul dword ptr [fpCamLookAhead]  // st0 = dirX * lookAhead
  fadd dword ptr [edi+0x14]    // st0 = ball.x + dirX * lookAhead
  fstp dword ptr [camX]        // store target.x

  // target.y = ball.y
  mov eax, [edi+0x18]          // ball.y
  mov [camY], eax

  // target.z = ball.z + dirZ * lookAhead
  fld dword ptr [dirZ]          // st0 = dirZ
  fmul dword ptr [fpCamLookAhead]  // st0 = dirZ * lookAhead
  fadd dword ptr [edi+0x1C]    // st0 = ball.z + dirZ * lookAhead
  fstp dword ptr [camZ]        // store target.z

  // --- Compute direction vector (from eye to target) ---
  // eye = ball_pos + (0, height, 0)
  // direction = target - eye = (dirX*la, -height, dirZ*la)
  
  // dir.x = dirX * lookAhead (already computed in camX - ball.x, but recompute for clarity)
  fld dword ptr [dirX]          // st0 = dirX
  fmul dword ptr [fpCamLookAhead]  // st0 = dirX * lookAhead
  fstp dword ptr [dirX]         // overwrite dirX with dirX * lookAhead

  // dir.y = -height
  fld dword ptr [fpCamHeight]   // st0 = height
  fchs                         // st0 = -height
  fstp dword ptr [dirY]         // dir.y = -height

  // dir.z = dirZ * lookAhead
  fld dword ptr [dirZ]          // st0 = dirZ (original normalized, not yet scaled)
  fmul dword ptr [fpCamLookAhead]  // st0 = dirZ * lookAhead
  fstp dword ptr [dirZ]         // overwrite dirZ with dirZ * lookAhead

  // --- Call camera->SetPosition(targetX, targetY, targetZ) ---
  // __thiscall: ECX = camera, push Z, Y, X, RET 0xC
  mov ecx, [esi+0x87C]          // camera object
  mov edx, [ecx]                // vtable
  push dword ptr [camZ]         // push Z (target.z)
  push dword ptr [camY]         // push Y (target.y = ball.y)
  push dword ptr [camX]         // push X (target.x)
  call dword ptr [edx+0x8]      // SetPosition(X, Y, Z) — sets look-at target

  // --- Call camera->SetDirection(&dir_vec, 1.0) ---
  // __thiscall: ECX = camera, push distance, push &vec, RET 0x8
  // distance = 1.0 so eye = target - direction * 1.0 = ball + (0, height, 0)
  mov ecx, [esi+0x87C]          // camera object
  mov edx, [ecx]                // vtable
  push 3F800000                 // push distance = 1.0f
  lea eax, [dirX]               // &direction_vec
  push eax                      // push &dir_vec
  call dword ptr [edx+0xC]      // SetDirection(&dir, dist) — sets view direction + orbit distance

  pop edx
  pop ecx
  pop eax

  // Continue to ApplyCamera: graphics->vtable[1](camera)
  jmp 0041A2BF

// --- Hook: 5-byte JMP at Scene_SetCamera epilogue ---
0041A254:
  jmp newmem

[DISABLE]
0041A254:
  db 8B 44 24 14 8B

dealloc(newmem)
dealloc(fpCamData)
unregistersymbol(fpCamHeight)
unregistersymbol(fpCamLookAhead)
