// ============================================================================
// Arena Stands Mesh Swap - TOOB variant
// Swaps arena stands with arena-Toob (8442 verts, 5 N:BUMPER + 4 O:TOOBY)
// This gives the most collision objects of any arena mesh.
// ============================================================================
// Patch: PUSH 0x004CFF2C at 0x41330C -> PUSH cave string "levels\arena-Toob"
// ============================================================================

[ENABLE]

alloc(StandsStringCave, 64)

StandsStringCave:
  // "levels\arena-Toob\0" (18 bytes)
  db 6C 65 76 65 6C 73 5C 61 72 65 6E 61 2D 54 6F 6F 62 00

registersymbol(StandsStringCave)

0041330C:
    push StandsStringCave

[DISABLE]

0041330C:
    push 004CFF2C

dealloc(StandsStringCave)
unregistersymbol(StandsStringCave)
