// ============================================================
// Hamsterball Entity Limit Fixer v5 — CE AutoAssembler Script
// Prevents freezes AND crashes when spawning many entities
// (8-balls, cloned players) in arenas.
//
// FREEZE ROOT CAUSE (traced via GhidraMCP decompilation):
//
// When many balls are spawned, the game freezes because of THREE
// compounding per-frame costs:
//
// 1. Mesh_FindClosestCollision (0x465D90) is called 2× per ball per
//    frame inside Ball_Update (0x405E00) at 0x40651F and 0x407557.
//    Each call builds a full SpatialTree + CollisionMesh from level
//    geometry, traverses it, then frees everything.
//    At 30 balls: 60 spatial tree builds per frame.
//
// 2. Ball_FindClosestRespawnPoint (0x405190) is called EVERY FRAME
//    for each fallen ball with player_index != −1 (i.e. player clones).
//    This function iterates ALL respawn points (~16 in arenas) and
//    for EACH candidate calls Mesh_FindClosestCollision at 0x405C46.
//    With 10 fallen clones: 10 × 16 = 160 spatial tree builds per frame.
//
// 3. Ball_AI_ChaseNearest (0x408390) has two O(N) loops scanning ALL
//    balls, making total AI cost O(N²). At 30 balls: 900 iterations.
//
// Total: ~200+ spatial tree builds + thousands of heap allocs per frame
// → game thread takes >16ms per frame → FREEZE.
//
// CRASH ROOT CAUSE:
//   operator_new (0x4BA57B) calls CRT_ThrowBadAlloc (0x4BA69D) when
//   malloc fails. This throws a C++ exception that Hamsterball doesn't
//   catch → crash. Patch 1 replaces the CALL with return-NULL.
//
// v5 PATCHES (all addresses verified via GhidraMCP disassembly):
//
//   1  0x4BA58D  operator_new → return NULL instead of throwing
//   2a 0x40651F  Skip Mesh_FindClosestCollision #1 in Ball_Update (conditional)
//   2b 0x407557  Skip Mesh_FindClosestCollision #2 in Ball_Update (conditional)
//   3  0x405C46  Skip Mesh_FindClosestCollision in RespawnPoint (conditional)
//   4a 0x4083D9  Skip AI O(N²) loop 1 when too many balls
//   4b 0x408548  Skip AI O(N²) loop 2 when too many balls
//   5  0x405190  Throttle Ball_FindClosestRespawnPoint to every Nth frame
//
// All Mesh_FindClosestCollision patches are CONDITIONAL: they only
// skip when ball count > MAX_BALLS (default 30). Below that threshold,
// the game runs normally with full collision detection.
//
// Mesh_FindClosestCollision uses RET 0x20 (callee cleans 32 bytes = 8
// params). When we skip the call, we must manually ADD ESP,0x20 to
// clean up the stack. We also write 99999.0f (0x47C34F80) to the output
// buffer so callers get a valid "no collision" result.
//
// ADJUSTABLE PARAMETERS (add to CE address list):
//   MAX_BALLS (default 30): ball count threshold for skipping
//     - Lower = more aggressive skipping (more stable, less accurate)
//     - Higher = less skipping (more accurate, may freeze at high counts)
//   RESPAWN_THROTTLE (default 60): frames between respawn searches
//     - Lower = more frequent respawns (smoother, more CPU)
//     - Higher = less frequent (more stable, slower respawns)
//     - 0 = no throttle (always execute)
// ============================================================

[ENABLE]

alloc(GlobalState, 32)
alloc(Cave2A, 128)
alloc(Cave2B, 128)
alloc(Cave3, 128)
alloc(Cave4A, 128)
alloc(Cave4B, 128)
alloc(Cave5, 128)

label(frame_counter)
label(MAX_BALLS)
label(RESPAWN_THROTTLE)

label(cave2a_skip)
label(cave2a_call)
label(cave2b_skip)
label(cave2b_call)
label(cave3_skip)
label(cave3_call)
label(cave4a_skip)
label(cave4a_call)
label(cave4b_skip)
label(cave4b_call)
label(cave5_skip)
label(cave5_call)

registersymbol(MAX_BALLS)
registersymbol(RESPAWN_THROTTLE)

// ============================================================
// Global state
// ============================================================
GlobalState:
  frame_counter:
    dd 0
  MAX_BALLS:
    dd #30        // Ball count threshold for skipping expensive ops
  RESPAWN_THROTTLE:
    dd #60        // Frames between respawn searches (0 = no throttle)
  padding:
    dd 0

// ============================================================
// PATCH 1: operator_new → return NULL instead of bad_alloc crash
//
// At 0x4BA58D, operator_new calls CRT_ThrowBadAlloc (0x4BA69D) when
// malloc fails. This throws an uncaught C++ exception → crash.
//
// Replace the 5-byte CALL with:
//   XOR EAX,EAX  (33 C0) — return NULL
//   POP ESI       (5E)    — restore saved ESI (PUSHed at function entry)
//   RET           (C3)    — return to caller (__cdecl, caller cleans stack)
//   NOP           (90)    — padding
//
// All allocation sites in Hamsterball have NULL checks, so returning
// NULL is handled gracefully (ball creation skipped, no crash).
// ============================================================

0x4BA58D:
  xor eax,eax
  pop esi
  ret
  nop

// ============================================================
// PATCH 2a: Skip Mesh_FindClosestCollision #1 in Ball_Update
//
// At 0x40651F, Ball_Update calls Mesh_FindClosestCollision for floor
// collision. This is the #2 freeze cause (2× per ball per frame).
//
// When ball count > MAX_BALLS, we skip the call and write 99999.0f
// to the output buffer (meaning "no collision far away"). The game
// treats this as "no floor below ball" — fallen balls keep falling,
// active balls may fall through (but only when > MAX_BALLS active).
//
// Original: E8 6C F8 05 00 (CALL 0x465D90)
// Stack: 0x20 bytes of params (RET 0x20 callee-cleanup)
//
// Register state at 0x40651F:
//   ESI = ball pointer
//   [ESP] = output ptr (pushed by LEA+PUSH at 0x40651A-0x40651E)
// ============================================================

Cave2A:
  push eax
  push edx

  // Read Scene pointer from ball+0x14
  mov edx, [esi+0x14]
  test edx, edx
  jz cave2a_call            // No scene → call original

  // Read ball count from Scene+0x29D8 (bad_balls_list count)
  mov eax, [edx+0x29D8]
  cmp eax, [MAX_BALLS]
  jle cave2a_call           // Count <= MAX → call original

cave2a_skip:
  // Write 99999.0f (0x47C34F80) to output buffer
  // Output ptr is at [ESP+0x08] (after PUSH EDX + PUSH EAX)
  mov eax, [esp+0x08]
  mov [eax], 47C34F80
  mov [eax+4], 47C34F80
  mov [eax+8], 47C34F80

  // Clean up 0x20 bytes of stack params (callee would have done RET 0x20)
  add esp, 0x20

  xor eax, eax              // Return NULL (callers don't check EAX)

  pop edx
  pop eax
  jmp 0x406524              // Continue after original CALL

cave2a_call:
  pop edx
  pop eax
  call 0x465D90             // Original Mesh_FindClosestCollision
  jmp 0x406524              // Continue after original CALL

0x40651F:
  jmp Cave2A

// ============================================================
// PATCH 2b: Skip Mesh_FindClosestCollision #2 in Ball_Update
//
// At 0x407557, Ball_Update calls Mesh_FindClosestCollision for wall
// collision. Same conditional skip as patch 2a.
//
// Original: E8 34 E8 05 00 (CALL 0x465D90)
// ============================================================

Cave2B:
  push eax
  push edx

  mov edx, [esi+0x14]
  test edx, edx
  jz cave2b_call

  mov eax, [edx+0x29D8]
  cmp eax, [MAX_BALLS]
  jle cave2b_call

cave2b_skip:
  mov eax, [esp+0x08]
  mov [eax], 47C34F80
  mov [eax+4], 47C34F80
  mov [eax+8], 47C34F80

  add esp, 0x20

  xor eax, eax

  pop edx
  pop eax
  jmp 0x40755C              // Continue after original CALL

cave2b_call:
  pop edx
  pop eax
  call 0x465D90
  jmp 0x40755C

0x407557:
  jmp Cave2B

// ============================================================
// PATCH 3: Skip Mesh_FindClosestCollision in Ball_FindClosestRespawnPoint
//
// At 0x405C46, Ball_FindClosestRespawnPoint calls Mesh_FindClosestCollision
// for EACH respawn point candidate (~16 in arenas). This is the #1 freeze
// cause: 10 fallen clones × 16 points = 160 spatial tree builds per frame.
//
// When ball count > MAX_BALLS, we skip the call and write 99999.0f.
// The function picks the nearest respawn point by raw distance instead
// of collision-aware pathfinding — fine for gameplay.
//
// Original: E8 45 01 06 00 (CALL 0x465D90)
//
// Register state at 0x405C46:
//   ESI = ball pointer (set at 0x405199: MOV ESI,ECX)
//   ECX = [EDX+0x8B0] (SpatialTree, set at 0x405BF9 — clobbered)
//   [ESP] = output ptr (pushed at 0x405C45)
// ============================================================

Cave3:
  push eax
  push edx

  // Read Scene pointer from ball+0x14
  mov edx, [esi+0x14]
  test edx, edx
  jz cave3_call            // No scene → call original

  mov eax, [edx+0x29D8]
  cmp eax, [MAX_BALLS]
  jle cave3_call           // Count <= MAX → call original

cave3_skip:
  mov eax, [esp+0x08]      // Output ptr
  mov [eax], 47C34F80
  mov [eax+4], 47C34F80
  mov [eax+8], 47C34F80

  add esp, 0x20            // Clean up 8 stack params

  xor eax, eax

  pop edx
  pop eax
  jmp 0x405C4B             // Continue after original CALL

cave3_call:
  pop edx
  pop eax
  call 0x465D90            // Original Mesh_FindClosestCollision
  jmp 0x405C4B             // Continue after original CALL

0x405C46:
  jmp Cave3

// ============================================================
// PATCH 4a: Skip AI O(N²) loop 1 in Ball_AI_ChaseNearest
//
// At 0x4083D9, the 8-ball AI starts iterating the ball list to find
// nearby balls for bonus scoring. This is O(N) per ball = O(N²) total.
//
// When ball count > MAX_BALLS, we skip the entire loop by jumping to
// 0x4084F5 (the instruction after the loop body).
//
// Original bytes (9 bytes):
//   0x4083D9: 8B 4E 14           MOV ECX,[ESI+0x14]    (3 bytes)
//   0x4083DC: 81 C1 D4 29 00 00  ADD ECX,0x29D4        (6 bytes)
//   0x4083E2: E8 C9 AE 04 00     CALL AthenaList_NextIndex (untouched)
//
// We overwrite 9 bytes (0x4083D9-0x4083E1) with JMP + 4 NOPs.
// The CALL at 0x4083E2 is preserved — the cave jumps to it on the
// "continue" path.
//
// Register state at 0x4083D9:
//   ESI = ball pointer (this)
// ============================================================

Cave4A:
  push eax

  // Read Scene pointer
  mov eax, [esi+0x14]
  test eax, eax
  jz cave4a_skip           // No scene → skip loop

  // Read ball count
  mov eax, [eax+0x29D8]
  cmp eax, [MAX_BALLS]
  jg cave4a_skip           // Too many balls → skip loop

  pop eax
  // Original instructions
  mov ecx, [esi+0x14]
  add ecx, 0x29D4
  jmp 0x4083E2             // Continue to CALL AthenaList_NextIndex

cave4a_skip:
  pop eax
  jmp 0x4084F5             // Skip to end of loop 1

0x4083D9:
  jmp Cave4A
  nop
  nop
  nop
  nop

// ============================================================
// PATCH 4b: Skip AI O(N²) loop 2 in Ball_AI_ChaseNearest
//
// The second loop (find nearest target) starts at 0x408541 with
// MOV ECX,[ESI+0x14], then FSTP at 0x408544, then ADD ECX,0x29D4
// at 0x408548.
//
// We patch at 0x408548 (ADD ECX,0x29D4, 6 bytes) since ECX is already
// loaded with the Scene pointer by the MOV at 0x408541.
//
// When ball count > MAX_BALLS, skip to 0x408663 (end of loop 2).
//
// Original bytes (6 bytes):
//   0x408548: 81 C1 D4 29 00 00  ADD ECX,0x29D4
//
// Register state at 0x408548:
//   ESI = ball pointer
//   ECX = Scene pointer (from MOV at 0x408541)
// ============================================================

Cave4B:
  push eax

  // ECX = Scene pointer (already loaded by MOV at 0x408541)
  mov eax, [ecx+0x29D8]    // Ball count
  cmp eax, [MAX_BALLS]
  jg cave4b_skip           // Too many balls → skip loop

  pop eax
  // Original instruction
  add ecx, 0x29D4
  jmp 0x40854E             // Continue after ADD

cave4b_skip:
  pop eax
  jmp 0x408663             // Skip to end of loop 2

0x408548:
  jmp Cave4B
  nop

// ============================================================
// PATCH 5: Throttle Ball_FindClosestRespawnPoint
//
// Ball_FindClosestRespawnPoint (0x405190) is called EVERY FRAME for
// each fallen player clone (player_index != −1). At 10 fallen clones,
// that's 10 calls per frame, each doing 16 Mesh_FindClosestCollision
// calls = 160 spatial tree builds per frame.
//
// We throttle it to run only every RESPAWN_THROTTLE frames (default 60
// = once per second at 60fps). On off-frames, the function returns
// immediately (plain RET — __thiscall with ECX only, no stack params).
//
// The ball keeps its despawn flag and retries next frame automatically.
//
// Original bytes (6 bytes):
//   0x405190: 81 EC 84 00 00 00  SUB ESP,0x84
//
// Calling convention: __thiscall (ECX = ball, no stack params, plain RET)
// ============================================================

Cave5:
  // Increment frame counter
  inc dword ptr [frame_counter]

  // Check if this is a throttle frame
  mov eax, [frame_counter]
  mov ecx, [RESPAWN_THROTTLE]
  test ecx, ecx
  jz cave5_call             // Throttle = 0 → always execute (no throttle)

  xor edx, edx
  div ecx                    // EDX = frame_counter % RESPAWN_THROTTLE
  test edx, edx
  jnz cave5_skip             // Not zero → skip this frame

cave5_call:
  // Execute original: SUB ESP,0x84
  sub esp, 0x84
  jmp 0x405196               // Continue function body

cave5_skip:
  // Early return — __thiscall with no stack params → plain RET
  ret

0x405190:
  jmp Cave5
  nop

[DISABLE]

// ============================================================
// Restore original bytes
// ============================================================

// Patch 1: operator_new CALL CRT_ThrowBadAlloc
0x4BA58D:
  db E8 0B 01 00 00

// Patch 2a: CALL Mesh_FindClosestCollision #1 in Ball_Update
0x40651F:
  db E8 6C F8 05 00

// Patch 2b: CALL Mesh_FindClosestCollision #2 in Ball_Update
0x407557:
  db E8 34 E8 05 00

// Patch 3: CALL Mesh_FindClosestCollision in RespawnPoint
0x405C46:
  db E8 45 01 06 00

// Patch 4a: MOV ECX,[ESI+0x14] + ADD ECX,0x29D4
0x4083D9:
  db 8B 4E 14 81 C1 D4 29 00 00

// Patch 4b: ADD ECX,0x29D4
0x408548:
  db 81 C1 D4 29 00 00

// Patch 5: SUB ESP,0x84
0x405190:
  db 81 EC 84 00 00 00

dealloc(Cave2A)
dealloc(Cave2B)
dealloc(Cave3)
dealloc(Cave4A)
dealloc(Cave4B)
dealloc(Cave5)
dealloc(GlobalState)
unregistersymbol(MAX_BALLS)
unregistersymbol(RESPAWN_THROTTLE)
