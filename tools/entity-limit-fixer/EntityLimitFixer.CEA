// ============================================================
// Hamsterball Entity Limit Fixer v7 — CE AutoAssembler Script
// Prevents freezes AND crashes when many entities are active.
//
// v6→v7 REDESIGN: Single-function-entry hooks instead of per-call-site patches.
//
// ROOT CAUSE (traced via GhidraMCP decompilation):
//
// Mesh_FindClosestCollision (0x465D90, RET 0x20) builds a full SpatialTree
// + CollisionMesh from level geometry EVERY CALL, traverses it, then frees
// everything. Each call = ~1ms. Called from 5 call sites:
//
//   1. Ball_Update (0x40651F): 2× per ball per frame
//   2. Ball_Update (0x407557): 2× per ball per frame
//   3. Ball_FindClosestRespawnPoint (0x405C46): ~16× per fallen ball per frame
//   4. Scene_UpdateArenaPhysics (0x4406EE): 1× per ball per frame
//   5. Ball_FindMeshCollision (0x4039CD → 0x403980): 1× per BounceBall per frame
//
// v6 only patched 3 of 5 call sites, and only when ball count > 30.
// With 10 balls, NOTHING was patched → freeze.
//
// v7 FIX: Hook Mesh_FindClosestCollision's ENTRY POINT directly.
// A global flag SKIP_COLLISIONS is set at Scene_UpdateBallsAndState entry
// when ball count > MAX_BALLS (default 5). When the flag is set, ALL
// Mesh_FindClosestCollision calls return immediately with "no collision"
// (99999.0f) — covering ALL 5 call sites with a SINGLE patch.
//
// Ball_FindClosestRespawnPoint still runs to completion (it clears
// event_flag, resets collision mesh, teleports ball). Only the expensive
// Mesh_FindClosestCollision call inside it is skipped.
//
// PATCHES:
//   A  0x41B540  Hook Scene_UpdateBallsAndState → set SKIP_COLLISIONS flag
//   B  0x465D90  Hook Mesh_FindClosestCollision → check flag, skip if set
//   C  0x4BA58D  operator_new → return NULL (crash protection)
//   D  0x4083D9  Skip AI O(N²) loop 1 when flag set
//   E  0x408548  Skip AI O(N²) loop 2 when flag set
//
// ADJUSTABLE PARAMETERS (add to CE address list):
//   MAX_BALLS (default 5): ball count threshold for skipping collision
//     - Lower = more aggressive (more stable, less collision)
//     - Higher = less skipping (more collision, may freeze at high counts)
//   SKIP_COLLISIONS: runtime flag (1=skip, 0=normal), set automatically
//
// With ≤5 balls: SKIP_COLLISIONS=0, game runs 100% normally.
// With >5 balls: SKIP_COLLISIONS=1, all Mesh_FindClosestCollision calls
//   skip the expensive SpatialTree build. Balls won't collide with level
//   geometry but still bounce off each other (ball-ball collision is
//   separate). Balls that fall still respawn normally.
// ============================================================

[ENABLE]

alloc(GlobalState, 16)
alloc(CaveScene, 128)
alloc(CaveMesh, 128)
alloc(CaveAI1, 64)
alloc(CaveAI2, 64)

label(MAX_BALLS)
label(SKIP_COLLISIONS)

label(scene_check)
label(scene_set)
label(scene_clear)
label(scene_done)

label(mesh_skip)
label(mesh_original)

label(ai1_skip)
label(ai1_orig)

label(ai2_skip)
label(ai2_orig)

registersymbol(MAX_BALLS)
registersymbol(SKIP_COLLISIONS)

// ============================================================
// Global state
// ============================================================
GlobalState:
  MAX_BALLS:
    dd #5          // Ball count threshold (adjustable in CE)
  SKIP_COLLISIONS:
    dd 0           // Runtime flag: 1=skip collision, 0=normal

// ============================================================
// PATCH C: operator_new → return NULL instead of bad_alloc crash
//
// At 0x4BA58D, operator_new calls CRT_ThrowBadAlloc (0x4BA69D) when
// malloc fails. This throws an uncaught C++ exception → crash.
//
// Replace 5-byte CALL with: XOR EAX,EAX; POP ESI; RET; NOP
// Stack: [ESP]=saved_ESI, [ESP+4]=return_addr, [ESP+8]=size
// All allocation sites have NULL checks → safe.
// ============================================================

0x4BA58D:
  xor eax,eax
  pop esi
  ret
  nop

// ============================================================
// PATCH A: Hook Scene_UpdateBallsAndState entry (0x41B540)
//
// This function is called once per frame. ECX = Scene pointer (__thiscall).
// Ball count is at Scene+0x29D8 (AthenaList count field at Scene+0x29D4+4).
//
// Original first 5 bytes: 53 55 56 8B D9
//   PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX
//
// Cave executes original bytes, then checks ball count.
// If count > MAX_BALLS: set SKIP_COLLISIONS=1 (all collision calls skip this frame)
// If count <= MAX_BALLS: set SKIP_COLLISIONS=0 (normal collision)
// Then jumps to 0x41B545 (PUSH EDI — original code continues).
// ============================================================

CaveScene:
  // Execute original 5 bytes
  push ebx
  push ebp
  push esi
  mov ebx,ecx          // EBX = Scene pointer

  // Check ball count
  mov eax, [ebx+0x29D8]  // Ball count (AthenaList[+4] = count)
  cmp eax, [MAX_BALLS]
  jle scene_clear

scene_set:
  mov dword ptr [SKIP_COLLISIONS], 1
  jmp scene_done

scene_clear:
  mov dword ptr [SKIP_COLLISIONS], 0

scene_done:
  jmp 0x41B545          // Continue to PUSH EDI (original next instruction)

0x41B540:
  jmp CaveScene

// ============================================================
// PATCH B: Hook Mesh_FindClosestCollision entry (0x465D90)
//
// This is THE expensive function. It builds a SpatialTree from level
// geometry every call, does collision traversal, then frees everything.
//
// __thiscall: ECX = this (mesh object), RET 0x20 (callee cleans 32B).
// First stack param [ESP+4] = output pointer (3 floats: x,y,z).
//
// Original first 6 bytes: 64 A1 00 00 00 00
//   MOV EAX, FS:[0]  (SEH prolog start)
//
// Cave checks SKIP_COLLISIONS flag:
//   If 0: execute original 6 bytes, jump to 0x465D96 (continue prolog)
//   If 1: write 99999.0f to output[0..2], RET 0x20 (skip everything)
//
// 99999.0f = 0x47C34F80 (same value function returns when no collision).
// ============================================================

CaveMesh:
  // Check flag
  cmp dword ptr [SKIP_COLLISIONS], 0
  je mesh_original

mesh_skip:
  // Write "no collision" result to output
  mov eax, [esp+4]       // param_1 = output pointer
  mov dword ptr [eax], 47C34F80      // 99999.0f
  mov dword ptr [eax+4], 47C34F80
  mov dword ptr [eax+8], 47C34F80
  xor eax, eax           // Return value (unused by callers)
  ret 0x20               // Callee cleans 32 bytes (8 stack params)

mesh_original:
  // Execute original 6 bytes: MOV EAX, FS:[0]
  mov eax, fs:[0]
  jmp 0x465D96           // Continue original prolog (PUSH -1, etc.)

0x465D90:
  jmp CaveMesh
  nop                    // Pad 6th byte (original was 6-byte instruction)

// ============================================================
// PATCH D: Skip AI O(N²) loop 1 in Ball_AI_ChaseNearest
//
// At 0x4083D9, 8-ball AI iterates ball list to find nearby balls.
// O(N) per ball = O(N²) total. Skip when SKIP_COLLISIONS=1.
//
// Original 9 bytes: 8B 4E 14 81 C1 D4 29 00 00
//   MOV ECX,[ESI+0x14]; ADD ECX,0x29D4
// (followed by CALL AthenaList_NextIndex at 0x4083E2, preserved)
//
// Skip target: 0x4084F5 (after loop body)
// ============================================================

CaveAI1:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je ai1_orig

ai1_skip:
  jmp 0x4084F5           // Skip to end of loop 1

ai1_orig:
  // Original instructions
  mov ecx, [esi+0x14]
  add ecx, 0x29D4
  jmp 0x4083E2           // Continue to CALL AthenaList_NextIndex

0x4083D9:
  jmp CaveAI1
  nop
  nop
  nop
  nop

// ============================================================
// PATCH E: Skip AI O(N²) loop 2 in Ball_AI_ChaseNearest
//
// At 0x408548, second loop finds nearest target ball.
// ECX = Scene pointer (from MOV at 0x408541).
//
// Original 6 bytes: 81 C1 D4 29 00 00
//   ADD ECX,0x29D4
//
// Skip target: 0x408663 (end of loop 2)
// ============================================================

CaveAI2:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je ai2_orig

ai2_skip:
  jmp 0x408663           // Skip to end of loop 2

ai2_orig:
  // Original instruction
  add ecx, 0x29D4
  jmp 0x40854E           // Continue after ADD

0x408548:
  jmp CaveAI2

[DISABLE]

// ============================================================
// Restore original bytes
// ============================================================

// Patch C: operator_new CALL CRT_ThrowBadAlloc
0x4BA58D:
  db E8 0B 01 00 00

// Patch A: Scene_UpdateBallsAndState entry (5 bytes)
0x41B540:
  db 53 55 56 8B D9

// Patch B: Mesh_FindClosestCollision entry (6 bytes)
0x465D90:
  db 64 A1 00 00 00 00

// Patch D: AI loop 1 (9 bytes)
0x4083D9:
  db 8B 4E 14 81 C1 D4 29 00 00

// Patch E: AI loop 2 (6 bytes)
0x408548:
  db 81 C1 D4 29 00 00

dealloc(CaveAI2)
dealloc(CaveAI1)
dealloc(CaveMesh)
dealloc(CaveScene)
dealloc(GlobalState)
unregistersymbol(MAX_BALLS)
unregistersymbol(SKIP_COLLISIONS)
