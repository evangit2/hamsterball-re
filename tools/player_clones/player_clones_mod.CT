<?xml version="1.0" encoding="utf-8"?>
<!--
  Hamsterball Player Clones AI Mod — Cheat Engine Table
  ======================================================

  INSTRUCTIONS:
  1. Open Cheat Engine, attach to Hamsterball.exe
  2. Double-click this .CT file to load it (or File > Load)
  3. Check "Player Clones AI Mod" to enable
  4. Set clone counts in the child entries (P1/P2/P3/P4 Clones)
  5. Start a race or arena
  6. Press F1 to spawn clones
  7. Press F1 again anytime to spawn more

  WHAT IT DOES:
  - Patches AI gate (0x4083AE): enables COMPUTER AI in races, not just arenas
  - Patches targeting filter (0x4085CD): clones target ALL balls, not just players
  - Hooks Ball_UpdateAndAI (0x408390): captures Scene pointer on game thread (safe)
  - F1 hotkey: spawns configured clones using game's own Ball_ctor + operator_new
  - Clones share their original player's score (same player_index)

  REQUIREMENTS: Cheat Engine 7.2+ (for executeCodeEx thiscall support)
-->

<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>

    <!-- ================================================================ -->
    <!-- Main Script: Patches + Hook + F1 Hotkey                          -->
    <!-- ================================================================ -->
    <CheatEntry>
      <ID>1</ID>
      <Description>"Player Clones AI Mod (Enable + F1 to Spawn)"</Description>
      <Options moHideChildren="0"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>
{ ============================================================
  Hamsterball Player Clones AI Mod
  ============================================================

  PATCHES:
    Patch 1 @ 0x004083AE: NOP the JZ gate → AI runs in races too
    Patch 2 @ 0x004085CD: self-exclusion filter → target ALL balls

  HOOK @ 0x00408390 (Ball_UpdateAndAI entry):
    Captures Scene pointer from ball+0x14 every frame.
    This runs on the GAME'S OWN THREAD — no race conditions.
    The captured pointer is used by the F1 hotkey (Lua).

  F1 HOTKEY:
    Reads the captured Scene pointer, finds each player's ball,
    creates N clones via operator_new + Ball_ctor, sets AI params,
    sets player_index (for score sharing), adds to ball lists.

  CLONE COUNTS:
    Edit the child entries below (P1/P2/P3/P4 Clones).
    Default: P2=2, P3=1 (adjust to taste)
  ============================================================
}

[ENABLE]

// ═══════════════════════════════════════════════════════════════
// Allocations
// ═══════════════════════════════════════════════════════════════

// Clone count globals (user-editable via CE address list entries below)
globalalloc(CLONE_P1, 4)
globalalloc(CLONE_P2, 4)
globalalloc(CLONE_P3, 4)
globalalloc(CLONE_P4, 4)

CLONE_P1:
  dd 0

CLONE_P2:
  dd 2

CLONE_P3:
  dd 1

CLONE_P4:
  dd 0

// Captured Scene pointer (written by hook every frame, read by Lua)
globalalloc(SCENE_PTR, 4)
SCENE_PTR:
  dd 0

// Hook code cave
alloc(clone_hook, 64)
label(hook_return)

// ═══════════════════════════════════════════════════════════════
// Hook: Capture Scene pointer from Ball_UpdateAndAI
// ═══════════════════════════════════════════════════════════════
//
// Ball_UpdateAndAI at 0x408390 is called every frame for every ball.
// ECX = ball (this). ball+0x14 = Scene pointer.
// We grab it and store it in SCENE_PTR for the Lua hotkey to use.
//
// Original bytes at 0x408390:
//   83 EC 30       sub esp, 0x30
//   56             push esi
//   8B F1          mov esi, ecx
//
// We replace the first 6 bytes with a JMP to our cave.
// The cave captures Scene, runs the original 6 bytes, jumps back.

clone_hook:
  // Capture Scene pointer (ball->Scene at +0x14)
  mov eax, [ecx+0x14]
  mov [SCENE_PTR], eax

  // Original instructions (6 bytes)
  sub esp, 0x30
  push esi
  mov esi, ecx

  // Jump back to 0x408396 (right after the original 6 bytes)
  jmp hook_return

hook_return:

// Install hook: overwrite 0x408390 with JMP to clone_hook
Hamsterball.exe+8390:
  jmp clone_hook
  nop

// ═══════════════════════════════════════════════════════════════
// Patch 1: Gate 0 @ 0x4083AE — enable AI in races
// ═══════════════════════════════════════════════════════════════
//
// Original: 0F 84 76 04 00 00  (JZ +0x476 → skip AI entirely)
// Patched:  90 90 90 90 90 90  (NOP → AI always runs)
//
// Without this, AI only runs when:
//   ball+0xC74 (collision_contacts) != 0, OR
//   App+0x237 (arena_mode) != 0
// In races, both are 0, so AI is skipped. NOPing makes it always run.

Hamsterball.exe+83AE:
  db 90 90 90 90 90 90

// ═══════════════════════════════════════════════════════════════
// Patch 2: Targeting filter @ 0x4085CD — target ALL entities
// ═══════════════════════════════════════════════════════════════
//
// Original: 83 7F 18 FF 74 61
//   CMP DWORD PTR [EDI+0x18], 0xFFFFFFFF  ; check player_index == -1
//   JE 0x408634                              ; skip if NPC (8-ball)
//
// Patched:  39 FE 90 90 74 61
//   CMP ESI, EDI    ; is candidate ball == this ball? (self-check)
//   NOP NOP
//   JE 0x408634     ; skip if self (prevent targeting yourself)
//
// This makes ALL balls valid targets: players, clones, and 8-balls.

Hamsterball.exe+85CD:
  db 39 FE 90 90 74 61

// ═══════════════════════════════════════════════════════════════
// Lua: Register F1 Hotkey
// ═══════════════════════════════════════════════════════════════

{$lua}
if syntaxcheck then return end

-- Destroy previous hotkey if re-enabling
if cloneHotkey then
  cloneHotkey.destroy()
  cloneHotkey = nil
end

-- Constants
local BALL_PLAYER_IDX = 0x018
local BALL_DISPLAY_X  = 0x164
local BALL_DISPLAY_Y  = 0x168
local BALL_DISPLAY_Z  = 0x16C
local BALL_RADIUS_VAL = 0x284
local BALL_HOME_X     = 0xC60
local BALL_HOME_Y     = 0xC64
local BALL_HOME_Z     = 0xC68
local BALL_CHASE_DIST  = 0xC6C
local BALL_HOME_RADIUS = 0xC70
local BALL_SPIN_DIST   = 0xC7C

local SCENE_BAD_BALLS  = 0x29D4
local SCENE_ALL_BALLS  = 0x2DEC
local LIST_COUNT       = 0x004
local LIST_ARRAY        = 0x40C

-- Spawn function: creates AI clones of players
function spawnPlayerClones()
  local base = getAddress("Hamsterball.exe")
  if not base then
    print("[Clones] ERROR: Hamsterball.exe not found")
    return
  end

  local OPERATOR_NEW     = base + 0xBA57B
  local BALL_CTOR        = base + 0xAFE0
  local ATHENA_LIST_APPEND = base + 0x53780

  -- Read captured Scene pointer
  local sceneAddr = getAddress("SCENE_PTR")
  if not sceneAddr then
    print("[Clones] ERROR: SCENE_PTR symbol not found")
    return
  end
  local scene = readInteger(sceneAddr)
  if not scene or scene == 0 then
    print("[Clones] No Scene captured yet — start a level/arena first!")
    return
  end

  -- Read clone counts
  local counts = {
    readInteger(getAddress("CLONE_P1")) or 0,
    readInteger(getAddress("CLONE_P2")) or 0,
    readInteger(getAddress("CLONE_P3")) or 0,
    readInteger(getAddress("CLONE_P4")) or 0,
  }

  local total_requested = 0
  for i = 1, 4 do total_requested = total_requested + counts[i] end
  if total_requested == 0 then
    print("[Clones] All clone counts are 0 — set them in the table entries below")
    return
  end

  -- Get all_balls_list
  local allCount = readInteger(scene + SCENE_ALL_BALLS + LIST_COUNT)
  local allArray = readInteger(scene + SCENE_ALL_BALLS + LIST_ARRAY)
  if not allCount or allCount <= 0 or not allArray then
    print("[Clones] No balls in scene — start a level first!")
    return
  end

  print(string.format("[Clones] Scene=0x%08X  balls=%d  counts: P1=%d P2=%d P3=%d P4=%d",
        scene, allCount, counts[1], counts[2], counts[3], counts[4]))

  local total_cloned = 0

  for p = 0, 3 do
    local n = counts[p + 1]
    if n <= 0 then goto next_player end

    -- Find this player's ball in the all_balls_list
    local srcBall = nil
    for i = 0, allCount - 1 do
      local ball = readInteger(allArray + i * 4)
      if ball and ball > 0x10000 then
        local idx = readInteger(ball + BALL_PLAYER_IDX)
        if idx == p then
          srcBall = ball
          break
        end
      end
    end

    if not srcBall then
      print(string.format("  P%d: no ball found (skipping)", p + 1))
      goto next_player
    end

    local sx = readFloat(srcBall + BALL_DISPLAY_X)
    local sy = readFloat(srcBall + BALL_DISPLAY_Y)
    local sz = readFloat(srcBall + BALL_DISPLAY_Z)
    local srcRadius = readFloat(srcBall + BALL_RADIUS_VAL)
    print(string.format("  P%d: source at (%.0f,%.0f,%.0f) — spawning %d clones",
          p + 1, sx, sy, sz, n))

    for i = 1, n do
      -- 1. operator_new(0xC98) — cdecl
      local mem = executeCodeEx(0, nil, OPERATOR_NEW, 0xC98)
      if not mem or mem == 0 then
        print(string.format("    clone %d: operator_new FAILED", i))
        goto next_clone
      end

      -- 2. Ball_ctor(mem, scene) — thiscall: ECX=mem, push scene
      local clone = executeCodeEx(3, nil, BALL_CTOR, mem, scene)
      if not clone or clone == 0 then
        print(string.format("    clone %d: Ball_ctor FAILED", i))
        goto next_clone
      end

      -- 3. vtable[1](clone) = Ball_InitPhysicsDefaults — thiscall: ECX=clone
      local vtable = readInteger(clone)
      local initFn = readInteger(vtable + 4)
      if initFn and initFn > 0 then
        executeCodeEx(3, nil, initFn, clone)
      end

      -- 4. Set position (offset from source so they don't stack)
      writeFloat(clone + BALL_DISPLAY_X, sx + 10.0 * i)
      writeFloat(clone + BALL_DISPLAY_Y, sy)
      writeFloat(clone + BALL_DISPLAY_Z, sz)

      -- 5. Set home position (where AI returns to)
      writeFloat(clone + BALL_HOME_X, sx)
      writeFloat(clone + BALL_HOME_Y, sy)
      writeFloat(clone + BALL_HOME_Z, sz)

      -- 6. Set AI params (COMPUTER chase behavior)
      writeFloat(clone + BALL_CHASE_DIST, 1500.0)   -- detection range
      writeFloat(clone + BALL_HOME_RADIUS, 500.0)   -- patrol radius
      writeFloat(clone + BALL_SPIN_DIST, 100.0)      -- orbit distance

      -- 7. Copy ball radius/size from source
      if srcRadius then
        writeFloat(clone + BALL_RADIUS_VAL, srcRadius)
      end

      -- 8. Set player_index = same as original → SCORE SHARED!
      writeInteger(clone + BALL_PLAYER_IDX, p)

      -- 9. Add to Scene ball lists — thiscall: ECX=list, push ball
      executeCodeEx(3, nil, ATHENA_LIST_APPEND, scene + SCENE_BAD_BALLS, clone)
      executeCodeEx(3, nil, ATHENA_LIST_APPEND, scene + SCENE_ALL_BALLS, clone)

      print(string.format("    clone %d: 0x%08X [P%d] OK", i, clone, p + 1))
      total_cloned = total_cloned + 1

      ::next_clone::
    end

    ::next_player::
  end

  print(string.format("[Clones] Done! %d clones spawned. They use COMPUTER AI and share their player's score.", total_cloned))
end

-- Register F1 hotkey
cloneHotkey = createHotkey(spawnPlayerClones, VK_F1)
print("[Clones] Mod enabled. Set clone counts below, then press F1 in-game to spawn.")

[DISABLE]

// ═══════════════════════════════════════════════════════════════
// Restore original bytes
// ═══════════════════════════════════════════════════════════════

// Restore hook (Ball_UpdateAndAI entry)
Hamsterball.exe+8390:
  db 83 EC 30 56 8B F1

// Restore Gate 0
Hamsterball.exe+83AE:
  db 0F 84 76 04 00 00

// Restore targeting filter
Hamsterball.exe+85CD:
  db 83 7F 18 FF 74 61

// Dealloc hook code (safe: original bytes restored first)
dealloc(clone_hook)

// ═══════════════════════════════════════════════════════════════
// Lua: Destroy hotkey
// ═══════════════════════════════════════════════════════════════

{$lua}
if cloneHotkey then
  cloneHotkey.destroy()
  cloneHotkey = nil
end
print("[Clones] Mod disabled. Hotkey removed.")
      </AssemblerScript>
    </CheatEntry>

    <!-- ================================================================ -->
    <!-- Clone Count Entries (edit these in CE UI)                        -->
    <!-- ================================================================ -->
    <CheatEntry>
      <ID>2</ID>
      <Description>"P1 Clones (set count, press F1)"</Description>
      <LastState Value="0" RealAddress="00000000"/>
      <VariableType>4 Bytes</VariableType>
      <Address>CLONE_P1</Address>
    </CheatEntry>

    <CheatEntry>
      <ID>3</ID>
      <Description>"P2 Clones (set count, press F1)"</Description>
      <LastState Value="2" RealAddress="00000000"/>
      <VariableType>4 Bytes</VariableType>
      <Address>CLONE_P2</Address>
    </CheatEntry>

    <CheatEntry>
      <ID>4</ID>
      <Description>"P3 Clones (set count, press F1)"</Description>
      <LastState Value="1" RealAddress="00000000"/>
      <VariableType>4 Bytes</VariableType>
      <Address>CLONE_P3</Address>
    </CheatEntry>

    <CheatEntry>
      <ID>5</ID>
      <Description>"P4 Clones (set count, press F1)"</Description>
      <LastState Value="0" RealAddress="00000000"/>
      <VariableType>4 Bytes</VariableType>
      <Address>CLONE_P4</Address>
    </CheatEntry>

  </CheatEntries>

  <UserdefinedSymbols/>

  <LuaScript>
-- ============================================================
-- Hamsterball Player Clones AI Mod — Loaded!
-- ============================================================
--
-- QUICK START:
--   1. Enable "Player Clones AI Mod" (check the box)
--   2. Set clone counts: P1/P2/P3/P4 (default: P2=2, P3=1)
--   3. Start a race or arena in Hamsterball
--   4. Press F1 to spawn clones
--   5. Press F1 again anytime for more
--
-- WHAT THE CLONES DO:
--   - Use COMPUTER AI: chase all other balls
--   - Share their original player's score (same player_index)
--   - Work in races AND arenas
--   - Target ALL entities: players, clones, and 8-balls
--
-- PATCHES APPLIED:
--   0x4083AE: NOP JZ → AI runs in races (not just arenas)
--   0x4085CD: self-exclusion → target all balls (not just players)
--   0x408390: hook → captures Scene pointer (thread-safe)
--
-- CALL CONVENTIONS (for executeCodeEx):
--   0 = cdecl    (operator_new)
--   3 = thiscall (Ball_ctor, AthenaList_Append, vtable[1])
-- ============================================================

print("Hamsterball Player Clones Mod table loaded!")
print("Enable the script, set clone counts, then press F1 in-game.")
      </LuaScript>
</CheatTable>
