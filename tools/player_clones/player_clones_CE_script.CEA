// ============================================================
// Player Clones Mod v6 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v6:
//   1. RESPAWN FIX: Clear AI state (ball+0x808, ball+0x288) after respawn
//      so the AI searches for a new target instead of chasing a stale one.
//      Also clear ball+0x2F8 (respawn flag) after AI state reset.
//   2. CRASH FIX: Detect stale clones (scene ptr mismatch) and remove them
//      from the registry. Prevents use-after-free when arena exits.
//   3. SPAWN FIX: Read original ball ptr from player table
//      [scene+0x878 + pidx*0xA0 + 0x5DC] instead of searching ball_list.
//      Always finds the ORIGINAL player, never a dead clone.
//
// TRACED FUNCTIONS:
//   Ball_FindClosestRespawnPoint @ 0x405190
//     Sets: ball+0x2F8=1, ball+0x768=1, ball+0x2E8=0, ball+0x2E9=0
//     Does NOT clear: ball+0x808 (AI state), ball+0x288 (target ptr)
//     → Stale target causes AI to chase garbage → motionless!
//   Scene_UpdateBallsAndState @ 0x41B540
//     Iterates ball_list: calls vtable[4], checks ball+0x2E8 for respawn
//     Player balls (player_index != -1): respawn via 0x405190
//     NPC balls (player_index == -1): remove + free
//   COMPUTER AI @ 0x4222D0
//     Checks ball+0x808: if !=0, uses stored target (ball+0x288)
//     If ball+0x288 points to freed/invalid ball → garbage force vector
//
// BALL STRUCT OFFSETS:
//   +0x014  Scene ptr        +0x018  player_index
//   +0x164  pos X/Y/Z        +0x170  vel X/Y/Z
//   +0x188  max_speed        +0x1A0  render_scale
//   +0x1A4  CollisionMesh    +0x1B8  RenderContext1
//   +0x208  RenderContext2   +0x284  radius
//   +0x288  AI target ptr    +0x2E8  despawn flag (1=respawn needed)
//   +0x2F8  respawn flag      +0x2F9  is_falling
//   +0x324  return_early     +0x768  is_active
//   +0x808  AI state (0=search, !0=use stored target)
//
// PLAYER TABLE (in App sub-struct at scene+0x878):
//   +0x5DC + pidx*0xA0 = original ball pointer for player pidx
//   +0xB28 + pidx*4    = control mode (0x63=COMPUTER, 0x64=OFF, other=HUMAN)
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Right-click → Set Hotkey → Key 1/2/3/4 → Value = 1
//   5. Start a race or arena, press 1/2/3/4 to spawn clones
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(orig_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(saved_ball_ptr, 4)
alloc(saved_ctrl_mode, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
orig_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
saved_ball_ptr:
  dd 0
saved_ctrl_mode:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_notfound)
label(spawn_found)
label(spawn_next)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_dead)
label(stale_clone)
label(phase2)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// Original bytes: 53 55 56 8B D9 57
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Call COMPUTER AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  // Get clone pointer
  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK: verify clone's scene matches current scene ----
  // ball+0x14 = Scene ptr. If it doesn't match scene_saved,
  // the clone was freed when the previous scene was destroyed.
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  // Stale clone — null it out
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK: skip if clone is not active ----
  cmp byte [eax+0x768], 0
  je ai_skip_dead

  // ---- RESPAWN FIX: if ball+0x2F8 (respawn flag) is set,
  //      clear AI state so it searches for a new target ----
  cmp byte [eax+0x2F8], 0
  je no_respawn_reset
  // Clear AI state
  mov dword [eax+0x808], 0
  mov dword [eax+0x288], 0
  // Clear respawn flag (let physics resume normally)
  mov byte [eax+0x2F8], 0
  // Clear return_early
  mov byte [eax+0x324], 0
  // Clear velocity (start fresh at respawn point)
  mov dword [eax+0x170], 0
  mov dword [eax+0x174], 0
  mov dword [eax+0x178], 0

no_respawn_reset:
  // ---- Call COMPUTER AI for this clone ----
  mov edi, [clone_pidx + esi*4]    // edi = player_index

  // Save original ball ptr from player table
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [ecx + edx + 0x5DC]
  mov [saved_ball_ptr], ebx

  // Write clone ptr to player table
  mov [ecx + edx + 0x5DC], eax

  // Save original control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [ecx + edx + 0xB28]
  mov [saved_ctrl_mode], ebx

  // Set control mode to COMPUTER (0x63)
  mov dword [ecx + edx + 0xB28], 0x63

  // Call COMPUTER AI: __thiscall(ecx=scene, float* out, int pidx), ret 8
  push edi
  lea eax, [force_buf]
  push eax
  mov ecx, [scene_saved]
  call 004222D0

  // Restore original ball ptr
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [saved_ball_ptr]
  mov [ecx + edx + 0x5DC], ebx

  // Restore original control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [saved_ctrl_mode]
  mov [ecx + edx + 0xB28], ebx

ai_skip_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry: remove stale/null entries ----
  pushad
  xor ecx, ecx          // ecx = read index
  xor edx, edx          // edx = write index

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  // Check scene ptr validity
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  // Keep this clone
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad

  popad

original_code:
  push ebx          // 53
  push ebp          // 55
  push esi          // 56
  mov ebx, ecx      // 8B D9
  push edi          // 57
  jmp 0041B546

// ============================================================
// SpawnClone — Creates one player clone + registers it
// ============================================================

SpawnClone:
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // ---- Read ORIGINAL ball ptr from player table (NOT search ball_list) ----
  // This always gets the real player ball, never a dead clone.
  mov ecx, [ecx+0x878]
  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]
  test eax, eax
  jz spawn_skip

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz spawn_skip

  mov [orig_ball], eax

  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) — PLAYER ball constructor ----
  mov ecx, [scene_saved]
  push ecx
  mov ecx, [new_ball]
  call 004039E0

  // ---- Call player vtable[1] = SetupCollisionRender ----
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Copy render context from original (41 dwords from +0x1B8) ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd

  // ---- Copy trajectory from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x2AC]
  mov [edi+0x2AC], eax
  mov eax, [esi+0x2B0]
  mov [edi+0x2B0], eax
  mov eax, [esi+0x2B4]
  mov [edi+0x2B4], eax
  mov eax, [esi+0x2B8]
  mov [edi+0x2B8], eax

  // ---- Copy render position from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x1BC]
  mov [edi+0x1BC], eax
  mov eax, [esi+0x1C0]
  mov [edi+0x1C0], eax
  mov eax, [esi+0x1C4]
  mov [edi+0x1C4], eax
  mov eax, [esi+0x1C8]
  mov [edi+0x1C8], eax
  mov eax, [esi+0x204]
  mov [edi+0x204], eax

  // ---- Set player values ----
  mov edx, [new_ball]

  mov eax, [player_idx]
  mov [edx+0x18], eax

  // radius = 26.0
  mov dword [edx+0x284], 41D00000
  // max_speed = 5.0
  mov dword [edx+0x188], 40A00000
  // gravity_scale = 0.5
  mov dword [edx+0x278], 3F000000
  // gravity_mult = 0.1
  mov dword [edx+0x27C], 3DCCCCCD
  // render_scale = 1.05
  mov dword [edx+0x1A0], 3F866666

  // ---- Set position from original + 5.0 offset ----
  mov eax, [orig_ball]
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // ---- Copy velocity from original ----
  mov eax, [orig_ball]
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // ---- Set active flags ----
  mov byte [edx+0x768], 1
  mov byte [edx+0x769], 1
  mov byte [edx+0x2F9], 0
  mov byte [edx+0x324], 0

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0
  mov dword [edx+0x288], 0

  // ---- Add to scene->ball_list (0x29D4) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push edx
  call 00453810

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push edx
  call 00453810

  // ---- Register clone in arrays ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(orig_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(saved_ball_ptr)
dealloc(saved_ctrl_mode)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
