// ============================================================
// Player Clones Mod v8 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v8:
//   1. CHASE FIX (balls going toward world origin 0,0,0):
//      ROOT CAUSE: COMPUTER AI function (0x4222D0) searches ball_list
//      using a global shuffle table (0x4F7360). In races with only 1-2
//      balls, the search always finds the clone itself → skips → no target.
//      When no target found, AI computes force = normalize((0,0,0)-ball_pos)
//      × 0.125 → pushes ball toward world origin!
//      FIX: After calling COMPUTER AI, check ball+0x288 (target ptr).
//      If == 0 (no target), zero the force buffer. Ball gets zero force
//      from AI and just rolls with physics (gravity + collisions).
//      ALSO: Set ball+0xC6C (chase_distance) and ball+0xC70 (home_radius)
//      to huge values so the 8-ball AI fields don't interfere.
//
//   2. CRASH FIX (crash when spawning players 2-4 in races):
//      ROOT CAUSE: Fallback ball search accessed scene+0x2DEC+0x40C
//      (all_balls_list items array) which may be NULL in races.
//      Also: register clobbering between calls — EDX was used to hold
//      the new ball pointer but got overwritten by function calls.
//      FIX: Use Player 1's ball as fallback (always present in races).
//      If Player 1 also NULL, skip spawn entirely. Use memory variables
//      for all pointers instead of registers across function calls.
//
// BALL STRUCT OFFSETS:
//   +0x010  App ptr           +0x014  Scene ptr
//   +0x018  player_index     +0x164  pos X/Y/Z
//   +0x170  vel X/Y/Z        +0x188  max_speed
//   +0x1A0  render_scale     +0x1A4  CollisionMesh
//   +0x284  radius            +0x288  AI target ptr
//   +0x2F8  respawn flag      +0x2F9  is_falling
//   +0x324  return_early      +0x768  is_active
//   +0x808  AI state (0=search,!0=has target, set to 10 on bell hit)
//   +0xC6C  chase_distance   +0xC70  home_radius
//   +0xC78  spin_radius      +0xC7C  spin_factor
//
// PLAYER TABLE (App sub-struct at [scene+0x878]):
//   +0x5DC + pidx*0xA0 = ball pointer for player pidx
//   +0xB28 + pidx*4    = control mode (0x63=COMPUTER, 0x64=OFF, other=HUMAN)
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Set Hotkey → Key 1/2/3/4 → Value = 1
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(src_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(saved_ball_ptr, 4)
alloc(saved_ctrl_mode, 4)
alloc(tmp_val, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
src_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
saved_ball_ptr:
  dd 0
saved_ctrl_mode:
  dd 0
tmp_val:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_found)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_dead)
label(phase2)
label(use_p1_fallback)
label(no_fallback)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Call COMPUTER AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK ----
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK ----
  cmp byte [eax+0x768], 0
  je ai_skip_dead

  // ---- RESPAWN FIX ----
  cmp byte [eax+0x2F8], 0
  je no_respawn_reset
  mov dword [eax+0x808], 0
  mov dword [eax+0x288], 0
  mov byte [eax+0x2F8], 0
  mov byte [eax+0x324], 0
  mov dword [eax+0x170], 0
  mov dword [eax+0x174], 0
  mov dword [eax+0x178], 0

no_respawn_reset:
  // ---- CHASE FIX: re-apply AI fields every frame ----
  mov edx, eax
  mov dword [edx+0xC6C], 4B7A5E35   // chase_distance = 99999999.0
  mov dword [edx+0xC70], 4B7A5E35   // home_radius = 99999999.0
  mov dword [edx+0xC7C], 42480000   // spin_factor = 50.0
  // Don't touch 0xC78 (spin_radius) — it's a timer, let it accumulate

  // ---- Call COMPUTER AI ----
  mov edi, [clone_pidx + esi*4]    // edi = player_index

  // Save original ball ptr from player table
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]             // App sub-struct
  test ecx, ecx
  jz ai_skip_dead
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [ecx + edx + 0x5DC]    // original ball ptr
  mov [saved_ball_ptr], ebx

  // Write clone ptr to player table
  mov eax, [clone_ptrs + esi*4]
  mov [ecx + edx + 0x5DC], eax

  // Save + set control mode to COMPUTER
  mov edx, edi
  shl edx, 2
  mov ebx, [ecx + edx + 0xB28]
  mov [saved_ctrl_mode], ebx
  mov dword [ecx + edx + 0xB28], 0x63

  // Call COMPUTER AI: __thiscall(ecx=scene, float* out, int pidx)
  push edi
  lea eax, [force_buf]
  push eax
  mov ecx, [scene_saved]
  call 004222D0

  // ---- CHASE FIX: check if target was found ----
  // After COMPUTER AI returns, ball+0x288 = target ptr (0 if none found)
  mov eax, [clone_ptrs + esi*4]
  cmp dword [eax+0x288], 0
  jne has_target
  // No target found → AI returned force toward (0,0,0) → ZERO IT
  mov dword [force_buf], 0
  mov dword [force_buf+4], 0
  mov dword [force_buf+8], 0
  // Also clear AI state so it searches again next frame
  mov dword [eax+0x808], 0
  jmp restore_table

has_target:
  // Target found — force is valid, apply it

restore_table:
  // Restore original ball ptr
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [saved_ball_ptr]
  mov [ecx + edx + 0x5DC], ebx

  // Restore control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [saved_ctrl_mode]
  mov [ecx + edx + 0xB28], ebx

  // ---- Apply force to clone via vtable[5] ----
  // vtable[5] = [ball->vtable + 0x14] = ApplyForce(force_x, force_y, force_z)
  // But vtable[6] checks ball+0x808 != 0 → skip force.
  // We set 0x808 = 0 above, so force will be applied.
  mov eax, [clone_ptrs + esi*4]
  mov ecx, eax                    // ecx = this (ball)
  mov edx, [eax]                  // edx = vtable
  // Push force_z, force_y, force_x (reverse order for cdecl)
  push [force_buf+8]              // force_z
  push [force_buf+4]              // force_y
  push [force_buf]                // force_x
  call dword [edx+0x14]          // vtable[5] = ApplyForce
  // vtable[5] is ret 0x0C (cleans 12 bytes)

ai_skip_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry ----
  pushad
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ============================================================
// SpawnClone — Creates one player clone + registers it
// Uses player table for original ball, falls back to Player 1
// ============================================================

SpawnClone:
  // Clear source ball
  mov dword [src_ball], 0

  // ---- Try to read original ball from player table ----
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip                   // No App sub-struct → can't spawn

  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]   // original ball ptr
  test eax, eax
  jz use_p1_fallback

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz use_p1_fallback

  // Found valid original ball
  mov [src_ball], eax
  jmp spawn_found

use_p1_fallback:
  // ---- No original ball — use Player 1 as fallback ----
  // Player 1 (index 0) is always present in races
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov eax, [ecx + 0x5DC]          // Player 1 ball (pidx=0, offset=0)
  test eax, eax
  jz no_fallback                  // Even Player 1 is NULL → skip spawn

  // Check if Player 1 is active
  cmp byte [eax+0x768], 0
  jz no_fallback

  // Use Player 1 as source for position
  mov [src_ball], eax
  jmp spawn_found

no_fallback:
  // No balls available at all — skip spawn
  jmp spawn_skip

spawn_found:
  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B                   // operator_new
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  // __thiscall: ecx = this (ball), [esp+4] = scene
  mov ecx, [new_ball]
  mov edx, [scene_saved]
  push edx
  call 004039E0

  // ---- Call vtable[1] = SetupCollisionRender ----
  // __thiscall: ecx = this (ball)
  mov ecx, [new_ball]
  mov edx, [ecx]                  // vtable
  call dword [edx+4]             // vtable[1]

  // ---- Set player values ----
  mov edx, [new_ball]

  mov eax, [player_idx]
  mov [edx+0x18], eax             // player_index

  mov dword [edx+0x284], 41D00000  // radius = 26.0
  mov dword [edx+0x188], 40A00000  // max_speed = 5.0
  mov dword [edx+0x278], 3F000000  // gravity_scale = 0.5
  mov dword [edx+0x27C], 3DCCCCCD  // gravity_mult = 0.1
  mov dword [edx+0x1A0], 3F866666  // render_scale = 1.05

  // ---- CHASE FIX: Set AI fields ----
  mov dword [edx+0xC6C], 4B7A5E35  // chase_distance = 99999999.0
  mov dword [edx+0xC70], 4B7A5E35  // home_radius = 99999999.0
  mov dword [edx+0xC7C], 42480000  // spin_factor = 50.0
  mov dword [edx+0xC78], 0          // spin_radius = 0

  // ---- Set position from source ball ----
  mov eax, [src_ball]
  test eax, eax
  jz spawn_skip

  // Copy position from source + 5.0 offset
  fld dword [eax+0x164]            // src X
  fadd dword [004CF55C]           // + 5.0
  fstp dword [edx+0x164]          // → clone X

  fld dword [eax+0x168]            // src Y
  fadd dword [eax+0x284]          // + src radius (spawn above)
  fstp dword [edx+0x168]          // → clone Y

  fld dword [eax+0x16C]            // src Z
  fadd dword [004CF55C]           // + 5.0
  fstp dword [edx+0x16C]          // → clone Z

  // Copy velocity from source
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // Copy render context from source (41 dwords from +0x1B8)
  mov esi, eax                    // esi = src
  mov edi, edx                    // edi = clone
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29                   // 41 dwords
  cld
  rep movsd

  // Copy render position
  mov esi, eax
  mov edi, [new_ball]             // reload clone ptr (may be clobbered)
  mov ebx, [esi+0x1BC]
  mov [edi+0x1BC], ebx
  mov ebx, [esi+0x1C0]
  mov [edi+0x1C0], ebx
  mov ebx, [esi+0x1C4]
  mov [edi+0x1C4], ebx
  mov ebx, [esi+0x1C8]
  mov [edi+0x1C8], ebx
  mov ebx, [esi+0x204]
  mov [edi+0x204], ebx

  // Copy trajectory from source
  mov esi, eax
  mov edi, [new_ball]
  mov ebx, [esi+0x2AC]
  mov [edi+0x2AC], ebx
  mov ebx, [esi+0x2B0]
  mov [edi+0x2B0], ebx
  mov ebx, [esi+0x2B4]
  mov [edi+0x2B4], ebx
  mov ebx, [esi+0x2B8]
  mov [edi+0x2B8], ebx

  // ---- Set home position (ball+0xC60) to spawn position ----
  mov eax, [new_ball]
  mov ebx, [eax+0x164]
  mov [eax+0xC60], ebx
  mov ebx, [eax+0x168]
  mov [eax+0xC64], ebx
  mov ebx, [eax+0x16C]
  mov [eax+0xC68], ebx

  // ---- Set active flags ----
  mov edx, [new_ball]
  mov byte [edx+0x768], 1         // is_active
  mov byte [edx+0x769], 1         // is_visible
  mov byte [edx+0x2F9], 0         // not falling
  mov byte [edx+0x324], 0         // not return_early

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0        // AI state = search
  mov dword [edx+0x288], 0        // no target

  // ---- Add to scene->ball_list (0x29D4) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]          // &ball_list
  push edx                        // ball ptr
  call 00453810                  // AthenaList_Append

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]          // &all_balls_list
  push edx                        // ball ptr
  call 00453810                  // AthenaList_Append

  // ---- Register clone ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(src_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(saved_ball_ptr)
dealloc(saved_ctrl_mode)
dealloc(tmp_val)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
