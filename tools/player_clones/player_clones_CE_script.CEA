// ============================================================
// Player Clones Mod for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// TRACED FUNCTIONS (all verified from Hamsterball.exe binary):
//   Scene_UpdateBallsAndState  @ 0x41B540  (hook target, ecx=scene)
//   operator_new               @ 0x4BA57B  (__cdecl, allocates memory)
//   Ball_ctor                  @ 0x40AFE0  (__thiscall, 8-ball vtable 0x4CF3A0)
//   Ball_InitPhysicsDefaults   @ 0x405100  (vtable[1], sets player_index=-1)
//   AthenaList_Append          @ 0x453810  (__thiscall, ecx=list, push item)
//   AI tick                    @ 0x408390  (vtable[4] for 8-balls, chase logic)
//   Ball_Update                @ 0x405E00  (called from AI tick, handles physics)
//
// BALL STRUCT OFFSETS:
//   +0x00   vtable ptr      +0x18   player_index (-1=NPC)
//   +0x10   App ptr         +0x164  pos X (float)
//   +0x14   Scene ptr       +0x168  pos Y (float)
//   +0x188  max_speed       +0x16C  pos Z (float)
//   +0x18C  speed_scale     +0x284  radius (float)
//   +0x278  gravity_scale   +0x2F9  is_falling (bool)
//   +0x27C  gravity_mult    +0x324  return_early (bool)
//   +0x768  is_active       +0x769  active_flag
//   +0xC74  is_8ball (byte)  Size: 0xC98 bytes
//
// SCENE STRUCT OFFSETS:
//   +0x29D4  ball_list (AthenaList)
//   +0x29D8  ball_list count
//   +0x2DE0  ball_list items array ptr
//   +0x2DEC  all_balls_list (AthenaList)
//
// AI GATE AT 0x408390:
//   1. Read ball+0xC74 (is_8ball). If !=0, skip arena check → AI active
//   2. If ==0, check App+0x237 (arena_mode). If ==0, skip AI
//   3. Setting is_8ball=1 enables AI in ALL modes (races + arenas)
//
// SCORE SHARING:
//   Score at App+0x5E4 + player_index*0xA0
//   Clones use same player_index → automatic score sharing
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Right-click → Set Hotkey → Key 1/2/3/4 → Value = 1
//   5. Start a race or arena, press 1/2/3/4 to spawn clones
//      Each press spawns ONE clone of that player
// ============================================================

[ENABLE]

// ---- Allocate code cave and variables ----
alloc(CloneCode, 2048)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(orig_ball, 4)
alloc(new_ball, 4)

// ---- Initialize variables ----
scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
orig_ball:
  dd 0
new_ball:
  dd 0

// ---- Register symbols for address list ----
registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

// ---- Labels ----
label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_notfound)
label(spawn_found)
label(spawn_next)

// ============================================================
// CODE CAVE — Hook replacement for Scene_UpdateBallsAndState
// Original bytes at 0x41B540: 53 55 56 8B D9 57
//   push ebx / push ebp / push esi / mov ebx,ecx / push edi
// ============================================================

CloneCode:
  // Save scene pointer every frame (ecx = scene from __fastcall)
  mov [scene_saved], ecx

  // Quick check: any spawn flag set?
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz original_code

  // Save all registers before spawning
  pushad

  // ---- Player 1 ----
  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

original_code:
  // Execute original 6 bytes
  push ebx          // 53
  push ebp          // 55
  push esi          // 56
  mov ebx, ecx      // 8B D9
  push edi          // 57
  jmp 0041B546      // return to original code

// ============================================================
// SpawnClone — Creates one AI clone of the player in [player_idx]
// Caller must pushad/popad. Uses global vars for all I/O.
// Mirrors CreateBadBall (0x40BCA0) flow:
//   1. Find original player ball in scene->ball_list
//   2. operator_new(0xC98)
//   3. Ball_ctor(mem, scene) — sets 8-ball vtable 0x4CF3A0
//   4. vtable[1]() — InitPhysicsDefaults
//   5. Copy position/radius/speed from original
//   6. Set player_index (same as original for score sharing)
//   7. Set is_8ball=1 (enables AI in all modes)
//   8. Append to scene->ball_list and scene->all_balls_list
// ============================================================

SpawnClone:
  // Get scene pointer
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // Get ball_list items array and count
  // scene+0x2DE0 = items array pointer
  // scene+0x29D8 = count
  mov edx, [ecx+0x2DE0]
  mov edi, [ecx+0x29D8]
  test edi, edi
  jz spawn_skip
  test edx, edx
  jz spawn_skip

  // Find the player's ball
  xor esi, esi        // index = 0

spawn_next:
  cmp esi, edi
  jae spawn_notfound
  mov eax, [edx + esi*4]   // ball ptr
  test eax, eax
  jz spawn_notfound
  mov ebx, [player_idx]
  cmp [eax+0x18], ebx       // ball->player_index == target?
  je spawn_found
  inc esi
  jmp spawn_next

spawn_notfound:
  jmp spawn_skip

spawn_found:
  mov [orig_ball], eax

  // ---- Allocate 0xC98 bytes (same as CreateBadBall) ----
  push 0xC98
  call 004BA57B               // operator_new (__cdecl)
  add esp, 4                  // cleanup
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Ball_ctor(new_ball, scene) ----
  // __thiscall: ecx=this, push scene param (callee cleans)
  mov ecx, [scene_saved]
  push ecx                   // push scene
  mov ecx, eax               // this = new_ball
  call 0040AFE0              // Ball_ctor → sets vtable 0x4CF3A0

  // ---- vtable[1]() = InitPhysicsDefaults ----
  // __thiscall: ecx = new_ball, no params
  mov ecx, [new_ball]
  mov edx, [ecx]             // vtable ptr
  call dword [edx+4]         // vtable[1] = InitPhysicsDefaults

  // ---- Copy fields from original ball to clone ----
  mov eax, [orig_ball]
  mov edx, [new_ball]

  // Copy App pointer (ball+0x10)
  mov ebx, [eax+0x10]
  mov [edx+0x10], ebx

  // Copy Scene pointer (ball+0x14)
  mov ebx, [eax+0x14]
  mov [edx+0x14], ebx

  // Position X + 5.0 offset (game constant at 0x4CF55C)
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  // Position Y + radius offset (same as CreateBadBall)
  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  // Position Z + 5.0 offset
  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Copy radius (ball+0x284)
  mov ebx, [eax+0x284]
  mov [edx+0x284], ebx

  // Copy max_speed (ball+0x188)
  mov ebx, [eax+0x188]
  mov [edx+0x188], ebx

  // Copy speed_scale (ball+0x18C)
  mov ebx, [eax+0x18C]
  mov [edx+0x18C], ebx

  // Copy gravity_scale (ball+0x278)
  mov ebx, [eax+0x278]
  mov [edx+0x278], ebx

  // Copy gravity_mult (ball+0x27C)
  mov ebx, [eax+0x27C]
  mov [edx+0x27C], ebx

  // ---- Set player_index (same as original → shared score) ----
  mov ebx, [player_idx]
  mov [edx+0x18], ebx

  // ---- Set is_8ball = 1 (enables AI in ALL modes) ----
  mov byte [edx+0xC74], 1

  // ---- Set active flags ----
  mov byte [edx+0x768], 1    // is_active
  mov byte [edx+0x769], 1    // active_flag
  mov byte [edx+0x2F9], 0    // not falling
  mov byte [edx+0x324], 0    // no early return

  // ---- Add clone to scene->ball_list (0x29D4) ----
  // AthenaList_Append: __thiscall ecx=list, push item (callee cleans)
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push edx                   // push new_ball
  call 00453810              // AthenaList_Append

  // ---- Add clone to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push edx                   // push new_ball
  call 00453810              // AthenaList_Append

spawn_skip:
  ret

// ============================================================
// Install hook at 0x41B540
// Overwrite 6 bytes: 53 55 56 8B D9 57
// with: JMP CloneCode (5 bytes) + NOP (1 byte)
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

// ---- Restore original bytes ----
0041B540:
  db 53 55 56 8B D9 57

// ---- Cleanup ----
dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(orig_ball)
dealloc(new_ball)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
