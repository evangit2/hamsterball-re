// ============================================================
// Player Clones Mod v7 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v7:
//   1. CHASE FIX: Set 8-ball AI fields (ball+0xC6C, ball+0xC70, ball+0xC7C)
//      to huge values so clones chase from anywhere and never "return home".
//      Also set ball+0xC60 (home position) to spawn position.
//      Re-applied every frame in AI loop (survives respawn).
//   2. SPAWN WITHOUT ORIGINAL: Can clone players 2-4 even when their original
//      ball is not in the level. Falls back to Player 1's position, then to
//      first active ball in ball_list.
//
// 8-BALL AI FIELDS (set by InitPhysicsDefaults 0x405100):
//   ball+0xC60 = home position X (float)
//   ball+0xC64 = home position Y (float)
//   ball+0xC68 = home position Z (float)
//   ball+0xC6C = chase_distance = 600.0 (8-ball default) → set to 99999999.0
//   ball+0xC70 = home_radius = 1200.0 (8-ball default) → set to 99999999.0
//   ball+0xC78 = spin_radius = 0 (accumulator, grows each frame)
//   ball+0xC7C = spin_factor = 50.0 (speed multiplier)
//
// When chase_distance is huge, the AI always considers targets "in range".
// When home_radius is huge, the ball never triggers "return home" behavior.
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Set Hotkey → Key 1/2/3/4 → Value = 1
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(orig_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(saved_ball_ptr, 4)
alloc(saved_ctrl_mode, 4)
alloc(fallback_ball, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
orig_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
saved_ball_ptr:
  dd 0
saved_ctrl_mode:
  dd 0
fallback_ball:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_notfound)
label(spawn_found)
label(spawn_next)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_dead)
label(stale_clone)
label(phase2)
label(find_fallback)
label(fb_loop)
label(fb_done)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Call COMPUTER AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK ----
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK ----
  cmp byte [eax+0x768], 0
  je ai_skip_dead

  // ---- RESPAWN FIX: clear AI state after respawn ----
  cmp byte [eax+0x2F8], 0
  je no_respawn_reset
  mov dword [eax+0x808], 0
  mov dword [eax+0x288], 0
  mov byte [eax+0x2F8], 0
  mov byte [eax+0x324], 0
  mov dword [eax+0x170], 0
  mov dword [eax+0x174], 0
  mov dword [eax+0x178], 0

no_respawn_reset:
  // ---- CHASE FIX: re-apply AI fields every frame (survives respawn) ----
  mov edx, eax
  // chase_distance = 99999999.0 (0x4B7A5E35)
  mov dword [edx+0xC6C], 4B7A5E35
  // home_radius = 99999999.0 (0x4B7A5E35)
  mov dword [edx+0xC70], 4B7A5E35
  // spin_factor = 50.0 (0x42480000, same as 8-ball default)
  mov dword [edx+0xC7C], 42480000
  // spin_radius = 0 (reset accumulator each frame to prevent runaway)
  // Actually don't reset - it's used for distance calc. Just ensure it starts at 0.
  // The 8-ball AI adds 0x4CF48C (1.0) each frame. Leave it alone.

  // ---- Call COMPUTER AI ----
  mov edi, [clone_pidx + esi*4]

  // Save original ball ptr
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [ecx + edx + 0x5DC]
  mov [saved_ball_ptr], ebx

  // Write clone ptr to player table
  mov ecx, [clone_ptrs + esi*4]
  mov [ecx + edx + 0x5DC], ecx
  // Wait — that's wrong. ecx+edx+0x5DC is the table entry, but ecx is
  // the App sub-struct, not the clone. Let me fix this.

  // Actually: ecx = [scene+0x878] (App sub-struct)
  // [ecx + edx + 0x5DC] = ball ptr for player edi
  // We want to write our clone ptr there.
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  // Save original
  mov ebx, [ecx + edx + 0x5DC]
  mov [saved_ball_ptr], ebx
  // Write clone
  mov eax, [clone_ptrs + esi*4]
  mov [ecx + edx + 0x5DC], eax

  // Save + set control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [ecx + edx + 0xB28]
  mov [saved_ctrl_mode], ebx
  mov dword [ecx + edx + 0xB28], 0x63

  // Call COMPUTER AI
  push edi
  lea eax, [force_buf]
  push eax
  mov ecx, [scene_saved]
  call 004222D0

  // Restore original ball ptr
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [saved_ball_ptr]
  mov [ecx + edx + 0x5DC], ebx

  // Restore control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [saved_ctrl_mode]
  mov [ecx + edx + 0xB28], ebx

ai_skip_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry ----
  pushad
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ============================================================
// SpawnClone — Creates one player clone + registers it
// Uses player table for original ball, falls back to any active ball
// ============================================================

SpawnClone:
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // ---- Try to read original ball from player table ----
  mov ecx, [ecx+0x878]
  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]
  test eax, eax
  jz find_fallback

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz find_fallback

  mov [orig_ball], eax
  jmp spawn_found

find_fallback:
  // ---- No original ball — find ANY active ball to copy position from ----
  mov ecx, [scene_saved]
  mov edx, [ecx+0x2DE0]       // all_balls_list items array
  mov edi, [ecx+0x2DEC+4]    // all_balls_list count (at scene+0x2DEC+4)
  // Wait, 0x2DEC is the AthenaList. Items array at list+0x40C, count at list+4.
  // Actually: AthenaList at scene+0x2DEC.
  // count = [scene+0x2DEC+4], items = [scene+0x2DEC+0x40C]
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x2DEC+0x40C]  // items array
  mov edx, [scene_saved]
  mov edx, [edx+0x2DEC+4]       // count
  test edx, edx
  jz spawn_skip
  xor edi, edi                  // loop index

fb_loop:
  cmp edi, edx
  jae spawn_skip                 // no active ball found
  mov eax, [ecx + edi*4]
  test eax, eax
  jz fb_next
  cmp byte [eax+0x768], 0
  jne fb_found
fb_next:
  inc edi
  jmp fb_loop

fb_found:
  mov [fallback_ball], eax
  // Use this ball as the source for position
  jmp spawn_found

spawn_notfound:
  jmp spawn_skip

spawn_found:
  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  mov ecx, [scene_saved]
  push ecx
  mov ecx, [new_ball]
  call 004039E0

  // ---- Call player vtable[1] = SetupCollisionRender ----
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Set player values ----
  mov edx, [new_ball]

  mov eax, [player_idx]
  mov [edx+0x18], eax

  // radius = 26.0
  mov dword [edx+0x284], 41D00000
  // max_speed = 5.0
  mov dword [edx+0x188], 40A00000
  // gravity_scale = 0.5
  mov dword [edx+0x278], 3F000000
  // gravity_mult = 0.1
  mov dword [edx+0x27C], 3DCCCCCD
  // render_scale = 1.05
  mov dword [edx+0x1A0], 3F866666

  // ---- CHASE FIX: Set AI fields to huge values ----
  // chase_distance = 99999999.0
  mov dword [edx+0xC6C], 4B7A5E35
  // home_radius = 99999999.0
  mov dword [edx+0xC70], 4B7A5E35
  // spin_factor = 50.0 (same as 8-ball default)
  mov dword [edx+0xC7C], 42480000
  // spin_radius = 0
  mov dword [edx+0xC78], 0

  // ---- Set position ----
  // If we have an original ball, copy from it. Otherwise use fallback ball.
  mov eax, [orig_ball]
  test eax, eax
  jz use_fallback_pos

  // Copy position from original + 5.0 offset
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Copy velocity from original
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // Copy render context from original (41 dwords from +0x1B8)
  mov esi, eax
  mov edi, edx
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd

  // Copy trajectory from original
  mov esi, eax
  mov edi, edx
  mov ebx, [esi+0x2AC]
  mov [edi+0x2AC], ebx
  mov ebx, [esi+0x2B0]
  mov [edi+0x2B0], ebx
  mov ebx, [esi+0x2B4]
  mov [edi+0x2B4], ebx
  mov ebx, [esi+0x2B8]
  mov [edi+0x2B8], ebx

  // Copy render position
  mov esi, eax
  mov edi, edx
  mov ebx, [esi+0x1BC]
  mov [edi+0x1BC], ebx
  mov ebx, [esi+0x1C0]
  mov [edi+0x1C0], ebx
  mov ebx, [esi+0x1C4]
  mov [edi+0x1C4], ebx
  mov ebx, [esi+0x1C8]
  mov [edi+0x1C8], ebx
  mov ebx, [esi+0x204]
  mov [edi+0x204], ebx
  jmp set_home_pos

use_fallback_pos:
  // Use fallback ball position
  mov eax, [fallback_ball]
  test eax, eax
  jz set_home_pos

  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Zero velocity (start from rest)
  mov dword [edx+0x170], 0
  mov dword [edx+0x174], 0
  mov dword [edx+0x178], 0

set_home_pos:
  // ---- Set home position (ball+0xC60) to spawn position ----
  mov eax, [new_ball]
  mov ebx, [eax+0x164]
  mov [eax+0xC60], ebx
  mov ebx, [eax+0x168]
  mov [eax+0xC64], ebx
  mov ebx, [eax+0x16C]
  mov [eax+0xC68], ebx

  // ---- Set active flags ----
  mov edx, [new_ball]
  mov byte [edx+0x768], 1
  mov byte [edx+0x769], 1
  mov byte [edx+0x2F9], 0
  mov byte [edx+0x324], 0

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0
  mov dword [edx+0x288], 0

  // ---- Add to scene->ball_list (0x29D4) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push edx
  call 00453810

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push edx
  call 00453810

  // ---- Register clone ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  // Clear orig_ball and fallback_ball for next call
  mov dword [orig_ball], 0
  mov dword [fallback_ball], 0
  ret

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(orig_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(saved_ball_ptr)
dealloc(saved_ctrl_mode)
dealloc(fallback_ball)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
