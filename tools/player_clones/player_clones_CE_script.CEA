// ============================================================
// Player Clones Mod v12 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v12 (from v11):
//
//   v11 had THREE critical bugs that v12 fixes:
//
//   1. RACE SPAWN BUG — "pressing 2,3,4 only pushes P1, nothing spawns":
//      ROOT CAUSE: v10/v11 set ball+0x2E8 = 1 at spawn. But
//      Scene_UpdateBallsAndState checks 0x2E8 AFTER calling vtable[4].
//      If 0x2E8 == 1, it calls Ball_FindClosestRespawnPoint (0x405190)
//      which TELEPORTS the ball to the nearest START object immediately.
//      The clone gets spawned then instantly teleported to START →
//      appears as if "nothing spawned."
//      FIX: Set ball+0x2E8 = 0 (NOT 1). The game won't try to respawn
//      our clones. Clones stay where we put them.
//
//   2. ARENA BLACK CLONES + ABNORMAL MOVEMENT:
//      ROOT CAUSE (black): v11 didn't set ball+0xC38 (material_check)
//      to -1 (0xFFFFFFFF). Without this, Ball_Render skips rendering
//      or renders the ball as black/untextured.
//      FIX: Set ball+0xC38 = 0xFFFFFFFF, ball+0xC5C = 0, ball+0xC80 = 0.
//
//      ROOT CAUSE (abnormal movement): v11 SET velocity directly toward
//      target in XZ plane, overriding ALL physics. This causes jerky,
//      unnatural movement — ball can't follow slopes or ramps.
//      FIX: Use vtable[5] (ApplyForce) with proper gate clearing instead.
//      Clear ball+0x2F9 (is_falling), 0x2CC (stunned), 0x808 (AI state),
//      and 0x2F0 (counter) BEFORE calling vtable[5] so force is applied.
//      Use moderate force (2.0 × max_speed) so physics still works.
//
//   3. CLONES NOT CHASING / GOING "HOME":
//      ROOT CAUSE: v11 cleared 0x2F9/0x2FC BEFORE Ball_Update ran,
//      but Ball_Update set 0x2F9 back to 1 afterward. The respawn
//      system then teleported the clone back to START.
//      FIX: Set ball+0x2E8 = 0 so respawn system NEVER runs for clones.
//      Also set AI fields every frame:
//      - ball+0xC6C (chase_distance) = 99999999.0 (chase from anywhere)
//      - ball+0xC70 (home_radius) = 99999999.0 (never return home)
//      - ball+0xC74 (visibility_counter) = 0xFFFF (AI always active)
//      - ball+0xC7C (spin_distance) = 50.0
//      Also set home position (ball+0xC60/C64/C68) to spawn position.
//
//   P2-4 SPAWN FIX:
//      v8 already handles this correctly — use Player 1's ball as
//      fallback when the requested player's original ball doesn't exist.
//      The player_index is set to the requested value (0-3) regardless
//      of which ball was used as position source, so the render code
//      applies the correct per-player color.
//
//   WHAT WORKS IN v8 (preserved):
//      - COMPUTER AI approach (calling 0x4222D0) — but this has the
//        world-origin force bug. v12 replaces it with custom AI.
//      - Spawn pattern (Ball_ctor2 + vtable[1] + copy from source)
//      - Player 1 fallback for P2-4 spawning
//      - Memory variables for all pointers (no register reliance)
//
// BALL STRUCT OFFSETS:
//   +0x010  App ptr           +0x014  Scene ptr
//   +0x018  player_index      +0x164  pos X/Y/Z (3 floats)
//   +0x170  vel X/Y/Z (3 floats)  +0x188  max_speed
//   +0x1A0  render_scale      +0x284  radius
//   +0x288  AI target ptr     +0x2E8  process_flag (0=no respawn, 1=respawn)
//   +0x2F0  force_counter     +0x2F9  is_falling
//   +0x2CC  stunned_flag      +0x324  return_early
//   +0x768  is_active         +0x758  color R/G/B (3 floats)
//   +0x808  AI state          +0xC38  material_check (-1=enabled)
//   +0xC5C  render_flag (0)   +0xC60  home_pos X/Y/Z (3 floats)
//   +0xC6C  chase_distance    +0xC70  home_radius
//   +0xC74  visibility_counter +0xC7C spin_distance
//   +0xC80  viewport_clip (0)
//
// CALLING CONVENTIONS (verified by disassembling ret):
//   operator_new (0x4BA57B): __cdecl, `ret` — caller cleans up (add esp, 4)
//   Ball_ctor2 (0x4039E0):   __thiscall, `ret 4` — function cleans up
//   vtable[1] (0x4015B0):    __thiscall, `ret` — no stack args
//   AthenaList_Append (0x453810): __thiscall, `ret 4` — function cleans up!
//     → DO NOT add esp after call!
//   vtable[5] (ApplyForce):  __thiscall, `ret 0x0C` — function cleans 12 bytes
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Set Hotkey → Key 1/2/3/4 → Value = 1
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(src_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(tmp_ball, 4)
alloc(nearest_ball, 4)
alloc(nearest_dist, 4)
alloc(list_count, 4)
alloc(list_items, 4)
alloc(color_r, 4)
alloc(color_g, 4)
alloc(color_b, 4)
alloc(saved_esp, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
src_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
tmp_ball:
  dd 0
nearest_ball:
  dd 0
nearest_dist:
  dd 0
list_count:
  dd 0
list_items:
  dd 0
color_r:
  dd 0
color_g:
  dd 0
color_b:
  dd 0
saved_esp:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_found)
label(use_p1_fallback)
label(phase2)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_force)
label(has_target)
label(no_target)
label(apply_force)
label(do_compact)
label(compact_loop)
label(compact_done)
label(set_p1_color)
label(set_p2_color)
label(set_p3_color)
label(set_p4_color)
label(color_done)
label(find_target)
label(ft_loop)
label(ft_skip)
label(ft_done)
label(float_2_0)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Custom AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK: scene ptr still valid? ----
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK: is_active flag ----
  cmp byte [eax+0x768], 0
  je ai_skip_force

  // ---- Store current clone ptr ----
  mov [tmp_ball], eax

  // ---- RE-APPLY AI FIELDS EVERY FRAME ----
  // These get reset by the game's physics/respawn systems
  mov edx, eax
  mov dword [edx+0xC6C], 4B7A5E35   // chase_distance = 99999999.0
  mov dword [edx+0xC70], 4B7A5E35   // home_radius = 99999999.0
  mov dword [edx+0xC74], 0000FFFF    // visibility_counter = 65535 (AI always active)
  mov dword [edx+0xC7C], 42480000   // spin_distance = 50.0

  // ---- CLEAR GATES so vtable[5] applies force ----
  // These are set by the game at various points and block force application
  mov byte [edx+0x2F9], 0            // is_falling = 0
  mov byte [edx+0x2CC], 0            // stunned = 0
  mov dword [edx+0x808], 0           // AI state = search
  mov dword [edx+0x2F0], 0           // force_counter = 0
  mov byte [edx+0x324], 0            // return_early = 0

  // ---- CLEAR fall state ----
  // Prevents respawn teleport — clones never "fall off"
  mov byte [edx+0x2F8], 0            // respawn_flag = 0
  mov dword [edx+0x2FC], 0           // fall_timer = 0

  // ---- FIND NEAREST TARGET ----
  call FindNearestTarget

  // ---- Check if target found ----
  mov eax, [nearest_ball]
  test eax, eax
  jz ai_skip_force    // No target found → let physics handle it

  // ---- COMPUTE FORCE toward target ----
  // force = normalize(target_pos - clone_pos) × 2.0
  mov ecx, [tmp_ball]       // clone ptr
  mov edx, [nearest_ball]   // target ptr

  // direction = target_pos - clone_pos (3D)
  fld dword [edx+0x164]      // target X
  fsub dword [ecx+0x164]    // - clone X = dx
  fstp dword [force_buf]    // store dx

  fld dword [edx+0x168]      // target Y
  fsub dword [ecx+0x168]    // - clone Y = dy
  fstp dword [force_buf+4]   // store dy

  fld dword [edx+0x16C]      // target Z
  fsub dword [ecx+0x16C]    // - clone Z = dz
  fstp dword [force_buf+8]   // store dz

  // ---- NORMALIZE force_buf and scale by 2.0 ----
  // len = sqrt(dx² + dy² + dz²)
  fld dword [force_buf]       // st0 = dx
  fmul st0, st0              // dx²
  fld dword [force_buf+4]    // st0 = dy
  fmul st0, st0              // dy²
  faddp st1, st0            // dx² + dy²
  fld dword [force_buf+8]    // st0 = dz
  fmul st0, st0              // dz²
  faddp st1, st0            // dx² + dy² + dz²
  fsqrt                       // st0 = len

  // If len == 0, skip force
  ftst
  sahf
  je ai_skip_force            // len == 0 → skip (pops len below)

  // Normalize: divide each component by len, multiply by 2.0
  fld dword [force_buf]       // st0 = dx, st1 = len
  fdiv st0, st1              // dx / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf]     // force_x, st0 = len

  fld dword [force_buf+4]    // st0 = dy, st1 = len
  fdiv st0, st1              // dy / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf+4]   // force_y, st0 = len

  fld dword [force_buf+8]    // st0 = dz, st1 = len
  fdiv st0, st1              // dz / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf+8]   // force_z, st0 = len

  fstp st(0)                // pop len from FPU stack

  // ---- APPLY FORCE via vtable[5] ----
  // vtable[5] = ApplyForce(force_x, force_y, force_z)
  // __thiscall: ecx = this, args on stack, ret 0x0C (cleans 12 bytes)
  // We cleared all gates (0x2F9, 0x2CC, 0x808, 0x2F0) so force WILL be applied
  mov ecx, [tmp_ball]
  mov edx, [ecx]             // vtable
  push dword [force_buf+8]   // force_z
  push dword [force_buf+4]   // force_y
  push dword [force_buf]     // force_x
  call dword [edx+0x14]     // vtable[5] = ApplyForce (ret 0x0C)

ai_skip_force:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry (remove stale/dead clones) ----
do_compact:
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ============================================================
// FindNearestTarget — Find nearest active ball in ball_list
// Input: [tmp_ball] = clone ptr
// Output: [nearest_ball] = target ptr (0 if none found)
// Uses: ball_list at [scene_saved]+0x29D4
// ============================================================

FindNearestTarget:
  mov dword [nearest_ball], 0
  mov dword [nearest_dist], 447A0000   // 100000.0 (very large)

  // Get ball_list at scene+0x29D4
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  mov eax, [ecx+4]             // count
  mov [list_count], eax
  mov eax, [ecx+0x40C]         // items array ptr
  mov [list_items], eax

  // Validate list
  cmp [list_count], 0
  je ft_done
  cmp [list_items], 0
  je ft_done

  xor edi, edi                  // index = 0

ft_loop:
  cmp edi, [list_count]
  jae ft_done

  // Get ball at index
  mov ecx, [list_items]
  mov eax, [ecx + edi*4]      // ball ptr
  test eax, eax
  jz ft_skip

  // Skip self
  cmp eax, [tmp_ball]
  je ft_skip

  // Skip dead balls
  cmp byte [eax+0x768], 0
  je ft_skip

  // Compute distance² = dx² + dy² + dz²
  mov edx, [tmp_ball]          // clone ptr
  fld dword [eax+0x164]        // target X
  fsub dword [edx+0x164]      // - clone X = dx
  fmul st0, st0                // dx²
  fld dword [eax+0x168]       // target Y
  fsub dword [edx+0x168]      // - clone Y = dy
  fmul st0, st0                // dy²
  faddp st1, st0              // dx² + dy²
  fld dword [eax+0x16C]       // target Z
  fsub dword [edx+0x16C]      // - clone Z = dz
  fmul st0, st0                // dz²
  faddp st1, st0              // dx² + dy² + dz² = dist² (st0)

  // Compare: if dist² < nearest_dist → update nearest
  // CORRECT FPU comparison: fcomp + sahf + jae (v10 lesson)
  fcomp dword [nearest_dist]
  sahf                        // transfer FPU flags to CPU flags
  jae ft_skip                 // if st0 >= nearest_dist → not closer, skip

  // This ball is closer → update nearest
  mov [nearest_ball], eax
  // Recompute dist² and store as nearest_dist (fcomp popped st0)
  fld dword [eax+0x164]
  fsub dword [edx+0x164]
  fmul st0, st0
  fld dword [eax+0x168]
  fsub dword [edx+0x168]
  fmul st0, st0
  faddp st1, st0
  fld dword [eax+0x16C]
  fsub dword [edx+0x16C]
  fmul st0, st0
  faddp st1, st0
  fstp dword [nearest_dist]

ft_skip:
  inc edi
  jmp ft_loop

ft_done:
  ret

// ============================================================
// SpawnClone — Creates one player clone + registers it
// Uses player table for original ball, falls back to Player 1
// ============================================================

SpawnClone:
  mov dword [src_ball], 0

  // ---- Try to read original ball from player table ----
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]  // player table entry
  test eax, eax
  jz use_p1_fallback

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz use_p1_fallback

  mov [src_ball], eax
  jmp spawn_found

use_p1_fallback:
  // Use Player 1 as position source (always present in races)
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  mov eax, [ecx + 0x5DC]       // Player 1 ball (pidx=0, offset=0)
  test eax, eax
  jz spawn_skip

  cmp byte [eax+0x768], 0
  jz spawn_skip

  mov [src_ball], eax
  jmp spawn_found

spawn_found:
  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes (ball struct size) ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  // __thiscall: ECX = this (ball ptr), push scene ptr
  // ret 4 — function cleans up its own arg
  mov ecx, [new_ball]
  mov edx, [scene_saved]
  push edx
  call 004039E0

  // ---- Call vtable[1] = SetupCollisionRender ----
  // __thiscall: ECX = this, no stack args, ret 0
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Set player values ----
  mov edx, [new_ball]

  // player_index = requested value (NOT source's value)
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // Physics values
  mov dword [edx+0x284], 41D00000  // radius = 26.0
  mov dword [edx+0x188], 40A00000  // max_speed = 5.0
  mov dword [edx+0x278], 3F000000  // gravity_scale = 0.5
  mov dword [edx+0x27C], 3DCCCCCD  // gravity_mult = 0.1
  mov dword [edx+0x1A0], 3F866666  // render_scale = 1.05

  // ---- CRITICAL: process_flag = 0 (NOT 1!) ----
  // 0x2E8 = 1 triggers Ball_FindClosestRespawnPoint which teleports
  // the ball to START immediately. Set to 0 so respawn never runs.
  mov byte [edx+0x2E8], 0

  // ---- Set AI fields (these are zeroed by Ball_ctor2) ----
  // These must be set so the 8-ball AI tick works if it runs
  mov dword [edx+0xC6C], 4B7A5E35  // chase_distance = 99999999.0
  mov dword [edx+0xC70], 4B7A5E35  // home_radius = 99999999.0
  mov dword [edx+0xC74], 0000FFFF   // visibility_counter = 65535
  mov dword [edx+0xC7C], 42480000   // spin_distance = 50.0

  // ---- Set render flags (required for visible rendering) ----
  mov dword [edx+0xC38], 0xFFFFFFFF  // material_check = -1 (enabled)
  mov dword [edx+0xC5C], 0           // render_flag = 0
  mov byte [edx+0xC80], 0             // viewport_clip = 0

  // ---- Set position from source ball ----
  mov eax, [src_ball]
  test eax, eax
  jz spawn_skip

  // Reload new_ball ptr (may have been clobbered)
  mov edx, [new_ball]

  // Copy position from source + offset
  fld dword [eax+0x164]
  fadd dword [004CF55C]        // + 5.0
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]       // + radius (spawn above)
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]        // + 5.0
  fstp dword [edx+0x16C]

  // Copy velocity from source
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // ---- Set home position to spawn position ----
  // This prevents "going home" behavior
  mov eax, [new_ball]
  mov ebx, [eax+0x164]
  mov [eax+0xC60], ebx
  mov ebx, [eax+0x168]
  mov [eax+0xC64], ebx
  mov ebx, [eax+0x16C]
  mov [eax+0xC68], ebx

  // ---- Copy color from source ball ----
  mov eax, [src_ball]
  mov edx, [new_ball]
  mov ebx, [eax+0x758]
  mov [edx+0x758], ebx
  mov ebx, [eax+0x75C]
  mov [edx+0x75C], ebx
  mov ebx, [eax+0x760]
  mov [edx+0x760], ebx

  // ---- Override color with per-player distinct color ----
  mov eax, [player_idx]
  cmp eax, 0
  je set_p1_color
  cmp eax, 1
  je set_p2_color
  cmp eax, 2
  je set_p3_color
  cmp eax, 3
  je set_p4_color
  jmp color_done

set_p1_color:
  mov dword [color_r], 3F800000   // 1.0
  mov dword [color_g], 3F000000   // 0.5
  mov dword [color_b], 3F4CCCCD   // 0.8
  jmp color_done

set_p2_color:
  mov dword [color_r], 3E99999A   // 0.3
  mov dword [color_g], 3F000000   // 0.5
  mov dword [color_b], 3F800000   // 1.0
  jmp color_done

set_p3_color:
  mov dword [color_r], 3E99999A   // 0.3
  mov dword [color_g], 3F800000   // 1.0
  mov dword [color_b], 3E99999A   // 0.3
  jmp color_done

set_p4_color:
  mov dword [color_r], 3F800000   // 1.0
  mov dword [color_g], 3F800000   // 1.0
  mov dword [color_b], 00000000   // 0.0

color_done:
  mov edx, [new_ball]
  mov eax, [color_r]
  mov [edx+0x758], eax
  mov eax, [color_g]
  mov [edx+0x75C], eax
  mov eax, [color_b]
  mov [edx+0x760], eax

  // ---- Copy render context from source (41 dwords from +0x1B8) ----
  mov edx, [new_ball]
  push esi
  push edi
  mov esi, [src_ball]
  mov edi, edx
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd
  pop edi
  pop esi

  // ---- Copy additional render fields ----
  mov eax, [src_ball]
  mov edx, [new_ball]
  mov ebx, [eax+0x1BC]
  mov [edx+0x1BC], ebx
  mov ebx, [eax+0x1C0]
  mov [edx+0x1C0], ebx
  mov ebx, [eax+0x1C4]
  mov [edx+0x1C4], ebx
  mov ebx, [eax+0x1C8]
  mov [edx+0x1C8], ebx
  mov ebx, [eax+0x204]
  mov [edx+0x204], ebx

  // ---- Copy trajectory ----
  mov ebx, [eax+0x2AC]
  mov [edx+0x2AC], ebx
  mov ebx, [eax+0x2B0]
  mov [edx+0x2B0], ebx
  mov ebx, [eax+0x2B4]
  mov [edx+0x2B4], ebx
  mov ebx, [eax+0x2B8]
  mov [edx+0x2B8], ebx

  // ---- Set active flags ----
  mov edx, [new_ball]
  mov byte [edx+0x768], 1       // is_active
  mov byte [edx+0x769], 1       // is_visible
  mov byte [edx+0x2F9], 0       // not falling
  mov byte [edx+0x2F8], 0       // not respawn_pending
  mov byte [edx+0x324], 0       // not return_early

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0      // AI state = search
  mov dword [edx+0x288], 0      // no target

  // ---- Add to scene->ball_list (0x29D4) ----
  // AthenaList_Append (0x453810): __thiscall, ret 4
  // ECX = this (list ptr), [esp+4] = item to append
  // Function cleans up its own arg — DO NOT add esp after call!
  mov eax, [new_ball]
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push eax                      // arg: ball ptr (will be cleaned by ret 4)
  call 00453810                 // AthenaList_Append (thiscall, ret 4)

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov eax, [new_ball]            // reload from memory (safe)
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push eax                      // arg: ball ptr (will be cleaned by ret 4)
  call 00453810                 // AthenaList_Append (thiscall, ret 4)

  // ---- Register clone ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Data
// ============================================================

float_2_0:
  dd 40000000  // 2.0

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(src_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(tmp_ball)
dealloc(nearest_ball)
dealloc(nearest_dist)
dealloc(list_count)
dealloc(list_items)
dealloc(color_r)
dealloc(color_g)
dealloc(color_b)
dealloc(saved_esp)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
