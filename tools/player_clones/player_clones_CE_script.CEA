// ============================================================
// Player Clones Mod v4 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// WHAT'S NEW IN v4:
//   - Creates PLAYER ball (Ball_ctor2), NOT 8-ball (Ball_ctor)
//   - Allocates 0xC98 bytes (extra space for AI fields at 0xC60-0xC98)
//   - Zeros entire allocation before construction
//   - Allocates CUSTOM VTABLE: copy of player vtable with [4]=AI tick
//   - Sets AI fields manually (chase=600, home=1200, spin=50)
//   - Sets high visibility counter (ball+0xC74) for AI gate
//   - Copies render context from original player (appearance)
//   - Uses 8-ball dtor (vtable[0]) for proper 0xC98 cleanup
//
// APPROACH:
//   Ball_ctor2 creates a PLAYER ball (vtable=0x4CF314, player render, player physics).
//   We allocate 0xC98 (not 0xC60) to have space for AI fields at 0xC60-0xC98.
//   We build a custom vtable = player vtable + [4]=AI tick + [0]=8-ball dtor.
//   This gives: player appearance + player physics + AI targeting + AI force.
//
// TRACED FUNCTIONS (all verified from Hamsterball.exe binary):
//   Scene_UpdateBallsAndState  @ 0x41B540  (__fastcall, ecx=scene)
//   operator_new               @ 0x4BA57B  (__cdecl, allocates memory)
//   Ball_ctor2                  @ 0x4039E0  (__thiscall, PLAYER ball ctor, vtable=0x4CF314)
//   Ball_SetupCollisionRender  @ 0x4015B0  (player vtable[1], sound setup)
//   AthenaList_Append          @ 0x453810  (__thiscall, ecx=list, push item)
//   AI tick                    @ 0x408390  (8-ball vtable[4], calls Ball_Update + AI)
//   Ball_Update                @ 0x405E00  (called by AI tick, handles physics)
//   8-ball dtor                @ 0x4027F0  (handles 0xC98 cleanup + _free)
//
// PLAYER VTABLE (0x4CF314, 16 entries = 64 bytes):
//   [0] 0x402A50  dtor          [8]  0x409050  Player shadow
//   [1] 0x4015B0  SetupCollision [9]  0x401640  Timer_dtor
//   [2] 0x403DC0  Player render  [10] 0x457B10
//   [3] 0x402A70  (shared)       [11] 0x457B50
//   [4] 0x405E00  Ball_Update    [12] 0x457A70
//   [5] 0x401590  Force wrapper  [13] 0x457A50
//   [6] 0x4016F0  ApplyForceV2   [14] 0x401000
//   [7] 0x402C10  (shared)       [15] 0x457B80
//
// CUSTOM VTABLE: copy of player vtable with:
//   [0] = 0x4027F0  (8-ball dtor — handles 0xC98 byte free)
//   [4] = 0x408390  (AI tick — Ball_Update + AI targeting + force)
//   Everything else = player vtable entries (unchanged)
//
// BALL STRUCT OFFSETS:
//   +0x000  vtable ptr         +0x018  player_index (-1=NPC, 0-3=player)
//   +0x010  App ptr            +0x014  Scene ptr
//   +0x164  pos X              +0x168  pos Y            +0x16C  pos Z
//   +0x188  max_speed          +0x1A0  render_scale
//   +0x1A4  CollisionMesh ptr   +0x1B8  RenderContext1
//   +0x208  RenderContext2     +0x20C  color_RGBA
//   +0x278  gravity_scale      +0x27C  gravity_mult
//   +0x284  radius             +0x2F9  is_falling
//   +0x324  return_early       +0x768  is_active
//   +0xC38  material_check(-1) +0xC60  home_pos_X (AI patrol)
//   +0xC64  home_pos_Y         +0xC68  home_pos_Z
//   +0xC6C  chase_distance     +0xC70  home_radius
//   +0xC74  visibility_counter +0xC7C  spin_distance
//   Size: 0xC98 bytes
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Right-click → Set Hotkey → Key 1/2/3/4 → Value = 1
//   5. Start a race or arena, press 1/2/3/4 to spawn clones
// ============================================================

[ENABLE]

// ---- Allocate code cave, custom vtable, and variables ----
alloc(CloneCode, 4096)
alloc(CloneVTable, 64)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(orig_ball, 4)
alloc(new_ball, 4)

// ---- Build custom vtable (copy of player vtable with [0]+[4] replaced) ----
CloneVTable:
  dd 004027F0    // [0]  = 8-ball dtor (handles 0xC98 free)
  dd 004015B0    // [1]  = SetupCollisionRender (player)
  dd 00403DC0    // [2]  = Player render
  dd 00402A70    // [3]  = shared
  dd 00408390    // [4]  = AI tick (Ball_Update + AI targeting)
  dd 00401590    // [5]  = Force wrapper (shared)
  dd 004016F0    // [6]  = ApplyForceV2 (player)
  dd 00402C10    // [7]  = shared
  dd 00409050    // [8]  = Player shadow
  dd 00401640    // [9]  = Timer_dtor
  dd 00457B10    // [10]
  dd 00457B50    // [11]
  dd 00457A70    // [12]
  dd 00457A50    // [13]
  dd 00401000    // [14]
  dd 00457B80    // [15]

// ---- Initialize variables ----
scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
orig_ball:
  dd 0
new_ball:
  dd 0

// ---- Register symbols ----
registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

// ---- Labels ----
label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_notfound)
label(spawn_found)
label(spawn_next)
label(zero_loop)
label	copy_done

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// Original bytes: 53 55 56 8B D9 57
// ============================================================

CloneCode:
  // Save scene pointer (ecx = scene, __fastcall)
  mov [scene_saved], ecx

  // Quick check: any spawn flag set?
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz original_code

  // Save all registers
  pushad

  // ---- Player 1 ----
  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

original_code:
  push ebx          // 53
  push ebp          // 55
  push esi          // 56
  mov ebx, ecx      // 8B D9
  push edi          // 57
  jmp 0041B546

// ============================================================
// SpawnClone — Creates one AI clone of the player in [player_idx]
// Uses Ball_ctor2 (PLAYER ball) + custom vtable + manual AI fields
// ============================================================

SpawnClone:
  // Get scene pointer
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // Get ball_list items and count
  mov edx, [ecx+0x2DE0]
  mov edi, [ecx+0x29D8]
  test edi, edi
  jz spawn_skip
  test edx, edx
  jz spawn_skip

  // Find player's ball
  xor esi, esi

spawn_next:
  cmp esi, edi
  jae spawn_notfound
  mov eax, esi
  shl eax, 2
  add eax, edx
  mov eax, [eax]
  test eax, eax
  jz spawn_notfound
  mov ebx, [player_idx]
  cmp [eax+0x18], ebx
  je spawn_found
  inc esi
  jmp spawn_next

spawn_notfound:
  jmp spawn_skip

spawn_found:
  mov [orig_ball], eax

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B               // operator_new (__cdecl)
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation (0xC98 / 4 = 0x326 dwords) ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) — PLAYER ball constructor ----
  // __thiscall: ecx=this, push scene (callee cleans 4 bytes)
  mov ecx, [scene_saved]
  push ecx
  mov ecx, [new_ball]
  call 004039E0               // Ball_ctor2 → vtable=0x4CF314

  // ---- Call player vtable[1] = SetupCollisionRender ----
  // __thiscall: ecx=new_ball, no params
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Replace vtable with our custom vtable ----
  mov eax, [new_ball]
  mov dword [eax], CloneVTable

  // ---- Zero AI fields area (0xC60-0xC98) just in case ctor2 wrote there ----
  mov edi, [new_ball]
  add edi, 0xC60
  xor eax, eax
  mov ecx, 14                  // 0x38 / 4 = 14 dwords
  cld
  rep stosd

  // ---- Set AI fields ----
  mov edx, [new_ball]

  // chase_distance = 600.0
  mov dword [edx+0xC6C], 44160000
  // home_radius = 1200.0
  mov dword [edx+0xC70], 44960000
  // visibility_counter = 0xFFFF (high, keeps AI active)
  mov dword [edx+0xC74], 0000FFFF
  // spin_distance = 50.0
  mov dword [edx+0xC7C], 42480000

  // ---- Copy render context from original (0xA4 bytes = 41 dwords) ----
  // Includes RenderContext1, RenderContext2, color_RGBA, uses_alpha
  mov esi, [orig_ball]
  mov edi, [new_ball]
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd

  // ---- Copy trajectory from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x2AC]
  mov [edi+0x2AC], eax
  mov eax, [esi+0x2B0]
  mov [edi+0x2B0], eax
  mov eax, [esi+0x2B4]
  mov [edi+0x2B4], eax
  mov eax, [esi+0x2B8]
  mov [edi+0x2B8], eax

  // ---- Copy render position from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x1BC]
  mov [edi+0x1BC], eax
  mov eax, [esi+0x1C0]
  mov [edi+0x1C0], eax
  mov eax, [esi+0x1C4]
  mov [edi+0x1C4], eax
  mov eax, [esi+0x1C8]
  mov [edi+0x1C8], eax
  mov eax, [esi+0x204]
  mov [edi+0x204], eax

  // ---- Set player values ----
  mov edx, [new_ball]

  // player_index (score sharing)
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // radius = 26.0
  mov dword [edx+0x284], 41D00000
  // max_speed = 5.0
  mov dword [edx+0x188], 40A00000
  // gravity_scale = 0.5
  mov dword [edx+0x278], 3F000000
  // gravity_mult = 0.1
  mov dword [edx+0x27C], 3DCCCCCD
  // render_scale = 1.05
  mov dword [edx+0x1A0], 3F866666

  // ---- Set position from original + 5.0 offset ----
  mov eax, [orig_ball]
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // ---- Set home position = original's position ----
  mov eax, [orig_ball]
  mov ebx, [eax+0x164]
  mov [edx+0xC60], ebx
  mov ebx, [eax+0x168]
  mov [edx+0xC64], ebx
  mov ebx, [eax+0x16C]
  mov [edx+0xC68], ebx

  // ---- Set render/material flags ----
  mov dword [edx+0xC38], FFFFFFFF    // material_check = -1
  mov dword [edx+0xC5C], 0           // render_flag = 0
  mov byte [edx+0xC80], 0            // viewport_clip = false

  // ---- Set active flags ----
  mov byte [edx+0x768], 1             // is_active
  mov byte [edx+0x769], 1             // active_flag
  mov byte [edx+0x2F9], 0             // not falling
  mov byte [edx+0x324], 0             // no early return
  mov byte [edx+0x281], 1             // is_falling = false (byte)

  // ---- Copy velocity from original ----
  mov eax, [orig_ball]
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // ---- Add to scene->ball_list (0x29D4) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push edx
  call 00453810

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push edx
  call 00453810

spawn_skip:
  ret

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(CloneVTable)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(orig_ball)
dealloc(new_ball)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
