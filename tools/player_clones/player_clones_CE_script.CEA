// ============================================================
// Player Clones Mod v9 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v9:
//
// 1. CHASE FIX — Custom AI replaces broken COMPUTER AI:
//    ROOT CAUSE: COMPUTER AI (0x4222D0) searches ball_list using a global
//    shuffle table (0x4F7360). In races with 1-2 balls, search always finds
//    self → no target → computes force toward (0,0,0) world origin.
//    The AI also calls vtable[5] (ApplyForce) INTERNALLY at 0x422462,
//    so zeroing the output buffer does nothing — force is already applied.
//    FIX: Don't call COMPUTER AI at all. Write custom AI that:
//    a) Iterates scene->ball_list (scene+0x29D4) to find nearest active ball
//    b) Skips self and dead balls
//    c) Computes direction = target_pos - clone_pos
//    d) Normalizes and scales by 2.0 (aggressive chase speed)
//    e) Applies force directly via vtable[5] (ApplyForce)
//
// 2. CRASH/SPAWN FIX — Register clobbering between AthenaList_Append calls:
//    ROOT CAUSE: AthenaList_Append (0x453780) clobbers eax, ecx, edx, ebx.
//    v8 pushed EDX (new_ball ptr) to the second Append call AFTER EDX was
//    clobbered by the first Append → garbage pointer in all_balls_list → crash.
//    FIX: Use [new_ball] memory variable for all pointer access.
//    Reload from [new_ball] after EVERY function call. Never rely on registers
//    persisting across calls.
//
// 3. P2-4 SPAWN FIX — Correct player_index assignment:
//    Clones now get the correct player_index (0,1,2,3) regardless of which
//    ball was used as position source. Render context is NOT copied from
//    fallback (Player 1) when spawning P2-4 without original. Instead,
//    Ball_ctor2 defaults are used, and player_index is set to the requested
//    value so the render code applies the correct per-player color.
//
// BALL STRUCT OFFSETS:
//   +0x010  App ptr           +0x014  Scene ptr
//   +0x018  player_index      +0x164  pos X/Y/Z (3 floats)
//   +0x170  vel X/Y/Z (3 floats)  +0x188  max_speed
//   +0x1A0  render_scale      +0x284  radius
//   +0x288  AI target ptr     +0x2F8  respawn flag
//   +0x2F9  is_falling        +0x324  return_early
//   +0x768  is_active         +0x808  AI state (0=search, !=0=locked)
//
// ATHENALIST OFFSETS:
//   +0x004  count (int32)     +0x40C  items array (pointer to ptr array)
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Set Hotkey → Key 1/2/3/4 → Value = 1
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(src_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(tmp_ball, 4)
alloc(nearest_ball, 4)
alloc(nearest_dist, 4)
alloc(tmp_x, 4)
alloc(tmp_y, 4)
alloc(tmp_z, 4)
alloc(tmp_dist, 4)
alloc(list_count, 4)
alloc(list_items, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
src_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
tmp_ball:
  dd 0
nearest_ball:
  dd 0
nearest_dist:
  dd 0
tmp_x:
  dd 0
tmp_y:
  dd 0
tmp_z:
  dd 0
tmp_dist:
  dd 0
list_count:
  dd 0
list_items:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_found)
label(use_p1_fallback)
label(no_fallback)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_dead)
label(phase2)
label(find_target)
label(ft_loop)
label(ft_skip)
label(ft_done)
label(found_target)
label(no_target)
label(apply_force)
label(do_compact)
label(compact_loop)
label(compact_done)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Custom AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK ----
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK ----
  cmp byte [eax+0x768], 0
  je ai_skip_dead

  // ---- RESPAWN FIX ----
  cmp byte [eax+0x2F8], 0
  je no_respawn_reset
  mov dword [eax+0x808], 0
  mov dword [eax+0x288], 0
  mov byte [eax+0x2F8], 0
  mov byte [eax+0x324], 0
  mov dword [eax+0x170], 0
  mov dword [eax+0x174], 0
  mov dword [eax+0x178], 0

no_respawn_reset:
  // ---- Store current clone ptr ----
  mov [tmp_ball], eax

  // ---- FIND NEAREST TARGET ----
  call FindNearestTarget

  // ---- Check if target found ----
  mov eax, [nearest_ball]
  test eax, eax
  jz ai_skip_dead    // No target found → skip force (ball just rolls)

  // ---- COMPUTE FORCE toward target ----
  // force = normalize(target_pos - clone_pos) * 2.0
  mov ecx, [tmp_ball]       // clone ptr
  mov edx, [nearest_ball]   // target ptr

  // direction = target_pos - clone_pos
  fld dword [edx+0x164]      // target X
  fsub dword [ecx+0x164]    // - clone X
  fstp dword [force_buf]     // force_x = dx

  fld dword [edx+0x168]      // target Y
  fsub dword [ecx+0x168]    // - clone Y
  fstp dword [force_buf+4]   // force_y = dy

  fld dword [edx+0x16C]      // target Z
  fsub dword [ecx+0x16C]    // - clone Z
  fstp dword [force_buf+8]   // force_z = dz

  // ---- NORMALIZE force_buf and scale by 2.0 ----
  // len = sqrt(x² + y² + z²)
  fld dword [force_buf]       // st0 = x
  fmul st0, st0              // x²
  fld dword [force_buf+4]    // st0 = y
  fmul st0, st0              // y²
  faddp st1, st0            // x² + y²
  fld dword [force_buf+8]    // st0 = z
  fmul st0, st0              // z²
  faddp st1, st0            // x² + y² + z²
  fsqrt                       // len

  // If len == 0, skip force
  ftst
  fstsw ax
  test ah, 0x44              // check zero flag
  jp apply_force             // if not zero, normalize

  // len == 0, zero force
  mov dword [force_buf], 0
  mov dword [force_buf+4], 0
  mov dword [force_buf+8], 0
  jmp apply_force

apply_force:
  // Divide each component by len, then multiply by 2.0
  fld dword [force_buf]       // x
  fdiv st0, st1              // x / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf]     // force_x

  fld dword [force_buf+4]    // y
  fdiv st0, st1              // y / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf+4]   // force_y

  fld dword [force_buf+8]    // z
  fdiv st0, st1              // z / len
  fmul dword [float_2_0]     // × 2.0
  fstp dword [force_buf+8]   // force_z

  fstp st(0)                // pop len from FPU stack

  // ---- APPLY FORCE via vtable[5] ----
  // vtable[5] = ApplyForce(force_x, force_y, force_z)
  // __thiscall: ecx = this, args on stack
  mov ecx, [tmp_ball]
  mov edx, [ecx]             // vtable
  push dword [force_buf+8]   // force_z
  push dword [force_buf+4]   // force_y
  push dword [force_buf]     // force_x
  call dword [edx+0x14]     // vtable[5] = ApplyForce (ret 0x0C)

ai_skip_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry ----
do_compact:
  pushad
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ============================================================
// FindNearestTarget — Find nearest active ball in ball_list
// Input: [tmp_ball] = clone ptr
// Output: [nearest_ball] = target ptr (0 if none found)
// Uses: ball_list at [scene_saved]+0x29D4
// ============================================================

FindNearestTarget:
  mov dword [nearest_ball], 0
  mov dword [nearest_dist], 447A0000  // 100000.0 (very large)

  // Get ball_list
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]       // &ball_list
  mov eax, [ecx+4]             // count
  mov [list_count], eax
  mov eax, [ecx+0x40C]        // items array
  mov [list_items], eax

  // Check if list is valid
  cmp [list_count], 0
  je ft_done
  cmp [list_items], 0
  je ft_done

  xor edi, edi                  // loop index = 0

ft_loop:
  cmp edi, [list_count]
  jae ft_done

  // Get ball at index
  mov ecx, [list_items]
  mov eax, [ecx + edi*4]      // ball ptr
  test eax, eax
  jz ft_skip

  // Skip self
  cmp eax, [tmp_ball]
  je ft_skip

  // Skip dead balls
  cmp byte [eax+0x768], 0
  je ft_skip

  // Compute distance (squared, no sqrt needed for comparison)
  mov edx, [tmp_ball]          // clone ptr
  fld dword [eax+0x164]        // target X
  fsub dword [edx+0x164]      // - clone X
  fmul st0, st0                // dx²
  fld dword [eax+0x168]       // target Y
  fsub dword [edx+0x168]      // - clone Y
  fmul st0, st0                // dy²
  faddp st1, st0              // dx² + dy²
  fld dword [eax+0x16C]       // target Z
  fsub dword [edx+0x16C]      // - clone Z
  fmul st0, st0                // dz²
  faddp st1, st0              // dx² + dy² + dz²
  // st0 = dist²

  // Compare with nearest_dist
  fcomp dword [nearest_dist]
  fstsw ax
  test ah, 0x41               // if st0 < nearest_dist
  jp ft_skip                  // not less → skip

  // This ball is closer → update nearest
  mov [nearest_ball], eax
  // Store dist² as nearest_dist
  // We need to recompute because fcomp popped st0
  fld dword [eax+0x164]
  fsub dword [edx+0x164]
  fmul st0, st0
  fld dword [eax+0x168]
  fsub dword [edx+0x168]
  fmul st0, st0
  faddp st1, st0
  fld dword [eax+0x16C]
  fsub dword [edx+0x16C]
  fmul st0, st0
  faddp st1, st0
  fstp dword [nearest_dist]

ft_skip:
  inc edi
  jmp ft_loop

ft_done:
  ret

// ============================================================
// SpawnClone — Creates one player clone + registers it
// Uses player table for original ball, falls back to Player 1
// ============================================================

SpawnClone:
  mov dword [src_ball], 0

  // ---- Try to read original ball from player table ----
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]
  test eax, eax
  jz use_p1_fallback

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz use_p1_fallback

  mov [src_ball], eax
  jmp spawn_found

use_p1_fallback:
  // Use Player 1 as position source (always present in races)
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  mov eax, [ecx + 0x5DC]       // Player 1 ball (pidx=0, offset=0)
  test eax, eax
  jz spawn_skip

  cmp byte [eax+0x768], 0
  jz spawn_skip

  mov [src_ball], eax
  jmp spawn_found

no_fallback:
  jmp spawn_skip

spawn_found:
  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  mov ecx, [new_ball]
  mov edx, [scene_saved]
  push edx
  call 004039E0

  // ---- Call vtable[1] = SetupCollisionRender ----
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Set player values ----
  mov edx, [new_ball]

  // player_index = requested value
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // Physics values
  mov dword [edx+0x284], 41D00000  // radius = 26.0
  mov dword [edx+0x188], 40A00000  // max_speed = 5.0
  mov dword [edx+0x278], 3F000000  // gravity_scale = 0.5
  mov dword [edx+0x27C], 3DCCCCCD  // gravity_mult = 0.1
  mov dword [edx+0x1A0], 3F866666  // render_scale = 1.05

  // ---- Set position from source ball ----
  mov eax, [src_ball]
  test eax, eax
  jz spawn_skip

  // Reload new_ball ptr (may have been clobbered)
  mov edx, [new_ball]

  // Copy position from source + offset
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Copy velocity from source
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // Copy render context from source (41 dwords from +0x1B8)
  push esi
  push edi
  mov esi, eax
  mov edi, edx
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd
  pop edi
  pop esi

  // Copy render position
  mov eax, [src_ball]
  mov edx, [new_ball]
  mov ebx, [eax+0x1BC]
  mov [edx+0x1BC], ebx
  mov ebx, [eax+0x1C0]
  mov [edx+0x1C0], ebx
  mov ebx, [eax+0x1C4]
  mov [edx+0x1C4], ebx
  mov ebx, [eax+0x1C8]
  mov [edx+0x1C8], ebx
  mov ebx, [eax+0x204]
  mov [edx+0x204], ebx

  // Copy trajectory
  mov ebx, [eax+0x2AC]
  mov [edx+0x2AC], ebx
  mov ebx, [eax+0x2B0]
  mov [edx+0x2B0], ebx
  mov ebx, [eax+0x2B4]
  mov [edx+0x2B4], ebx
  mov ebx, [eax+0x2B8]
  mov [edx+0x2B8], ebx

  // ---- Set active flags ----
  mov edx, [new_ball]
  mov byte [edx+0x768], 1
  mov byte [edx+0x769], 1
  mov byte [edx+0x2F9], 0
  mov byte [edx+0x324], 0

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0
  mov dword [edx+0x288], 0

  // ---- Add to scene->ball_list (0x29D4) ----
  // AthenaList_Append clobbers eax,ecx,edx,ebx — save ball ptr first
  mov eax, [new_ball]
  push eax                      // save ball ptr on stack
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push eax                      // arg: ball ptr
  call 00453810
  pop eax                       // restore ball ptr (balance stack: push+pop)

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push eax                      // arg: ball ptr (reloaded from saved)
  call 00453810

  // ---- Register clone ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Data
// ============================================================

float_2_0:
  dd 40000000  // 2.0

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(src_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(tmp_ball)
dealloc(nearest_ball)
dealloc(nearest_dist)
dealloc(tmp_x)
dealloc(tmp_y)
dealloc(tmp_z)
dealloc(tmp_dist)
dealloc(list_count)
dealloc(list_items)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
