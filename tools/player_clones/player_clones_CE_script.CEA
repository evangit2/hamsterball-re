// ============================================================
// Player Clones Mod v5 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// WHAT'S NEW IN v5:
//   - Calls COMPUTER AI function (0x4222D0) for each clone every frame
//   - Uses PLAYER ball vtable (player appearance) NOT 8-ball vtable
//   - Swaps ball pointer in player table so AI targets the clone
//   - Temporarily sets control mode to COMPUTER (0x63)
//   - Restores original ball pointer and control mode after AI call
//   - COMPUTER AI excludes self from targeting (unlike 8-ball AI)
//   - Score sharing via player_index (same as original)
//
// ROOT CAUSE OF "MOTIONLESS" BUG (v3/v4):
//   The 8-ball AI tick (0x408390) does NOT exclude self from targeting.
//   When a clone is in the ball_list with player_index != -1,
//   the AI finds ITSELF as the nearest target (distance=0),
//   computes a zero force vector, and the ball never moves.
//   The COMPUTER AI function (0x4222D0) DOES exclude self:
//   it compares each candidate with [App+0x878 + pidx*0xA0 + 0x5DC]
//   and skips if they match.
//
// APPROACH:
//   1. Create PLAYER ball (Ball_ctor2, player vtable, player appearance)
//   2. Keep PLAYER vtable (NOT custom vtable with AI tick)
//      - vtable[4] = 0x405E00 (Ball_Update, physics only)
//      - The game calls vtable[4] every frame for physics
//   3. Every frame, for each clone:
//      a. Save original ball ptr at [scene+0x878 + pidx*0xA0 + 0x5DC]
//      b. Write clone ptr to that location
//      c. Save original control mode at [scene+0x878 + pidx*4 + 0xB28]
//      d. Write 0x63 (COMPUTER) to control mode
//      e. Call 0x4222D0(scene, &forceBuf, pidx) — AI computes force + applies via vtable[5]
//      f. Restore original ball ptr
//      g. Restore original control mode
//   4. The AI function internally:
//      - Checks control mode == 0x63 (COMPUTER) → passes
//      - Reads ball from [scene+0x878 + pidx*0xA0 + 0x5DC] → our clone
//      - Searches ball_list for nearest target (excludes self)
//      - Computes direction to target
//      - Normalizes + multiplies by speed scalar
//      - Applies force via ball->vtable[5] (player vtable[5] = 0x401590)
//      - Clears AI state (ball+0x808)
//
// FUNCTIONS TRACED:
//   Ball_ctor2             @ 0x4039E0  (PLAYER ball ctor, vtable=0x4CF314)
//   COMPUTER AI            @ 0x4222D0  (__thiscall, ecx=scene, ret 8)
//     [esp+4] = float* outForce (12 bytes)
//     [esp+8] = int playerIndex
//   Ball_Update            @ 0x405E00  (player vtable[4], physics only)
//   Force wrapper          @ 0x401590  (player vtable[5], applies force)
//   AthenaList_Append      @ 0x453810  (__thiscall, ecx=list, push item)
//   operator_new           @ 0x4BA57B  (__cdecl)
//
// BALL STRUCT OFFSETS:
//   +0x000  vtable          +0x010  App ptr
//   +0x014  Scene ptr       +0x018  player_index
//   +0x164  pos X/Y/Z       +0x170  vel X/Y/Z
//   +0x188  max_speed       +0x1A0  render_scale
//   +0x1A4  CollisionMesh   +0x1B8  RenderContext1
//   +0x208  RenderContext2  +0x278  gravity_scale
//   +0x284  radius          +0x288  AI target ptr
//   +0x768  is_active       +0x808  AI state (0=search, !0=use stored)
//
// PLAYER TABLE (in App sub-struct at scene+0x878):
//   +0x5DC + pidx*0xA0 = ball pointer for player pidx
//   +0xB28 + pidx*4    = control mode (0x63=COMPUTER, 0x64=OFF, other=HUMAN)
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Right-click → Set Hotkey → Key 1/2/3/4 → Value = 1
//   5. Start a race or arena, press 1/2/3/4 to spawn clones
// ============================================================

[ENABLE]

// ---- Allocate code cave, variables, clone registry ----
alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(orig_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)       // up to 8 clone ball pointers
alloc(clone_pidx, 32)       // up to 8 clone player indices
alloc(force_buf, 12)        // 3 floats for AI force output
alloc(saved_ball_ptr, 4)    // temp save for ball ptr swap
alloc(saved_ctrl_mode, 4)   // temp save for control mode swap

// ---- Initialize variables ----
scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
orig_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
saved_ball_ptr:
  dd 0
saved_ctrl_mode:
  dd 0

// ---- Register symbols ----
registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

// ---- Labels ----
label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_notfound)
label(spawn_found)
label(spawn_next)
label(registry_full)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip)
label(skip_ai_for_dead)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// Original bytes: 53 55 56 8B D9 57
// ============================================================

CloneCode:
  // Save scene pointer
  mov [scene_saved], ecx

  // ---- PHASE 1: Check spawn flags and create clones ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Call COMPUTER AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi          // esi = loop index

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  // Get clone pointer and player index
  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // Check if clone is still active (ball+0x768 != 0)
  cmp byte [eax+0x768], 0
  je skip_ai_for_dead

  // Save the clone's player index
  mov edi, [clone_pidx + esi*4]

  // ---- Swap ball pointer in player table ----
  // Original ball ptr at [scene+0x878 + pidx*0xA0 + 0x5DC]
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]           // ecx = App sub-struct
  // Calculate offset: pidx * 0xA0
  mov edx, edi
  imul edx, edx, 0xA0
  // Save original
  mov ebx, [ecx + edx + 0x5DC]
  mov [saved_ball_ptr], ebx
  // Write clone ptr
  mov [ecx + edx + 0x5DC], eax

  // ---- Swap control mode to COMPUTER ----
  // Control mode at [App+0x878 + pidx*4 + 0xB28]
  mov edx, edi
  shl edx, 2                       // pidx * 4
  mov ebx, [ecx + edx + 0xB28]
  mov [saved_ctrl_mode], ebx
  // Set to COMPUTER (0x63)
  mov dword [ecx + edx + 0xB28], 0x63

  // ---- Call COMPUTER AI function ----
  // __thiscall: ecx = scene, push force_buf, push pidx
  // ret 8 (callee cleans 8 bytes)
  push edi                         // push playerIndex
  lea eax, [force_buf]
  push eax                         // push &force_buf
  mov ecx, [scene_saved]
  call 004222D0                    // COMPUTER AI (ret 8)

  // ---- Restore original ball ptr ----
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [saved_ball_ptr]
  mov [ecx + edx + 0x5DC], ebx

  // ---- Restore original control mode ----
  mov edx, edi
  shl edx, 2
  mov ebx, [saved_ctrl_mode]
  mov [ecx + edx + 0xB28], ebx

skip_ai_for_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  popad

original_code:
  push ebx          // 53
  push ebp          // 55
  push esi          // 56
  mov ebx, ecx      // 8B D9
  push edi          // 57
  jmp 0041B546

// ============================================================
// SpawnClone — Creates one player clone + registers it
// Uses Ball_ctor2 (PLAYER ball) + player vtable (no custom vtable)
// ============================================================

SpawnClone:
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // Get ball_list items and count
  mov edx, [ecx+0x2DE0]
  mov edi, [ecx+0x29D8]
  test edi, edi
  jz spawn_skip
  test edx, edx
  jz spawn_skip

  // Find player's ball
  xor esi, esi

spawn_next:
  cmp esi, edi
  jae spawn_notfound
  mov eax, esi
  shl eax, 2
  add eax, edx
  mov eax, [eax]
  test eax, eax
  jz spawn_notfound
  mov ebx, [player_idx]
  cmp [eax+0x18], ebx
  je spawn_found
  inc esi
  jmp spawn_next

spawn_notfound:
  jmp spawn_skip

spawn_found:
  mov [orig_ball], eax

  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  mov ecx, [scene_saved]
  push ecx
  mov ecx, [new_ball]
  call 004039E0

  // ---- Call player vtable[1] = SetupCollisionRender ----
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Copy render context from original (41 dwords from +0x1B8) ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd

  // ---- Copy trajectory from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x2AC]
  mov [edi+0x2AC], eax
  mov eax, [esi+0x2B0]
  mov [edi+0x2B0], eax
  mov eax, [esi+0x2B4]
  mov [edi+0x2B4], eax
  mov eax, [esi+0x2B8]
  mov [edi+0x2B8], eax

  // ---- Copy render position from original ----
  mov esi, [orig_ball]
  mov edi, [new_ball]
  mov eax, [esi+0x1BC]
  mov [edi+0x1BC], eax
  mov eax, [esi+0x1C0]
  mov [edi+0x1C0], eax
  mov eax, [esi+0x1C4]
  mov [edi+0x1C4], eax
  mov eax, [esi+0x1C8]
  mov [edi+0x1C8], eax
  mov eax, [esi+0x204]
  mov [edi+0x204], eax

  // ---- Set player values ----
  mov edx, [new_ball]

  // player_index (score sharing)
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // radius = 26.0
  mov dword [edx+0x284], 41D00000
  // max_speed = 5.0
  mov dword [edx+0x188], 40A00000
  // gravity_scale = 0.5
  mov dword [edx+0x278], 3F000000
  // gravity_mult = 0.1
  mov dword [edx+0x27C], 3DCCCCCD
  // render_scale = 1.05
  mov dword [edx+0x1A0], 3F866666

  // ---- Set position from original + 5.0 offset ----
  mov eax, [orig_ball]
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // ---- Copy velocity from original ----
  mov eax, [orig_ball]
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // ---- Set active flags ----
  mov byte [edx+0x768], 1
  mov byte [edx+0x769], 1
  mov byte [edx+0x2F9], 0
  mov byte [edx+0x324], 0

  // ---- Clear AI state (ball+0x808 = 0, ball+0x288 = 0) ----
  mov dword [edx+0x808], 0
  mov dword [edx+0x288], 0

  // ---- Add to scene->ball_list (0x29D4) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push edx
  call 00453810

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push edx
  call 00453810

  // ---- Register clone in arrays ----
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Install hook at 0x41B540
// ============================================================

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(orig_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(saved_ball_ptr)
dealloc(saved_ctrl_mode)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
