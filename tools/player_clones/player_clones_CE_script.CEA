// ============================================================
// Player Clones Mod v10 for Hamsterball
// Pure AutoAssembler — No Lua Required
// ============================================================
//
// FIXES IN v10 (from v9):
//
// 1. MOTIONLESS CLONES FIX — Two root causes:
//    a) FPU comparison bug in FindNearestTarget:
//       v9 used "test ah, 0x41 / jp ft_skip" which tests the wrong
//       FPU condition flags and uses the parity flag incorrectly.
//       The comparison NEVER found a target → nearest_ball stayed 0
//       → AI applied zero force → motionless clones.
//       FIX: Use sahf + jb (jump if below = st0 < mem = closer)
//
//    b) FPU zero-check bug in normalize:
//       Same wrong flag testing ("test ah, 0x44 / jp").
//       FIX: Use ftst + sahf + jne (jump if not zero).
//
//    c) Direct velocity manipulation instead of vtable[5]:
//       vtable[5] → vtable[6] (0x4016F0) has 4 gate checks:
//       - ball+0x2F9 != 0 (is_falling) → rejects force
//       - ball+0x2CC != 0 (stunned) → rejects force
//       - ball+0x808 != 0 (AI state) → rejects force
//       - ball+0x2F0 > 80 (counter) → rejects force
//       Any of these can block force application.
//       FIX: Bypass vtable[5] entirely. Add force directly to velocity
//       at ball+0x170/0x174/0x178.
//
// 2. PLAYER COLOR FIX:
//    ball+0x758/0x75C/0x760 = float R/G/B color of the ball.
//    Ball_ctor2 doesn't set these (leaves at 0 = black).
//    The render code copies them to [App+0x178]+0x854+pidx*12.
//    v9 didn't copy them from source → all clones were black.
//    FIX: Copy ball+0x758/0x75C/0x760 from source ball, AND set
//    per-player override colors when the requested player_index
//    differs from the source (for visual distinction).
//
// 3. GAME PROCESSING FIX:
//    ball+0x2E8 must be set to 1 or Scene_UpdateBallsAndState skips
//    the post-update collision processing (0x405190).
//    FIX: Set ball+0x2E8 = 1 at spawn.
//
// BALL STRUCT OFFSETS:
//   +0x010  App ptr           +0x014  Scene ptr
//   +0x018  player_index      +0x164  pos X/Y/Z (3 floats)
//   +0x170  vel X/Y/Z (3 floats)  +0x188  max_speed
//   +0x1A0  render_scale      +0x284  radius
//   +0x288  AI target ptr     +0x2E8  process_flag (must be 1)
//   +0x2F0  counter           +0x2F8  respawn flag
//   +0x2F9  is_falling        +0x324  return_early
//   +0x768  is_active         +0x758  color R/G/B (3 floats)
//   +0x808  AI state
//
// ATHENALIST OFFSETS:
//   +0x004  count (int32)     +0x40C  items array (pointer to ptr array)
//
// SETUP:
//   1. Attach CE to Hamsterball.exe
//   2. Auto Assembler (Ctrl+A) → paste → Execute
//   3. Add addresses: spawnP1, spawnP2, spawnP3, spawnP4
//   4. For each: Set Hotkey → Key 1/2/3/4 → Value = 1
// ============================================================

[ENABLE]

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(src_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(tmp_ball, 4)
alloc(nearest_ball, 4)
alloc(nearest_dist, 4)
alloc(list_count, 4)
alloc(list_items, 4)
alloc(color_r, 4)
alloc(color_g, 4)
alloc(color_b, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
src_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
tmp_ball:
  dd 0
nearest_ball:
  dd 0
nearest_dist:
  dd 0
list_count:
  dd 0
list_items:
  dd 0
color_r:
  dd 0
color_g:
  dd 0
color_b:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_found)
label(use_p1_fallback)
label(phase2)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_force)
label(do_compact)
label(compact_loop)
label(compact_done)
label(set_p1_color)
label(set_p2_color)
label(set_p3_color)
label(set_p4_color)
label(color_done)

// ============================================================
// CODE CAVE — Hook for Scene_UpdateBallsAndState (0x41B540)
// ============================================================

CloneCode:
  mov [scene_saved], ecx

  // ---- PHASE 1: Spawn clones if requested ----
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

  // ---- PHASE 2: Custom AI for each clone ----
phase2:
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  mov eax, [clone_ptrs + esi*4]
  test eax, eax
  jz ai_next

  // ---- STALE CHECK: scene ptr still valid? ----
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  mov dword [clone_ptrs + esi*4], 0
  jmp ai_next

not_stale:
  // ---- DEAD CHECK: is_active flag ----
  cmp byte [eax+0x768], 0
  je ai_skip_force

  // ---- Store current clone ptr ----
  mov [tmp_ball], eax

  // ---- FIND NEAREST TARGET ----
  call FindNearestTarget

  // ---- Check if target found ----
  mov eax, [nearest_ball]
  test eax, eax
  jz ai_skip_force    // No target found → skip force (ball rolls with physics)

  // ---- COMPUTE FORCE toward target ----
  // force = normalize(target_pos - clone_pos) * FORCE_MAGNITUDE
  mov ecx, [tmp_ball]       // clone ptr
  mov edx, [nearest_ball]   // target ptr

  // direction = target_pos - clone_pos
  fld dword [edx+0x164]      // target X
  fsub dword [ecx+0x164]    // - clone X
  fstp dword [force_buf]     // force_x = dx

  fld dword [edx+0x168]      // target Y
  fsub dword [ecx+0x168]    // - clone Y
  fstp dword [force_buf+4]   // force_y = dy

  fld dword [edx+0x16C]      // target Z
  fsub dword [ecx+0x16C]    // - clone Z
  fstp dword [force_buf+8]   // force_z = dz

  // ---- NORMALIZE and scale ----
  // len = sqrt(x² + y² + z²)
  fld dword [force_buf]       // st0 = x
  fmul st0, st0              // x²
  fld dword [force_buf+4]    // st0 = y
  fmul st0, st0              // y²
  faddp st1, st0            // x² + y²
  fld dword [force_buf+8]    // st0 = z
  fmul st0, st0              // z²
  faddp st1, st0            // x² + y² + z²
  fsqrt                       // st0 = len

  // If len == 0, skip force
  ftst
  sahf
  je ai_skip_force           // len == 0 → skip (no direction)

  // Normalize: divide each component by len, then multiply by 0.5
  // Using 0.5 as force magnitude (reasonable acceleration per frame)
  fld dword [force_buf]       // st0 = x, st1 = len
  fdiv st0, st1              // x / len
  fmul dword [float_0_5]     // × 0.5
  fstp dword [force_buf]     // store force_x, st0 = len

  fld dword [force_buf+4]    // st0 = y, st1 = len
  fdiv st0, st1              // y / len
  fmul dword [float_0_5]     // × 0.5
  fstp dword [force_buf+4]   // store force_y, st0 = len

  fld dword [force_buf+8]    // st0 = z, st1 = len
  fdiv st0, st1              // z / len
  fmul dword [float_0_5]     // × 0.5
  fstp dword [force_buf+8]   // store force_z, st0 = len

  fstp st(0)                // pop len from FPU stack

  // ---- APPLY FORCE DIRECTLY TO VELOCITY ----
  // Bypass vtable[5] entirely — no gate checks
  // vel += force
  mov ecx, [tmp_ball]

  fld dword [ecx+0x170]       // vel_x
  fadd dword [force_buf]     // + force_x
  fstp dword [ecx+0x170]     // store new vel_x

  fld dword [ecx+0x174]       // vel_y
  fadd dword [force_buf+4]   // + force_y
  fstp dword [ecx+0x174]     // store new vel_y

  fld dword [ecx+0x178]       // vel_z
  fadd dword [force_buf+8]   // + force_z
  fstp dword [ecx+0x178]     // store new vel_z

  // ---- CLAMP VELOCITY to max_speed ----
  // If |vel| > max_speed, scale down
  // Simple approach: just clamp each component to ±max_speed
  mov edx, [ecx+0x188]       // max_speed (float)
  test edx, edx
  jz ai_skip_force

  // Clamp vel_x
  fld dword [ecx+0x170]
  fabs
  fcomp dword [ecx+0x188]    // compare |vel_x| with max_speed
  sahf
  jbe skip_clamp_x           // if |vel_x| <= max_speed, skip
  // vel_x > max_speed → clamp
  fld dword [ecx+0x170]
  fmul dword [float_neg1]   // -vel_x (will be positive if vel was negative)
  // Actually, just set vel_x = max_speed * sign(vel_x)
  // Simpler: if vel_x > max_speed, vel_x = max_speed
  //          if vel_x < -max_speed, vel_x = -max_speed
  fstp st(0)                 // pop garbage
  fld dword [ecx+0x170]
  ftst
  sahf
  ja clamp_x_pos
  // vel_x is negative
  fld dword [ecx+0x188]
  fmul dword [float_neg1]
  fstp dword [ecx+0x170]
  jmp skip_clamp_x
clamp_x_pos:
  fld dword [ecx+0x188]
  fstp dword [ecx+0x170]
skip_clamp_x:

  // Clamp vel_z (skip Y — gravity needs free vertical movement)
  fld dword [ecx+0x178]
  fcomp dword [ecx+0x188]
  sahf
  jbe ai_skip_force
  fld dword [ecx+0x178]
  ftst
  sahf
  ja clamp_z_pos
  fld dword [ecx+0x188]
  fmul dword [float_neg1]
  fstp dword [ecx+0x178]
  jmp ai_skip_force
clamp_z_pos:
  fld dword [ecx+0x188]
  fstp dword [ecx+0x178]

ai_skip_force:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // ---- Compact registry (remove stale/dead clones) ----
do_compact:
  pushad
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, [clone_ptrs + ecx*4]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  mov [clone_ptrs + edx*4], eax
  mov eax, [clone_pidx + ecx*4]
  mov [clone_pidx + edx*4], eax
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ============================================================
// FindNearestTarget — Find nearest active ball in ball_list
// Input: [tmp_ball] = clone ptr
// Output: [nearest_ball] = target ptr (0 if none found)
// ============================================================

FindNearestTarget:
  mov dword [nearest_ball], 0
  mov dword [nearest_dist], 44700000   // 3904.0 (large enough)

  // Get ball_list at scene+0x29D4
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  mov eax, [ecx+4]             // count
  mov [list_count], eax
  mov eax, [ecx+0x40C]        // items array ptr
  mov [list_items], eax

  // Validate list
  cmp [list_count], 0
  je ft_done
  cmp [list_items], 0
  je ft_done

  xor edi, edi                  // index = 0

ft_loop:
  cmp edi, [list_count]
  jae ft_done

  // Get ball at index
  mov ecx, [list_items]
  mov eax, [ecx + edi*4]      // ball ptr
  test eax, eax
  jz ft_skip

  // Skip self
  cmp eax, [tmp_ball]
  je ft_skip

  // Skip dead balls
  cmp byte [eax+0x768], 0
  je ft_skip

  // Compute distance² = dx² + dy² + dz²
  mov edx, [tmp_ball]          // clone ptr
  fld dword [eax+0x164]        // target X
  fsub dword [edx+0x164]      // - clone X = dx
  fmul st0, st0                // dx²
  fld dword [eax+0x168]       // target Y
  fsub dword [edx+0x168]      // - clone Y = dy
  fmul st0, st0                // dy²
  faddp st1, st0              // dx² + dy²
  fld dword [eax+0x16C]       // target Z
  fsub dword [edx+0x16C]      // - clone Z = dz
  fmul st0, st0                // dz²
  faddp st1, st0              // dx² + dy² + dz² = dist² (st0)

  // Compare: if dist² < nearest_dist → update
  fcomp dword [nearest_dist]
  sahf                        // transfer FPU flags to CPU flags
  jae ft_skip                 // if st0 >= nearest_dist → not closer, skip

  // This ball is closer → update nearest
  mov [nearest_ball], eax
  // Recompute dist² and store as nearest_dist
  fld dword [eax+0x164]
  fsub dword [edx+0x164]
  fmul st0, st0
  fld dword [eax+0x168]
  fsub dword [edx+0x168]
  fmul st0, st0
  faddp st1, st0
  fld dword [eax+0x16C]
  fsub dword [edx+0x16C]
  fmul st0, st0
  faddp st1, st0
  fstp dword [nearest_dist]

ft_skip:
  inc edi
  jmp ft_loop

ft_done:
  ret

// ============================================================
// SpawnClone — Creates one player clone + registers it
// ============================================================

SpawnClone:
  mov dword [src_ball], 0

  // ---- Try to read original ball from player table ----
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  mov ecx, [ecx+0x878]        // App ptr
  test ecx, ecx
  jz spawn_skip

  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx + edx + 0x5DC]  // player table entry
  test eax, eax
  jz use_p1_fallback

  // Check if original ball is active
  cmp byte [eax+0x768], 0
  jz use_p1_fallback

  mov [src_ball], eax
  jmp spawn_found

use_p1_fallback:
  // Use Player 1 as position source (always present in races)
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  mov eax, [ecx + 0x5DC]       // Player 1 ball (pidx=0, offset=0)
  test eax, eax
  jz spawn_skip

  cmp byte [eax+0x768], 0
  jz spawn_skip

  mov [src_ball], eax
  jmp spawn_found

spawn_found:
  // Check clone registry capacity
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // ---- Allocate 0xC98 bytes (ball struct size) ----
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // ---- Zero entire allocation ----
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // ---- Ball_ctor2(new_ball, scene) ----
  mov ecx, [new_ball]
  mov edx, [scene_saved]
  push edx
  call 004039E0

  // ---- Call vtable[1] = SetupCollisionRender ----
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // ---- Set player values ----
  mov edx, [new_ball]

  // player_index = requested value
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // Physics values
  mov dword [edx+0x284], 41D00000  // radius = 26.0
  mov dword [edx+0x188], 40A00000  // max_speed = 5.0
  mov dword [edx+0x278], 3F000000  // gravity_scale = 0.5
  mov dword [edx+0x27C], 3DCCCCCD  // gravity_mult = 0.1
  mov dword [edx+0x1A0], 3F866666  // render_scale = 1.05

  // ---- Set process flag (must be 1 or game skips collision) ----
  mov byte [edx+0x2E8], 1

  // ---- Set position from source ball ----
  mov eax, [src_ball]
  test eax, eax
  jz spawn_skip

  // Reload new_ball ptr (may have been clobbered)
  mov edx, [new_ball]

  // Copy position from source + offset
  fld dword [eax+0x164]
  fadd dword [004CF55C]        // 5.0 offset
  fstp dword [edx+0x164]

  fld dword [eax+0x168]
  fadd dword [eax+0x284]       // + radius (spawn above)
  fstp dword [edx+0x168]

  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Copy velocity from source
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // ---- Copy color from source ball ----
  // ball+0x758/0x75C/0x760 = float R/G/B
  mov ebx, [eax+0x758]
  mov [edx+0x758], ebx
  mov ebx, [eax+0x75C]
  mov [edx+0x75C], ebx
  mov ebx, [eax+0x760]
  mov [edx+0x760], ebx

  // ---- Override color with per-player distinct color ----
  // This makes clones visually distinguishable even in races
  // where only P1 exists
  mov eax, [player_idx]
  cmp eax, 0
  je set_p1_color
  cmp eax, 1
  je set_p2_color
  cmp eax, 2
  je set_p3_color
  cmp eax, 3
  je set_p4_color
  jmp color_done

set_p1_color:
  // P1: Pink (1.0, 0.5, 0.8)
  mov dword [color_r], 3F800000   // 1.0
  mov dword [color_g], 3F000000   // 0.5
  mov dword [color_b], 3F4CCCCD   // 0.8
  jmp color_done

set_p2_color:
  // P2: Blue (0.3, 0.5, 1.0)
  mov dword [color_r], 3E99999A   // 0.3
  mov dword [color_g], 3F000000   // 0.5
  mov dword [color_b], 3F800000   // 1.0
  jmp color_done

set_p3_color:
  // P3: Green (0.3, 1.0, 0.3)
  mov dword [color_r], 3E99999A   // 0.3
  mov dword [color_g], 3F800000   // 1.0
  mov dword [color_b], 3E99999A   // 0.3
  jmp color_done

set_p4_color:
  // P4: Yellow (1.0, 1.0, 0.0)
  mov dword [color_r], 3F800000   // 1.0
  mov dword [color_g], 3F800000   // 1.0
  mov dword [color_b], 00000000   // 0.0

color_done:
  // Apply color to ball
  mov edx, [new_ball]
  mov eax, [color_r]
  mov [edx+0x758], eax
  mov eax, [color_g]
  mov [edx+0x75C], eax
  mov eax, [color_b]
  mov [edx+0x760], eax

  // ---- Copy render context from source (41 dwords from +0x1B8) ----
  mov edx, [new_ball]
  push esi
  push edi
  mov esi, [src_ball]
  mov edi, edx
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd
  pop edi
  pop esi

  // ---- Copy render position ----
  mov eax, [src_ball]
  mov edx, [new_ball]
  mov ebx, [eax+0x1BC]
  mov [edx+0x1BC], ebx
  mov ebx, [eax+0x1C0]
  mov [edx+0x1C0], ebx
  mov ebx, [eax+0x1C4]
  mov [edx+0x1C4], ebx
  mov ebx, [eax+0x1C8]
  mov [edx+0x1C8], ebx
  mov ebx, [eax+0x204]
  mov [edx+0x204], ebx

  // ---- Set active flags ----
  mov edx, [new_ball]
  mov byte [edx+0x768], 1       // is_active
  mov byte [edx+0x769], 1
  mov byte [edx+0x2F9], 0       // not falling
  mov byte [edx+0x324], 0       // not return_early

  // ---- Clear AI state ----
  mov dword [edx+0x808], 0
  mov dword [edx+0x288], 0

  // ---- Add to scene->ball_list (0x29D4) ----
  // AthenaList_Append clobbers eax,ecx,edx,ebx — save ball ptr on stack
  mov eax, [new_ball]
  push eax                      // save ball ptr
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x29D4]
  push eax                      // arg: ball ptr
  call 00453810
  add esp, 4                    // clean up arg (cdecl? or stdcall?)

  // ---- Add to scene->all_balls_list (0x2DEC) ----
  mov ecx, [scene_saved]
  lea ecx, [ecx+0x2DEC]
  push dword [new_ball]         // arg: ball ptr (from memory, not register)
  call 00453810
  add esp, 4

  // ---- Register clone ----
  pop eax                       // restore ball ptr from stack
  mov [new_ball], eax            // store back (just in case)
  mov eax, [clone_count]
  mov ecx, [new_ball]
  mov [clone_ptrs + eax*4], ecx
  mov ecx, [player_idx]
  mov [clone_pidx + eax*4], ecx
  inc dword [clone_count]

spawn_skip:
  ret

// ============================================================
// Data
// ============================================================

float_0_5:
