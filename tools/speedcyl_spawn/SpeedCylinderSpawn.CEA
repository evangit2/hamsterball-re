[ENABLE]

// ============================================================
// SpeedCylinder Spawn Mod v2
// Pure CEA — no bass.dll, no Lua
//
// Verified addresses (Ghidra 2026-06-22):
//   0x41B540  Scene_UpdateBallsAndState (hook point, ECX=Board)
//   0x4BA57B  operator_new (__cdecl, RET)
//   0x461510  MeshWorld_ctor (__thiscall, RET 0x8, 2 params)
//   0x436A20  Pendulum_ctor (__thiscall, RET 0x18, 6 params)
//   0x453810  AthenaList_Append thunk (__thiscall, RET 0x4, 1 param)
//   0x4D1140  "levels\levelup-speedcylinder" string
//   0x5341E0  App global ptr
//   App+0x178  Board/Scene ptr
//   Board+0x878  App ptr (set in Board_ctor)
//   Board+0x4788  SpeedCylinder mesh (only set on Up Race)
//   Board+0x2578  mechanical objects AthenaList
//   Board+0x2DEC  all_balls AthenaList
//   AthenaList+0x004  count (int)
//   AthenaList+0x40C  array ptr (int*)
//   Ball+0x164/0x168/0x16C  display pos X/Y/Z (float)
//   Ball+0x2F0  player_index (int, 0-3)
//   Ball+0x768  alive flag (byte)
//
// Usage: In Cheat Engine, add address "SpawnFlag".
//   Set SpawnFlag to 1 to spawn a SpeedCylinder at Player 1's position.
//   The flag auto-resets to 0 after spawning.
// ============================================================

alloc(SpawnCode, 4096)
alloc(SpawnFlag, 4)
alloc(saved_board, 4)
alloc(mesh_cache, 4)
alloc(last_board, 4)
alloc(pos_buf, 12)

registersymbol(SpawnFlag)

SpawnFlag:
  dd 0

saved_board:
  dd 0

mesh_cache:
  dd 0

last_board:
  dd 0

pos_buf:
  dd 0 0 0

label(original_code)
label(have_mesh)
label(load_mesh)
label(mesh_loaded)
label(find_player)
label(found_player)
label(next_ball)
label(use_default_pos)
label(do_spawn)
label(done_spawn)

SpawnCode:
  // ECX = Board pointer (from Scene_UpdateBallsAndState)
  mov [saved_board], ecx

  // Check spawn flag
  cmp [SpawnFlag], 0
  je original_code

  // Clear flag immediately (prevents double-spawn)
  mov [SpawnFlag], 0

  pushad

  // === DETECT LEVEL TRANSITION ===
  // If Board pointer changed, our mesh cache is stale — clear it
  mov eax, [saved_board]
  cmp eax, [last_board]
  je same_board
  mov [mesh_cache], 0
  mov [last_board], eax
same_board:

  // === ENSURE MESH IS LOADED ===
  // Check our cache first
  mov eax, [mesh_cache]
  test eax, eax
  jnz have_mesh

  // Check if Board+0x4788 has a pre-loaded mesh (Up Race only)
  mov eax, [saved_board]
  mov eax, [eax + 0x4788]
  test eax, eax
  jz load_mesh

  // Use pre-loaded mesh, cache it
  mov [mesh_cache], eax
  jmp have_mesh

load_mesh:
  // Allocate MeshWorld struct (0x10D0 bytes)
  push 0x10D0
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov [mesh_cache], eax

  // Get render context: *(*(Board+0x878) + 0x174)
  // Board+0x878 = App ptr, App+0x174 = render context
  mov edx, [saved_board]
  mov edx, [edx + 0x878]
  mov edx, [edx + 0x174]

  // MeshWorld_ctor(mem, render_ctx, "levels\levelup-speedcylinder")
  // __thiscall: ECX = mem, PUSH param_2 (string), PUSH param_1 (render_ctx)
  push 004D1140
  push edx
  mov ecx, [mesh_cache]
  call 00461510
  // RET 0x8 — callee cleans 2 params

  // EAX = constructed MeshWorld*
  mov [mesh_cache], eax

have_mesh:
  // === GET PLAYER 1 POSITION ===
  // all_balls_list at Board+0x2DEC
  mov esi, [saved_board]
  add esi, 0x2DEC

  // array = [list + 0x40C]
  mov edi, [esi + 0x40C]
  test edi, edi
  jz use_default_pos

  xor ebx, ebx
  mov ecx, [esi + 0x004]

find_player:
  cmp ebx, ecx
  jae use_default_pos

  mov eax, [edi + ebx*4]
  test eax, eax
  jz next_ball

  // Check alive: ball+0x768 != 0
  cmp byte [eax + 0x768], 0
  je next_ball

  // Check player_index == 0 (Player 1)
  cmp dword [eax + 0x2F0], 0
  je found_player

next_ball:
  inc ebx
  jmp find_player

found_player:
  // Copy position: Ball+0x164 (X), +0x168 (Y), +0x16C (Z)
  mov edx, [eax + 0x164]
  mov [pos_buf], edx
  mov edx, [eax + 0x168]
  mov [pos_buf + 4], edx
  mov edx, [eax + 0x16C]
  mov [pos_buf + 8], edx
  jmp do_spawn

use_default_pos:
  mov dword [pos_buf], 0
  mov dword [pos_buf + 4], 0
  mov dword [pos_buf + 8], 0

do_spawn:
  // === CREATE SPEEDCYLINDER ===
  // 1. Allocate Pendulum struct (0x150C bytes)
  push 0x150C
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov edi, eax

  // 2. Pendulum_ctor(mem, scene, pos.x, pos.y, pos.z, param5, mesh)
  //    __thiscall: ECX = mem, 6 params pushed right-to-left
  //    Push order (last param first):
  //      param_6 = mesh_ptr
  //      param_5 = 0 (int, initial rotation = 0)
  //      param_4 = pos.z
  //      param_3 = pos.y
  //      param_2 = pos.x
  //      param_1 = scene (Board)
  mov edx, [mesh_cache]
  push edx
  push 0
  mov edx, [pos_buf + 8]
  push edx
  mov edx, [pos_buf + 4]
  push edx
  mov edx, [pos_buf]
  push edx
  mov edx, [saved_board]
  push edx
  mov ecx, edi
  call 00436A20
  // RET 0x18 — callee cleans 6 params

  // EAX = SpeedCylinder*
  test eax, eax
  jz done_spawn

  // 3. Register in Board+0x2578 (mechanical objects list)
  //    AthenaList_Append(list, item)
  //    __thiscall: ECX = list, PUSH item
  push eax
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810
  // RET 0x4 — callee cleans 1 param

done_spawn:
  popad

original_code:
  // Execute original 6 bytes (verified from binary):
  //   PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX; PUSH EDI
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi

  // Jump back to 0x41B546 (after 6-byte hook)
  jmp 0041B546

// === HOOK INSTALLATION ===
0041B540:
  jmp SpawnCode
  nop

[DISABLE]

0041B540:
  // Original bytes: PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX; PUSH EDI
  db 53 55 56 8B D9 57

dealloc(SpawnCode)
dealloc(SpawnFlag)
dealloc(saved_board)
dealloc(mesh_cache)
dealloc(last_board)
dealloc(pos_buf)
