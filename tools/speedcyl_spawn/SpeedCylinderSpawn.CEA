[ENABLE]

// ============================================================
// SpeedCylinder Spawn Mod v4 — Global (all races + arenas)
// Pure CEA — no bass.dll, no Lua
//
// APPROACH: Call the game's OWN CreateSpeedCylinder (0x4117B0)
// directly. This handles ALL internal details: allocation,
// Pendulum_ctor, mesh binding, AthenaList_Append — everything.
//
// We just need to:
// 1. Ensure Board+0x4788 has a valid SpeedCylinder mesh
//    (only set by BoardLevel_Up_Ctor; NULL on other levels)
// 2. Find Player 1's position from the ball list
// 3. Build a param block (position+rotation data)
// 4. Call CreateSpeedCylinder(Board, name, &out1, &out2, &paramblock)
//
// Verified addresses (Ghidra 2026-06-22):
//   0x41B540  Scene_UpdateBallsAndState (__fastcall, ECX=Board)
//   0x4117B0  CreateSpeedCylinder (__thiscall, ECX=Board, RET 0x10)
//   0x4BA57B  operator_new (__cdecl)
//   0x461510  MeshWorld_ctor (__thiscall, ECX=mem, RET 0x8)
//   0x4CFE4C  "SPEEDCYLINDER" string in game binary
//   0x4D1140  "levels\levelup-speedcylinder" mesh file path string
//
//   Board+0x878  = App ptr
//   App+0x174    = render context (Direct3D device wrapper)
//   Board+0x4788 = SpeedCylinder mesh ptr (only set on Up Race)
//   Board+0x29D4 = ball AthenaList (count at +0x004, array at +0x40C)
//   Ball+0x018   = player_index (0=Player1, -1=NPC)
//   Ball+0x164   = pos.x (float)
//   Ball+0x168   = pos.y (float)
//   Ball+0x16C   = pos.z (float)
//   Ball+0x769   = alive flag (byte, 1=alive)
//
// Usage: Add address "SpawnFlag" in CE. Set to 1 to spawn a
//   SpeedCylinder at Player 1's position. Auto-resets to 0.
// ============================================================

alloc(SpawnCode, 4096)
alloc(SpawnFlag, 4)
alloc(saved_board, 4)
alloc(last_board, 4)
alloc(param_block, 32)
alloc(out_obj, 4)
alloc(out_col, 4)

registersymbol(SpawnFlag)

SpawnFlag:
  dd 0

saved_board:
  dd 0

last_board:
  dd 0

param_block:
  dd 0 0 0 0 0 0 0 0

out_obj:
  dd 0

out_col:
  dd 0

label(original_code)
label(ensure_mesh)
label(load_mesh)
label(find_player)
label(found_player)
label(next_ball)
label(use_default_pos)
label(do_spawn)
label(done_spawn)

SpawnCode:
  // ECX = Board pointer (from Scene_UpdateBallsAndState)
  mov [saved_board], ecx

  // Check spawn flag
  cmp [SpawnFlag], 0
  je original_code

  // Clear flag immediately
  mov [SpawnFlag], 0

  pushad

  // === LEVEL TRANSITION DETECTION ===
  // If Board pointer changed, we're on a new level — force mesh reload
  mov eax, [saved_board]
  cmp eax, [last_board]
  je ensure_mesh
  mov [last_board], eax

ensure_mesh:
  // === ENSURE Board+0x4788 HAS A VALID MESH ===
  // On Up Race, BoardLevel_Up_Ctor sets this during level load.
  // On all other levels, it's NULL. We load it ourselves.
  mov edx, [saved_board]
  mov edx, [edx + 0x4788]
  test edx, edx
  jnz find_player

load_mesh:
  // Load SpeedCylinder mesh into Board+0x4788
  // Same pattern as BoardLevel_Up_Ctor at 0x4204F1-0x4204FA

  // Step 1: operator_new(0x10D0)
  push 0x10D0
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov ebx, eax  // ebx = allocated MeshWorld memory

  // Step 2: Get render context: Board+0x878 → App → App+0x174
  mov edx, [saved_board]
  mov edx, [edx + 0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx + 0x174]
  test edx, edx
  jz done_spawn

  // Step 3: MeshWorld_ctor(mem, render_ctx, "levels\levelup-speedcylinder")
  // __thiscall: ECX=mem(this), push param_2(string) first, push param_1(render_ctx) second
  //   MeshWorld_ctor(this, render_ctx, filename_string)
  //   RET 0x8 — callee cleans 8 bytes (2 params)
  push 004D1140           // param_2: "levels\levelup-speedcylinder"
  push edx                // param_1: render context
  mov ecx, ebx            // this = allocated memory
  call 00461510

  test eax, eax
  jz done_spawn

  // Step 4: Store loaded mesh in Board+0x4788
  // Now CreateSpeedCylinder can read it from there
  mov edx, [saved_board]
  mov [edx + 0x4788], eax

find_player:
  // === FIND PLAYER 1 BALL ===
  // Ball list at Board+0x29D4 (AthenaList)
  mov esi, [saved_board]
  add esi, 0x29D4

  // count = [list + 0x004]
  mov ecx, [esi + 0x004]
  test ecx, ecx
  jz use_default_pos

  // array_ptr = [list + 0x40C]
  mov edi, [esi + 0x40C]
  test edi, edi
  jz use_default_pos

  xor ebx, ebx  // index = 0

find_player_loop:
  cmp ebx, ecx
  jae use_default_pos

  // Get ball pointer from array
  mov eax, [edi + ebx*4]
  test eax, eax
  jz next_ball

  // Check alive: ball+0x769 != 0
  cmp byte [eax + 0x769], 0
  je next_ball

  // Check player_index == 0 (Player 1)
  cmp dword [eax + 0x018], 0
  je found_player

next_ball:
  inc ebx
  jmp find_player_loop

found_player:
  // Copy player position into param_block
  // param_block+0x04 = pos.x, +0x08 = pos.y, +0x0C = pos.z
  mov edx, [eax + 0x164]
  mov [param_block + 4], edx
  mov edx, [eax + 0x168]
  mov [param_block + 8], edx
  mov edx, [eax + 0x16C]
  mov [param_block + 0xC], edx
  jmp do_spawn

use_default_pos:
  // Fallback: spawn at (0, 50, 0) if no player found
  mov dword [param_block + 4], 0          // x = 0.0
  mov dword [param_block + 8], 0x42480000 // y = 50.0f
  mov dword [param_block + 0xC], 0        // z = 0.0

do_spawn:
  // Clear unused param_block fields
  mov dword [param_block], 0          // +0x00: type (unused for SPEEDCYLINDER)
  mov dword [param_block + 0x10], 0   // +0x10: unused
  mov dword [param_block + 0x14], 0   // +0x14: rotation angle = 0 → param_5 = (int)(360-0) = 360
  mov dword [param_block + 0x18], 0   // +0x18: unused

  // Clear output buffers
  mov dword [out_obj], 0
  mov dword [out_col], 0

  // === CALL CreateSpeedCylinder ===
  // __thiscall: ECX = Board (this)
  // Stack (4 params, pushed right-to-left):
  //   push param_block  (param_4: position data ptr)
  //   push out_col      (param_3: receives collision level ptr)
  //   push out_obj      (param_2: receives created Pendulum ptr)
  //   push 004CFE4C     (param_1: "SPEEDCYLINDER" string)
  // RET 0x10 — callee cleans 16 bytes
  push param_block
  push out_col
  push out_obj
  push 004CFE4C
  mov ecx, [saved_board]
  call 004117B0

done_spawn:
  popad
  // Fall through to original code

original_code:
  // Re-execute original 6 bytes: PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX; PUSH EDI
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// === HOOK INSTALLATION ===
0041B540:
  jmp SpawnCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(SpawnCode)
dealloc(SpawnFlag)
dealloc(saved_board)
dealloc(last_board)
dealloc(param_block)
dealloc(out_obj)
dealloc(out_col)
unregistersymbol(SpawnFlag)
