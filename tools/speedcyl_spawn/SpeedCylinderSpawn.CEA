[ENABLE]

// ============================================================
// SpeedCylinder Spawn Mod v7 — Global (all races + arenas)
// Pure CEA — no bass.dll, no Lua
//
// ROOT CAUSE OF "NO COLLISIONS" (found in v7):
// Scene_CreateDynamicObjects (0x40C430) registers the Pendulum's
// CollisionLevel (out_col) with TWO lists:
//   a. Board+0x10EC (collision levels master list)
//   b. Board+0x8B0+0x18 (level CollisionLevel's AthenaList)
// The ball checks Board+0x8B0 for collisions. Without step (b),
// the Pendulum's collision data is invisible to the ball!
//
// ROOT CAUSE OF "NO FUNCTIONS" (found in v7):
// Scene_CreateDynamicObjects calls init callbacks WITH a Timer:
//   vtable[0x58]() — SceneObject_CallUpdate (starts animation)
//   vtable[0x54](&timer) — SceneObject_CallRender (render init)
// Timer_Init/Timer_Cleanup bracket these calls.
// Without these, the Pendulum doesn't animate/spin.
//
// ROOT CAUSE OF WRONG POSITION:
// The param_block needs [0x14]=rotation field. The game computes
// rotation as (int)(360.0 - param_block[0x14]). Setting [0x14]=0
// gives rotation=360 which is fine. Position fields at +4/+8/+0xC
// are correct. The "wrong position" was likely caused by crashes
// corrupting memory — with the crash fixes, position should work.
//
// CRASH FIXES (from v5/v6):
// - No mesh loading on Up Race (vtable check 0x4D11A0)
// - Force mesh load on non-Up levels
// - NULL checks on Board+0x8AC and SceneObject
//
// VERIFIED FROM Scene_CreateDynamicObjects disasm (0x40C430):
//   Timer_Init   @ 0x457AD0  __fastcall ECX=&timer, plain RET
//   Timer_Cleanup @ 0x457A40  __fastcall ECX=&timer, plain RET
//   vtable[0x58] = SceneObject_CallUpdate @ 0x45DF80  __thiscall, plain RET
//   vtable[0x54] = SceneObject_CallRender @ 0x45DF90  __thiscall, 1 param, RET 0x4
//   AthenaList_Append @ 0x453810  __thiscall, 1 param, RET 0x4
//   CreateSpeedCylinder @ 0x4117B0  __thiscall, 4 params, RET 0x10
//   MeshWorld_ctor @ 0x461510  __thiscall, 2 params, RET 0x8
//   operator_new @ 0x4BA57B  __cdecl, plain RET
//
//   Timer struct: 68 bytes (0x44), vtable=0x4CF338
//   Board+0x10EC = collision levels AthenaList
//   Board+0x8B0  = level CollisionLevel; +0x18 = its AthenaList
//   Board+0xCD4  = scene objects AthenaList
//   Board+0x8AC  = level MeshWorld; +0x480 = SceneObject; +0x1C = AthenaList
//
// Usage: Add address "SpawnFlag" in CE. Set to 1 to spawn.
// ============================================================

alloc(SpawnCode, 4096)
alloc(SpawnFlag, 4)
alloc(saved_board, 4)
alloc(last_board, 4)
alloc(mesh_loaded, 4)
alloc(param_block, 32)
alloc(out_obj, 4)
alloc(out_col, 4)

registersymbol(SpawnFlag)

SpawnFlag:
  dd 0

saved_board:
  dd 0

last_board:
  dd 0

mesh_loaded:
  dd 0

param_block:
  dd 0 0 0 0 0 0 0 0

out_obj:
  dd 0

out_col:
  dd 0

label(original_code)
label(ensure_mesh)
label(skip_mesh_load)
label(load_mesh)
label(find_player)
label(found_player)
label(next_ball)
label(use_default_pos)
label(do_spawn)
label(post_spawn)
label(skip_post_spawn)
label(register_collision)
label(skip_collision)
label(done_spawn)
label(find_player_loop)

SpawnCode:
  // ECX = Board pointer (from Scene_UpdateBallsAndState)
  mov [saved_board], ecx

  // Check spawn flag
  cmp [SpawnFlag], 0
  je original_code

  // Clear flag immediately
  mov [SpawnFlag], 0

  pushad

  // === LEVEL TRANSITION DETECTION ===
  mov eax, [saved_board]
  cmp eax, [last_board]
  je ensure_mesh
  mov [last_board], eax
  mov [mesh_loaded], 0

ensure_mesh:
  cmp [mesh_loaded], 0
  jne find_player

  // Check if this is Up Race Board (vtable at Board+0x00 == 0x4D11A0)
  mov eax, [saved_board]
  mov eax, [eax]
  cmp eax, 0x4D11A0
  je skip_mesh_load

load_mesh:
  // Force-load SpeedCylinder mesh into Board+0x4788

  // Step 1: operator_new(0x10D0)
  push 0x10D0
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov ebx, eax  // ebx = allocated memory

  // Step 2: Get render context: Board+0x878 → App → App+0x174
  mov edx, [saved_board]
  mov edx, [edx + 0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx + 0x174]
  test edx, edx
  jz done_spawn

  // Step 3: MeshWorld_ctor(mem, render_ctx, "levels\levelup-speedcylinder")
  push 004D1140           // param_2: mesh file path
  push edx                // param_1: render context
  mov ecx, ebx            // this = allocated memory
  call 00461510
  // RET 0x8 — callee cleaned 8 bytes

  test eax, eax
  jz done_spawn

  // Step 4: Store loaded mesh in Board+0x4788
  mov edx, [saved_board]
  mov [edx + 0x4788], eax
  mov [mesh_loaded], 1
  jmp find_player

skip_mesh_load:
  // Up Race: mesh already loaded by BoardLevel_Up_ctor
  mov [mesh_loaded], 1

find_player:
  // === FIND PLAYER 1 BALL ===
  mov esi, [saved_board]
  add esi, 0x29D4         // esi = &AthenaList (ball list)

  mov ecx, [esi + 0x004]  // count
  test ecx, ecx
  jz use_default_pos

  mov edi, [esi + 0x40C]   // array_ptr
  test edi, edi
  jz use_default_pos

  xor ebx, ebx  // index = 0

find_player_loop:
  cmp ebx, ecx
  jae use_default_pos

  mov eax, [edi + ebx*4]  // ball pointer
  test eax, eax
  jz next_ball

  cmp byte [eax + 0x769], 0  // alive?
  je next_ball

  cmp dword [eax + 0x018], 0  // player_index == 0?
  je found_player

next_ball:
  inc ebx
  jmp find_player_loop

found_player:
  // Copy player position into param_block
  mov edx, [eax + 0x164]
  mov [param_block + 4], edx
  mov edx, [eax + 0x168]
  mov [param_block + 8], edx
  mov edx, [eax + 0x16C]
  mov [param_block + 0xC], edx
  jmp do_spawn

use_default_pos:
  mov dword [param_block + 4], 0
  mov dword [param_block + 8], 0x42480000  // 50.0f
  mov dword [param_block + 0xC], 0

do_spawn:
  // Clear unused param_block fields
  mov dword [param_block], 0
  mov dword [param_block + 0x10], 0
  mov dword [param_block + 0x14], 0      // rotation: 360-0=360 degrees
  mov dword [param_block + 0x18], 0

  // Clear output buffers
  mov dword [out_obj], 0
  mov dword [out_col], 0

  // === CALL CreateSpeedCylinder ===
  // __thiscall: ECX = Board, 4 stack params, RET 0x10
  lea eax, [param_block]
  push eax                 // param_4: position data ptr
  push out_col             // param_3: receives CollisionLevel ptr
  push out_obj             // param_2: receives Pendulum ptr
  push 004CFE4C            // param_1: "SPEEDCYLINDER" string
  mov ecx, [saved_board]
  call 004117B0
  // RET 0x10 — callee cleaned 16 bytes

post_spawn:
  // Check if out_obj is valid
  mov eax, [out_obj]
  test eax, eax
  jz skip_post_spawn

  mov esi, eax  // esi = Pendulum ptr

  // === ALLOCATE TIMER ON STACK ===
  // Timer struct = 68 bytes (0x44)
  sub esp, 68              // allocate timer on stack
  mov ebx, esp             // ebx = &timer

  // Timer_Init(&timer) — __fastcall ECX=&timer
  mov ecx, ebx
  call 00457AD0
  // plain RET — no stack cleanup

  // === 1. AthenaList_Append(Board+0xCD4, pendulum) ===
  push esi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

  // === 2. AthenaList_Append(level_mesh->SceneObject+0x1C, pendulum) ===
  mov edx, [saved_board]
  mov edx, [edx + 0x8AC]
  test edx, edx
  jz skip_collision
  mov edx, [edx + 0x480]
  test edx, edx
  jz skip_collision

  push esi
  lea ecx, [edx + 0x1C]
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

  // === 3. CALL vtable[0x58] — SceneObject_CallUpdate ===
  // __thiscall: ECX=pendulum, no stack params, plain RET
  mov ecx, esi
  mov eax, [esi]           // eax = vtable ptr
  call dword [eax + 0x58]  // vtable[0x58]
  // plain RET — no stack cleanup

  // === 4. CALL vtable[0x54] — SceneObject_CallRender ===
  // __thiscall: ECX=pendulum, 1 stack param (&timer), RET 0x4
  push ebx                  // push &timer
  mov ecx, esi
  mov eax, [esi]
  call dword [eax + 0x54]   // vtable[0x54]
  // RET 0x4 — callee cleaned 4 bytes

register_collision:
  // === 5. Register CollisionLevel with level collision system ===
  // This is THE MISSING STEP that enables ball collision!
  mov eax, [out_col]
  test eax, eax
  jz skip_collision

  // 5a. AthenaList_Append(Board+0x10EC, out_col) — collision levels list
  push eax
  mov ecx, [saved_board]
  add ecx, 0x10EC
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

  // 5b. AthenaList_Append(Board+0x8B0+0x18, out_col) — level CollisionLevel's AthenaList
  mov edx, [saved_board]
  mov edx, [edx + 0x8B0]   // level CollisionLevel
  test edx, edx
  jz skip_collision

  mov eax, [out_col]
  push eax
  lea ecx, [edx + 0x18]    // CollisionLevel+0x18 = AthenaList
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

skip_collision:
  // === Timer_Cleanup(&timer) — __fastcall ECX=&timer ===
  mov ecx, ebx
  call 00457A40
  // plain RET — no stack cleanup

  // Restore stack (remove 68-byte timer)
  add esp, 68

skip_post_spawn:

done_spawn:
  popad
  // Fall through to original code

original_code:
  // Re-execute original 6 bytes: PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX; PUSH EDI
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// === HOOK INSTALLATION ===
0041B540:
  jmp SpawnCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(SpawnCode)
dealloc(SpawnFlag)
dealloc(saved_board)
dealloc(last_board)
dealloc(mesh_loaded)
dealloc(param_block)
dealloc(out_obj)
dealloc(out_col)
unregistersymbol(SpawnFlag)
