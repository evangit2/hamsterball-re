[ENABLE]

// ============================================================
// SpeedCylinder Spawn Mod v8
// Pure CEA — no bass.dll, no Lua
//
// Based on user's stable pastebin version (hooks Ball_Update).
//
// FIXES IN v8:
// 1. "No function" fix: SpatialTree_CloneToLevel does NOT copy +0x864
//    (entity name). The collision dispatch (FUN_004119B0) checks
//    node+0x864 for "N:SPEEDCYLINDER". If NULL, stricmp fails and
//    Pendulum_PlayCollisionSound is never called → no speed boost.
//    FIX: After spawn, recursively walk the CollisionLevel's spatial
//    tree and set +0x864 = "N:SPEEDCYLINDER" (0x4CFE68) on every node.
//
// 2. Position: Uses player 1's ball position saved every frame.
//    Works correctly — spawns at Player 1 location.
//
// 3. Collisions: Registered with Board+0x10EC and Board+0x8B0+0x18.
//    Works correctly — balls can touch SpeedCylinders.
//
// HOOK: Ball_Update at 0x405E22 (ESI = ball pointer)
// Original bytes: 8B 86 5C 0C 00 00 (mov eax,[esi+0x0c5c])
//
// Entity name string "N:SPEEDCYLINDER" at 0x4CFE68 in binary.
// Pendulum_PlayCollisionSound (0x436B70) sets Ball+0x808 = 10 (speed boost).
// ============================================================

alloc(SpawnCode, 4096)
alloc(SpawnFlag, 4)
alloc(saved_board, 4)
alloc(param_block, 32)
alloc(out_obj, 4)
alloc(out_col, 4)
alloc(temp_mesh, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)

registersymbol(SpawnFlag)

SpawnFlag:
  dd 0

saved_board:
  dd 0

param_block:
  dd 0 0 0 0 0 0 0 0

out_obj:
  dd 0

out_col:
  dd 0

temp_mesh:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

label(original_code)
label(check_spawn)
label(do_spawn)
label(post_spawn)
label(skip_post_spawn)
label(register_collision)
label(skip_collision)
label(done_spawn)
label(set_name_recursive)
label(set_name_loop)
label(set_name_ret)

SpawnCode:
  // Save player 1 position every frame (when player_index == 0)
  cmp dword [esi+0x18], 0
  jne check_spawn

  mov eax, [esi+0x164]
  mov [playerX], eax
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax

check_spawn:
  cmp dword [SpawnFlag], 0
  je original_code

  // Only spawn from player 1's ball update
  cmp dword [esi+0x18], 0
  jne original_code

  mov dword [SpawnFlag], 0

  pushad

  // Get Board pointer from ball+0x14
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz done_spawn

  // Validate Board fields before mesh loading
  mov edx, [eax+0x8AC]
  test edx, edx
  jz done_spawn

  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx+0x174]
  test edx, edx
  jz done_spawn

  // === LOAD SPEEDCYLINDER MESH ===
  push 0x10D0
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov ebx, eax

  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]

  push 004D1140              // "levels\levelup-speedcylinder"
  push edx                   // render context
  mov ecx, ebx
  call 00461510               // MeshWorld_ctor — RET 0x8

  test eax, eax
  jz done_spawn

  mov [temp_mesh], eax

  // Store mesh in Board+0x4788
  mov edx, [saved_board]
  mov [edx+0x4788], eax

  // Copy saved player position into param_block
  mov edx, [playerX]
  mov [param_block+4], edx
  mov edx, [playerY]
  mov [param_block+8], edx
  mov edx, [playerZ]
  mov [param_block+0xC], edx

do_spawn:
  // Clear unused param_block fields
  mov dword [param_block], 0
  mov dword [param_block+0x10], 0
  mov dword [param_block+0x14], 0
  mov dword [param_block+0x18], 0

  mov dword [out_obj], 0
  mov dword [out_col], 0

  // CreateSpeedCylinder(Board, "SPEEDCYLINDER", &out_obj, &out_col, param_block)
  // __thiscall: ECX=Board, 4 stack params, RET 0x10
  push param_block
  push out_col
  push out_obj
  push 004CFE4C              // "SPEEDCYLINDER"
  mov ecx, [saved_board]
  call 004117B0

post_spawn:
  mov eax, [out_obj]
  test eax, eax
  jz skip_post_spawn

  mov esi, eax               // esi = Pendulum pointer

  // === ALLOCATE TIMER ON STACK (68 bytes) ===
  sub esp, 68
  mov ebx, esp               // ebx = &timer

  // Timer_Init(&timer) — __fastcall ECX=&timer
  mov ecx, ebx
  call 00457AD0

  // 1. AthenaList_Append(Board+0xCD4, pendulum) — scene objects list
  push esi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810              // RET 0x4

  // 2. AthenaList_Append(level_mesh->SceneObject+0x1C, pendulum)
  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_collision

  push esi
  lea ecx, [edx+0x1C]
  call 00453810              // RET 0x4

  // 3. vtable[0x58] — SceneObject_CallUpdate (start animation)
  mov ecx, esi
  mov eax, [esi]
  call dword [eax+0x58]

  // 4. vtable[0x54] — SceneObject_CallRender (render init)
  push ebx                   // push &timer
  mov ecx, esi
  mov eax, [esi]
  call dword [eax+0x54]     // RET 0x4

register_collision:
  mov eax, [out_col]
  test eax, eax
  jz skip_collision

  // === FIX: Set entity name on ALL spatial tree nodes ===
  // SpatialTree_CloneToLevel does NOT copy +0x864 (entity name).
  // Without this, collision dispatch can't match "N:SPEEDCYLINDER"
  // and Pendulum_PlayCollisionSound never fires → no speed boost.
  // We recursively walk the tree and set +0x864 = 0x4CFE68.
  mov ecx, eax
  push ebx                   // save timer pointer (subroutine clobbers EBX)
  call set_name_recursive
  pop ebx                    // restore timer pointer

  // 5a. AthenaList_Append(Board+0x10EC, out_col) — collision levels list
  mov eax, [out_col]         // re-read (clobbered by subroutine)
  push eax
  mov ecx, [saved_board]
  add ecx, 0x10EC
  call 00453810              // RET 0x4

  // 5b. AthenaList_Append(Board+0x8B0+0x18, out_col)
  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz skip_collision

  mov eax, [out_col]
  push eax
  lea ecx, [edx+0x18]
  call 00453810              // RET 0x4

skip_collision:
  // Timer_Cleanup(&timer) — __fastcall ECX=&timer
  mov ecx, ebx
  call 00457A40

  // Restore stack (remove 68-byte timer)
  add esp, 68

skip_post_spawn:
  mov dword [temp_mesh], 0

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

// === SUBROUTINE: set_name_recursive ===
// Recursively walks a SpatialTree/Level node and its children,
// setting +0x864 = "N:SPEEDCYLINDER" (0x4CFE68) on each node.
// This fixes the "no function" bug where the speed boost doesn't trigger.
//
// Input: ECX = node pointer
// Clobbers: EAX, EDX, ESI, EDI, EBX (all saved by pushad in caller)
// Stack per level: 16 bytes (3 pushes + return addr)
// Max depth: ~10 levels (160 bytes) — SpeedCylinder mesh is shallow (2-3 levels)
set_name_recursive:
  test ecx, ecx
  jz set_name_ret

  // Set this node's entity name
  mov dword [ecx + 0x864], 004CFE68

  // Get AthenaList at node+0x18 (embedded struct, not pointer)
  lea edx, [ecx + 0x18]
  mov edi, [edx + 0x04]      // count
  test edi, edi
  jz set_name_ret

  mov esi, [edx + 0x40C]    // data_ptr (array of child node pointers)
  test esi, esi
  jz set_name_ret

  xor ebx, ebx               // index = 0

set_name_loop:
  cmp ebx, edi
  jae set_name_ret

  // Save loop state
  push ebx
  push edi
  push esi

  // Get child node
  mov ecx, [esi + ebx*4]

  // Recursive call
  call set_name_recursive

  // Restore loop state
  pop esi
  pop edi
  pop ebx

  inc ebx
  jmp set_name_loop

set_name_ret:
  ret

// === HOOK INSTALLATION ===
00405E22:
  jmp SpawnCode
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnFlag)
dealloc(saved_board)
dealloc(param_block)
dealloc(out_obj)
dealloc(out_col)
dealloc(temp_mesh)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
unregistersymbol(SpawnFlag)
