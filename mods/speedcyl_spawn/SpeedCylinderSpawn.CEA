[ENABLE]

// ============================================================
// SpeedCylinder Spawn Mod v6 — Global (all races + arenas)
// Pure CEA — no bass.dll, no Lua
//
// CHANGES FROM v5:
// - REMOVED init callbacks (vtable[0x54], [0x58]) — they caused
//   heap corruption and crashes during gameplay (0001:0006186E)
// - Added vtable check: on Up Race (Board vtable==0x4D11A0), mesh
//   is already loaded by BoardLevel_Up_ctor — skip loading
// - On non-Up levels: force-load mesh, overwrite garbage at +0x4788
// - Added NULL checks for Board+0x8AC, level_mesh, SceneObject
// - Use lea+push for param_block to avoid CE address ambiguity
//
// CRASH ROOT CAUSES (v5):
// 1. Init callbacks called during gameplay corrupted heap state
//    → operator_new returned NULL → Level_ctor crash at 0x46186E
// 2. Stack corruption from callback tail-calls (6500C0:B40001B5)
//
// VERIFIED ADDRESSES (Ghidra 2026-06-22):
//   0x41B540  Scene_UpdateBallsAndState (__fastcall, ECX=Board)
//   0x4117B0  CreateSpeedCylinder (__thiscall, ECX=Board, RET 0x10)
//   0x4BA57B  operator_new (__cdecl, plain RET)
//   0x461510  MeshWorld_ctor (__thiscall, ECX=mem, RET 0x8)
//   0x453810  AthenaList_Append (__thiscall, ECX=list, 1 param, RET 0x4)
//   0x4CFE4C  "SPEEDCYLINDER" string
//   0x4D1140  "levels\levelup-speedcylinder" mesh file path
//   0x4D11A0  Up Race Board vtable (if Board+0x00 == this, mesh is loaded)
//
//   Board+0x878  = App ptr
//   App+0x174    = render context (D3D device)
//   Board+0x8AC  = level MeshWorld ptr (Level/MeshWorld object)
//   Board+0x4788 = SpeedCylinder mesh (set by Up ctor, garbage on other levels)
//   Board+0x29D4 = ball AthenaList (count@+4, array@+0x40C)
//   Board+0xCD4  = scene objects AthenaList (for update/render/dtor)
//   Level+0x480  = SceneObject ptr
//   SceneObject+0x1C = AthenaList (for level-based rendering)
//   Ball+0x018   = player_index (0=Player1, -1=NPC)
//   Ball+0x164/+0x168/+0x16C = pos.x/pos.y/pos.z (floats)
//   Ball+0x769   = alive flag (byte, 1=alive)
//
// Usage: Add address "SpawnFlag" in CE. Set to 1 to spawn.
// ============================================================

alloc(SpawnCode, 4096)
alloc(SpawnFlag, 4)
alloc(saved_board, 4)
alloc(last_board, 4)
alloc(mesh_loaded, 4)
alloc(param_block, 32)
alloc(out_obj, 4)
alloc(out_col, 4)

registersymbol(SpawnFlag)

SpawnFlag:
  dd 0

saved_board:
  dd 0

last_board:
  dd 0

mesh_loaded:
  dd 0

param_block:
  dd 0 0 0 0 0 0 0 0

out_obj:
  dd 0

out_col:
  dd 0

label(original_code)
label(ensure_mesh)
label(skip_mesh_load)
label(load_mesh)
label(find_player)
label(found_player)
label(next_ball)
label(use_default_pos)
label(do_spawn)
label(post_spawn)
label(skip_post_spawn)
label(done_spawn)

SpawnCode:
  // ECX = Board pointer (from Scene_UpdateBallsAndState)
  mov [saved_board], ecx

  // Check spawn flag
  cmp [SpawnFlag], 0
  je original_code

  // Clear flag immediately
  mov [SpawnFlag], 0

  pushad

  // === LEVEL TRANSITION DETECTION ===
  mov eax, [saved_board]
  cmp eax, [last_board]
  je ensure_mesh
  mov [last_board], eax
  mov [mesh_loaded], 0

ensure_mesh:
  cmp [mesh_loaded], 0
  jne find_player

  // Check if this is Up Race Board (vtable at Board+0x00 == 0x4D11A0)
  // Up Race already loaded the mesh in BoardLevel_Up_ctor
  mov eax, [saved_board]
  mov eax, [eax]           // eax = Board vtable ptr
  cmp eax, 0x4D11A0        // Up Race Board vtable?
  je skip_mesh_load

load_mesh:
  // Force-load SpeedCylinder mesh into Board+0x4788
  // (non-Up levels have GARBAGE here — Board_ctor doesn't zero it)

  // Step 1: operator_new(0x10D0)
  push 0x10D0
  call 004BA57B
  add esp, 4

  test eax, eax
  jz done_spawn

  mov ebx, eax  // ebx = allocated memory

  // Step 2: Get render context: Board+0x878 → App → App+0x174
  mov edx, [saved_board]
  mov edx, [edx + 0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx + 0x174]
  test edx, edx
  jz done_spawn

  // Step 3: MeshWorld_ctor(mem, render_ctx, "levels\levelup-speedcylinder")
  // __thiscall: ECX=mem, push param_2(path) first, push param_1(render_ctx) second
  // RET 0x8 (callee cleans 8 bytes)
  push 004D1140           // param_2: mesh file path string
  push edx                // param_1: render context
  mov ecx, ebx            // this = allocated memory
  call 00461510

  test eax, eax
  jz done_spawn

  // Step 4: Store loaded mesh in Board+0x4788
  mov edx, [saved_board]
  mov [edx + 0x4788], eax
  mov [mesh_loaded], 1
  jmp find_player

skip_mesh_load:
  // Up Race: mesh already loaded by BoardLevel_Up_ctor
  mov [mesh_loaded], 1

find_player:
  // === FIND PLAYER 1 BALL ===
  mov esi, [saved_board]
  add esi, 0x29D4         // esi = &AthenaList (ball list)

  // count = [list + 0x004]
  mov ecx, [esi + 0x004]
  test ecx, ecx
  jz use_default_pos

  // array_ptr = [list + 0x40C]
  mov edi, [esi + 0x40C]
  test edi, edi
  jz use_default_pos

  xor ebx, ebx  // index = 0

find_player_loop:
  cmp ebx, ecx
  jae use_default_pos

  // Get ball pointer from array
  mov eax, [edi + ebx*4]
  test eax, eax
  jz next_ball

  // Check alive: ball+0x769 != 0
  cmp byte [eax + 0x769], 0
  je next_ball

  // Check player_index == 0 (Player 1)
  cmp dword [eax + 0x018], 0
  je found_player

next_ball:
  inc ebx
  jmp find_player_loop

found_player:
  // Copy player position into param_block
  // param_block+0x04 = pos.x, +0x08 = pos.y, +0x0C = pos.z
  mov edx, [eax + 0x164]
  mov [param_block + 4], edx
  mov edx, [eax + 0x168]
  mov [param_block + 8], edx
  mov edx, [eax + 0x16C]
  mov [param_block + 0xC], edx
  jmp do_spawn

use_default_pos:
  // Fallback: spawn at (0, 50, 0)
  mov dword [param_block + 4], 0
  mov dword [param_block + 8], 0x42480000  // 50.0f
  mov dword [param_block + 0xC], 0

do_spawn:
  // Clear unused param_block fields
  mov dword [param_block], 0          // +0x00: type
  mov dword [param_block + 0x10], 0   // +0x10: unused
  mov dword [param_block + 0x14], 0   // +0x14: rotation = 0 → 360-0=360
  mov dword [param_block + 0x18], 0   // +0x18: unused

  // Clear output buffers
  mov dword [out_obj], 0
  mov dword [out_col], 0

  // === CALL CreateSpeedCylinder ===
  // __thiscall: ECX = Board, 4 stack params, RET 0x10
  // Push right-to-left: param_4, param_3, param_2, param_1
  lea eax, [param_block]   // use lea to ensure we push the ADDRESS
  push eax                 // param_4: position data ptr
  push out_col             // param_3: receives collision level ptr
  push out_obj             // param_2: receives created Pendulum ptr
  push 004CFE4C            // param_1: "SPEEDCYLINDER" string
  mov ecx, [saved_board]
  call 004117B0
  // RET 0x10 — callee cleaned 16 bytes

post_spawn:
  // Check if out_obj is valid
  mov eax, [out_obj]
  test eax, eax
  jz skip_post_spawn

  mov esi, eax  // esi = Pendulum ptr

  // 1. AthenaList_Append(Board+0xCD4, pendulum)
  // __thiscall: ECX = list, push pendulum, RET 0x4
  push esi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

  // 2. AthenaList_Append(level_mesh->SceneObject+0x1C, pendulum)
  // level_mesh = Board+0x8AC
  mov edx, [saved_board]
  mov edx, [edx + 0x8AC]
  test edx, edx
  jz skip_post_spawn
  mov edx, [edx + 0x480]  // SceneObject ptr
  test edx, edx
  jz skip_post_spawn

  push esi
  lea ecx, [edx + 0x1C]
  call 00453810
  // RET 0x4 — callee cleaned 4 bytes

  // NO init callbacks — they caused heap corruption and crashes
  // The Pendulum will still render via the AthenaList at Board+0xCD4

skip_post_spawn:

done_spawn:
  popad
  // Fall through to original code

original_code:
  // Re-execute original 6 bytes: PUSH EBX; PUSH EBP; PUSH ESI; MOV EBX,ECX; PUSH EDI
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// === HOOK INSTALLATION ===
0041B540:
  jmp SpawnCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(SpawnCode)
dealloc(SpawnFlag)
dealloc(saved_board)
dealloc(last_board)
dealloc(mesh_loaded)
dealloc(param_block)
dealloc(out_obj)
dealloc(out_col)
unregistersymbol(SpawnFlag)
