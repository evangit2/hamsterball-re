{
  Arena Y-Check Respawn
  When any ball falls below Y=-500, teleport to (0,0,0) and clear
  falling/death state so ball is immediately active and attackable.
  No respawn platform, no SinkPlatform, no freezing.
}

[ENABLE]

alloc(YCheck_Cave,256)
alloc(Orig_405E00,8)
registersymbol(YCheck_Cave)
registersymbol(Orig_405E00)

Orig_405E00:
  readmem(Hamsterball.exe+5E00,8)

Hamsterball.exe+5E00:
  jmp YCheck_Cave
  nop
  nop
  nop

YCheck_Cave:
   { Check ball Y position (float at ECX+0x168) }
   { -500.0f = 0xC3FA0000 as IEEE754 unsigned }
   { If Y < -500.0, unsigned value >= 0xC3FA0000 (negative floats are large unsigned) }
  mov eax,[ecx+0x168]
  cmp eax,C3FA0000
  jb YCheck_normal
   { Y < -500.0: teleport to (0,0,0) }
  xor eax,eax
  mov [ecx+0x164],eax
  mov [ecx+0x168],eax
  mov [ecx+0x16C],eax
   { Zero velocity }
  mov [ecx+0x170],eax
  mov [ecx+0x174],eax
  mov [ecx+0x178],eax
   { Clear falling flag (ball+0x2E8) }
  mov byte ptr [ecx+0x2E8],00
   { Clear death_pending (ball+0x2E9) }
  mov byte ptr [ecx+0x2E9],00
   { Clear bounce_count (ball+0x2EC) }
  mov byte ptr [ecx+0x2EC],00
   { Set alpha = 1.0 (visible, ball+0x2FC) }
  mov dword ptr [ecx+0x2FC],3F800000
YCheck_normal:
   { Original prologue: PUSH -1; MOV EAX, FS:[0] }
  push -1
  mov eax,fs:[0]
  jmp 00405E08

[DISABLE]

Hamsterball.exe+5E00:
  readmem(Orig_405E00,8)

dealloc(YCheck_Cave)
dealloc(Orig_405E00)
unregistersymbol(YCheck_Cave)
unregistersymbol(Orig_405E00)
