// ============================================================
// Arena Instant Respawn v3
// ============================================================
// Makes entity balls in arenas respawn the same way player 1
// respawns in races — using nearest safespot via LGP.
//
// ROOT CAUSE (why v1 and v2 failed):
//   Ball_Respawn (0x405190) has TWO safespot search paths:
//     - Race path (0x405811): finds NEAREST safespot using LGP
//     - Arena path (0x405A80): picks RANDOM safespot + validates
//       with Mesh_FindClosestCollision (expensive, can fail)
//
//   At 0x40580B, Ball_Respawn checks App+0x237 (arena flag).
//   If arena: takes the random path → often fails to find valid
//   safespot → falls through to velocity-zero-only (ball stays
//   in place, doesn't actually respawn).
//
//   v1 hooked Ball_FallDeath/BadBall_StartFallCountdown — wrong path.
//   v2 patched Scene_UpdateBallsAndState conditions — redundant,
//   entity balls already go through Ball_Respawn via the arena
//   flag check at 0x41B5B9.
//
// FIX:
//   Patch 0x40580B: JNZ → NOP (6 bytes)
//   Forces Ball_Respawn to ALWAYS use the race path (nearest
//   safespot), even in arena mode.
//
//   Arena levels DO have SAFESPOT entries (verified in MESHWORLD
//   files), so the race path will find valid respawns.
// ============================================================

[ENABLE]

alloc(ArenaInstantRespawn_v3_Orig,6)
registersymbol(ArenaInstantRespawn_v3_Orig)

// Save original bytes
ArenaInstantRespawn_v3_Orig:
  readmem(0040580B,6)

// Patch: NOP out the JNZ that branches to arena random-safespot path
// Original: 0F 85 6F 02 00 00 (JNZ 00405A80 — arena random search)
// Patched:  90 90 90 90 90 90 (NOP NOP NOP NOP NOP NOP — fall through to race path)
0040580B:
  db 90 90 90 90 90 90

[DISABLE]

// Restore original bytes
0040580B:
  readmem(ArenaInstantRespawn_v3_Orig,6)

dealloc(ArenaInstantRespawn_v3_Orig)
unregistersymbol(ArenaInstantRespawn_v3_Orig)
