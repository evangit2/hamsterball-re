// ============================================================
// Arena Instant Respawn v5
// ============================================================
// Makes entity balls in arenas respawn the same way player 1
// respawns in races — finding the NEAREST safespot to where
// the ball actually died.
//
// ROOT CAUSE (found after v1-v4):
//   Entity balls have LGP (ball+0x2DC/0x2E0/0x2E4) = (0,0,0)
//   because it's never initialized by CreateBadBall or Ball_ctor.
//   LGP is only updated in Ball_Update when ball touches ground.
//   If ball falls before touching ground, LGP stays (0,0,0).
//
//   Ball_Respawn searches for nearest safespot using LGP as origin.
//   With LGP=(0,0,0), ALL entity balls compute distance from (0,0,0)
//   → ALL pick the SAME nearest safespot → all on one platform.
//
//   v3 forced race path (correct) but LGP was still (0,0,0).
//   v4 scanned all safespots (correct) but LGP was still (0,0,0).
//   v5 copies ball's CURRENT POSITION to LGP at Ball_Respawn entry.
//
// THREE PATCHES:
//   Patch 1 (v3): 0x40580B JNZ→NOP — use race path, not arena random
//   Patch 2 (v4): 0x405A3D JNZ→NOP — scan all, not first match
//   Patch 3 (v5): Code cave at 0x405190 — copy pos→LGP before search
// ============================================================

[ENABLE]

alloc(ArenaRespawn_Cave, 64)
alloc(ArenaRespawn_Orig1,6)
alloc(ArenaRespawn_Orig2,6)
alloc(ArenaRespawn_OrigEntry,6)
registersymbol(ArenaRespawn_Cave)
registersymbol(ArenaRespawn_Orig1)
registersymbol(ArenaRespawn_Orig2)
registersymbol(ArenaRespawn_OrigEntry)

// Save original bytes
ArenaRespawn_Orig1:
  readmem(0040580B,6)

ArenaRespawn_Orig2:
  readmem(00405A3D,6)

ArenaRespawn_OrigEntry:
  readmem(00405190,6)

// Patch 1: Use race-path safespot search instead of arena random path
0040580B:
  db 90 90 90 90 90 90

// Patch 2: Scan ALL safespots instead of breaking after first match
00405A3D:
  db 90 90 90 90 90 90

// Patch 3: Code cave at Ball_Respawn entry
// Hook: replace first instruction with JMP to cave
00405190:
  jmp ArenaRespawn_Cave
  nop

// Code cave: execute original instruction + copy pos to LGP
ArenaRespawn_Cave:
  sub esp,84                 // Original: SUB ESP, 0x84
  mov eax,[ecx+0x164]        // ball pos X
  mov [ecx+0x2DC],eax        // LGP X = pos X
  mov eax,[ecx+0x168]        // ball pos Y
  mov [ecx+0x2E0],eax        // LGP Y = pos Y
  mov eax,[ecx+0x16C]        // ball pos Z
  mov [ecx+0x2E4],eax        // LGP Z = pos Z
  jmp 00405196               // Return to PUSH EBX (next original instruction)

[DISABLE]

// Restore all original bytes
0040580B:
  readmem(ArenaRespawn_Orig1,6)

00405A3D:
  readmem(ArenaRespawn_Orig2,6)

00405190:
  readmem(ArenaRespawn_OrigEntry,6)

dealloc(ArenaRespawn_Cave)
dealloc(ArenaRespawn_Orig1)
dealloc(ArenaRespawn_Orig2)
dealloc(ArenaRespawn_OrigEntry)
unregistersymbol(ArenaRespawn_Cave)
unregistersymbol(ArenaRespawn_Orig1)
unregistersymbol(ArenaRespawn_Orig2)
unregistersymbol(ArenaRespawn_OrigEntry)
