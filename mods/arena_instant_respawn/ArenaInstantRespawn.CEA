{
  Arena No Freeze — Skip SinkPlatform for ALL balls
  Fixes freeze when 5+ balls fall simultaneously in arenas.
  Scene_StartCountdown has one shared slot (scene+0x10F8).
  Multiple balls fighting over it = freeze.
  Fix: RET 4 immediately. Balls respawn via Ball_Respawn instead.
}

[ENABLE]

alloc(Orig_437130,6)
registersymbol(Orig_437130)

Orig_437130:
  readmem(Hamsterball.exe+37130,6)

Hamsterball.exe+37130:
  db C2 04 00 90 90 90

[DISABLE]

Hamsterball.exe+37130:
  readmem(Orig_437130,6)

dealloc(Orig_437130)
unregistersymbol(Orig_437130)
