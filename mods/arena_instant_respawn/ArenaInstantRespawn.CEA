// ============================================================
// Arena Instant Respawn v2
// ============================================================
// Makes ALL entity balls in arenas respawn the same way
// player 1 respawns in races — via Ball_Respawn (0x405190)
// which uses LGP (last grounded position) to find nearest
// safespot and teleports ball there on the ground.
//
// Original game behavior:
//   Player balls (ball+0x18 != -1) → Ball_Respawn (safespot search)
//   Entity balls (ball+0x18 == -1) → DESTROYED + new ball spawned
//
// Patched behavior:
//   ALL balls → Ball_Respawn (safespot search, same as races)
//
// Patch 1: Scene_UpdateBallsAndState list 1 (scene+0x29D4)
//   0x41B5A9: JNZ → JMP (entity balls go to Ball_Respawn)
//
// Patch 2: Scene_UpdateBallsAndState list 2 (scene+0x3204)
//   0x41B64E: JZ → NOP NOP (entity balls fall through to Ball_Respawn)
// ============================================================

[ENABLE]

alloc(ArenaInstantRespawn_Orig1,2)
alloc(ArenaInstantRespawn_Orig2,2)

registersymbol(ArenaInstantRespawn_Orig1)
registersymbol(ArenaInstantRespawn_Orig2)

// Save original bytes
ArenaInstantRespawn_Orig1:
  readmem(0041B5A9,2)

ArenaInstantRespawn_Orig2:
  readmem(0041B64E,2)

// Patch 1: List 1 — entity balls use Ball_Respawn instead of being destroyed
// Original: 75 22 (JNZ 0041B5CD) — only player balls go to Ball_Respawn
// Patched:  EB 22 (JMP 0041B5CD) — ALL non-split balls go to Ball_Respawn
0041B5A9:
  db EB 22

// Patch 2: List 2 — entity balls fall through to Ball_Respawn
// Original: 74 09 (JZ 0041B659) — entity balls jump to destroy path
// Patched:  90 90 (NOP NOP)     — entity balls fall through to Ball_Respawn
0041B64E:
  db 90 90

[DISABLE]

// Restore original bytes
0041B5A9:
  readmem(ArenaInstantRespawn_Orig1,2)

0041B64E:
  readmem(ArenaInstantRespawn_Orig2,2)

dealloc(ArenaInstantRespawn_Orig1)
dealloc(ArenaInstantRespawn_Orig2)
unregistersymbol(ArenaInstantRespawn_Orig1)
unregistersymbol(ArenaInstantRespawn_Orig2)
