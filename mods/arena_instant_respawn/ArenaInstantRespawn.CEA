{
  Arena No Freeze + Race-Style Respawn
  Fixes freeze when 5+ balls fall simultaneously in arenas.
  Balls respawn directly on arena ground like player 1 in races.
}

[ENABLE]

alloc(BallRespawn_Cave,64)
alloc(Orig_437130,6)
alloc(Orig_405190,6)
alloc(Orig_40580B,6)
alloc(Orig_405A3D,6)
registersymbol(BallRespawn_Cave)
registersymbol(Orig_437130)
registersymbol(Orig_405190)
registersymbol(Orig_40580B)
registersymbol(Orig_405A3D)

Orig_437130:
  readmem(Hamsterball.exe+37130,6)

Orig_405190:
  readmem(Hamsterball.exe+5190,6)

Orig_40580B:
  readmem(Hamsterball.exe+580B,6)

Orig_405A3D:
  readmem(Hamsterball.exe+5A3D,6)

Hamsterball.exe+37130:
  db C2 04 00 90 90 90

Hamsterball.exe+580B:
  db 90 90 90 90 90 90

Hamsterball.exe+5A3D:
  db 90 90 90 90 90 90

Hamsterball.exe+5190:
  jmp BallRespawn_Cave
  nop

BallRespawn_Cave:
  sub esp,84
  mov eax,[ecx+0x164]
  mov [ecx+0x2DC],eax
  mov eax,[ecx+0x168]
  mov [ecx+0x2E0],eax
  mov eax,[ecx+0x16C]
  mov [ecx+0x2E4],eax
  jmp 00405196

[DISABLE]

Hamsterball.exe+37130:
  readmem(Orig_437130,6)

Hamsterball.exe+5190:
  readmem(Orig_405190,6)

Hamsterball.exe+580B:
  readmem(Orig_40580B,6)

Hamsterball.exe+5A3D:
  readmem(Orig_405A3D,6)

dealloc(BallRespawn_Cave)
dealloc(Orig_437130)
dealloc(Orig_405190)
dealloc(Orig_40580B)
dealloc(Orig_405A3D)
unregistersymbol(BallRespawn_Cave)
unregistersymbol(Orig_437130)
unregistersymbol(Orig_405190)
unregistersymbol(Orig_40580B)
unregistersymbol(Orig_405A3D)
