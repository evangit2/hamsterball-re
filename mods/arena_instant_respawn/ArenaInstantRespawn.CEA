// ============================================================
// Arena Instant Respawn v9
// ============================================================
// ALL balls (players + entities) in arenas respawn instantly at
// nearest safespot — no respawn platform, no crashes/freezes.
//
// PROBLEM: When 5+ balls fall simultaneously in arenas, the game
// crashes/freezes because:
// - Scene_StartCountdown only handles ONE ball (scene+0x10F8)
// - Ball_Respawn arena path calls expensive Mesh_FindClosestCollision
// - Multiple balls compete for the shared respawn platform
//
// FIX: Four patches:
// 1. Skip Scene_StartCountdown for ALL balls (no platform)
// 2. Force race-path search (no Mesh_FindClosestCollision)
// 3. Scan ALL safespots (find nearest, not first)
// 4. Copy ball pos→LGP (each ball searches from actual position)
//
// This makes all balls respawn independently and quickly.
// ============================================================

[ENABLE]

alloc(BallRespawn_Cave, 64)
alloc(SinkSkip_Cave, 32)
alloc(Orig_40580B, 6)
alloc(Orig_405A3D, 6)
alloc(Orig_405190, 6)
alloc(Orig_437130, 6)
registersymbol(BallRespawn_Cave)
registersymbol(SinkSkip_Cave)
registersymbol(Orig_40580B)
registersymbol(Orig_405A3D)
registersymbol(Orig_405190)
registersymbol(Orig_437130)

// Save original bytes
Orig_40580B:
  readmem(0040580B, 6)

Orig_405A3D:
  readmem(00405A3D, 6)

Orig_405190:
  readmem(00405190, 6)

Orig_437130:
  readmem(00437130, 6)

// Patch 1: Force race-path search (no Mesh_FindClosestCollision)
0040580B:
  db 90 90 90 90 90 90

// Patch 2: Scan ALL safespots (not just first match)
00405A3D:
  db 90 90 90 90 90 90

// Patch 3: Code cave at Ball_Respawn entry — copy pos to LGP
00405190:
  jmp BallRespawn_Cave
  nop

BallRespawn_Cave:
  sub esp,84                  // Original: SUB ESP, 0x84
  mov eax,[ecx+0x164]         // ball pos X
  mov [ecx+0x2DC],eax         // LGP X = pos X
  mov eax,[ecx+0x168]         // ball pos Y
  mov [ecx+0x2E0],eax         // LGP Y = pos Y
  mov eax,[ecx+0x16C]         // ball pos Z
  mov [ecx+0x2E4],eax         // LGP Z = pos Z
  jmp 00405196                // Return to PUSH EBX

// Patch 4: Skip Scene_StartCountdown for ALL balls
// Just RET 4 immediately — no platform for anyone
00437130:
  jmp SinkSkip_Cave
  nop

SinkSkip_Cave:
  ret 0004

[DISABLE]

0040580B:
  readmem(Orig_40580B, 6)

00405A3D:
  readmem(Orig_405A3D, 6)

00405190:
  readmem(Orig_405190, 6)

00437130:
  readmem(Orig_437130, 6)

dealloc(BallRespawn_Cave)
dealloc(SinkSkip_Cave)
dealloc(Orig_40580B)
dealloc(Orig_405A3D)
dealloc(Orig_405190)
dealloc(Orig_437130)
unregistersymbol(BallRespawn_Cave)
unregistersymbol(SinkSkip_Cave)
unregistersymbol(Orig_40580B)
unregistersymbol(Orig_405A3D)
unregistersymbol(Orig_405190)
unregistersymbol(Orig_437130)
