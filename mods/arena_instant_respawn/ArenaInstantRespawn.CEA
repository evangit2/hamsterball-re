// ============================================================
// Arena Instant Respawn v8
// ============================================================
// Entity balls in arenas respawn directly on the arena ground
// without the respawn platform coming from above.
//
// FIX: Simply skip Scene_StartCountdown for entity balls.
// When a ball touches a SinkPlatform, SinkPlatformArenaCollisionEvents
// calls Scene_StartCountdown(scene, ball). For entity balls, we RET
// immediately — the platform never activates.
//
// ArenaBoard_Update (0x420DA0) separately detects when a ball falls
// below the Y-threshold and calls Ball_Respawn directly. This uses
// the ORIGINAL game code with NO patches to Ball_Respawn.
//
// SINGLE PATCH: Code cave at Scene_StartCountdown entry (0x437130)
// ============================================================

[ENABLE]

alloc(SinkSkip_Cave, 64)
alloc(Orig_437130, 6)
registersymbol(SinkSkip_Cave)
registersymbol(Orig_437130)

Orig_437130:
  readmem(00437130, 6)

// Hook Scene_StartCountdown entry
00437130:
  jmp SinkSkip_Cave
  nop

SinkSkip_Cave:
  // Get ball ptr from stack param ([ESP+4])
  mov eax,[esp+04]
  // Check if entity ball (player_slot == -1)
  cmp dword [eax+0x18],-1
  jnz player_ball
  // Entity ball: return immediately, no platform
  ret 0004
player_ball:
  // Player ball: execute original instruction and continue
  mov al,[ecx+0x10F1]
  jmp 00437136

[DISABLE]

00437130:
  readmem(Orig_437130, 6)

dealloc(SinkSkip_Cave)
dealloc(Orig_437130)
unregistersymbol(SinkSkip_Cave)
unregistersymbol(Orig_437130)
