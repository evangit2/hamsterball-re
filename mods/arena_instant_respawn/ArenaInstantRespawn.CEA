{
  Arena Instant Respawn v10
  ALL balls (Players 1-4 + badballs) respawn in arenas the same way
  player 1 respawns in races — nearest safespot via LGP, no platform.
}

[ENABLE]

alloc(BallRespawn_Cave,64)
alloc(SinkSkip_Cave,32)
alloc(Orig_40580B,6)
alloc(Orig_405A3D,6)
alloc(Orig_405190,6)
alloc(Orig_437130,6)
registersymbol(BallRespawn_Cave)
registersymbol(SinkSkip_Cave)
registersymbol(Orig_40580B)
registersymbol(Orig_405A3D)
registersymbol(Orig_405190)
registersymbol(Orig_437130)

Orig_40580B:
  readmem(0040580B,6)

Orig_405A3D:
  readmem(00405A3D,6)

Orig_405190:
  readmem(00405190,6)

Orig_437130:
  readmem(00437130,6)

Hamsterball.exe+580B:
  db 90 90 90 90 90 90

Hamsterball.exe+5A3D:
  db 90 90 90 90 90 90

Hamsterball.exe+5190:
  jmp BallRespawn_Cave
  nop

BallRespawn_Cave:
  sub esp,84
  mov eax,[ecx+0x164]
  mov [ecx+0x2DC],eax
  mov eax,[ecx+0x168]
  mov [ecx+0x2E0],eax
  mov eax,[ecx+0x16C]
  mov [ecx+0x2E4],eax
  jmp 00405196

Hamsterball.exe+37130:
  jmp SinkSkip_Cave
  nop

SinkSkip_Cave:
  ret 0004

[DISABLE]

Hamsterball.exe+580B:
  readmem(Orig_40580B,6)

Hamsterball.exe+5A3D:
  readmem(Orig_405A3D,6)

Hamsterball.exe+5190:
  readmem(Orig_405190,6)

Hamsterball.exe+37130:
  readmem(Orig_437130,6)

dealloc(BallRespawn_Cave)
dealloc(SinkSkip_Cave)
dealloc(Orig_40580B)
dealloc(Orig_405A3D)
dealloc(Orig_405190)
dealloc(Orig_437130)
unregistersymbol(BallRespawn_Cave)
unregistersymbol(SinkSkip_Cave)
unregistersymbol(Orig_40580B)
unregistersymbol(Orig_405A3D)
unregistersymbol(Orig_405190)
