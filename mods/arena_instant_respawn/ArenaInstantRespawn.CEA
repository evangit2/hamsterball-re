// ============================================================
// Arena Instant Respawn v4
// ============================================================
// Makes entity balls in arenas respawn the same way player 1
// respawns in races — using nearest safespot via LGP.
//
// ROOT CAUSE (why v3 was glitchy):
//   Ball_Respawn (0x405190) has arena-specific behavior at TWO points:
//
//   1. 0x40580B: JNZ → arena random-safespot path (0x405A80)
//      v3 NOP'd this to use race path instead. CORRECT.
//
//   2. 0x405A3D: JNZ → break after first acceptable safespot (0x405CCC)
//      INSIDE the race path! When arena flag (App+0x237) is set,
//      the search loop accepts the FIRST safespot found and breaks
//      instead of scanning ALL safespots to find the nearest one.
//      This caused ALL entity balls to respawn on the SAME platform
//      (the first safespot in the list).
//
// FIX: NOP BOTH JNZ instructions so Ball_Respawn:
//   - Uses the race-path search (not arena random path)
//   - Scans ALL safespots to find the truly nearest one
//
// Patch 1: 0x40580B: JNZ → NOP (6 bytes) — use race path
// Patch 2: 0x405A3D: JNZ → NOP (6 bytes) — scan all safespots
// ============================================================

[ENABLE]

alloc(ArenaInstantRespawn_v4_Orig1,6)
alloc(ArenaInstantRespawn_v4_Orig2,6)
registersymbol(ArenaInstantRespawn_v4_Orig1)
registersymbol(ArenaInstantRespawn_v4_Orig2)

// Save original bytes
ArenaInstantRespawn_v4_Orig1:
  readmem(0040580B,6)

ArenaInstantRespawn_v4_Orig2:
  readmem(00405A3D,6)

// Patch 1: Use race-path safespot search instead of arena random path
// Original: 0F 85 6F 02 00 00 (JNZ 00405A80 — arena random search)
// Patched:  90 90 90 90 90 90 (NOP — fall through to race path)
0040580B:
  db 90 90 90 90 90 90

// Patch 2: Scan ALL safespots instead of breaking after first match
// Original: 0F 85 89 02 00 00 (JNZ 00405CCC — arena early break)
// Patched:  90 90 90 90 90 90 (NOP — continue scanning for nearest)
00405A3D:
  db 90 90 90 90 90 90

[DISABLE]

// Restore original bytes
0040580B:
  readmem(ArenaInstantRespawn_v4_Orig1,6)

00405A3D:
  readmem(ArenaInstantRespawn_v4_Orig2,6)

dealloc(ArenaInstantRespawn_v4_Orig1)
dealloc(ArenaInstantRespawn_v4_Orig2)
unregistersymbol(ArenaInstantRespawn_v4_Orig1)
unregistersymbol(ArenaInstantRespawn_v4_Orig2)
