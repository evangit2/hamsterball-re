{ NOP bounce_count increment }
Hamsterball.exe+75C9:
  db 90 90 90 90 90 90

{ Ball_Shatter — RET 4 }
Hamsterball.exe+8D70:
  db C2 04 00

{ Ball_SplitDeath — RET }
Hamsterball.exe+9050:
  db C3 90 90

{ Ball_FallDeath — set 0x2E8=1 only (NOT 0x2E9), triggers respawn }
Hamsterball.exe+9480:
  jmp FallDeath_Cave
  db 90 90 90 90 90 90

FallDeath_Cave:
  db C6 81 E8 02 00 00 01
  db C3 90 90 90 90 90 90

{ NOP death_pending (0x2E9) sets — 5 locations, 7 bytes each }
Hamsterball.exe+7391:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F22D:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F268:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F2A3:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F317:
  db 90 90 90 90 90 90 90

{ NOP active flag (0x768) clears — 4 locations, 7 bytes each }
Hamsterball.exe+F226:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F261:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F29C:
  db 90 90 90 90 90 90 90
Hamsterball.exe+F310:
  db 90 90 90 90 90 90 90

{ NOP ball-to-ball collision skip (death_pending) }
Hamsterball.exe+6C01:
  db 90 90

{ NOP bumper skip on respawn flag (0x2F8) }
Hamsterball.exe+22DCB:
  db 90 90
Hamsterball.exe+2395B:
  db 90 90

{ NOP object skip on snap flag (0x2F9) }
Hamsterball.exe+85A6:
  db 90 90 90 90 90 90
Hamsterball.exe+3FFA6:
  db 90 90 90 90 90 90

{ NOP bumper/object skip on active flag (0x768) }
Hamsterball.exe+22DD5:
  db 90 90
Hamsterball.exe+23965:
  db 90 90
Hamsterball.exe+8598:
  db 90 90 90 90 90 90
Hamsterball.exe+3FF98:
  db 90 90 90 90 90 90
Hamsterball.exe+18378:
  db 90 90 90 90 90 90

{ NOP entity-skip jumps (ball+0x18==-1) — 6 locations }
Hamsterball.exe+5ADC:
  db 90 90 90 90 90 90
Hamsterball.exe+6FFB:
  db 90 90 90 90 90 90
Hamsterball.exe+7441:
  db 90 90 90 90 90 90
Hamsterball.exe+70BE:
  db 90 90 90 90 90 90
Hamsterball.exe+8416:
  db 90 90 90 90 90 90
Hamsterball.exe+85D1:
  db 90 90

{ Hook 2: Scene_UpdateBallsAndState, entity list (0x3204) }
{ Clear 0x2E8 so entity balls don't get destroyed }
{ Keep all other flags clear for normal state }
Hamsterball.exe+1B636:
  jmp ClearState_Cave2
  db 90

ClearState_Cave2:
  { Clear falling flag — prevents destroy in Scene_UpdateBallsAndState }
  mov byte ptr [esi+0x2E8],00
  { Clear death_pending }
  mov byte ptr [esi+0x2E9],00
  { Clear is_split_ball so respawn path if needed }
  mov byte ptr [esi+0x324],00
  { Set player ID to 0 if -1 }
  cmp dword ptr [esi+0x18],-1
  jne SkipPID2
  mov dword ptr [esi+0x18],00000000
SkipPID2:
  { Clear all state flags }
  mov byte ptr [esi+0x2CC],00
  mov byte ptr [esi+0x2D4],00
  mov byte ptr [esi+0x2EC],00
  mov dword ptr [esi+0x2F4],00000000
  mov dword ptr [esi+0x808],00000000
  { Clear respawn sequence }
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  { AL = 0 (not falling) }
  xor al,al
  jmp Hamsterball.exe+1B63C

[DISABLE]

