// ============================================================
// No Killplane Break — All Balls
// ============================================================
// ALL balls (Players 1-4 + badballs) no longer break when hitting
// killplanes or falling from height. They still respawn when falling.
//
// Ball_FallDeath (vtable[8], 0x409480) creates Ball_Split fragments
// (ball breaks visually). death_pending is set by the CALLER before
// vtable[8], so Ball_Respawn still fires even if we skip FallDeath.
//
// FIX: Make Ball_FallDeath RET immediately for ALL balls.
// No fragments, no breaking. Balls still respawn via death_pending.
// ============================================================

[ENABLE]

alloc(Orig_409480, 8)
registersymbol(Orig_409480)

Orig_409480:
  readmem(00409480, 8)

// Replace Ball_FallDeath entry with immediate RET
00409480:
  ret
  nop
  nop
  nop
  nop
  nop
  nop
  nop

[DISABLE]

00409480:
  readmem(Orig_409480, 8)

dealloc(Orig_409480)
unregistersymbol(Orig_409480)
