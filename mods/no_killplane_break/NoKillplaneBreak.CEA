{
  No Fall Damage + No Air Break (Full) — with BadBall immunity
  Credits to BookwormKevin for the original script!
  Players 1-4 AND badballs are immune to ground killplanes.
  Balls still respawn when falling into the void.
}

[ENABLE]

alloc(FallDeath_Cave,64)
alloc(Orig_402390,3)
registersymbol(FallDeath_Cave)
registersymbol(Orig_402390)

Orig_402390:
  readmem(Hamsterball.exe+2390,3)

Hamsterball.exe+75C9:
db 90 90 90 90 90 90

Hamsterball.exe+8D70:
db C3 90 90

Hamsterball.exe+9050:
db C3 90 90

Hamsterball.exe+2390:
db C3 90 90

Hamsterball.exe+9480:
jmp FallDeath_Cave
db 90 90 90

FallDeath_Cave:
db C6 81 E8 02 00 00 01
db C6 81 E9 02 00 00 01
db C3

[DISABLE]

Hamsterball.exe+75C9:
db FF 86 EC 02 00 00

Hamsterball.exe+8D70:
db 6A FF 64

Hamsterball.exe+9050:
db 6A FF 64

Hamsterball.exe+2390:
readmem(Orig_402390,3)

Hamsterball.exe+9480:
db 6A FF 64 A1 00 00 00 00

dealloc(FallDeath_Cave)
dealloc(Orig_402390)
unregistersymbol(FallDeath_Cave)
unregistersymbol(Orig_402390)
