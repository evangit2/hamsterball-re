{
  No Fall Damage + No Air Break (Full) — with BadBall immunity
  Credits to BookwormKevin for the original script!
  Players 1-4 AND badballs immune to ground killplanes.
  Badballs still attack players on ground (removed death_pending check).
  Balls respawn when falling into void (Ball_Update sets falling flag).
}

[ENABLE]

alloc(Orig_402390,3)
alloc(Orig_13926,6)
alloc(Orig_13934,6)
registersymbol(Orig_402390)
registersymbol(Orig_13926)
registersymbol(Orig_13934)

Orig_402390:
  readmem(Hamsterball.exe+2390,3)

Orig_13926:
  readmem(Hamsterball.exe+13926,6)

Orig_13934:
  readmem(Hamsterball.exe+13934,6)

