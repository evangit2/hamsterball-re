{ NOP bounce_count increment }
Hamsterball.exe+75C9:
  db 90 90 90 90 90 90

{ Ball_Shatter — RET 4 }
Hamsterball.exe+8D70:
  db C2 04 00

{ Ball_SplitDeath — RET }
Hamsterball.exe+9050:
  db C3 90 90

{ Ball_FallDeath — set 0x2E8=1 only (NOT 0x2E9), triggers respawn }
Hamsterball.exe+9480:
  jmp FallDeath_Cave
  db 90 90 90 90 90 90

FallDeath_Cave:
  db C6 81 E8 02 00 00 01
  db C3 90 90 90 90 90 90

{ NOP ball-to-ball collision skip (death_pending 0x2E9) }
Hamsterball.exe+6C01:
  db 90 90

{ NOP bumper skip on respawn flag (0x2F8) }
Hamsterball.exe+22DCB:
  db 90 90
Hamsterball.exe+2395B:
  db 90 90

{ NOP object skip on snap flag (0x2F9) }
Hamsterball.exe+85A6:
  db 90 90 90 90 90 90
Hamsterball.exe+3FFA6:
  db 90 90 90 90 90 90

{ NOP bumper/object skip on active flag (0x768) }
Hamsterball.exe+22DD5:
  db 90 90
Hamsterball.exe+23965:
  db 90 90
Hamsterball.exe+8598:
  db 90 90 90 90 90 90
Hamsterball.exe+3FF98:
  db 90 90 90 90 90 90
Hamsterball.exe+18378:
  db 90 90 90 90 90 90

{ NOP [ecx+0x2F8] respawn skip — 3 locations }
Hamsterball.exe+22D44:
  db 90 90
Hamsterball.exe+23394:
  db 90 90
Hamsterball.exe+238D4:
  db 90 90

{ NOP [ecx+0x768] active flag skip — 2 locations }
Hamsterball.exe+22D4E:
  db 90 90
Hamsterball.exe+238DE:
  db 90 90

{ NOP [esi+0x768] and [eax+0x768/0x2F8/0x2F9/0x2E9] collision skips }
Hamsterball.exe+81E1:
  db 90 90
