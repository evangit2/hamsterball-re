{ ============================================================
  No Killplane Break — All Balls
  ============================================================
  ALL balls (Players 1-4 + badballs) no longer break when hitting
  killplanes or falling from height. They still respawn when falling.
  ============================================================
}

[ENABLE]

alloc(Orig_409480,8)
registersymbol(Orig_409480)

Orig_409480:
  readmem(00409480,8)

00409480:
  db C3 90 90 90 90 90 90 90

[DISABLE]

00409480:
  readmem(Orig_409480,8)

dealloc(Orig_409480)
unregistersymbol(Orig_409480)
