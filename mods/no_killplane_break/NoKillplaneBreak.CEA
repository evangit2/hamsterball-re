{
  No Fall Damage + No Air Break (Full) — Fixed
  Credits to BookwormKevin for the original script!
  Fix: Ball_FallDeath sets falling+death_pending flags then RETs
  instead of bare RET (which skipped flag setting for Players 1-4).
}

[ENABLE]

alloc(FallDeath_Cave,64)
registersymbol(FallDeath_Cave)

Hamsterball.exe+75C9:
db 90 90 90 90 90 90

Hamsterball.exe+C761:
db 90 90 90 90 90 90

Hamsterball.exe+F226:
db 90 90 90 90 90 90 90

Hamsterball.exe+8D70:
db C3 90 90

Hamsterball.exe+9050:
db C3 90 90

Hamsterball.exe+9480:
jmp FallDeath_Cave
db 90 90 90

FallDeath_Cave:
db C6 81 E8 02 00 00 01
db C6 81 E9 02 00 00 01
db C3

[DISABLE]

Hamsterball.exe+75C9:
db FF 86 EC 02 00 00

Hamsterball.exe+C761:
db 88 85 68 07 00 00

Hamsterball.exe+F226:
db C6 86 68 07 00 00 00

Hamsterball.exe+8D70:
db 6A FF 64

Hamsterball.exe+9050:
db 6A FF 64

Hamsterball.exe+9480:
db 6A FF 64 A1 00 00 00 00

dealloc(FallDeath_Cave)
unregistersymbol(FallDeath_Cave)
