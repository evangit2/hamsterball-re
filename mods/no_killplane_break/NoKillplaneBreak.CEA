  readmem(Orig_2395B,2)
Hamsterball.exe+85A6:
  readmem(Orig_85A6,6)
Hamsterball.exe+3FFA6:
  readmem(Orig_3FFA6,6)
Hamsterball.exe+22DD5:
  readmem(Orig_22DD5,2)
Hamsterball.exe+23965:
  readmem(Orig_23965,2)
Hamsterball.exe+8598:
  readmem(Orig_8598,6)
Hamsterball.exe+3FF98:
  readmem(Orig_3FF98,6)
Hamsterball.exe+18378:
  readmem(Orig_18378,6)
Hamsterball.exe+22D44:
  readmem(Orig_22D44,2)
Hamsterball.exe+23394:
  readmem(Orig_23394,2)
Hamsterball.exe+238D4:
  readmem(Orig_238D4,2)
Hamsterball.exe+22D4E:
  readmem(Orig_22D4E,2)
Hamsterball.exe+238DE:
  readmem(Orig_238DE,2)
Hamsterball.exe+1B591:
  readmem(Orig_1B591,6)
Hamsterball.exe+1B636:
  readmem(Orig_1B636,6)

dealloc(FallDeath_Cave)
dealloc(ClearState_Cave1)
dealloc(ClearState_Cave2)
