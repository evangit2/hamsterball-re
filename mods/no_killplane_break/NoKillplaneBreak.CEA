{
  No Fall Damage + No Air Break + Entity Immunity + BadBall AI Fix
  Credits to BookwormKevin for the original script!
  Players 1-4 respawn when falling into void (native Ball_Respawn).
  Badballs immune to killplanes (don't disappear).
  All balls always collide with bumpers, mousetraps, badballs.

  Patches:
  1. Ball_Shatter (0x8D70): RET 4
  2. Ball_SplitDeath (0x9050): RET
  3. Ball_FallDeath (0x9480): set 0x2E8=1 only (triggers respawn)
  4. bounce_count (0x75C9): NOP
  5. Collision skip checks (15 locations): NOP — collision always runs
  6. Hook1 (+1B591): clear 0x2E8 for entity balls in list 1 (prevent destroy)
  7. Hook2 (+1B636): clear 0x2E8 for entity balls in list 2 (prevent destroy)
}

[ENABLE]

alloc(FallDeath_Cave,64)
alloc(ClearState_Cave1,256)
alloc(ClearState_Cave2,256)
alloc(Orig_8D70,3)
alloc(Orig_9050,3)
alloc(Orig_9480,12)
alloc(Orig_75C9,6)
alloc(Orig_6C01,2)
alloc(Orig_22DCB,2)
alloc(Orig_2395B,2)
alloc(Orig_85A6,6)
alloc(Orig_3FFA6,6)
alloc(Orig_22DD5,2)
alloc(Orig_23965,2)
alloc(Orig_8598,6)
alloc(Orig_3FF98,6)
alloc(Orig_18378,6)
alloc(Orig_22D44,2)
alloc(Orig_23394,2)
alloc(Orig_238D4,2)
alloc(Orig_22D4E,2)
alloc(Orig_238DE,2)
alloc(Orig_1B591,6)
alloc(Orig_1B636,6)
registersymbol(FallDeath_Cave)
registersymbol(ClearState_Cave1)
registersymbol(ClearState_Cave2)
registersymbol(Orig_8D70)
registersymbol(Orig_9050)
registersymbol(Orig_9480)
registersymbol(Orig_75C9)
registersymbol(Orig_6C01)
registersymbol(Orig_22DCB)
registersymbol(Orig_2395B)
registersymbol(Orig_85A6)
registersymbol(Orig_3FFA6)
registersymbol(Orig_22DD5)
registersymbol(Orig_23965)
registersymbol(Orig_8598)
registersymbol(Orig_3FF98)
registersymbol(Orig_18378)
registersymbol(Orig_22D44)
registersymbol(Orig_23394)
registersymbol(Orig_238D4)
registersymbol(Orig_22D4E)
registersymbol(Orig_238DE)
registersymbol(Orig_1B591)
registersymbol(Orig_1B636)

Orig_8D70:
  readmem(Hamsterball.exe+8D70,3)
Orig_9050:
  readmem(Hamsterball.exe+9050,3)
Orig_9480:
  readmem(Hamsterball.exe+9480,12)
Orig_75C9:
  readmem(Hamsterball.exe+75C9,6)
Orig_6C01:
  readmem(Hamsterball.exe+6C01,2)
Orig_22DCB:
  readmem(Hamsterball.exe+22DCB,2)
Orig_2395B:
  readmem(Hamsterball.exe+2395B,2)
Orig_85A6:
  readmem(Hamsterball.exe+85A6,6)
Orig_3FFA6:
  readmem(Hamsterball.exe+3FFA6,6)
Orig_22DD5:
  readmem(Hamsterball.exe+22DD5,2)
Orig_23965:
  readmem(Hamsterball.exe+23965,2)
Orig_8598:
  readmem(Hamsterball.exe+8598,6)
Orig_3FF98:
  readmem(Hamsterball.exe+3FF98,6)
Orig_18378:
  readmem(Hamsterball.exe+18378,6)
Orig_22D44:
  readmem(Hamsterball.exe+22D44,2)
Orig_23394:
  readmem(Hamsterball.exe+23394,2)
Orig_238D4:
  readmem(Hamsterball.exe+238D4,2)
Orig_22D4E:
  readmem(Hamsterball.exe+22D4E,2)
Orig_238DE:
  readmem(Hamsterball.exe+238DE,2)
Orig_1B591:
  readmem(Hamsterball.exe+1B591,6)
Orig_1B636:
  readmem(Hamsterball.exe+1B636,6)

{ NOP bounce_count increment }
Hamsterball.exe+75C9:
  db 90 90 90 90 90 90

{ Ball_Shatter — RET 4 }
Hamsterball.exe+8D70:
  db C2 04 00

{ Ball_SplitDeath — RET }
Hamsterball.exe+9050:
  db C3 90 90

{ Ball_FallDeath — set 0x2E8=1 only (NOT 0x2E9), triggers respawn }
Hamsterball.exe+9480:
  jmp FallDeath_Cave
  db 90 90 90 90 90 90

FallDeath_Cave:
  db C6 81 E8 02 00 00 01
  db C3 90 90 90 90 90 90

{ NOP ball-to-ball collision skip (death_pending 0x2E9) }
Hamsterball.exe+6C01:
  db 90 90

{ NOP bumper skip on respawn flag (0x2F8) }
Hamsterball.exe+22DCB:
  db 90 90
Hamsterball.exe+2395B:
  db 90 90

{ NOP object skip on snap flag (0x2F9) }
Hamsterball.exe+85A6:
  db 90 90 90 90 90 90
Hamsterball.exe+3FFA6:
  db 90 90 90 90 90 90

{ NOP bumper/object skip on active flag (0x768) }
Hamsterball.exe+22DD5:
  db 90 90
Hamsterball.exe+23965:
  db 90 90
Hamsterball.exe+8598:
  db 90 90 90 90 90 90
Hamsterball.exe+3FF98:
  db 90 90 90 90 90 90
Hamsterball.exe+18378:
  db 90 90 90 90 90 90

{ NOP [ecx+0x2F8] respawn skip — 3 locations }
Hamsterball.exe+22D44:
  db 90 90
Hamsterball.exe+23394:
  db 90 90
Hamsterball.exe+238D4:
  db 90 90

{ NOP [ecx+0x768] active flag skip — 2 locations }
Hamsterball.exe+22D4E:
  db 90 90
Hamsterball.exe+238DE:
  db 90 90

{ Hook 1: Scene_UpdateBallsAndState, list 1 (player + maybe badballs) }
{ If entity ball (0x324!=0): clear 0x2E8 → prevent destroy }
{ If player ball (0x324==0): keep 0x2E8 → respawn works }
Hamsterball.exe+1B591:
  jmp ClearState_Cave1
  db 90

ClearState_Cave1:
  { Check if entity ball }
  mov al,[esi+0x324]
  test al,al
  jz PlayerBall1
  { Entity ball: clear 0x2E8, clear state, return AL=0 }
  mov byte ptr [esi+0x2E8],00
  mov byte ptr [esi+0x2E9],00
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  xor al,al
  jmp Hamsterball.exe+1B597
PlayerBall1:
  { Player ball: keep 0x2E8 for respawn, just clear state flags }
  mov byte ptr [esi+0x2E9],00
  mov al,[esi+0x2E8]
  jmp Hamsterball.exe+1B597

{ Hook 2: Scene_UpdateBallsAndState, list 2 (entity balls) }
{ Clear 0x2E8 so entity balls don't get destroyed }
Hamsterball.exe+1B636:
  jmp ClearState_Cave2
  db 90

ClearState_Cave2:
  mov byte ptr [esi+0x2E8],00
  mov byte ptr [esi+0x2E9],00
  mov byte ptr [esi+0x2CC],00
  mov byte ptr [esi+0x2D4],00
  mov byte ptr [esi+0x2EC],00
  mov dword ptr [esi+0x2F4],00000000
  mov dword ptr [esi+0x808],00000000
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  xor al,al
  jmp Hamsterball.exe+1B63C

[DISABLE]

Hamsterball.exe+75C9:
  readmem(Orig_75C9,6)
Hamsterball.exe+8D70:
  readmem(Orig_8D70,3)
Hamsterball.exe+9050:
  readmem(Orig_9050,3)
