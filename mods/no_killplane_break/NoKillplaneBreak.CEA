{
  No Fall Damage + No Air Break (Full) — with BadBall immunity + AI fix
  Credits to BookwormKevin for the original script!
  Players 1-4 AND badballs immune to ground killplanes.
  All entity balls forced to NORMAL STATE every frame.
  Badballs attack all balls — no dead/falling/dizzy state possible.
  Void respawn: balls below Y=-500 are teleported to (0,0,0) with zeroed velocity.

  v2 fixes:
  1. 10-byte patches → 6-byte (don't overwrite test al,al + jz)
  2. ret in cave → jmp back (don't exit Scene_UpdateBallsAndState)
  3. Ball_Shatter: RET 4 (__thiscall with 1 stack param)

  v3 fixes:
  4. Void respawn: Y<-500 → teleport to origin, zero velocity + angular
  5. Zero ball+0x178/0x17C/0x180 (angular velocity) on respawn
}

[ENABLE]

alloc(ClearState_Cave1,512)
alloc(ClearState_Cave2,512)
alloc(Orig_402390,3)
alloc(Orig_8D70,3)
alloc(Orig_9050,3)
alloc(Orig_9480,9)
alloc(Orig_13918,6)
alloc(Orig_13926,6)
alloc(Orig_13934,6)
alloc(Orig_1B591,6)
alloc(Orig_1B636,6)
alloc(Orig_75C9,6)
registersymbol(ClearState_Cave1)
registersymbol(ClearState_Cave2)
registersymbol(Orig_402390)
registersymbol(Orig_8D70)
registersymbol(Orig_9050)
registersymbol(Orig_9480)
registersymbol(Orig_13918)
registersymbol(Orig_13926)
registersymbol(Orig_13934)
registersymbol(Orig_1B591)
registersymbol(Orig_1B636)
registersymbol(Orig_75C9)

Orig_402390:
  readmem(Hamsterball.exe+2390,3)

Orig_8D70:
  readmem(Hamsterball.exe+8D70,3)

Orig_9050:
  readmem(Hamsterball.exe+9050,3)

Orig_9480:
  readmem(Hamsterball.exe+9480,9)

Orig_13918:
  readmem(Hamsterball.exe+13918,6)

Orig_13926:
  readmem(Hamsterball.exe+13926,6)

Orig_13934:
  readmem(Hamsterball.exe+13934,6)

Orig_1B591:
  readmem(Hamsterball.exe+1B591,6)

Orig_1B636:
  readmem(Hamsterball.exe+1B636,6)

Orig_75C9:
  readmem(Hamsterball.exe+75C9,6)

{ NOP bounce_count increment (ball+0x2EC) }
Hamsterball.exe+75C9:
  db 90 90 90 90 90 90

{ Ball_Shatter (0x408D70) — __thiscall with 1 stack param, ret 4 }
Hamsterball.exe+8D70:
  db C2 04 00

{ Ball_SplitDeath (0x409050) — __fastcall, bare ret }
Hamsterball.exe+9050:
  db C3 90 90

{ BadBall_StartFallCountdown (0x402390) — __fastcall, bare ret }
Hamsterball.exe+2390:
  db C3 90 90

{ Ball_FallDeath (0x409480) — __fastcall, bare ret }
Hamsterball.exe+9480:
  db C3 90 90 90 90 90 90 90 90

{ NOP three JNZ: skip player_active / death_pending / respawn checks }
Hamsterball.exe+13918:
  db 90 90 90 90 90 90

Hamsterball.exe+13926:
  db 90 90 90 90 90 90

Hamsterball.exe+13934:
  db 90 90 90 90 90 90

{ Hook 1: in Scene_UpdateBallsAndState, list 1 (player balls) }
{ After vtable[4] call, original: mov al,[esi+0x2E8] (6 bytes) }
Hamsterball.exe+1B591:
  jmp ClearState_Cave1
  db 90

{ Hook 2: in Scene_UpdateBallsAndState, list 2 (entity balls) }
Hamsterball.exe+1B636:
  jmp ClearState_Cave2
  db 90

ClearState_Cave1:
  { Void respawn: if ball Y < -500.0, teleport to origin }
  { ball+0x168 = Y position (float) }
  mov eax,[esi+0x168]
  shr eax,1
  jc DoRespawn1
  jz SkipRespawn1
  cmp eax,1F7D0000
  jae DoRespawn1
SkipRespawn1:
  jmp ClearStates1

DoRespawn1:
  { Teleport to (0,0,0) }
  mov dword ptr [esi+0x164],00000000
  mov dword ptr [esi+0x168],00000000
  mov dword ptr [esi+0x16C],00000000
  { Zero velocity (ball+0x5D/0x5E/0x5C = 0x174/0x178/0x17C) }
  mov dword ptr [esi+0x174],00000000
  mov dword ptr [esi+0x178],00000000
  mov dword ptr [esi+0x17C],00000000
  { Zero angular velocity (ball+0x184/0x180/0x17C) }
  mov dword ptr [esi+0x180],00000000
  mov dword ptr [esi+0x184],00000000

ClearStates1:
  { Clear in-tar (ball+0x2CC) }
  mov byte ptr [esi+0x2CC],00
  { Clear vacuum (ball+0x2D4) }
  mov byte ptr [esi+0x2D4],00
  { Clear falling (ball+0x2E8) }
  mov byte ptr [esi+0x2E8],00
  { Clear death_pending (ball+0x2E9) }
  mov byte ptr [esi+0x2E9],00
  { Clear bounce_count (ball+0x2EC) }
  mov byte ptr [esi+0x2EC],00
  { Clear dizzy_immunity_timer (ball+0x2F4) }
  mov dword ptr [esi+0x2F4],00000000
  { Clear respawn flag (ball+0x2F8) }
  mov byte ptr [esi+0x2F8],00
  { Clear snap/respawn flag (ball+0x2F9) }
  mov byte ptr [esi+0x2F9],00
  { Set alpha = 1.0 visible (ball+0x2FC) }
  mov dword ptr [esi+0x2FC],3F800000
  { Clear respawn timer (ball+0x300) }
  mov dword ptr [esi+0x300],00000000
  { Clear impact (ball+0x808) }
  mov dword ptr [esi+0x808],00000000
  { AL = 0 (not falling) — original instruction loads AL from ball+0x2E8 }
  xor al,al
  { Return to test al,al at 0x41B597 }
  jmp Hamsterball.exe+1B597

ClearState_Cave2:
  { Void respawn: if ball Y < -500.0, teleport to origin }
  mov eax,[esi+0x168]
  shr eax,1
  jc DoRespawn2
  jz SkipRespawn2
  cmp eax,1F7D0000
  jae DoRespawn2
SkipRespawn2:
  jmp ClearStates2

DoRespawn2:
  mov dword ptr [esi+0x164],00000000
  mov dword ptr [esi+0x168],00000000
  mov dword ptr [esi+0x16C],00000000
  mov dword ptr [esi+0x174],00000000
  mov dword ptr [esi+0x178],00000000
  mov dword ptr [esi+0x17C],00000000
  mov dword ptr [esi+0x180],00000000
  mov dword ptr [esi+0x184],00000000

ClearStates2:
  mov byte ptr [esi+0x2CC],00
  mov byte ptr [esi+0x2D4],00
  mov byte ptr [esi+0x2E8],00
  mov byte ptr [esi+0x2E9],00
  mov byte ptr [esi+0x2EC],00
  mov dword ptr [esi+0x2F4],00000000
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  mov dword ptr [esi+0x808],00000000
  xor al,al
  { Return to test al,al at 0x41B63C }
  jmp Hamsterball.exe+1B63C

[DISABLE]

Hamsterball.exe+75C9:
  readmem(Orig_75C9,6)

Hamsterball.exe+8D70:
  readmem(Orig_8D70,3)

Hamsterball.exe+9050:
  readmem(Orig_9050,3)

Hamsterball.exe+2390:
  readmem(Orig_402390,3)

Hamsterball.exe+9480:
  readmem(Orig_9480,9)

Hamsterball.exe+13918:
  readmem(Orig_13918,6)

Hamsterball.exe+13926:
  readmem(Orig_13926,6)

Hamsterball.exe+13934:
  readmem(Orig_13934,6)

Hamsterball.exe+1B591:
  readmem(Orig_1B591,6)

Hamsterball.exe+1B636:
  readmem(Orig_1B636,6)

dealloc(ClearState_Cave1)
dealloc(ClearState_Cave2)
dealloc(Orig_402390)
dealloc(Orig_8D70)
dealloc(Orig_9050)
dealloc(Orig_9480)
dealloc(Orig_13918)
dealloc(Orig_13926)
dealloc(Orig_13934)
dealloc(Orig_1B591)
dealloc(Orig_1B636)
dealloc(Orig_75C9)
unregistersymbol(ClearState_Cave1)
unregistersymbol(ClearState_Cave2)
unregistersymbol(Orig_402390)
unregistersymbol(Orig_8D70)
unregistersymbol(Orig_9050)
unregistersymbol(Orig_9480)
unregistersymbol(Orig_13918)
unregistersymbol(Orig_13926)
unregistersymbol(Orig_13934)
unregistersymbol(Orig_1B591)
unregistersymbol(Orig_1B636)
