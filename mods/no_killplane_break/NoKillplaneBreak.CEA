Hamsterball.exe+1B0D9:
  db 90 90

{ Hook 1: Scene_UpdateBallsAndState, list 1 (player + maybe badballs) }
{ If entity ball (0x324!=0): clear 0x2E8 → prevent destroy }
{ If player ball (0x324==0): keep 0x2E8 → respawn works }
Hamsterball.exe+1B591:
  jmp ClearState_Cave1
  db 90

ClearState_Cave1:
  { Check if entity ball }
  mov al,[esi+0x324]
  test al,al
  jz PlayerBall1
  { Entity ball: clear 0x2E8, clear state, return AL=0 }
  mov byte ptr [esi+0x2E8],00
  mov byte ptr [esi+0x2E9],00
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  xor al,al
  jmp Hamsterball.exe+1B597
PlayerBall1:
  { Player ball: keep 0x2E8 for respawn, just clear state flags }
  mov byte ptr [esi+0x2E9],00
  mov al,[esi+0x2E8]
  jmp Hamsterball.exe+1B597

{ Hook 2: Scene_UpdateBallsAndState, list 2 (entity balls) }
{ Clear 0x2E8 so entity balls don't get destroyed }
Hamsterball.exe+1B636:
  jmp ClearState_Cave2
  db 90

ClearState_Cave2:
  mov byte ptr [esi+0x2E8],00
  mov byte ptr [esi+0x2E9],00
  mov byte ptr [esi+0x2CC],00
  mov byte ptr [esi+0x2D4],00
  mov byte ptr [esi+0x2EC],00
  mov dword ptr [esi+0x2F4],00000000
  mov dword ptr [esi+0x808],00000000
  mov byte ptr [esi+0x2F8],00
  mov byte ptr [esi+0x2F9],00
  mov dword ptr [esi+0x2FC],3F800000
  mov dword ptr [esi+0x300],00000000
  xor al,al
  jmp Hamsterball.exe+1B63C

[DISABLE]

