[ENABLE]
 
// =====================================================
// Global PopCylinder Spawner with Chrome Release v5 (DEBUG)
// =====================================================
// HOOK: Ball_Update at 0x405E22
//   Original: 8B 86 5C 0C 00 00 = mov eax, [esi+0x0C5C]
//   ESI = ball pointer (ECX from __fastcall Ball_Update)
//
// HOTKEY: Set [SpawnPopCylinder] to 1 via CE to spawn
//
// DEBUG: Check [DebugFrame] (should count up rapidly),
//        [DebugSpawnAttempt] (should be 1 after setting flag),
//        [DebugError] (0=success, see below)
//
// Error codes:
//   0 = success, 1 = board NULL, 2 = App NULL,
//   3 = mesh alloc failed, 4 = gfx_device NULL,
//   5 = mesh ctor failed, 6 = mesh still NULL,
//   7 = popcyl alloc failed, 8 = ctor failed
// =====================================================
 
alloc(SpawnCode, 2048)
alloc(SpawnPopCylinder, 4)
alloc(saved_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(DebugFrame, 4)
alloc(DebugSpawnAttempt, 4)
alloc(DebugError, 4)
 
registersymbol(SpawnPopCylinder)
registersymbol(DebugFrame)
registersymbol(DebugSpawnAttempt)
registersymbol(DebugError)
 
SpawnPopCylinder:
 dd 0
saved_board:
 dd 0
playerX:
 dd 0
playerY:
 dd 0
playerZ:
 dd 0
DebugFrame:
 dd 0
DebugSpawnAttempt:
 dd 0
DebugError:
 dd 0
 
label(original_code)
label(check_spawn)
label(done_spawn)
label(mesh_done)
label(mesh_create)
 
SpawnCode:
 
// === FRAME COUNTER (proves hook is running) ===
inc dword [DebugFrame]
 
// === SAVE PLAYER POSITION ===
mov eax, [esi+0x164]
mov [playerX], eax
mov eax, [esi+0x168]
mov [playerY], eax
mov eax, [esi+0x16C]
mov [playerZ], eax
 
// === SPAWN CHECK ===
check_spawn:
cmp dword [SpawnPopCylinder], 0
je original_code
mov dword [SpawnPopCylinder], 0
inc dword [DebugSpawnAttempt]
mov dword [DebugError], 0
 
pushad
 
// Get board from ball+0x14
mov eax, [esi+0x14]
mov [saved_board], eax
test eax, eax
jz fail_1
 
// Verify board has App pointer (board+0x878)
mov edx, [eax+0x878]
test edx, edx
jz fail_2
 
// === MESH LOADING ===
mov edx, [saved_board]
cmp dword [edx+0x5420], 0
jne mesh_done
 
mesh_create:
push 0x10D0
call 004BA57B
add esp, 4
test eax, eax
jz fail_3
 
// Get D3D device: board+0x878 (App) -> +0x174 (gfx_device)
mov edx, [saved_board]
mov edx, [edx+0x878]
mov edx, [edx+0x174]
test edx, edx
jz fail_4
 
push 004D0F5C
push edx
mov ecx, eax
call 00461510
test eax, eax
jz fail_5
 
mov edx, [saved_board]
mov [edx+0x5420], eax
 
mesh_done:
mov edx, [saved_board]
mov edx, [edx+0x5420]
test edx, edx
jz fail_6
 
// === ALLOCATE POPCYLINDER ===
push 0x10E8
call 004BA57B
add esp, 4
test eax, eax
jz fail_7
mov edi, eax
 
mov edx, [saved_board]
mov ecx, [edx+0x5420]
push ecx
mov edx, [playerZ]
push edx
mov edx, [playerY]
push edx
mov edx, [playerX]
push edx
mov edx, [saved_board]
push edx
mov ecx, edi
call 00436EE0
test eax, eax
jz fail_8
mov edi, eax
 
// === REGISTER IN ACTIVE OBJECTS LIST ===
push edi
mov ecx, [saved_board]
add ecx, 0x2578
call 00453810
 
jmp done_spawn
 
fail_1:
mov dword [DebugError], 1
jmp done_spawn
fail_2:
mov dword [DebugError], 2
jmp done_spawn
fail_3:
mov dword [DebugError], 3
jmp done_spawn
fail_4:
mov dword [DebugError], 4
jmp done_spawn
fail_5:
mov dword [DebugError], 5
jmp done_spawn
fail_6:
mov dword [DebugError], 6
jmp done_spawn
fail_7:
mov dword [DebugError], 7
jmp done_spawn
fail_8:
mov dword [DebugError], 8
 
done_spawn:
popad
 
original_code:
mov eax, [esi+0x0c5c]
jmp 00405E28
 
00405E22:
jmp SpawnCode
nop
 
[DISABLE]
00405E22:
db 8B 86 5C 0C 00 00
 
dealloc(SpawnCode)
dealloc(SpawnPopCylinder)
dealloc(saved_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(DebugFrame)
dealloc(DebugSpawnAttempt)
dealloc(DebugError)
unregistersymbol(SpawnPopCylinder)
unregistersymbol(DebugFrame)
unregistersymbol(DebugSpawnAttempt)
unregistersymbol(DebugError)
