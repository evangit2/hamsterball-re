[ENABLE]

alloc(SpawnCode, 4096)
alloc(SpawnFan, 4)
alloc(saved_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(float_20, 4)

registersymbol(SpawnFan)

SpawnFan:
  dd 0

saved_board:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

float_20:
  dd 0x41A00000

label(original_code)
label(check_spawn)
label(done_spawn)


SpawnCode:
  cmp dword [esi+0x18], 0
  jne check_spawn

  fld dword [esi+0x164]
  fadd dword [float_20]
  fstp dword [playerX]
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax

check_spawn:
  cmp dword [SpawnFan], 0
  je original_code
  cmp dword [esi+0x18], 0
  jne original_code
  mov dword [SpawnFan], 0

  pushad
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz done_spawn
  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx+0x174]
  test edx, edx
  jz done_spawn

  push 0x1188
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn

  push 0
  sub esp, 0xC
  mov edx, [playerX]
  mov [esp], edx
  mov edx, [playerY]
  mov [esp+4], edx
  mov edx, [playerZ]
  mov [esp+8], edx
  mov edx, [saved_board]
  push edx
  mov ecx, eax
  call 00438C20
  test eax, eax
  jz done_spawn
  mov edi, eax

  push edi
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  push edi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  test edx, edx
  jz done_spawn
  mov edx, [edx+0x480]
  test edx, edx
  jz done_spawn
  push edi
  lea ecx, [edx+0x1C]
  call 00453810

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SpawnCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnFan)
dealloc(saved_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(float_20)
unregistersymbol(SpawnFan)
