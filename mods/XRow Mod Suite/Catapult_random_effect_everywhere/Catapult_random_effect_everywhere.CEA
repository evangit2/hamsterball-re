[ENABLE]
alloc(newmem, 1000)
alloc(cylTimer, 4)
alloc(launchFrame, 4)
alloc(entityCount, 4)
alloc(randAngle, 4)

cylTimer:
  dd 180
launchFrame:
  dd 0
entityCount:
  dd 0
randAngle:
  dd (float)0.0

newmem:
  push eax
  push ecx
  push edx
  push ebx

  mov eax, [esi+0x18]
  cmp eax, 0
  jne check_launch

  dec dword ptr [cylTimer]
  cmp dword ptr [cylTimer], 0
  jg check_launch
  mov dword ptr [cylTimer], 180
  mov dword ptr [launchFrame], 1
  mov dword ptr [entityCount], 0

check_launch:
  cmp dword ptr [launchFrame], 0
  je done

  mov eax, [esi+0x1A4]
  test eax, eax
  jz done

  // Random angle per entity
  push eax
  rdtsc
  add eax, [entityCount]
  and eax, 0xFF
  mov [randAngle], eax
  fild dword ptr [randAngle]
  fmul dword ptr [scale]
  fstp dword ptr [randAngle]
  pop eax

  // Fixed XZ force = 20
  fld dword ptr [randAngle]
  fmul dword ptr [degToRad]
  fcos
  fmul dword ptr [xzForce]
  fstp dword ptr [eax+0xCA4]

  fld dword ptr [randAngle]
  fmul dword ptr [degToRad]
  fsin
  fmul dword ptr [xzForce]
  fstp dword ptr [eax+0xCAC]

  // Fixed Y launch force
  mov dword ptr [eax+0xCA8], 0x41A00000  // 20.0

  inc dword ptr [entityCount]
  cmp dword ptr [entityCount], 5
  jl done
  mov dword ptr [launchFrame], 0

done:
  pop ebx
  pop edx
  pop ecx
  pop eax
  mov [esi+0x168], eax
  jmp 00407C72

xzForce:
  dd (float)15.0
degToRad:
  dd (float)0.0174533
scale:
  dd (float)1.40625

00407C6C:
  jmp newmem
  nop

[DISABLE]
00407C6C:
db 89 86 68 01 00 00
dealloc(newmem)
dealloc(cylTimer)
dealloc(randAngle)
dealloc(launchFrame)
dealloc(entityCount)
