[ENABLE]

alloc(renderPatch, 256)
alloc(SpawnCode, 4096)
alloc(SpawnFunball, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(ballCount, 4)
alloc(spawnNow, 4)

registersymbol(SpawnFunball)

SpawnFunball:
  dd 0

playerX:
  dd 0
playerY:
  dd 0
playerZ:
  dd 0
ballCount:
  dd 0
spawnNow:
  dd 0

renderPatch:
  cmp dword ptr [ebp+0x754], 14
  jne check_dizzy
  mov ecx, [edx+0x264]
  jmp render_continue
check_dizzy:
  cmp dword ptr [ebp+0x754], 12
  jne check_bell
  mov ecx, [edx+0x274]
  jmp render_continue
check_bell:
  cmp dword ptr [ebp+0x754], 11
  jne check_funball
  mov ecx, [edx+0x270]
  jmp render_continue
check_funball:
  cmp dword ptr [ebp+0x754], 10
  jne use_default
  mov ecx, [edx+0x26C]
  jmp render_continue
use_default:
  mov ecx, [edx+0x268]
render_continue:
  mov eax, [ecx]
  push ebx
  lea edx, [esp+0x14]
  push edx
  jmp 00402F82

label(original_code)

SpawnCode:
  cmp dword ptr [esi+0x18], 0
  jne original_code
  mov eax, [esi+0x164]
  mov [playerX], eax
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax

  cmp dword ptr [SpawnFunball], 0
  je original_code
  cmp dword ptr [esi+0x18], 0
  jne original_code

  mov dword ptr [SpawnFunball], 0
  mov dword ptr [spawnNow], 1

  push ecx
  push edx
  push ebx

  mov ecx, [esi+0x14]
  mov edx, [ecx+0x29d8]
  mov [ballCount], edx

  mov ecx, [esi+0x14]
  call 0040BCA0

  mov ecx, [esi+0x14]
  mov edx, [ecx+0x29d8]
  cmp edx, [ballCount]
  jle no_new

  mov ebx, [ecx+0x2DE0]
  test ebx, ebx
  jz no_new
  mov ebx, [ebx+edx*4-4]
  test ebx, ebx
  jz no_new

  cmp dword ptr [ebx+0x18], -1
  jne no_new

  mov eax, [playerX]
  mov [ebx+0x164], eax
  mov eax, [playerY]
  mov [ebx+0x168], eax
  mov eax, [playerZ]
  mov [ebx+0x16C], eax
  mov dword ptr [ebx+0x170], 0
  mov dword ptr [ebx+0x174], 0
  mov dword ptr [ebx+0x178], 0

  mov dword ptr [ebx+0x754], 10
  mov dword ptr [ebx+0x284], 0x41D00000
  mov dword ptr [ebx+0xC6C], 0x49742400
  mov dword ptr [ebx+0xC70], 0x49742400
  mov dword ptr [ebx+0xC7C], 0

  mov dword ptr [ebx+0x188], 0x41400000   // master speed = 12.0
  mov eax, [ebx+0x1A4]
  test eax, eax
  jz no_new
  mov dword ptr [eax+0xC70], 0x41880000   // max speed = 17.0
  mov dword ptr [eax+0xC68], 0x3F800000   // drag = 1.0 (default)

no_new:
  mov dword ptr [spawnNow], 0
  pop ebx
  pop edx
  pop ecx

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

alloc(spawnHook, 1000)
spawnHook:
  cmp dword ptr [spawnNow], 0
  je normal_check
  cmp dword ptr [spawnNow], 2
  je stop_spawn
  inc dword ptr [spawnNow]
  jmp 0040BD2D
stop_spawn:
  jmp 0040BEFE
normal_check:
  push 0x7
  push 004CF74C
  push dword ptr [edi]
  call 004C7677
  add esp, 0xC
  test eax, eax
  jnz 0040BEFE
  jmp 0040BD2D

00402F74:
  jmp renderPatch
  nop

0040BD27:
  jmp spawnHook
  nop

00405E22:
  jmp SpawnCode
  nop

[DISABLE]
0040BD27:
  db 0F 85 D1 01 00 00
00405E22:
  db 8B 86 5C 0C 00 00

unregistersymbol(SpawnFunball)
dealloc(SpawnCode)
dealloc(spawnHook)
dealloc(SpawnFunball)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(ballCount)
dealloc(spawnNow)
