{ ============================================================
  First-Person Ball Cam for Hamsterball
  ============================================================
  
  Hook: Scene_SetCamera epilogue (0x41A254)
  
  Camera system overview:
  - Scene+0x87C = camera object pointer
  - Camera vtable[2] (+0x8) = SetPosition(x, y, z) — target position
  - Camera vtable[3] (+0xC) = SetDirection(&vec3, dist) — look dir + distance
  - Ball+0x14 = position (vec3: X,Y,Z at +0x14,+0x18,+0x1C)
  - Ball+0x20 = velocity (vec3: X,Y,Z at +0x20,+0x24,+0x28)
  - Ball+0x3C = radius (float)
  
  This mod replaces the camera position/direction setup with:
  - Camera position: ball_pos + (0, radius + height, 0) — above the ball
  - Camera direction: normalized velocity — where ball is going
  - Camera distance: adjustable (default 1.0, lower = more first-person)
  
  When ball is nearly stationary, direction defaults to (0, 0, 1) — forward.
  
  Adjustable via CE address table (registered symbols):
  - fpCamHeight: height above ball surface (default 10.0)
  - fpCamDist: camera distance from target (default 1.0)
  ============================================================ }

[ENABLE]
alloc(fpCamData, 64)
alloc(newmem, 512)

label(dirX)
label(dirY)
label(dirZ)
label(camX)
label(camY)
label(camZ)
label(fpCamHeight)
label(fpCamDist)
label(minVel)
label(useDefaultDir)
label(computeCamPos)

registersymbol(fpCamHeight)
registersymbol(fpCamDist)

// --- Data section ---
fpCamData:
  dirX: dd 0
  dirY: dd 0
  dirZ: dd 0
  camX: dd 0
  camY: dd 0
  camZ: dd 0
  fpCamHeight: dd 41200000   // 10.0f
  fpCamDist: dd 3F800000     // 1.0f
  minVel: dd 3A83126F       // 0.001f

// --- Code cave ---
// At entry: ESI = Scene*, EDI = Ball*
newmem:
  push eax
  push ecx
  push edx

  // --- Compute look direction from ball velocity ---
  // len = sqrt(vx*vx + vy*vy + vz*vz)
  fld dword ptr [edi+0x20]    // vx
  fmul st(0), st(0)           // vx*vx
  fld dword ptr [edi+0x24]    // vy
  fmul st(0), st(0)           // vy*vy
  faddp                       // vx*vx + vy*vy
  fld dword ptr [edi+0x28]    // vz
  fmul st(0), st(0)           // vz*vz
  faddp                       // vx*vx + vy*vy + vz*vz
  fsqrt                       // st(0) = len

  // If len <= minVel or unordered, use default direction
  fcom dword ptr [minVel]     // compare st(0) with 0.001 (no pop)
  fstsw ax
  test ah, 0x41               // C0 (less than) or C3 (equal/unordered)
  jnz useDefaultDir

  // Normalize: dir = velocity / len
  fld dword ptr [edi+0x20]    // st(0)=vx, st(1)=len
  fdiv st(0), st(1)           // vx/len
  fstp dword ptr [dirX]       // dir.x, pop -> st(0)=len
  fld dword ptr [edi+0x24]    // st(0)=vy, st(1)=len
  fdiv st(0), st(1)           // vy/len
  fstp dword ptr [dirY]       // dir.y, pop -> st(0)=len
  fld dword ptr [edi+0x28]    // st(0)=vz, st(1)=len
  fdiv st(0), st(1)           // vz/len
  fstp dword ptr [dirZ]       // dir.z, pop -> st(0)=len
  fstp st(0)                  // pop len, FPU empty
  jmp computeCamPos

useDefaultDir:
  fstp st(0)                  // pop len, FPU empty
  mov dword ptr [dirX], 0
  mov dword ptr [dirY], 0
  mov dword ptr [dirZ], 3F800000  // 1.0f (look forward +Z)

computeCamPos:
  // Camera position = ball_pos + (0, radius + height, 0)
  mov eax, [edi+0x14]         // ball.x
  mov [camX], eax
  fld dword ptr [edi+0x18]     // ball.y
  fadd dword ptr [edi+0x3C]   // + radius
  fadd dword ptr [fpCamHeight] // + height offset
  fstp dword ptr [camY]        // cam.y
  mov eax, [edi+0x1C]         // ball.z
  mov [camZ], eax

  // camera->SetPosition(camX, camY, camZ)  [vtable+0x8, __thiscall]
  mov ecx, [esi+0x87C]         // camera object
  mov edx, [ecx]               // vtable
  push dword ptr [camZ]        // push Z
  push dword ptr [camY]        // push Y
  push dword ptr [camX]        // push X
  call dword ptr [edx+0x8]     // SetPosition (callee cleanup RET 0xC)

  // camera->SetDirection(&dir_vec, dist)  [vtable+0xC, __thiscall]
  mov ecx, [esi+0x87C]         // camera object
  mov edx, [ecx]               // vtable
  push dword ptr [fpCamDist]   // push distance
  lea eax, [dirX]              // &dir_vec
  push eax                     // push &dir_vec
  call dword ptr [edx+0xC]     // SetDirection (callee cleanup RET 0x8)

  pop edx
  pop ecx
  pop eax

  // Continue to ApplyCamera: graphics->vtable[1](camera)
  jmp 0041A2BF

// --- Hook: 5-byte JMP at Scene_SetCamera epilogue ---
// Original bytes: 8B 44 24 14 8B (MOV EAX,[ESP+0x14]; first byte of MOV ECX)
0041A254:
  jmp newmem

[DISABLE]
// Restore original 5 bytes
0041A254:
  db 8B 44 24 14 8B

dealloc(newmem)
dealloc(fpCamData)
unregistersymbol(fpCamHeight)
unregistersymbol(fpCamDist)
