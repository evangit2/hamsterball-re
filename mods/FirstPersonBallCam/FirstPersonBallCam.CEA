{ ============================================================
  First-Person Ball Cam for Hamsterball — v4 (Simple)
  ============================================================

  HOOK: Scene_SetCamera epilogue at 0x41A254
  JUMP-BACK: 0x41A25E (let original SetPosition/SetDirection run)

  APPROACH: Don't call vtable functions ourselves.
  Instead, modify the INPUTS the original camera code uses:
  1. Overwrite camera target (stack locals) with ball position
  2. Set orbit distance (scene+0x29C0) to 1.0 (camera at ball)
  3. Set orbit angle (scene+0x29BC) to 0 (facing +Z, sin=0, cos=1)
  Then let the original SetPosition + SetDirection calls run unmodified.

  This is much safer than calling vtable functions ourselves.

  Adjustable via CE address table:
  - fpCamHeight: extra height above ball (default 0.0 = at ball center)
  - fpCamDist: orbit distance (default 1.0 = essentially at ball)
  ============================================================ }

[ENABLE]
alloc(fpCamData, 64)
alloc(newmem, 256)

label(fpCamHeight)
label(fpCamDist)

registersymbol(fpCamHeight)
registersymbol(fpCamDist)

// --- Data section ---
fpCamData:
  fpCamHeight: dd 00000000     // 0.0f (extra height above ball center)
  fpCamDist: dd 3F800000       // 1.0f (orbit distance, ~0 = at ball)

// --- Code cave ---
// At entry: ESI = Scene*, EDI = Ball*
// Stack: [ESP+0xC]=local_24(X), [ESP+0x10]=local_20(Y), [ESP+0x14]=local_1c(Z)
// These are the camera target values that original code pushes to SetPosition.
newmem:
  push eax

  // --- Overwrite camera target with exact ball position ---
  // After push eax, ESP shifts by 4. Original ESP+0xC is now ESP+0x10, etc.
  mov eax, [edi+0x14]          // ball.x
  mov [esp+0x10], eax           // overwrite local_24 (target X)
  mov eax, [edi+0x18]          // ball.y
  mov [esp+0x14], eax           // overwrite local_20 (target Y)
  mov eax, [edi+0x1C]          // ball.z
  mov [esp+0x18], eax           // overwrite local_1c (target Z)

  // --- Set orbit distance to fpCamDist (default 1.0 = at ball) ---
  mov eax, [fpCamDist]
  mov [esi+0x29C0], eax

  // --- Set orbit angle to 0 (sin=0, cos=1, looking +Z) ---
  // This makes direction = {0, 0.9, 1}, so camera is directly behind ball on Z axis.
  // TODO: Replace with atan2(vx, vz) for velocity-facing camera.
  mov dword ptr [esi+0x29BC], 0

  pop eax

  // Execute the original instructions we overwrote (2 bytes at 0x41A254)
  // Original: MOV EAX, [ESP+0x14]  (8B 44 24 14)
  //           MOV ECX, [ESI+0x87C] (8B 8E 7C 08 00 00)
  mov eax, [esp+0x14]
  mov ecx, [esi+0x87C]

  // Continue with original SetPosition + SetDirection + ApplyCamera
  jmp 0041A25E

// --- Hook: 5-byte JMP at Scene_SetCamera epilogue ---
0041A254:
  jmp newmem

[DISABLE]
0041A254:
  db 8B 44 24 14 8B

dealloc(newmem)
dealloc(fpCamData)
unregistersymbol(fpCamHeight)
unregistersymbol(fpCamDist)
