// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v10 — Pitch black + ALL player balls glow white
//
// ROOT CAUSE (why v9 didn't work):
// v9's Hook 3 called SetMaterial(white_emissive) at Ball_RenderAI entry.
// BUT inside Ball_RenderAI, the mesh draw calls Graphics_ApplyMaterialAndDraw
// (0x455110) which calls SetMaterial AGAIN with the ball's original material
// — OVERRIDING the white emissive! The ball never glowed.
//
// v10 FIX:
// Use gfx+0x7C0 (custom material override pointer). Graphics_ApplyMaterialAndDraw
// checks gfx+0x7C0 FIRST — if non-NULL, it uses that material instead of the
// ball's default. By setting gfx+0x7C0 = g_GlowMaterial (white emissive) before
// ball render and clearing it after, the ball renders with white emissive while
// scene objects use their own materials (which have no emissive = black).
//
// D3D lighting formula (LIGHTING=1, no lights, ambient=0):
//   FinalColor = Diffuse×0 + Ambient_material×0 + Emissive
// Scene objects: 0 + 0 + 0 = BLACK
// Ball: 0 + 0 + white_emissive = WHITE GLOW
//
// HOOKS:
// 1. Ball_Update (0x405E22): gfx+0x730=0 (dark ambient) every frame
// 2. After light loop (0x454C97): LightEnable(0..7, FALSE) — disable all lights
// 3. Ball_RenderAI entry (0x403DC0): gfx+0x7C0=g_GlowMaterial + AMBIENT=white
// 4. Ball_RenderAI exit (0x4050D9): gfx+0x7C0=0 + AMBIENT=0 (restore dark)
//
// MATERIAL OBJECT STRUCTURE (80 bytes = 0x50):
// [0x00] vtable/flags: 0 (unused by SetMaterial)
// [0x04] D3DMATERIAL8.Diffuse (16 bytes)
// [0x14] D3DMATERIAL8.Ambient (16 bytes)
// [0x24] D3DMATERIAL8.Specular (16 bytes)
// [0x34] D3DMATERIAL8.Emissive (16 bytes) ← white = glow!
// [0x44] D3DMATERIAL8.Power (4 bytes)
// [0x48] texture info: 0 (NULL = no texture, simple render path)
// [0x4C] blend flag: 0
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 256)
alloc(neon_lights_off, 256)
alloc(neon_glow_entry, 512)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_GlowMaterial, 80)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// Material object (80 bytes):
// gfx+0x7C0 points here. Graphics_ApplyMaterialAndDraw reads:
//   this_00[0x12] (offset 0x48) = texture info → 0 = no texture (simple path)
//   this_00[0x13] (offset 0x4C) = blend flag → 0
//   SetMaterial(device, this_00 + 1) → D3DMATERIAL8 at offset 0x04
g_GlowMaterial:
  dd 00000000                                          // [0x00] vtable/flags
  dd 3F800000 3F800000 3F800000 3F800000              // [0x04] Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000              // [0x14] Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000              // [0x24] Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000              // [0x34] Emissive: 1,1,1,1
  dd 00000000                                          // [0x44] Power: 0
  dd 00000000                                          // [0x48] texture: NULL
  dd 00000000                                          // [0x4C] blend: 0

label(skip_dark)
label(skip_lights)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — ESI = ball
// Sets gfx+0x730=0 (dark ambient) + fog + SetRenderState(AMBIENT, 0)
// Original: mov eax, [esi+0x00000C5C] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]          // ball+0x10 = App
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]         // App+0x174 = gfx
  test eax, eax
  jz skip_dark

  // Zero ambient + enable fog + black fog color
  mov dword ptr [eax+0x730], 0
  mov byte ptr [eax+0x734], 1
  mov dword ptr [eax+0x738], 0

  // SetRenderState(AMBIENT=0x8B, 0) on D3D device
  mov edx, [eax+0x154]         // gfx+0x154 = D3D device
  test edx, edx
  jz skip_dark
  mov ecx, [edx]               // vtable
  push 0                       // value = 0
  push 8B                      // state = D3DRS_AMBIENT
  push edx                     // device
  call dword ptr [ecx+0xC8]    // SetRenderState — clobbers EAX/ECX/EDX

skip_dark:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]    // original instruction
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: After light loop (0x454C97) — EBP = gfx
// Disable all 8 directional lights via LightEnable(0..7, FALSE)
// Original: MOV ESI, [EBP+0x730] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_lights_off:
  push eax
  push ecx
  push edx
  push esi

  mov eax, [ebp+0x154]         // D3D device
  test eax, eax
  jz skip_lights
  mov edx, [eax]               // vtable

  xor esi, esi                  // light index 0..7

neon_lights_loop:
  push 0                       // FALSE = disable
  push esi                      // light index
  push eax                      // device
  call dword ptr [edx+0xB0]    // LightEnable — clobbers EAX/ECX/EDX

  mov eax, [ebp+0x154]         // reload device (clobbered by stdcall)
  mov edx, [eax]               // reload vtable
  inc esi
  cmp esi, 8
  jl neon_lights_loop

skip_lights:
  pop esi
  pop edx
  pop ecx
  pop eax

  mov esi, [ebp+0x730]         // original instruction
  jmp 00454C9D

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Ball_RenderAI entry (0x403DC0) — ECX = ball (__thiscall)
// Sets gfx+0x7C0 = g_GlowMaterial (white emissive override)
// + SetRenderState(AMBIENT, white) for ball rendering
// Original: push -1; mov eax, fs:[0] (8 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx
  push esi

  // ECX = ball. ball+0x10 = App, App+0x174 = gfx
  mov eax, [ecx+0x10]
  test eax, eax
  jz skip_glow_entry
  mov esi, [eax+0x174]         // gfx
  test esi, esi
  jz skip_glow_entry
  mov [g_GfxDevice], esi        // save for exit hook

  // Set gfx+0x7C0 = g_GlowMaterial (material override)
  // Graphics_ApplyMaterialAndDraw checks this FIRST;
  // if non-NULL, uses this material instead of the ball's default
  mov dword ptr [esi+0x7C0], g_GlowMaterial

  // SetRenderState(AMBIENT=0x8B, 0xFFFFFFFF) — white ambient for ball
  mov edx, [esi+0x154]         // D3D device
  test edx, edx
  jz skip_glow_entry
  mov eax, [edx]               // vtable
  push FFFFFFFF                 // value = white
  push 8B                       // state = D3DRS_AMBIENT
  push edx                      // device
  call dword ptr [eax+0xC8]    // SetRenderState — clobbers

skip_glow_entry:
  pop esi
  pop edx
  pop ecx
  pop eax
  // Original instructions: push -1; mov eax, fs:[0]
  push -1
  mov eax, fs:[0]
  jmp 00403DC8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 4: Ball_RenderAI exit (0x4050D9) — restore dark scene
// Clears gfx+0x7C0 (remove material override)
// + SetRenderState(AMBIENT, 0) (restore dark ambient)
// Original: MOV ECX, [ESP+0x12C] (7 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]        // gfx (saved by entry hook)
  test ecx, ecx
  jz skip_glow_exit

  // Clear material override so scene objects use their own materials
  mov dword ptr [ecx+0x7C0], 0

  // SetRenderState(AMBIENT=0x8B, 0) — restore dark ambient
  mov edx, [ecx+0x154]         // D3D device
  test edx, edx
  jz skip_glow_exit
  mov eax, [edx]               // vtable
  push 0                        // value = 0 (black)
  push 8B                       // state = D3DRS_AMBIENT
  push edx                      // device
  call dword ptr [eax+0xC8]    // SetRenderState — clobbers

skip_glow_exit:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]    // original instruction
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

00454C97:
  jmp neon_lights_off
  nop

00403DC0:
  jmp neon_glow_entry
  nop
  nop
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00454C97:
  db 8B B5 30 07 00 00

00403DC0:
  db 6A FF 64 A1 00 00 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_lights_off)
dealloc(neon_dark)
dealloc(g_GlowMaterial)
dealloc(g_GfxDevice)
