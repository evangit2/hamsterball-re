// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v6 — Dark scene + glowing ball
// CRASH FIX: D3D __stdcall calls clobber EAX/ECX/EDX. Reload after each call.
// No LIGHTING changes — just dark ambient + SetMaterial(white emissive).
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 256)
alloc(neon_glow_entry, 512)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_WhiteMaterial, 68)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// D3DMATERIAL8: white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(skip_neon)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — dark ambient + fog
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]
  test eax, eax
  jz skip_neon
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_neon

  // Write dark values to gfx struct
  mov dword ptr [eax+0x730], 0      // ambient = black
  mov byte ptr [eax+0x734], 1       // fog enabled
  mov dword ptr [eax+0x738], 0      // fog color = black

  // SetRenderState(AMBIENT, 0) on D3D device
  mov edx, [eax+0x154]               // EDX = D3D device (save in EDX before clobber)
  test edx, edx
  jz skip_neon
  mov ecx, [edx]                     // ECX = vtable
  push 0
  push 8B
  push edx
  call dword ptr [ecx+0xC8]         // SetRenderState — clobbers EAX/ECX/EDX

skip_neon:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: Player Render Entry (0x403DDF) — SetMaterial + white ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx

  mov eax, [ebp+0x10]
  test eax, eax
  jz skip_glow_entry
  mov ecx, [eax+0x174]
  test ecx, ecx
  jz skip_glow_entry
  mov [g_GfxDevice], ecx             // save gfx for exit hook

  // SetMaterial(white emissive)
  mov edx, [ecx+0x154]               // EDX = D3D device
  test edx, edx
  jz skip_glow_entry
  mov eax, [edx]                     // EAX = vtable
  push g_WhiteMaterial
  push edx
  call dword ptr [eax+0xA8]         // SetMaterial — clobbers EAX/ECX/EDX

  // SetRenderState(AMBIENT, white) — reload after clobber
  mov ecx, [g_GfxDevice]             // reload gfx
  mov edx, [ecx+0x154]              // reload D3D device
  mov eax, [edx]                     // reload vtable
  push FFFFFFFF
  push 8B
  push edx
  call dword ptr [eax+0xC8]         // SetRenderState — clobbers

skip_glow_entry:
  pop edx
  pop ecx
  pop eax
  mov eax, [ebp+0x10]
  mov ecx, [eax+0x174]
  jmp 00403DE8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Render Exit (0x4050D9) — restore dark ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  mov edx, [ecx+0x154]               // D3D device
  test edx, edx
  jz skip_glow_exit
  mov eax, [edx]                     // vtable
  push 0
  push 8B
  push edx
  call dword ptr [eax+0xC8]         // SetRenderState(AMBIENT, 0) — clobbers

skip_glow_exit:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_cave
  nop

00403DDF:
  jmp neon_glow_entry
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00403DDF:
  db 8B 45 10 8B 88 74 01 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_cave)
dealloc(g_WhiteMaterial)
dealloc(g_GfxDevice)
