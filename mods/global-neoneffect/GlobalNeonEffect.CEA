// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v5 — Dark scene + glowing ball
// Fixes: v4 crashed from disabling D3DRS_LIGHTING globally.
//
// v5 approach: Don't disable lighting. Just set dark ambient + fog.
// Use SetMaterial(white emissive) for ball glow.
// Emissive works even with dark ambient — self-illumination.
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 256)
alloc(neon_glow_entry, 256)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_WhiteMaterial, 68)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// D3DMATERIAL8: white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(skip_neon)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — dark ambient + fog
// ESI = ball
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]
  test eax, eax
  jz skip_neon
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_neon

  // Write dark values to gfx struct
  mov dword ptr [eax+0x730], 0      // ambient = black
  mov byte ptr [eax+0x734], 1       // fog enabled
  mov dword ptr [eax+0x738], 0      // fog color = black

  // Also call SetRenderState(AMBIENT, 0) on D3D device
  mov eax, [eax+0x154]
  test eax, eax
  jz skip_neon
  mov edx, [eax]
  push 0
  push 8B
  push eax
  call dword ptr [edx+C8]

skip_neon:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: Player Render Entry (0x403DDF) — SetMaterial + white ambient
// EBP = ball
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx

  mov eax, [ebp+0x10]
  test eax, eax
  jz skip_glow_entry
  mov ecx, [eax+0x174]
  test ecx, ecx
  jz skip_glow_entry
  mov [g_GfxDevice], ecx

  // SetMaterial(white emissive)
  mov eax, [ecx+0x154]
  test eax, eax
  jz skip_glow_entry
  mov edx, [eax]
  push g_WhiteMaterial
  push eax
  call dword ptr [edx+0xA8]

  // SetRenderState(AMBIENT, white)
  push FFFFFFFF
  push 8B
  push eax
  call dword ptr [edx+C8]

skip_glow_entry:
  pop edx
  pop ecx
  pop eax

  // Original instructions (9 bytes)
  mov eax, [ebp+0x10]
  mov ecx, [eax+0x174]
  jmp 00403DE8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Render Exit (0x4050D9) — restore dark ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  mov eax, [ecx+0x154]
  test eax, eax
  jz skip_glow_exit
  mov edx, [eax]

  // SetRenderState(AMBIENT, 0)
  push 0
  push 8B
  push eax
  call dword ptr [edx+C8]

skip_glow_exit:
  pop edx
  pop ecx
  pop eax

  // Original instruction
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_cave
  nop

00403DDF:
  jmp neon_glow_entry
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00403DDF:
  db 8B 45 10 8B 88 74 01 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_cave)
dealloc(g_WhiteMaterial)
dealloc(g_GfxDevice)
