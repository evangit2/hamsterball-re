// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v18 — Pitch-black scene via proven hook + fog fix
//
// v16: Hook at 0x405E22 (Ball_Update) WORKED — background went black.
//      BUG: gfx+0x734=0 DISABLED FOG. Scene geometry stayed fully lit.
//      User saw: "only changes the background color."
//
// v17: Moved hook to 0x454C97 (Graphics_RenderScene). HOOK DIDN'T FIRE.
//      User saw: "nothing changes at all, literally nothing."
//
// v18: Back to v16's PROVEN hook point (0x405E22). Fix the ONE bug:
//      gfx+0x734=1 (FOG ENABLED) instead of 0 (FOG DISABLED).
//      With fog enabled + black fog color, distant geometry fades to
//      black. Ball appears bright by contrast = NEON GLOW.
//
// HOW NEON RACE WORKS (traced from binary):
//   - Scene_SetupLevelDark (0x416270) loads LevelDark.MESHWORLD (dark textures)
//   - Level_InitScene (0x40B090) picks RANDOM ambient + fog via Color_RandomRGBA()
//   - Graphics_RenderScene (0x454BC0) calls SetRenderState every frame:
//       0x454C97: SetRenderState(AMBIENT=0x8B, gfx+0x730)
//       0x454CB2: SetRenderState(FOGENABLE=0x1C, gfx+0x734)
//       0x454CEE: SetRenderState(FOGCOLOR=0x22, gfx+0x738)
//   - Ball_InitRenderState (0x402860) sets LIGHTING=TRUE for ball
//   - Ball "glows" by contrast: lit by directional lights against dark scene
//   - Game description: "YOUR HAMSTER GIVES OFF SOME GLOW OF HIS OWN"
//
// v18 writes to cached gfx values in Ball_Update (runs per-frame before
// RenderScene). RenderScene picks up our values via its own SetRenderState
// calls. NO stdcall from our cave = NO freeze risk.
//
// REGISTER SAFETY:
//   ESI = callee-preserved (ball pointer survives)
//   EAX = saved/restored (push/pop)
//   NO call instructions → NO register clobbering
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 128)

label(skip_dark)

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update (0x405E22) — ESI = ball (PROVEN in v16)
// Original: mov eax, [esi+0x00000C5C] (6 bytes: 8B 86 5C 0C 00 00)
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax

  // ball+0x10 = App
  mov eax, [esi+0x10]
  test eax, eax
  jz skip_dark

  // App+0x174 = gfx
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_dark

  // gfx+0x730 = 0 (AMBIENT = BLACK)
  // Game calls SetRenderState(0x8B, [gfx+0x730]) at 0x454CAC
  mov dword ptr [eax+0x730], 0

  // gfx+0x738 = 0xFF000000 (FOG COLOR = BLACK)
  // Game calls SetRenderState(0x22, [gfx+0x738]) at 0x454D00
  mov dword ptr [eax+0x738], 0FF000000h

  // gfx+0x734 = 1 (FOG ENABLE = TRUE) *** v16 BUG FIX ***
  // v16 wrote 0 here → FOG DISABLED → scene stayed fully lit
  // Game calls SetRenderState(0x1C, [gfx+0x734]) at 0x454CCD
  // With fog=TRUE + fogcolor=BLACK, distant geometry fades to black
  mov byte ptr [eax+0x734], 1

skip_dark:
  pop eax
  mov eax, [esi+0x00000C5C]    // original instruction
  jmp 00405E28

// ── Install hook ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(neon_dark)
