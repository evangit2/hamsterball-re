// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v9 — Pitch black + ALL player balls glow
//
// ROOT CAUSE (why v8 didn't work):
// 1. LIGHTING=0 makes D3D IGNORE materials entirely. Emissive is only
//    applied when LIGHTING=1. v8's wrapper set LIGHTING=0 which
//    disabled the emissive glow.
// 2. v8 hooks at 0x403DDF/0x4050D9 only fire inside Ball_Render (player).
//    But they didn't set the material correctly because LIGHTING was off.
//
// v9 FIX:
// - Keep LIGHTING=1 globally (never disable it)
// - Disable all 8 directional lights via LightEnable(0..7, FALSE)
// - Set gfx+0x730=0 (ambient) so scene renders black
// - Hook Ball_Render (0x403DC0) entry: SetMaterial(white emissive) +
//   SetRenderState(AMBIENT, white) → ball glows
// - Hook Ball_Render exit (0x4050D9): SetRenderState(AMBIENT, 0)
//   → scene stays dark
//
// D3D lighting formula (LIGHTING=1):
//   FinalColor = Material.Diffuse × Light + Material.Ambient × AmbientState + Material.Emissive
// Scene objects: Diffuse×0(lights off) + Ambient×0(ambient=0) + Emissive×0 = BLACK
// Ball: Diffuse×0 + Ambient(white)×white(ambient=white) + Emissive(white) = WHITE GLOW
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 256)
alloc(neon_lights_off, 256)
alloc(neon_glow_entry, 512)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_WhiteMaterial, 68)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// D3DMATERIAL8: white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(skip_dark)
label(skip_lights)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — dark ambient + fog
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_dark

  mov dword ptr [eax+0x730], 0
  mov byte ptr [eax+0x734], 1
  mov dword ptr [eax+0x738], 0

  mov edx, [eax+0x154]
  test edx, edx
  jz skip_dark
  mov ecx, [edx]
  push 0
  push 8B
  push edx
  call dword ptr [ecx+0xC8]

skip_dark:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: After light loop (0x454C97) — disable all 8 lights
// EBP = gfx device
// Original: MOV ESI, [EBP+0x730] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_lights_off:
  push eax
  push ecx
  push edx
  push esi

  mov eax, [ebp+0x154]
  test eax, eax
  jz skip_lights
  mov edx, [eax]

  xor esi, esi

neon_lights_loop:
  push 0
  push esi
  push eax
  call dword ptr [edx+0xB0]      // LightEnable — clobbers

  mov eax, [ebp+0x154]           // reload
  mov edx, [eax]
  inc esi
  cmp esi, 8
  jl neon_lights_loop

skip_lights:
  pop esi
  pop edx
  pop ecx
  pop eax

  mov esi, [ebp+0x730]
  jmp 00454C9D

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Ball_Render entry (0x403DC0) — ECX = ball (__thiscall)
// Set SetMaterial(white emissive) + SetRenderState(AMBIENT, white)
// Original: push -1; mov eax, fs:[0] (8 bytes total)
// JMP (5) + 3 NOP = 8 bytes, jump back to 0x403DC8
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx
  push esi

  // ECX = ball. ball+0x10 = App, App+0x174 = gfx
  mov eax, [ecx+0x10]
  test eax, eax
  jz skip_glow_entry
  mov esi, [eax+0x174]
  test esi, esi
  jz skip_glow_entry
  mov [g_GfxDevice], esi

  // SetMaterial(white emissive)
  mov edx, [esi+0x154]
  test edx, edx
  jz skip_glow_entry
  mov eax, [edx]
  push g_WhiteMaterial
  push edx
  call dword ptr [eax+0xA8]     // SetMaterial — clobbers

  // SetRenderState(AMBIENT, white) — reload
  mov esi, [g_GfxDevice]
  mov edx, [esi+0x154]
  mov eax, [edx]
  push FFFFFFFF
  push 8B
  push edx
  call dword ptr [eax+0xC8]     // SetRenderState — clobbers

skip_glow_entry:
  pop esi
  pop edx
  pop ecx
  pop eax
  // Original instructions: push -1; mov eax, fs:[0]
  push -1
  mov eax, fs:[0]
  jmp 00403DC8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 4: Ball_Render exit (0x4050D9) — restore dark ambient
// Original: MOV ECX, [ESP+0x12C] (7 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  mov edx, [ecx+0x154]
  test edx, edx
  jz skip_glow_exit
  mov eax, [edx]
  push 0
  push 8B
  push edx
  call dword ptr [eax+0xC8]     // SetRenderState(AMBIENT, 0)

skip_glow_exit:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

00454C97:
  jmp neon_lights_off
  nop

00403DC0:
  jmp neon_glow_entry
  nop
  nop
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00454C97:
  db 8B B5 30 07 00 00

00403DC0:
  db 6A FF 64 A1 00 00 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_lights_off)
dealloc(neon_dark)
dealloc(g_WhiteMaterial)
dealloc(g_GfxDevice)
