// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v27 — Vertex fog + cached gfx values + dim ambient
// ═══════════════════════════════════════════════════════════════════════
//
// v26 PROBLEM: Fog not visible. Two likely causes:
//   1. Table fog (FOGTABLEMODE) needs pixel-level GPU support — may be
//      silently ignored. Vertex fog (FOGVERTEXMODE) is computed per-vertex
//      and works on all GPUs.
//   2. Only called SetRenderState — didn't write to gfx struct's cached
//      values (gfx+0x730/0x734/0x738/0x73C/0x740). The game reads these
//      cached values during rendering. Writing to them ensures the game's
//      own rendering code uses our values.
//
// v27 APPROACH:
//   1. Write gfx cached values: ambient=dim gray, fog=enable+black+200..1000
//   2. Call SetRenderState for immediate D3D effect (all 7 states)
//   3. Use VERTEX fog (not table fog) for GPU compatibility
//   4. Ambient = 0xFF202020 (dim gray, ~12% brightness — NOT pure black)
//   5. Fog start=200, end=1000 (camera is ~800-1100 units from ball)
//
// GFX STRUCT CACHED VALUES (from RenderScene 0x454BC0 disassembly):
//   gfx+0x730 = DWORD  ambient color     (applied via SetRenderState 0x8B)
//   gfx+0x734 = BYTE   fog enable flag   (applied via SetRenderState 0x1C)
//   gfx+0x738 = DWORD  fog color          (applied via SetRenderState 0x22)
//   gfx+0x73C = FLOAT  fog start          (applied via SetRenderState 0x24)
//   gfx+0x740 = FLOAT  fog end            (applied via SetRenderState 0x25)
//
// HOOK: Graphics_BeginFrame (0x453B50) — called every frame
//   Hook at 0x453B63: MOV EAX,[EBX+0x154] (6 bytes: 8B 83 54 01 00 00)
//   EBX = gfx (set at 0x453B51: MOV EBX,ECX)
//
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 512)

label(neon_skip)

// ═══════════════════════════════════════════════════════════════════════
// CODE CAVE: Hook at 0x453B63 (inside Graphics_BeginFrame)
// EBX = gfx (set at 0x453B51: MOV EBX,ECX)
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  pushfd
  pushad

  // ── Write gfx cached values ─────────────────────────────────────
  // gfx+0x730 = ambient color (DWORD)
  mov dword ptr [ebx+0x730], 0FF202020

  // gfx+0x734 = fog enable (BYTE = 1)
  mov byte ptr [ebx+0x734], 01

  // gfx+0x738 = fog color (DWORD = black)
  mov dword ptr [ebx+0x738], 0FF000000

  // gfx+0x73C = fog start (FLOAT = 200.0 = 0x43480000)
  mov dword ptr [ebx+0x73C], 43480000

  // gfx+0x740 = fog end (FLOAT = 1000.0 = 0x447A0000)
  mov dword ptr [ebx+0x740], 447A0000

  // ── Get D3D device wrapper ──────────────────────────────────────
  mov eax, [ebx+0x154]       // gfx+0x154 = D3D device wrapper
  test eax, eax
  jz neon_skip
  mov edi, eax               // EDI = device (saved by PUSHAD)

  // ── Enable fog ──────────────────────────────────────────────────
  // SetRenderState(D3DRS_FOGENABLE=0x1C, TRUE=1)
  push 1
  push 1C
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Vertex fog = LINEAR (computed per-vertex, works on all GPUs) ──
  // SetRenderState(D3DRS_FOGVERTEXMODE=0x8C, D3DFOG_LINEAR=3)
  push 3
  push 8C
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Disable table fog (use vertex fog only) ────────────────────
  // SetRenderState(D3DRS_FOGTABLEMODE=0x23, D3DFOG_NONE=0)
  push 0
  push 23
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog start = 200.0 ───────────────────────────────────────────
  // SetRenderState(D3DRS_FOGSTART=0x24, 200.0f=0x43480000)
  push 43480000
  push 24
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog end = 1000.0 ────────────────────────────────────────────
  // SetRenderState(D3DRS_FOGEND=0x25, 1000.0f=0x447A0000)
  // ADJUST: 43FA0000=500(near), 447A0000=1000(default), 44FA0000=2000(far)
  push 447A0000
  push 25
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog color = black ──────────────────────────────────────────
  // SetRenderState(D3DRS_FOGCOLOR=0x22, 0xFF000000)
  push 0FF000000
  push 22
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Ambient = dim gray (NOT black — v25 bug) ───────────────────
  // SetRenderState(D3DRS_AMBIENT=0x8B, 0xFF202020)
  // 0x20=32 → ~12% brightness. Game lighting still works on top of this.
  push 0FF202020
  push 8B
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

neon_skip:
  popad
  popfd

  // ── Original instruction ────────────────────────────────────────
  // MOV EAX, [EBX+0x154] — load D3D device wrapper
  mov eax, [ebx+0x154]

  // ── Return to next instruction ──────────────────────────────────
  jmp 00453B69

// ═══════════════════════════════════════════════════════════════════════
// INSTALL HOOK
// ═══════════════════════════════════════════════════════════════════════

// Hook at 0x453B63: MOV EAX,[EBX+0x154] (6 bytes: 8B 83 54 01 00 00)
// Replace with: JMP neon_cave (5 bytes) + NOP (1 byte) = 6 bytes
00453B63:
  jmp neon_cave
  nop

[DISABLE]

// Restore original instruction at 0x453B63
// MOV EAX, [EBX+0x154] = 8B 83 54 01 00 00
00453B63:
  db 8B 83 54 01 00 00

dealloc(neon_cave)
