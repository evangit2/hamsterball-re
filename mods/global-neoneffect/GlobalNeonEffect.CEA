// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v8 — Pitch black + glowing ball
//
// FIX: Hook 2 moved from 0x454BD1 (after SetupLights, BEFORE light loop)
//      to 0x454C97 (AFTER light loop). Lights are re-enabled by the
//      8 light objects at gfx+0x710 which run AFTER Graphics_SetupLights.
//      Now we disable them AFTER they're all set up.
//
// HOOKS:
//   1. Ball_Update (0x405E22) — gfx+0x730=0 + fog + SetRenderState(AMBIENT,0)
//   2. After light loop (0x454C97) — LightEnable(0..7, FALSE)
//   3. Player Render Entry (0x403DDF) — SetMaterial(white emissive) + AMBIENT=white
//   4. Player Render Exit (0x4050D9) — AMBIENT=0
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 256)
alloc(neon_lights_off, 256)
alloc(neon_glow_entry, 512)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_WhiteMaterial, 68)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// D3DMATERIAL8: white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(skip_dark)
label(skip_lights)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — dark ambient + fog
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_dark

  mov dword ptr [eax+0x730], 0
  mov byte ptr [eax+0x734], 1
  mov dword ptr [eax+0x738], 0

  mov edx, [eax+0x154]
  test edx, edx
  jz skip_dark
  mov ecx, [edx]
  push 0
  push 8B
  push edx
  call dword ptr [ecx+0xC8]

skip_dark:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: After light loop (0x454C97) — disable all 8 lights
// EBP = gfx device
// Original instruction: MOV ESI, [EBP+0x730] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_lights_off:
  push eax
  push ecx
  push edx
  push esi

  mov eax, [ebp+0x154]
  test eax, eax
  jz skip_lights
  mov edx, [eax]

  xor esi, esi

neon_lights_loop:
  push 0
  push esi
  push eax
  call dword ptr [edx+0xB0]      // LightEnable — clobbers

  mov eax, [ebp+0x154]           // reload
  mov edx, [eax]
  inc esi
  cmp esi, 8
  jl neon_lights_loop

skip_lights:
  pop esi
  pop edx
  pop ecx
  pop eax

  // Original instruction
  mov esi, [ebp+0x730]
  jmp 00454C9D

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Render Entry (0x403DDF) — SetMaterial + white ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx

  mov eax, [ebp+0x10]
  test eax, eax
  jz skip_glow_entry
  mov ecx, [eax+0x174]
  test ecx, ecx
  jz skip_glow_entry
  mov [g_GfxDevice], ecx

  // SetMaterial(white emissive)
  mov edx, [ecx+0x154]
  test edx, edx
  jz skip_glow_entry
  mov eax, [edx]
  push g_WhiteMaterial
  push edx
  call dword ptr [eax+0xA8]     // SetMaterial — clobbers

  // SetRenderState(AMBIENT, white) — reload
  mov ecx, [g_GfxDevice]
  mov edx, [ecx+0x154]
  mov eax, [edx]
  push FFFFFFFF
  push 8B
  push edx
  call dword ptr [eax+0xC8]     // SetRenderState — clobbers

skip_glow_entry:
  pop edx
  pop ecx
  pop eax
  mov eax, [ebp+0x10]
  mov ecx, [eax+0x174]
  jmp 00403DE8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 4: Player Render Exit (0x4050D9) — restore dark ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  mov edx, [ecx+0x154]
  test edx, edx
  jz skip_glow_exit
  mov eax, [edx]
  push 0
  push 8B
  push edx
  call dword ptr [eax+0xC8]     // SetRenderState(AMBIENT, 0)

skip_glow_exit:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

00454C97:
  jmp neon_lights_off
  nop

00403DDF:
  jmp neon_glow_entry
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00454C97:
  db 8B B5 30 07 00 00

00403DDF:
  db 8B 45 10 8B 88 74 01 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_lights_off)
dealloc(neon_dark)
dealloc(g_WhiteMaterial)
dealloc(g_GfxDevice)
