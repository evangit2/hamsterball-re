// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v21 — Dark ambient, NO fog, ball visible via lights
//
// ═══════════════════════════════════════════════════════════════════════
// ROOT CAUSE OF v19/v20 FAILURE: FOG WAS THE PROBLEM!
//
// v19/v20 enabled fog with FOGSTART=0, FOGEND=500. In Hamsterball levels,
// the camera is typically 800-1200 units from geometry. With FOGEND=500,
// EVERYTHING beyond 500 units is pure black. This caused most of the
// scene to disappear into black void, leaving only nearby flat geometry.
//
// The actual Neon Race does NOT use fog! Its dark look comes from:
//   - Dark ambient color (MESHWORLD Section 4 background)
//   - Directional lights still illuminating geometry
//   - Ball visible because it's lit by scene lights
//
// v21 approach:
//   1. gfx+0x730 = 0xFF000000 (AMBIENT = pure black, alpha=255)
//      → Removes ambient light, making the scene dark
//      → Directional lights still work (set by Graphics_SetupLights)
//   2. gfx+0x734 = 0 (FOGENABLE = FALSE) ← KEY FIX: disable fog!
//   3. gfx+0x738 = 0xFF000000 (FOGCOLOR = black, irrelevant if fog off)
//   4. Remove ALL direct SetRenderState calls — not needed!
//      The game applies gfx+0x730/734/738 via Graphics_RenderScene.
//      No need for FOGVERTEXMODE, FOGTABLEMODE, FOGSTART, FOGEND.
//      No need for EMISSIVEMATERIALSOURCE or COLORVERTEX.
//      The ball will be visible because LIGHTING=TRUE (set by
//      Ball_InitRenderState) and directional lights still illuminate it.
//
// D3D8 render state IDs (verified against d3d8types.h):
//   0x8B = 139 = D3DRS_AMBIENT (gfx+0x730, applied by Graphics_RenderScene)
//   0x1C = 28  = D3DRS_FOGENABLE (gfx+0x734)
//   0x22 = 34  = D3DRS_FOGCOLOR (gfx+0x738)
//
// Graphics_RenderScene (0x454BC0) at 0x454CAC:
//   SetRenderState(0x8B, [gfx+0x730])  → AMBIENT
//   SetRenderState(0x1C, [gfx+0x734])  → FOGENABLE
//   SetRenderState(0x22, [gfx+0x738])  → FOGCOLOR
//
// ═══════════════════════════════════════════════════════════════════════
// HOOK SAFETY: Ball_Update (0x405E22) — SEH frame installed at 0x405E0E,
// BEFORE our hook. ECX/EDX clobbered after hook (XOR at 0x405E35/0x405E42).
// EAX saved with PUSH/POP. ESI=callee-preserved (ball pointer).
// No stdcall calls needed — just memory writes to gfx struct!
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 128)

label(neon_skip)
label(neon_done)

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update (0x405E22) — ESI = ball, SEH already set up
// Original: MOV EAX, [ESI+0x00000C5C] (6 bytes: 8B 86 5C 0C 00 00)
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  push eax                    // save EAX (original instruction's target)

  // ── Resolve gfx pointer ──────────────────────────────────────────
  mov eax, [esi+0x10]         // ball+0x10 = App
  test eax, eax
  jz neon_skip
  mov eax, [eax+0x174]        // App+0x174 = gfx
  test eax, eax
  jz neon_skip

  // ── Write cached values (Graphics_RenderScene applies these) ────
  // gfx+0x730 = 0xFF000000 (AMBIENT = pure black, alpha=255)
  // This removes ambient light → scene becomes dark
  // Directional lights still work (set by Graphics_SetupLights)
  mov dword ptr [eax+0x730], 0FF000000h

  // gfx+0x734 = 0 (FOGENABLE = FALSE) ← KEY: NO fog!
  // v19/v20 had fog enabled with FOGEND=500, which fogged out
  // everything beyond 500 units. Camera is typically 800-1200
  // units away, so entire scene was black. Disabling fog fixes this.
  mov byte ptr [eax+0x734], 0

  // gfx+0x738 = 0xFF000000 (FOGCOLOR = black, irrelevant with fog off)
  mov dword ptr [eax+0x738], 0FF000000h

  jmp neon_done

neon_skip:
  // Null pointer path — just restore EAX

neon_done:
  pop eax                     // restore EAX
  mov eax, [esi+0x00000C5C]  // original instruction
  jmp 00405E28

// ── Install hook ─────────────────────────────────────────────────────
00405E22:
  jmp neon_cave
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(neon_cave)
