// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v2 — Dark ambient + ball glow for ALL races/arenas
// Fixes: crash from +0xC80 on player balls, AOB conflict with shapeshift
//
// HOW NEON RACE WORKS (deep binary trace):
//
//   1. Level_InitScene (0x40B090) calls Color_RandomRGBA (0x40A050) which
//      reads color values from the MESHWORLD collision data (Section 4).
//      For LevelDark.MESHWORLD, these colors are dark.
//      Then calls Gfx_SetVTable8B (0x453BA0) which:
//        - SetRenderState(D3DRS_AMBIENT, color) → applies to D3D device
//        - Stores color to gfx+0x730
//   2. Graphics_RenderScene (0x454BC0) reads gfx+0x730 every frame and
//      re-applies it via SetRenderState(0x8B, gfx+0x730).
//   3. Ball_Render_AI (0x402DE0) checks ball+0xC80:
//        If dark: SetRenderState(AMBIENT, white) → render ball → SetRenderState(AMBIENT, black)
//      This per-ball ambient toggle makes the ball "glow" in the dark.
//   4. Player Ball Render (0x403DC0) does NOT check +0xC80.
//
// WHY v1 CRASHED:
//   - Set ball+0xC80=1 on PLAYER balls → Ball_Render_AI reads ball+0xC88/
//     C8C/C90 (viewport clip matrix) which are UNINITIALIZED on player balls
//     (only Ball_ctor sets them, not Ball_ctor2) → garbage values → crash.
//   - Hooked Ball_Update at 0x405E22 → AOB conflict with Shapeshift mod.
//
// v2 APPROACH (3 clean hooks, no Ball_Update, no +0xC80):
//   Hook 1: Graphics_RenderScene AFTER ambient applied → force gfx+0x730=0 (dark)
//   Hook 2: Player Ball Render ENTRY → set gfx+0x730=white (ball glows)
//   Hook 3: Player Ball Render EXIT → set gfx+0x730=0 (dark again)
//
// GFX DEVICE STRUCT:
//   +0x154 = D3D device pointer
//   +0x730 = ambient color (D3DRS_AMBIENT, render state 0x8B)
//   +0x734 = fog enable (D3DRS_FOGENABLE, render state 0x1C)
//   +0x738 = fog color (D3DRS_FOGCOLOR, render state 0x22)
//
// HOTKEY: Set g_NeonEnabled = 1 (on) or 0 (off) in CE table.
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

// ── AOB scans ──────────────────────────────────────────────────────────
aobscanmodule(Neon_AmbientWrite,  Hamsterball.exe, 89 B5 30 07 00 00)
aobscanmodule(Neon_RenderEntry,   Hamsterball.exe, 8B 45 10 8B 88 74 01 00 00 8B 95 38 0C 00 00 3B 91 C4 07 00 00 56 57)
aobscanmodule(Neon_RenderExit,     Hamsterball.exe, 8B 8C 24 2C 01 00 00 5F 5E 5D 64 89 0D 00 00 00 00 5B 81 C4 28 01 00 00 C3)

// ── Allocs ─────────────────────────────────────────────────────────────
alloc(g_NeonEnabled, 4)
alloc(g_GfxDevice, 4)
alloc(neon_ambient_cave, 128)
alloc(neon_entry_cave, 256)
alloc(neon_exit_cave, 128)

registersymbol(g_NeonEnabled)
registersymbol(g_GfxDevice)

// ── Init ───────────────────────────────────────────────────────────────
g_NeonEnabled:
  dd 00000001

g_GfxDevice:
  dd 00000000

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Graphics_RenderScene (0x454CC4)
// After ambient is applied, override to dark.
// Original (6 bytes): MOV [EBP+0x730], ESI
// EBP = gfx device
// ═══════════════════════════════════════════════════════════════════════
neon_ambient_cave:
  push eax
  mov eax, [g_NeonEnabled]
  test eax, eax
  jz neon_ambient_original

  // Neon ON: force dark ambient + fog
  mov dword ptr [ebp+0x730], 0       // black ambient
  mov byte ptr [ebp+0x734], 1        // fog enabled
  mov dword ptr [ebp+0x738], 0       // black fog color
  jmp neon_ambient_done

neon_ambient_original:
  // Neon OFF: original behavior
  mov [ebp+0x730], esi

neon_ambient_done:
  pop eax
  jmp Neon_AmbientWrite+6

Neon_AmbientWrite:
  jmp neon_ambient_cave
  nop

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: Player Ball Render ENTRY (0x403DDF)
// Before rendering P1's ball, set ambient = white (ball glows).
// Original (9 bytes): MOV EAX,[EBP+0x10] / MOV ECX,[EAX+0x174] / MOV EDX,[EBP+0xC38]
// EBP = ball (set at 0x403DDD)
// ═══════════════════════════════════════════════════════════════════════
neon_entry_cave:
  // Check if neon is enabled
  push eax
  push ecx
  mov eax, [g_NeonEnabled]
  test eax, eax
  jz neon_entry_original

  // Neon ON: set white ambient
  mov eax, [ebp+0x10]           // EAX = App
  mov ecx, [eax+0x174]          // ECX = gfx device
  mov [g_GfxDevice], ecx        // cache for exit hook
  mov dword ptr [ecx+0x730], FFFFFFFF  // white ambient

neon_entry_original:
  pop ecx
  pop eax

  // Original instructions (9 bytes):
  // MOV EAX, [EBP+0x10]
  mov eax, [ebp+0x10]
  // MOV ECX, [EAX+0x174]
  mov ecx, [eax+0x174]
  // MOV EDX, [EBP+0xC38]
  mov edx, [ebp+0x00000C38]

  // Jump back to 0x403DE8
  jmp Neon_RenderEntry+9

Neon_RenderEntry:
  jmp neon_entry_cave
  nop
  nop
  nop
  nop

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Ball Render EXIT (0x4050D9)
// After P1's ball renders, restore ambient = dark.
// Original (7 bytes): MOV ECX, [ESP+0x12C]
// EBP = ball still valid
// ═══════════════════════════════════════════════════════════════════════
neon_exit_cave:
  push eax
  push ecx
  mov eax, [g_NeonEnabled]
  test eax, eax
  jz neon_exit_original

  // Neon ON: restore dark ambient
  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz neon_exit_original
  mov dword ptr [ecx+0x730], 0

neon_exit_original:
  pop ecx
  pop eax

  // Original instruction: MOV ECX, [ESP+0x12C]
  mov ecx, [esp+0x0000012C]

  // Jump back to 0x4050E0
  jmp Neon_RenderExit+7

Neon_RenderExit:
  jmp neon_exit_cave
  nop
  nop

[DISABLE]

// ── Restore original code ──────────────────────────────────────────────
Neon_AmbientWrite:
  db 89 B5 30 07 00 00

Neon_RenderEntry:
  db 8B 45 10 8B 88 74 01 00 00

Neon_RenderExit:
  db 8B 8C 24 2C 01 00 00

// ── Cleanup ────────────────────────────────────────────────────────────
unregistersymbol(g_NeonEnabled)
unregistersymbol(g_GfxDevice)

dealloc(neon_exit_cave)
dealloc(neon_entry_cave)
dealloc(neon_ambient_cave)
dealloc(g_GfxDevice)
dealloc(g_NeonEnabled)

// ═══════════════════════════════════════════════════════════════════════
// USAGE:
//   1. Open this CEA in Cheat Engine
//   2. Activate the script (Enable checkbox)
//   3. Start any race or arena
//   4. Everything goes dark, player ball glows white
//   5. Toggle g_NeonEnabled between 0/1 to turn effect on/off
//
//   Set hotkey in CE: Numpad 1 → toggle g_NeonEnabled (0↔1)
//
// NOTE: This mod does NOT conflict with the Shapeshift mod.
// They use completely different hook points.
// ═══════════════════════════════════════════════════════════════════════
