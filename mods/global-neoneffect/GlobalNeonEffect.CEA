// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v3 — Dark ambient + ball glow for ALL races/arenas
// Based on XRow's working script + gfx+0x730 write fix
//
// PROBLEM IN ORIGINAL: Hook 1 called SetRenderState(0x8B, 0) directly on
// the D3D device, but did NOT write 0 to gfx+0x730. Then
// Graphics_RenderScene (0x454BC0) ran and read gfx+0x730 (still the
// ORIGINAL ambient value) → called SetRenderState(0x8B, original_value)
// → overrode our dark ambient back to normal → scene was only "a bit darker"
// instead of pitch black.
//
// FIX: Also write 0 to gfx+0x730 so Graphics_RenderScene reads and applies
// dark ambient. Also set gfx+0x734=1 (fog on) and gfx+0x738=0 (black fog)
// for the full neon dark distance effect.
//
// GFX DEVICE STRUCT:
//   +0x154 = D3D device pointer
//   +0x730 = ambient color (D3DRS_AMBIENT, render state 0x8B)
//   +0x734 = fog enable (D3DRS_FOGENABLE, render state 0x1C)
//   +0x738 = fog color (D3DRS_FOGCOLOR, render state 0x22)
//
// HOOK POINTS:
//   1. Ball_Update at 0x405E22 — force gfx+0x730=0 + fog=on/black
//   2. Player Render Entry at 0x403DDF — set D3DRS_AMBIENT=white (ball glows)
//   3. Player Render Exit at 0x4050D9 — set D3DRS_AMBIENT=0 (dark again)
//
// Enable/Disable only — no hotkey address needed.
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 256)
alloc(neon_glow_entry, 256)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

label(skip_neon)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — force dark ambient + black fog
// ESI = ball pointer
// gfx = *(*(ball+0x10) + 0x174)
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  push eax
  push ecx
  push edx

  // Get gfx device: gfx = *(*(ball+0x10) + 0x174)
  mov eax, [esi+0x10]
  test eax, eax
  jz skip_neon
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_neon

  // Write dark ambient to gfx struct so Graphics_RenderScene reads it
  mov dword ptr [eax+0x730], 0      // ambient = black
  mov byte ptr [eax+0x734], 1       // fog enabled
  mov dword ptr [eax+0x738], 0      // fog color = black

  // Also call SetRenderState directly for immediate effect this frame
  mov eax, [eax+0x154]              // D3D device
  test eax, eax
  jz skip_neon
  mov edx, [eax]                    // D3D vtable
  push 0                            // value = 0 (black)
  push 8B                           // state = D3DRS_AMBIENT
  push eax                           // this = D3D device
  call dword ptr [edx+C8]           // SetRenderState(AMBIENT, 0)

skip_neon:
  pop edx
  pop ecx
  pop eax

  // Original instruction: MOV EAX, [ESI+0xC5C]
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: Player Render Entry (0x403DDF) — set white ambient (ball glows)
// EBP = ball (set at 0x403DDD)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx

  // Get gfx device
  mov eax, [ebp+0x10]
  test eax, eax
  jz skip_glow_entry
  mov ecx, [eax+0x174]
  test ecx, ecx
  jz skip_glow_entry

  // Cache gfx for exit hook
  mov [g_GfxDevice], ecx

  // Set white ambient via direct SetRenderState
  mov eax, [ecx+0x154]              // D3D device
  test eax, eax
  jz skip_glow_entry
  mov edx, [eax]                    // D3D vtable
  push FFFFFFFF                     // value = white
  push 8B                           // state = D3DRS_AMBIENT
  push eax                          // this = D3D device
  call dword ptr [edx+C8]           // SetRenderState(AMBIENT, white)

skip_glow_entry:
  pop ecx
  pop eax

  // Original instructions (9 bytes):
  // MOV EAX, [EBP+0x10]
  mov eax, [ebp+0x10]
  // MOV ECX, [EAX+0x174]
  mov ecx, [eax+0x174]
  jmp 00403DE8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Render Exit (0x4050D9) — restore dark ambient
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  // Set dark ambient via direct SetRenderState
  mov eax, [ecx+0x154]              // D3D device
  test eax, eax
  jz skip_glow_exit
  mov edx, [eax]                    // D3D vtable
  push 0                            // value = black
  push 8B                           // state = D3DRS_AMBIENT
  push eax                          // this = D3D device
  call dword ptr [edx+C8]           // SetRenderState(AMBIENT, 0)

skip_glow_exit:
  pop ecx
  pop eax

  // Original instruction: MOV ECX, [ESP+0x12C]
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_cave
  nop

00403DDF:
  jmp neon_glow_entry
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

// ── Restore original code ──────────────────────────────────────────────
00405E22:
  db 8B 86 5C 0C 00 00

00403DDF:
  db 8B 45 10 8B 88 74 01 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_cave)
dealloc(g_GfxDevice)

// ═══════════════════════════════════════════════════════════════════════
// USAGE:
//   1. Open this CEA in Cheat Engine
//   2. Activate the script (Enable checkbox)
//   3. Start any race or arena
//   4. Everything goes pitch black, player ball glows white
//   5. Disable to restore normal lighting
//
// NOTE: This mod hooks Ball_Update at 0x405E22 — same hook point as
// the Shapeshift mod. Do NOT run both simultaneously.
// ═══════════════════════════════════════════════════════════════════════
