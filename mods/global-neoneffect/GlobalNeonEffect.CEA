// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v12 — Pitch black scene + glowing player balls
//
// v11 CRASH ROOT CAUSE:
// Hook 1 called SetRenderState (stdcall) which clobbered EAX. The second
// SetRenderState call used EAX as gfx pointer, but EAX=0 (S_OK return).
// mov edx,[eax+0x154] read from address 0x154 → ACCESS VIOLATION → crash.
// This is the CEA D3D stdcall clobbering rule: after EVERY stdcall, EAX/ECX/EDX
// are destroyed. Only EBX/ESI/EDI/EBP survive.
//
// v12 FIX:
// - Hook 1: REMOVED all SetRenderState calls. Just writes gfx+0x730=0,
//   gfx+0x734=1, gfx+0x738=0 (cached values). The game itself calls
//   SetRenderState(AMBIENT, gfx+0x730) in Graphics_RenderScene. No stdcall
//   = no register clobbering = no crash.
// - Hook 2: Fixed LightEnable vtable offset: 0xB8 (index 46), NOT 0xB0
//   (which is SetLight — calling with wrong params would crash).
//   EBP=gfx (callee-preserved) survives stdcall, reload device after each call.
// - Hooks 3+4: Already safe (push/pop around call, no clobbered register use).
//
// NEON LIGHTING SYSTEM (traced from decompilation):
//
// Graphics_SetupLights (0x454630) — called every frame:
//   Sets D3DRS_LIGHTING=TRUE, D3DRS_SPECULARENABLE=TRUE
//   Clears gfx+0x7C0=0 (no material override)
//   Sets up D3D defaults (cull mode, blend mode, etc.)
//
// Graphics_RenderScene (0x454BC0) — render pipeline:
//   1. Graphics_SetupLights(gfx)
//   2. Light loop: 8 light objects at gfx+0x710, each calls vtable[3] (apply)
//      → Each light object calls D3D::SetLight + D3D::LightEnable internally
//   3. Reads gfx+0x730 → SetRenderState(AMBIENT, gfx+0x730) ← HOOK 2 HERE
//   4. Reads gfx+0x734 → SetRenderState(FOGENABLE, gfx+0x734)
//   5. Reads gfx+0x738 → SetRenderState(FOGCOLOR, gfx+0x738)
//   6. Renders opaque objects (vtable[0x64]) — includes balls
//   7. Renders transparent objects (vtable[0x68])
//   8. Renders overlay (vtable[0x70]) + postFX (vtable[0x6C])
//
// Gfx_SetVTable8B (0x453BA0): writes gfx+0x730 + SetRenderState(0x8B, val)
// Gfx_SetVTable22 (0x453B20): writes gfx+0x738 + SetRenderState(0x22, val)
//
// D3D8 vtable offsets (verified from SetMaterial at 0xA8):
//   SetMaterial     = vtable[42] = 0xA8
//   SetLight        = vtable[44] = 0xB0
//   LightEnable     = vtable[46] = 0xB8  ← v11 used 0xB0 (WRONG!)
//   SetRenderState  = vtable[50] = 0xC8
//
// D3D lighting formula (LIGHTING=TRUE, AMBIENT=0, lights disabled):
//   FinalColor = Emissive + Ambient_light*Ambient_material + Σ(Lights)
//             = Emissive + 0 + 0 = Emissive
//   Scene objects: Emissive=0 → PITCH BLACK
//   Neon geometry: Emissive=color → GLOWS
//   Ball (AMBIENT=white): Emissive + 1.0*Ambient_material = GLOWS in player color
//
// HOOKS:
// 1. Ball_Update (0x405E22): Write gfx+0x730=0, gfx+0x734=1, gfx+0x738=0
//    (No SetRenderState — game applies these in Graphics_RenderScene)
// 2. After light loop (0x454C97): gfx+0x730=0 + LightEnable(0..7, FALSE)
//    (EBP=gfx, callee-preserved. Reload device from EBP after each stdcall)
// 3. Ball_RenderAI entry (0x403DC0): SetRenderState(AMBIENT, white)
//    (Push/pop EAX/ECX/EDX around call. No clobbered register use after)
// 4. Ball_RenderAI exit (0x4050D9): SetRenderState(AMBIENT, 0) + gfx+0x730=0
//    (Re-reads App from global 0x5341E0 after stdcall)
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 128)
alloc(neon_lights_off, 256)
alloc(neon_glow_entry, 128)
alloc(neon_glow_exit, 128)

label(skip_dark)
label(skip_lights)
label(skip_glow_entry)
label(skip_glow_exit)
label(neon_light_loop)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — ESI = ball
// Writes cached gfx values: ambient=0, fog=on, fog color=black.
// NO SetRenderState calls — the game applies these in Graphics_RenderScene.
// ESI is callee-preserved, so ball pointer is safe.
// Original: mov eax, [esi+0x00000C5C] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax
  push ecx
  push edx

  mov eax, [esi+0x10]           // ball+0x10 = App
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]          // App+0x174 = gfx
  test eax, eax
  jz skip_dark

  // Write cached gfx values — NO stdcall, no register clobbering
  mov dword ptr [eax+0x730], 0       // gfx+0x730 = 0 (ambient = black)
  mov byte ptr [eax+0x734], 1        // gfx+0x734 = 1 (fog enabled)
  mov dword ptr [eax+0x738], 0       // gfx+0x738 = 0 (fog color = black)

skip_dark:
  pop edx
  pop ecx
  pop eax
  mov eax, [esi+0x00000C5C]    // original instruction
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: After light loop (0x454C97) — EBP = gfx (callee-preserved)
// Writes gfx+0x730=0 (clears any ambient set by light objects).
// Then disables all 8 D3D lights via LightEnable(0..7, FALSE).
// EBP survives stdcall, so gfx is re-readable after each call.
// Original: mov esi, [ebp+0x730] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_lights_off:
  push eax
  push ecx
  push edx
  push esi

  // Reset gfx+0x730=0 (clear ambient from last frame's ball render)
  mov dword ptr [ebp+0x730], 0

  // Disable all 8 D3D lights
  mov eax, [ebp+0x154]         // D3D device (EBP = gfx, preserved)
  test eax, eax
  jz skip_lights
  mov edx, [eax]               // vtable

  xor esi, esi                  // light index 0..7

neon_light_loop:
  push 0                       // FALSE = disable
  push esi                      // light index
  push eax                      // device (this)
  call dword ptr [edx+0xB8]    // LightEnable = vtable[46] (0xB8)
                                // clobbers EAX/ECX/EDX

  // Reload device + vtable from EBP (callee-preserved, survives stdcall)
  mov eax, [ebp+0x154]         // device
  mov edx, [eax]               // vtable
  inc esi
  cmp esi, 8
  jl neon_light_loop

skip_lights:
  pop esi
  pop edx
  pop ecx
  pop eax

  mov esi, [ebp+0x730]         // original instruction (reads 0)
  jmp 00454C9D

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Ball_RenderAI entry (0x403DC0) — ECX = ball (__fastcall this)
// Sets D3DRS_AMBIENT=white so ball's Ambient material lights up.
// Push/pop EAX/ECX/EDX around the call — no clobbered register use after pop.
// Original: push -1; mov eax, fs:[0] (8 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx

  // ECX = ball. ball+0x10 = App, App+0x174 = gfx
  mov eax, [ecx+0x10]
  test eax, eax
  jz skip_glow_entry
  mov eax, [eax+0x174]         // gfx
  test eax, eax
  jz skip_glow_entry
  mov edx, [eax+0x154]         // D3D device
  test edx, edx
  jz skip_glow_entry
  mov eax, [edx]               // vtable

  // SetRenderState(AMBIENT=0x8B, 0xFFFFFFFF) — white ambient for ball
  push FFFFFFFF                 // value = white
  push 8B                       // state = D3DRS_AMBIENT
  push edx                      // device (this)
  call dword ptr [eax+0xC8]    // SetRenderState = vtable[50] — clobbers EAX/ECX/EDX

skip_glow_entry:
  pop edx
  pop ecx
  pop eax
  // Original instructions
  push -1
  mov eax, fs:[0]
  jmp 00403DC8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 4: Ball_RenderAI exit (0x4050D9) — restore dark scene
// Sets D3DRS_AMBIENT=0 + gfx+0x730=0.
// Re-reads App from global 0x5341E0 after stdcall (not from clobbered EAX).
// Original: mov ecx, [esp+0x12C] (7 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  // Get gfx from global App (safe — 0x5341E0 is a constant address)
  mov eax, [005341E0]           // App
  test eax, eax
  jz skip_glow_exit
  mov eax, [eax+0x174]         // gfx
  test eax, eax
  jz skip_glow_exit
  mov edx, [eax+0x154]         // D3D device
  test edx, edx
  jz skip_glow_exit
  mov eax, [edx]               // vtable

  // SetRenderState(AMBIENT=0x8B, 0) — restore dark ambient
  push 0                        // value = 0 (black)
  push 8B                       // state = D3DRS_AMBIENT
  push edx                      // device (this)
  call dword ptr [eax+0xC8]    // SetRenderState — clobbers EAX/ECX/EDX

  // Write gfx+0x730=0 (re-read from global — EAX was clobbered by stdcall)
  mov eax, [005341E0]           // App (re-read, safe)
  mov eax, [eax+0x174]         // gfx
  mov dword ptr [eax+0x730], 0

skip_glow_exit:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]    // original instruction
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

00454C97:
  jmp neon_lights_off
  nop

00403DC0:
  jmp neon_glow_entry
  nop
  nop
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00454C97:
  db 8B B5 30 07 00 00

00403DC0:
  db 6A FF 64 A1 00 00 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_lights_off)
dealloc(neon_dark)
