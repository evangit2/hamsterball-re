// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v26 — Distance fog only (no ambient kill)
// ═══════════════════════════════════════════════════════════════════════
//
// v25 PROBLEM: Ambient=black killed ALL geometry lighting → pure black
// silhouettes. Fog end=300 too short → everything fully fogged.
//
// v26 FIX: Remove ambient override. Use fog start=500, end=2000 so only
// distant geometry fades to black. Near geometry stays normally lit.
//
// HOOK: Graphics_BeginFrame (0x453B50) — called every frame
// Hook at 0x453B63: MOV EAX,[EBX+0x154] (6 bytes: 8B 83 54 01 00 00)
// EBX = gfx (set at 0x453B51: MOV EBX,ECX)
//
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 256)

label(neon_skip)

// ═══════════════════════════════════════════════════════════════════════
// CODE CAVE: Hook at 0x453B63 (inside Graphics_BeginFrame)
// EBX = gfx (set at 0x453B51: MOV EBX,ECX)
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  pushfd
  pushad

  // ── Get D3D device wrapper ──────────────────────────────────────
  mov eax, [ebx+0x154]       // gfx+0x154 = D3D device wrapper
  test eax, eax
  jz neon_skip
  mov edi, eax               // EDI = device (saved by PUSHAD)

  // ── Enable fog ──────────────────────────────────────────────────
  // SetRenderState(D3DRS_FOGENABLE=0x1C, TRUE=1)
  push 1
  push 1C
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog table mode = LINEAR ─────────────────────────────────────
  // SetRenderState(D3DRS_FOGTABLEMODE=0x23, D3DFOG_LINEAR=3)
  push 3
  push 23
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Disable vertex fog (use table fog only) ────────────────────
  // SetRenderState(D3DRS_FOGVERTEXMODE=0x8C, D3DFOG_NONE=0)
  push 0
  push 8C
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog start = 500.0 (near geometry unaffected) ───────────────
  // SetRenderState(D3DRS_FOGSTART=0x24, 500.0f=0x43FA0000)
  push 43FA0000
  push 24
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog end = 2000.0 (distant geometry fully fogged) ───────────
  // SetRenderState(D3DRS_FOGEND=0x25, 2000.0f=0x44FA0000)
  // ADJUST: 447A0000=1000(near), 44FA0000=2000(default), 457A0000=4000(far)
  push 44FA0000
  push 25
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // ── Fog color = black ──────────────────────────────────────────
  // SetRenderState(D3DRS_FOGCOLOR=0x22, 0xFF000000)
  push 0FF000000
  push 22
  push edi
  mov eax, [edi]
  call dword ptr [eax+0xC8]

  // NOTE: No ambient override — let the game's normal lighting work.
  // v25 set ambient=black which killed ALL geometry → pure black.

neon_skip:
  popad
  popfd

  // ── Original instruction ────────────────────────────────────────
  // MOV EAX, [EBX+0x154] — load D3D device wrapper
  mov eax, [ebx+0x154]

  // ── Return to next instruction ──────────────────────────────────
  jmp 00453B69

// ═══════════════════════════════════════════════════════════════════════
// INSTALL HOOK
// ═══════════════════════════════════════════════════════════════════════

// Hook at 0x453B63: MOV EAX,[EBX+0x154] (6 bytes: 8B 83 54 01 00 00)
// Replace with: JMP neon_cave (5 bytes) + NOP (1 byte) = 6 bytes
00453B63:
  jmp neon_cave
  nop

[DISABLE]

// Restore original instruction at 0x453B63
// MOV EAX, [EBX+0x154] = 8B 83 54 01 00 00
00453B63:
  db 8B 83 54 01 00 00

dealloc(neon_cave)
