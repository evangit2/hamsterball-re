// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v4 — Pitch black scene + glowing ball for ALL races
//
// ROOT CAUSE ANALYSIS (why v3 didn't work):
//   1. SCENE NOT DARK ENOUGH: gfx+0x730=0 only kills ambient light.
//      D3D directional lights (from MESHWORLD Section 3) still illuminate
//      the scene. Need to also disable D3DRS_LIGHTING (0x89).
//   2. BALL NOT GLOWING: Entry hook called SetRenderState(AMBIENT, white)
//      but NOT SetMaterial. D3D formula: FinalColor = Material.Diffuse×Light
//      + Material.Ambient×AMBIENT + Emissive. Without SetMaterial,
//      Material.Ambient=0 → 0×white=0 → no glow!
//      FIX: Add SetMaterial(white diffuse+ambient+emissive).
//      Emissive makes the ball self-illuminated regardless of lights/ambient.
//
// D3D RENDER STATES:
//   0x8B = D3DRS_AMBIENT    (ambient light color)
//   0x89 = D3DRS_LIGHTING   (0=disable all D3D lighting, 1=enable)
//   0x1C = D3DRS_FOGENABLE
//   0x22 = D3DRS_FOGCOLOR
//
// D3D vtable offsets:
//   0xA8 (index 42) = SetMaterial(D3DMATERIAL8*)
//   0xC8 (index 50) = SetRenderState(state, value)
//
// BALL INIT: Ball_InitRenderState (0x402860) sets LIGHTING=1 + SPECULARENABLE=1
// before each ball render. Hook 3 sets LIGHTING=0 after ball render exits.
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_cave, 256)
alloc(neon_glow_entry, 256)
alloc(neon_glow_exit, 256)
alloc(g_GfxDevice, 4)
alloc(g_WhiteMaterial, 68)

registersymbol(g_GfxDevice)

g_GfxDevice:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + ambient + emissive
// Diffuse  (1,1,1,1) — reflects all direct light (when lighting enabled)
// Ambient  (1,1,1,1) — reflects all ambient light
// Specular (0,0,0,0)
// Emissive (1,1,1,1) — self-illumination (works even with lighting off!)
// Power    0
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(skip_neon)
label(skip_glow_entry)
label(skip_glow_exit)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — force dark ambient + disable lighting
// ESI = ball pointer
// ═══════════════════════════════════════════════════════════════════════
neon_cave:
  push eax
  push ecx
  push edx

  // Get gfx: gfx = *(*(ball+0x10) + 0x174)
  mov eax, [esi+0x10]
  test eax, eax
  jz skip_neon
  mov eax, [eax+0x174]
  test eax, eax
  jz skip_neon

  // Write to gfx struct so Graphics_RenderScene reads dark values
  mov dword ptr [eax+0x730], 0      // ambient = black
  mov byte ptr [eax+0x734], 1       // fog enabled
  mov dword ptr [eax+0x738], 0      // fog color = black

  // Disable D3D lighting on the device → pitch black scene
  mov eax, [eax+0x154]               // D3D device
  test eax, eax
  jz skip_neon
  mov edx, [eax]                     // D3D vtable
  push 0                             // value = 0 (disable)
  push 89                            // state = D3DRS_LIGHTING
  push eax                           // this = D3D device
  call dword ptr [edx+C8]            // SetRenderState(LIGHTING, 0)

skip_neon:
  pop edx
  pop ecx
  pop eax

  // Original instruction
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: Player Render Entry (0x403DDF) — ball glow setup
// EBP = ball
// ═══════════════════════════════════════════════════════════════════════
neon_glow_entry:
  push eax
  push ecx
  push edx

  // Get gfx
  mov eax, [ebp+0x10]
  test eax, eax
  jz skip_glow_entry
  mov ecx, [eax+0x174]
  test ecx, ecx
  jz skip_glow_entry
  mov [g_GfxDevice], ecx

  // SetMaterial(white) — emissive makes ball glow regardless of lights
  mov eax, [ecx+0x154]               // D3D device
  test eax, eax
  jz skip_glow_entry
  mov edx, [eax]                     // D3D vtable
  push g_WhiteMaterial               // material pointer
  push eax                           // this = D3D device
  call dword ptr [edx+0xA8]         // SetMaterial(d3d, &whiteMat)

  // SetRenderState(AMBIENT, white)
  push FFFFFFFF                      // value = white
  push 8B                           // state = D3DRS_AMBIENT
  push eax                          // this = D3D device
  call dword ptr [edx+C8]           // SetRenderState(AMBIENT, white)

skip_glow_entry:
  pop edx
  pop ecx
  pop eax

  // Original instructions (9 bytes)
  mov eax, [ebp+0x10]
  mov ecx, [eax+0x174]
  jmp 00403DE8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Player Render Exit (0x4050D9) — restore dark scene
// ═══════════════════════════════════════════════════════════════════════
neon_glow_exit:
  push eax
  push ecx
  push edx

  mov ecx, [g_GfxDevice]
  test ecx, ecx
  jz skip_glow_exit

  mov eax, [ecx+0x154]               // D3D device
  test eax, eax
  jz skip_glow_exit
  mov edx, [eax]                     // D3D vtable

  // SetRenderState(AMBIENT, 0) — dark ambient
  push 0                             // value = black
  push 8B                            // state = D3DRS_AMBIENT
  push eax                           // this = D3D device
  call dword ptr [edx+C8]            // SetRenderState(AMBIENT, 0)

  // SetRenderState(LIGHTING, 0) — disable D3D lighting again
  push 0                             // value = 0 (disable)
  push 89                            // state = D3DRS_LIGHTING
  push eax                           // this = D3D device
  call dword ptr [edx+C8]            // SetRenderState(LIGHTING, 0)

skip_glow_exit:
  pop edx
  pop ecx
  pop eax

  // Original instruction
  mov ecx, [esp+0x0000012C]
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_cave
  nop

00403DDF:
  jmp neon_glow_entry
  nop

004050D9:
  jmp neon_glow_exit
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00403DDF:
  db 8B 45 10 8B 88 74 01 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

unregistersymbol(g_GfxDevice)

dealloc(neon_glow_exit)
dealloc(neon_glow_entry)
dealloc(neon_cave)
dealloc(g_WhiteMaterial)
dealloc(g_GfxDevice)

// ═══════════════════════════════════════════════════════════════════════
// USAGE: Enable script, start any race. Scene goes pitch black, ball glows.
// Disable to restore normal lighting.
// NOTE: Hooks Ball_Update at 0x405E22 — same as Shapeshift. Don't run both.
// ═══════════════════════════════════════════════════════════════════════
