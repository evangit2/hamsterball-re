// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v16 — Dark scene + bright ball via cached render values
//
// ROOT CAUSE OF v15 FREEZE:
//   Hooks 3 and 4 called SetRenderState(LIGHTING, FALSE/TRUE) at Ball_RenderAI
//   entry/exit. Two fatal problems:
//   1. Hook 3 fires BEFORE Ball_RenderAI's SEH frame (push -1; mov eax, fs:[0]).
//      If SetRenderState faults during level load → no exception handler → FREEZE.
//   2. Ball_RenderAI has MULTIPLE exit paths (exceptions, early returns from
//      star-circling, impact wobble, alpha, mesh-swap branches). Hook 4 at
//      0x4050D9 only covers ONE exit. If function exits elsewhere, LIGHTING
//      stays FALSE → pipeline stall → FREEZE.
//
// v16 APPROACH (ZERO stdcall calls):
//   The game ITSELF calls SetRenderState every frame in Graphics_RenderScene:
//     0x454C97: MOV ESI, [gfx+0x730]  → SetRenderState(AMBIENT=0x8B, ESI)
//     0x454CEE: MOV ESI, [gfx+0x738]  → SetRenderState(FOGCOLOR=0x22, ESI)
//   We just write 0 (black) to gfx+0x730 AND gfx+0x738 in Ball_Update.
//   The game's own SetRenderState calls will use our values.
//
//   With ambient=0 and fog=black:
//   - Unlit areas (backfaces, shadows, distant geometry) are pitch black
//   - Directional lights still illuminate facing surfaces of the ball
//   - The ball appears bright against the dark scene = NEON GLOW effect
//   - This is EXACTLY how Neon Race works — dark scene, bright ball by contrast
//
//   Also writing gfx+0x734=0 to disable specular highlights (cleaner dark look).
//
// TRACE: How Neon Race lighting actually works:
//   - Scene_SetupLevelDark (0x416270) loads "levels\leveldark" MeshWorld
//   - Level_InitScene (0x40B090) calls Color_RandomRGBA() for fog + ambient
//   - The DARKNESS comes from the MESHWORLD file (dark textures), NOT code
//   - The ball "glows" only by contrast — it's lit by directional lights
//   - There is NO special "neon glow" code path for the ball
//   - Replicating globally = set ambient=0 + fog=black on ALL levels
//
// REGISTER SAFETY:
//   ESI = callee-preserved (ball pointer survives)
//   EAX = saved/restored (push/pop)
//   NO stdcall calls → NO register clobbering → NO freeze risk
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 128)

label(skip_dark)

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update (0x405E22) — ESI = ball
// Writes ambient=0, fog=black, specular=0 to gfx cached values.
// The game's own SetRenderState calls in Graphics_RenderScene will use these.
// Original: mov eax, [esi+0x00000C5C] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax

  mov eax, [esi+0x10]           // ball+0x10 = App
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]          // App+0x174 = gfx
  test eax, eax
  jz skip_dark

  // gfx+0x730 = 0 (ambient = BLACK — game calls SetRenderState(0x8B, 0) at 0x454CAC)
  mov dword ptr [eax+0x730], 0
  // gfx+0x738 = 0xFF000000 (fog color = BLACK — game calls SetRenderState(0x22, black) at 0x454D00)
  mov dword ptr [eax+0x738], 0FF000000h
  // gfx+0x734 = 0 (specular flag = disabled — game calls SetRenderState(0x1C, 0) at 0x454CCD)
  mov byte ptr [eax+0x734], 0

skip_dark:
  pop eax
  mov eax, [esi+0x00000C5C]    // original instruction
  jmp 00405E28

// ── Install hook ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(neon_dark)
