// ═══════════════════════════════════════════════════════════════════════
// GLOBAL NEON EFFECT v14 — Pitch black scene + glowing player balls
//
// v13 BUG (FREEZE ROOT CAUSE):
// LightEnable vtable offset was 0xB8 = SetClipPlane (index 46), NOT LightEnable.
// SetClipPlane(Index, pPlane=NULL) dereferences NULL to read 4 floats →
// access violation 8 times per frame (~480/sec at 60fps). SEH handler caught
// each one but kernel-mode exception overhead froze the game. "Not crash, freeze."
//
// v13b: "Lighting is just decreased, not pitch black" — because lights were
// never actually disabled (SetClipPlane doesn't disable lights).
//
// v14 FIX:
// 1. LightEnable offset corrected: 0xB8 → 0xB4 (vtable[45])
//    Verified via D3D8 vtable layout: SetMaterial=0xA4, SetRenderState=0xC8
//    Methods between: GetMaterial(0xA8), SetLight(0xAC), GetLight(0xB0),
//    LightEnable(0xB4), SetClipPlane(0xB8), GetClipPlane(0xBC),
//    SetClipStatus(0xC0), GetClipStatus(0xC4), SetRenderState(0xC8)
// 2. All push values use explicit hex (push 0x89 not push 89)
// 3. Same 4-hook architecture, just with correct D3D calls
//
// EFFECT:
// - Scene: LIGHTING=TRUE + AMBIENT=0 + all 8 lights disabled
//   FinalColor = Emissive(0) + 0×AmbientMaterial + 0 = 0 = PITCH BLACK
// - Ball: LIGHTING=FALSE → D3D skips ALL lighting calculations
//   FinalColor = VertexColor × Texture (full brightness = GLOWING)
//
// D3D8 vtable offsets (verified against game's own calls):
//   SetRenderState = vtable[50] = 0xC8  (confirmed: game uses [ECX+0xC8])
//   LightEnable    = vtable[45] = 0xB4  (FIXED: was 0xB8=SetClipPlane)
//   SetTransform   = vtable[37] = 0x94  (confirmed: game uses [ECX+0x94])
//
// D3D8 render states:
//   D3DRS_LIGHTING = 0x89 (137)
//   D3DRS_AMBIENT  = 0x8B (139)
//
// HOOKS:
// 1. Ball_Update (0x405E22): gfx+0x730=0 (ambient=black). NO stdcall.
// 2. After light loop (0x454C97): gfx+0x730=0 + LightEnable(0..7, FALSE)
// 3. Ball_RenderAI entry (0x403DC0): SetRenderState(LIGHTING=0x89, FALSE=0)
// 4. Ball_RenderAI exit (0x4050D9): SetRenderState(LIGHTING=0x89, TRUE=1)
//    + gfx+0x730=0 (restore dark ambient for remaining scene objects)
//
// REGISTER SAFETY (stdcall clobbering rule):
// After EVERY stdcall (call dword ptr [...]), EAX/ECX/EDX are DESTROYED.
// Only EBX/ESI/EDI/EBP survive. Must reload from callee-preserved registers
// or global addresses.
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

alloc(neon_dark, 64)
alloc(neon_lights_off, 256)
alloc(neon_ball_lit, 64)
alloc(neon_ball_dark, 64)

label(skip_dark)
label(skip_lights)
label(skip_ball_lit)
label(skip_ball_dark)
label(neon_light_loop)

// ═══════════════════════════════════════════════════════════════════════
// HOOK 1: Ball_Update (0x405E22) — ESI = ball
// Writes gfx+0x730=0 (dark ambient). NO stdcall, NO fog changes.
// ESI is callee-preserved, so ball pointer survives.
// Original: mov eax, [esi+0x00000C5C] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_dark:
  push eax

  mov eax, [esi+0x10]           // ball+0x10 = App
  test eax, eax
  jz skip_dark
  mov eax, [eax+0x174]          // App+0x174 = gfx
  test eax, eax
  jz skip_dark

  mov dword ptr [eax+0x730], 0       // gfx+0x730 = 0 (ambient = black)

skip_dark:
  pop eax
  mov eax, [esi+0x00000C5C]    // original instruction
  jmp 00405E28

// ═══════════════════════════════════════════════════════════════════════
// HOOK 2: After light loop (0x454C97) — EBP = gfx (callee-preserved)
// Resets gfx+0x730=0 + disables all 8 D3D lights via LightEnable(0..7, FALSE).
// EBP survives stdcall, so gfx is re-readable after each call.
// Original: mov esi, [ebp+0x730] (6 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_lights_off:
  push eax
  push ecx
  push edx
  push esi

  mov dword ptr [ebp+0x730], 0       // gfx+0x730 = 0 (ambient = black)

  mov eax, [ebp+0x154]         // D3D device
  test eax, eax
  jz skip_lights
  mov edx, [eax]               // vtable

  xor esi, esi                  // light index 0..7

neon_light_loop:
  push 0                       // FALSE = disable
  push esi                      // light index
  push eax                      // device (this)
  call dword ptr [edx+0xB4]    // LightEnable = vtable[45] (FIXED: was 0xB8=SetClipPlane)

  mov eax, [ebp+0x154]         // reload device (clobbered by stdcall)
  mov edx, [eax]               // reload vtable
  inc esi
  cmp esi, 8
  jl neon_light_loop

skip_lights:
  pop esi
  pop edx
  pop ecx
  pop eax

  mov esi, [ebp+0x730]         // original instruction (reads 0)
  jmp 00454C9D

// ═══════════════════════════════════════════════════════════════════════
// HOOK 3: Ball_RenderAI entry (0x403DC0) — ECX = ball
// Sets D3DRS_LIGHTING=FALSE so ball renders with vertex/texture colors
// directly (no D3D lighting calculations). Ball appears fully lit against
// the pitch-black scene = GLOWING effect.
// Original: push -1; mov eax, fs:[0] (8 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_ball_lit:
  push eax
  push ecx
  push edx

  mov eax, [ecx+0x10]          // ball+0x10 = App
  test eax, eax
  jz skip_ball_lit
  mov eax, [eax+0x174]         // gfx
  test eax, eax
  jz skip_ball_lit
  mov edx, [eax+0x154]         // D3D device
  test edx, edx
  jz skip_ball_lit
  mov eax, [edx]               // vtable

  // SetRenderState(LIGHTING=0x89, FALSE=0)
  push 0                        // value = 0 (LIGHTING disabled)
  push 0x89                     // state = D3DRS_LIGHTING
  push edx                      // device (this)
  call dword ptr [eax+0xC8]    // SetRenderState = vtable[50]

skip_ball_lit:
  pop edx
  pop ecx
  pop eax
  push -1
  mov eax, fs:[0]
  jmp 00403DC8

// ═══════════════════════════════════════════════════════════════════════
// HOOK 4: Ball_RenderAI exit (0x4050D9) — restore dark scene
// Sets D3DRS_LIGHTING=TRUE so remaining scene objects use D3D lighting
// (with ambient=0 and no lights → pitch black).
// Also writes gfx+0x730=0 to ensure dark ambient for next frame.
// Re-reads App from global 0x5341E0 after stdcall (EAX clobbered).
// Original: mov ecx, [esp+0x12C] (7 bytes)
// ═══════════════════════════════════════════════════════════════════════
neon_ball_dark:
  push eax
  push ecx
  push edx

  mov eax, [005341E0]           // App (global, always safe)
  test eax, eax
  jz skip_ball_dark
  mov eax, [eax+0x174]         // gfx
  test eax, eax
  jz skip_ball_dark
  mov edx, [eax+0x154]         // D3D device
  test edx, edx
  jz skip_ball_dark
  mov eax, [edx]               // vtable

  // SetRenderState(LIGHTING=0x89, TRUE=1)
  push 1                        // value = 1 (LIGHTING enabled)
  push 0x89                     // state = D3DRS_LIGHTING
  push edx                      // device (this)
  call dword ptr [eax+0xC8]    // SetRenderState — clobbers EAX/ECX/EDX

  // Write gfx+0x730=0 (re-read from global, EAX was clobbered)
  mov eax, [005341E0]           // App (re-read)
  mov eax, [eax+0x174]         // gfx
  mov dword ptr [eax+0x730], 0

skip_ball_dark:
  pop edx
  pop ecx
  pop eax
  mov ecx, [esp+0x0000012C]    // original instruction
  jmp 004050E0

// ── Install hooks ─────────────────────────────────────────────────────
00405E22:
  jmp neon_dark
  nop

00454C97:
  jmp neon_lights_off
  nop

00403DC0:
  jmp neon_ball_lit
  nop
  nop
  nop

004050D9:
  jmp neon_ball_dark
  nop
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

00454C97:
  db 8B B5 30 07 00 00

00403DC0:
  db 6A FF 64 A1 00 00 00 00

004050D9:
  db 8B 8C 24 2C 01 00 00

dealloc(neon_ball_dark)
dealloc(neon_ball_lit)
dealloc(neon_lights_off)
dealloc(neon_dark)
