[ENABLE]
alloc(WireframeCave, 512)
alloc(g_WireframeEnabled, 4)
registersymbol(g_WireframeEnabled)

g_WireframeEnabled:
  dd 1

WireframeCave:
  // ---- Original 7 bytes from Graphics_BeginFrame ----
  push ebx
  mov ebx,ecx
  mov ecx,[esp+08]

  // ---- Set FILLMODE + update cache ----
  // EBX = Graphics object, +0x154 = D3D device, +0x70D = fillmode cache
  push eax
  push edx

  mov eax,[ebx+154]
  test eax,eax
  jz WireframeCave_skip

  mov edx,[eax]

  cmp [g_WireframeEnabled],0
  jz WireframeCave_solid

  // Wireframe ON: FILLMODE=2, cache=1 (tricks game into skipping its own FILLMODE=1 sets)
  push 2
  mov byte ptr [ebx+70D], 1
  jmp WireframeCave_call

WireframeCave_solid:
  // Wireframe OFF: FILLMODE=3, cache=3
  push 3
  mov byte ptr [ebx+70D], 3

WireframeCave_call:
  push 7
  push eax
  call dword ptr [edx+C8]

WireframeCave_skip:
  pop edx
  pop eax

  jmp 00453B57

// ---- Hook Graphics_BeginFrame ----
00453B50:
  jmp WireframeCave
  nop
  nop

// ================================================================
// Patch 3 direct SetRenderState(FILLMODE=7, POINT=1) calls that
// bypass the cache check. Change state byte from 07 to FE (invalid
// state = harmless no-op, stack stays balanced).
// ================================================================

// Site 1: Ball_Render at 0x404340 — 6A 07 50 FF 91 C8
// 0x404340=6A(push 1), 0x404341=07(FILLMODE), patch 07→FE
00404341:
  db FE

// Site 2: Graphics_SetupLights Defaults(17) at 0x45497F — 6A 07 50 FF 91 C8
// 0x45497F=6A(push ???), 0x454980=07(FILLMODE), patch 07→FE
00454980:
  db FE

// Site 3: D3DXSkinMesh_CopyStripData at 0x45E05D — 6A 01 6A 07 50 FF 91 C8
// 0x45E05D=6A(push 1), 0x45E05E=07(FILLMODE), patch 07→FE
0045E05E:
  db FE

[DISABLE]
00453B50:
  db 53 8B D9 8B 4C 24 08

00404341:
  db 07

00454980:
  db 07

0045E05E:
  db 07

dealloc(WireframeCave)
dealloc(g_WireframeEnabled)
unregistersymbol(g_WireframeEnabled)
