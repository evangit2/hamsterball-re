// ============================================================
// SnowMod v4 — "Snow Storm" visibility mod for Hamsterball
// ============================================================
// Makes all races look like a blinding snow storm:
//   1. Heavy fog = reduced visibility (adjustable)
//   2. White-grayish background color (snow clouds)
//   3. White-grayish ambient lighting (overcast sky)
//
// v3 BUG: Hook 2 was at 0x454D09 inside Graphics_RenderScene.
//   Graphics_RenderScene (0x454BC0) is ONLY called from
//   Graphics_PresentOrEnd (0x455A90) when Present() returns
//   D3DERR_DEVICELOST (0x88760868) — i.e. on device reset.
//   During normal gameplay, Present() returns S_OK, the JNZ at
//   0x455AB7 skips to 0x455B70, and Graphics_RenderScene is
//   NEVER reached. Hook 2's SetRenderState calls never executed.
//
// v4 FIX: Single hook at 0x46C214 (App_ResetFrame, vtable[9]).
//   App_ResetFrame is called EVERY FRAME in the render path:
//     Graphics_BeginFrame → vtable[9]=App_ResetFrame → vtable[10]=Draw → vtable[11]=DrawUI → Present
//   At 0x46C214: ECX = gfx, ESI = App, gfx+0x154 = D3D device.
//   ALL SetRenderState calls moved here. No Hook 2 needed.
//
// D3D8 RENDER STATE NUMBERS (verified from disassembly):
//   0x1C (28)  = D3DRS_FOGENABLE
//   0x22 (34)  = D3DRS_FOGCOLOR
//   0x23 (35)  = D3DRS_FOGTABLEMODE
//   0x24 (36)  = D3DRS_FOGSTART
//   0x25 (37)  = D3DRS_FOGEND
//   0x8B (139) = D3DRS_AMBIENT
//   0x8C (140) = D3DRS_FOGVERTEXMODE
//
// gfx struct offsets:
//   gfx+0x154 = D3D device pointer
//   gfx+0x730 = ambient color (game reads at 0x454C97)
//   gfx+0x734 = fog enable byte (game reads at 0x454CB2)
//   gfx+0x738 = fog/bg color (game reads at 0x454CEE, Clear uses it)
//   gfx+0x73C = fog start (game reads at 0x454CD9)
//   gfx+0x740 = fog end (game reads at 0x454CD3)
//
// SetRenderState calling convention (stdcall, callee-clean):
//   push value, push state, push device, call [vtable+0xC8]
//   After call: EAX/ECX/EDX trashed, 12 bytes cleaned.
//   ESI = App (preserved by App_ResetFrame), gfx = [ESI+0x174]
//
// ADJUSTABLE PARAMETERS (CE address list):
//   snow_fog_start     — fog begins at this distance (default 10.0)
//   snow_fog_end       — fog total at this distance (default 200.0)
//   snow_fog_color     — fog + background color (default FFE0E0E0)
//   snow_ambient_color — ambient light color (default FFE0E0E0)
// ============================================================

[ENABLE]

alloc(snow_cave, 512)
alloc(snow_fog_start, 4)
alloc(snow_fog_end, 4)
alloc(snow_fog_color, 4)
alloc(snow_ambient_color, 4)

registersymbol(snow_fog_start)
registersymbol(snow_fog_end)
registersymbol(snow_fog_color)
registersymbol(snow_ambient_color)

// Default values — adjust in CE address list!
snow_fog_start:
  dd 41200000   // float 10.0

snow_fog_end:
  dd 43480000   // float 200.0

snow_fog_color:
  dd FFE0E0E0   // RGB 224,224,224 = white-grayish

snow_ambient_color:
  dd FFE0E0E0   // RGB 224,224,224 = white-grayish

// ============================================================
// SINGLE HOOK: 0x46C214 in App_ResetFrame (called every frame)
// ============================================================
// Original: 8B 81 38 07 00 00 = MOV EAX,[ECX+0x738] (6 bytes)
// ECX = gfx pointer, ESI = App pointer (both available)
// After our cave: EAX = fog/bg color for Clear call at 0x46C21B

snow_cave:
  // --- Write gfx struct fields (for game's own calls) ---
  // Fog enable = 1 (byte at gfx+0x734)
  mov byte ptr [ecx+0x734], 1

  // Ambient color (gfx+0x730)
  mov edx, [snow_ambient_color]
  mov [ecx+0x730], edx

  // Fog start (gfx+0x73C) and fog end (gfx+0x740)
  mov edx, [snow_fog_start]
  mov [ecx+0x73C], edx
  mov edx, [snow_fog_end]
  mov [ecx+0x740], edx

  // Fog/bg color (gfx+0x738)
  mov edx, [snow_fog_color]
  mov [ecx+0x738], edx

  // --- Force D3D render states via direct SetRenderState ---
  // ESI = App, gfx = [ESI+0x174], device = [gfx+0x154]
  // vtable = [device], SetRenderState = [vtable+0xC8]

  // 1. FOGENABLE = 1 (state 0x1C)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push 1
  push 0x1C
  push eax
  call dword ptr [ecx+0xC8]

  // 2. FOGTABLEMODE = LINEAR (state 0x23, value 3)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push 3
  push 0x23
  push eax
  call dword ptr [ecx+0xC8]

  // 3. FOGVERTEXMODE = LINEAR (state 0x8C, value 3)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push 3
  push 0x8C
  push eax
  call dword ptr [ecx+0xC8]

  // 4. FOGSTART (state 0x24)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push [snow_fog_start]
  push 0x24
  push eax
  call dword ptr [ecx+0xC8]

  // 5. FOGEND (state 0x25)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push [snow_fog_end]
  push 0x25
  push eax
  call dword ptr [ecx+0xC8]

  // 6. FOGCOLOR (state 0x22)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push [snow_fog_color]
  push 0x22
  push eax
  call dword ptr [ecx+0xC8]

  // 7. AMBIENT (state 0x8B)
  mov eax, [esi+0x174]
  mov eax, [eax+0x154]
  mov ecx, [eax]
  push [snow_ambient_color]
  push 0x8B
  push eax
  call dword ptr [ecx+0xC8]

  // --- Execute original instruction ---
  // ECX was trashed by SetRenderState calls. Reload from ESI.
  mov ecx, [esi+0x174]
  mov eax, [ecx+0x738]

  // --- Jump back to 0x46C21A (PUSH EAX → CALL Clear) ---
  jmp 0046C21A

0046C214:
  jmp snow_cave
  nop

[DISABLE]

// Restore: 8B 81 38 07 00 00 = MOV EAX,[ECX+0x738]
0046C214:
  db 8B 81 38 07 00 00

dealloc(snow_cave)
dealloc(snow_fog_start)
dealloc(snow_fog_end)
dealloc(snow_fog_color)
dealloc(snow_ambient_color)
unregistersymbol(snow_fog_start)
unregistersymbol(snow_fog_end)
unregistersymbol(snow_fog_color)
unregistersymbol(snow_ambient_color)
