// ============================================================================
// GluebieSpawn v5 — Spawn Gluebies globally + real tar effect
// ============================================================================
// PROBLEM: Gluebies are purely visual (Level3-Gluebie.MESHWORLD has 0
// collision geometry, no N:TARPIT). The tar effect comes from N:TARPIT
// level geometry in the main MESHWORLD, not the Gluebie object.
//
// SOLUTION:
//   1. Spawn Gluebie using board's pre-loaded mesh (same as factory):
//      operator_new(0x110C) -> Gluebie_ctor(alloc, board, mesh)
//      -> set position -> AthenaList_Append to gluebie list + general list
//   2. Per-frame proximity check: iterate board's Gluebie list.
//      When ball is within 30 units AND ball+0x2CC==0:
//      Call DispatchCollisionEvents(board, ball, fake_entry) with fake N:TARPIT name.
//      This triggers EXACT original tar logic: 0x2CC=1, 0x768=0, tar sound.
//
// HOTKEY: Numpad 7 spawns Gluebie at player position
// WORKS: Dizzy (mesh=board+0x4374, list=board+0x4378)
//        Master (mesh=board+0x607C, list=board+0x6080)
// HOOK: Ball_Update at 0x405E22 (ESI=ball, fires for all balls in arena)
// ============================================================================

[ENABLE]

alloc(TarCode, 4096)
alloc(SpawnFlag, 4)
alloc(fake_coll_obj, 0x868)
alloc(fake_coll_entry, 8)
alloc(tarpit_str, 16)

registersymbol(SpawnFlag)

// --- "N:TARPIT" string ---
tarpit_str:
  db 'N:TARPIT',00

// --- Fake collision entry: [type=0, obj_ptr=fake_coll_obj] ---
fake_coll_entry:
  dd 0
  dd fake_coll_obj

// --- Fake collision obj: only +0x864 (entity name) matters ---
fake_coll_obj+864:
  dd tarpit_str

// ============================================================================
// HOOK: Ball_Update at 0x405E22
// Original: MOV EAX,[ESI+0xC5C] (6 bytes)
// ESI = ball
// ============================================================================
00405E22:
  jmp TarCode
  nop

TarCode:
  // --- Execute original instruction ---
  mov eax,[esi+0xC5C]

  // --- Save all registers ---
  pushad

  // --- EBP = ball (preserved across all calls below) ---
  mov ebp,esi

  // ==============================
  // PART 1: Spawn check (hotkey)
  // ==============================
  push 67h                    // VK_NUMPAD7
  call GetAsyncKeyState
  test ax,8000h
  jz TarCode_SpawnDone        // key not pressed

  cmp dword ptr [SpawnFlag],0
  jne TarCode_SpawnDone       // debounce: already pressed
  mov dword ptr [SpawnFlag],1

  // --- Get board = ball+0x14 ---
  mov edx,[ebp+0x14]          // EDX = board
  test edx,edx
  jz TarCode_SpawnDone

  // --- Save board in ESP-4 (free stack slot, below pushad frame) ---
  // Actually, just use a register we can restore later.
  // EDI = board (we'll save/restore via push)
  push edx                    // [esp] = board

  // --- Check arena mode: scene+0x23C ---
  mov eax,[edx+0x878]         // scene
  test eax,eax
  jz TarCode_SpawnPop
  mov ebx,[eax+0x23C]
  test ebx,ebx
  jz TarCode_SpawnPop          // race mode, skip

  // --- Detect board type ---
  mov ecx,[edx]               // board vtable
  cmp ecx,#0x4D0890           // Dizzy?
  je TarCode_SpawnDizzy
  cmp ecx,#0x4D12B0           // Master?
  je TarCode_SpawnMaster
  jmp TarCode_SpawnPop

TarCode_SpawnDizzy:
  mov ecx,[edx+0x4374]        // mesh
  lea edi,[edx+0x4378]        // gluebie list
  jmp TarCode_DoSpawn

TarCode_SpawnMaster:
  mov ecx,[edx+0x607C]        // mesh
  lea edi,[edx+0x6080]        // gluebie list

TarCode_DoSpawn:
  test ecx,ecx
  jz TarCode_SpawnPop          // no mesh loaded

  // --- operator_new(0x110C) ---
  push ecx                    // save mesh
  push edi                    // save list
  push 0x110C
  call 004BA57B
  add esp,4
  pop edi                     // restore list
  pop ecx                     // restore mesh
  test eax,eax
  jz TarCode_SpawnPop

  // --- Gluebie_ctor(this=EAX, board=EDX, mesh=ECX) ---
  // __thiscall: push mesh, push board, mov ecx,this, call
  mov esi,eax                 // ESI = new Gluebie
  push ecx                    // push mesh (param_2)
  push edx                    // push board (param_1)
  mov ecx,eax                 // ECX = this
  call 00437CB0

  // --- Set position from ball ---
  mov eax,[ebp+0x164]         // ball X
  mov [esi+0x10D4],eax
  mov eax,[ebp+0x168]         // ball Y
  mov [esi+0x10D8],eax
  mov eax,[ebp+0x16C]         // ball Z
  mov [esi+0x10DC],eax

  // --- AthenaList_Append(gluebie_list, gluebie) ---
  push esi
  mov ecx,edi
  call 00453810               // thiscall, callee cleans

  // --- AthenaList_Append(general_list, gluebie) ---
  // general_list = board+0x2578
  mov edx,[esp+0]             // recover board from stack
  push esi
  lea ecx,[edx+0x2578]
  call 00453810

TarCode_SpawnPop:
  pop edx                     // clean up saved board

TarCode_SpawnDone:
  // Reset debounce when key released
  push 67h
  call GetAsyncKeyState
  test ax,8000h
  jnz TarCode_ProxCheck       // still held
  mov dword ptr [SpawnFlag],0

  // ==============================
  // PART 2: Tar proximity check
  // ==============================
TarCode_ProxCheck:
  // --- EBP = ball ---
  // Skip if already tarred
  cmp byte ptr [ebp+0x2CC],0
  jne TarCode_End

  // --- Get board ---
  mov edx,[ebp+0x14]          // board
  test edx,edx
  jz TarCode_End

  // --- Detect board type ---
  mov ecx,[edx]               // vtable
  cmp ecx,#0x4D0890           // Dizzy?
  je TarCode_ProxDizzy
  cmp ecx,#0x4D12B0           // Master?
  je TarCode_ProxMaster
  jmp TarCode_End

TarCode_ProxDizzy:
  lea edi,[edx+0x4378]        // gluebie list
  jmp TarCode_ProxIterate

TarCode_ProxMaster:
  lea edi,[edx+0x6080]        // gluebie list

TarCode_ProxIterate:
  // --- AthenaList: count at +4, array at +0x40C ---
  mov ecx,[edi+0x04]          // count
  test ecx,ecx
  jz TarCode_End

  mov ebx,[edi+0x40C]         // array_ptr
  test ebx,ebx
  jz TarCode_End

  // --- Loop: check each Gluebie ---
TarCode_ProxLoop:
  mov esi,[ebx]               // ESI = gluebie[i]
  test esi,esi
  jz TarCode_ProxNext

  // --- XZ distance² = (ballX-glueX)² + (ballZ-glueZ)² ---
  fld dword ptr [ebp+0x164]           // ballX
  fsub dword ptr [esi+0x10D4]         // dx
  fmul st(0),st(0)                    // dx²

  fld dword ptr [ebp+0x16C]           // ballZ
  fsub dword ptr [esi+0x10DC]         // dz
  fmul st(0),st(0)                    // dz²

  faddp st(1),st(0)                   // dx²+dz²

  // --- Compare with 900.0 (= 30²) ---
  fcom dword ptr [TarCode_Range]
  fnstsw ax
  sahf
  fstp st(0)                          // pop distance
  jae TarCode_ProxNext                 // too far

  // --- Ball is near! Call DispatchCollisionEvents ---
  // DispatchCollisionEvents(board, ball, entry): ECX=board, push entry, push ball
  mov edx,[ebp+0x14]                  // board
  push fake_coll_entry                 // collision_entry
  push ebp                            // ball
  mov ecx,edx                        // board
  call 0040C5D0                      // DispatchCollisionEvents (RET 0x8)
  // Callee cleans 8 bytes — no add esp needed

  // --- DispatchCollisionEvents set 0x2CC=1, 0x768=0, played sound ---
  jmp TarCode_End

TarCode_ProxNext:
  add ebx,4                           // next entry
  dec ecx
  jnz TarCode_ProxLoop

TarCode_End:
  // --- Restore ESI = ball (we clobbered it in the loop) ---
  mov esi,ebp
  popad
  jmp 00405E28

TarCode_Range:
  dd 44610000h                        // float 900.0 (30²)

[DISABLE]

00405E22:
  mov eax,[esi+0xC5C]

unregistersymbol(SpawnFlag)

dealloc(TarCode)
dealloc(SpawnFlag)
dealloc(fake_coll_obj)
dealloc(fake_coll_entry)
dealloc(tarpit_str)
