[ENABLE]

// =====================================================
// Global Blockdawg v8 — Minimal (debug version)
// =====================================================
// Stripped down to find the crash:
// - Only calls Blockdawg_ctor + AthenaList_Append(board+0x2578)
// - NO SpeedCylinder post-processing
// - NO render list, scene tree, collision registration
// - If this crashes → Blockdawg_ctor itself is the problem
// - If this doesn't crash → post-processing is the problem
// =====================================================

alloc(DawgCode, 4096)
alloc(SpawnDawg, 4)
alloc(saved_board, 4)
alloc(dawg_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x_hdr, 4)
alloc(spline_z_hdr, 4)
alloc(spline_x_data, 4)
alloc(spline_z_data, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)

registersymbol(SpawnDawg)

SpawnDawg:
  dd 0
saved_board:
  dd 0
dawg_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x_hdr:
  dd 0
spline_z_hdr:
  dd 0
spline_x_data:
  dd 0
spline_z_data:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0

label(original_code)
label(dawg_done)

DawgCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  cmp dword [SpawnDawg], 0
  je original_code
  cmp dword [dawg_ptr], 0
  jne original_code
  mov dword [SpawnDawg], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz dawg_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz dawg_done
  mov edx, [eax+0x878]
  test edx, edx
  jz dawg_done
  mov edx, [edx+0x174]
  test edx, edx
  jz dawg_done

  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Blockdawg1 mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done

  push 004D0DF0
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz dawg_done
  mov [our_mesh], eax

  // === Build dummy DAWGPATH (2 vertices + spline data) ===
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // 2 vertex entries
  push 8
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [vertex_arr], eax
  mov dword [eax], 0
  mov dword [eax+4], 0

  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+8]
  mov [ecx+0x08], edx

  // X spline data (32 bytes, 2 entries)
  push 0x20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_data], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // Z spline data
  push 0x20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_data], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // X spline header
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_hdr], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  mov edx, [spline_x_data]
  mov [eax+0x04], edx

  // Z spline header
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_hdr], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  mov edx, [spline_z_data]
  mov [eax+0x04], edx

  // Link splines into path
  mov ecx, [path_obj]
  mov edx, [spline_x_hdr]
  mov [ecx+0x30], edx
  mov edx, [spline_z_hdr]
  mov [ecx+0x40], edx

  // Set spline c0 = player position
  mov edx, [spline_x_data]
  mov eax, [pos_x]
  mov [edx+0x0C], eax
  mov edx, [spline_z_data]
  mov eax, [pos_z]
  mov [edx+0x0C], eax

  // === Allocate Blockdawg object ===
  push 0x1154
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [dawg_ptr], eax

  // === Call Blockdawg_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [dawg_ptr]
  call 0043C310

  // === MINIMAL registration (what the game does) ===
  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Post-init fixes ===
  mov ecx, [dawg_ptr]
  mov dword [ecx+0x10E4], 0
  mov dword [ecx+0x10E8], 0
  mov dword [ecx+0x10EC], 0x3F800000
  mov dword [ecx+0x1138], 0
  mov dword [ecx+0x1148], 0x7FFFFFFF
  mov byte [ecx+0x1151], 1

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x_hdr], 0
  mov dword [spline_z_hdr], 0
  mov dword [spline_x_data], 0
  mov dword [spline_z_data], 0

dawg_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp DawgCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(DawgCode)
dealloc(SpawnDawg)
dealloc(saved_board)
dealloc(dawg_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x_hdr)
dealloc(spline_z_hdr)
dealloc(spline_x_data)
dealloc(spline_z_data)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnDawg)
