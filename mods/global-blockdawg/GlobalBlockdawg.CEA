[ENABLE]

// =====================================================
// Global Blockdawg Spawner v4
// =====================================================
// DEEP TRACE OF BLOCKDAWGS IN TOOB RACE:
//
// CREATION (FUN_0040FC29 @ 0x40FC29):
//   operator_new(0x1154) → Blockdawg_ctor(0x43C310)
//   Mesh: "Levels\Level8-Blockdawg1" (0x4D0DF0)
//   Path: Level_FindObjectByName(scene, "DAWGPATH1")
//   Post: AthenaList_Append(board+0x2578, blockdawg)
//
// BLOCKDAWG_CTOR (0x43C310):
//   __thiscall: ECX=this(0x1154), params: board, X, Y, Z, mesh, path
//   1. Stands_ctor(this, mesh) — base constructor (SceneObject_ctor 0x462850)
//      Sets vtable 0x4D8FB0, inits 4 AthenaLists, clones SpatialTree
//   2. Sets vtable = 0x4D5638 (Blockdawg)
//   3. Timer_Init(this+0x10F4)
//   4. this+0x10D0 = board
//   5. this+0x10D8/10DC/10E0 = X/Y/Z position
//   6. this+0x10F0 = path
//   7. operator_new(0x10D0) + FUN_00465080 → mesh clone at this+0x10D4
//   8. Reads path+4/path+8 to count vertices → random(0, count-2)
//      Sets this+0x1138 = random starting path index
//   9. Sets: speed(0x113C)=1.0, Y_offset(0x114C)=25.0, state(0x1150)=0
//
// BLOCKDAWG_UPDATE (vtable[0x0B] = ArenaObject_Update @ 0x43C4E0):
//   State 0 (active, 0x1150==0):
//     counter(0x1138) += speed(0x113C) * frame_time
//     if counter >= count-1: wrap counter
//     Path_GetPosition(path, &pos, counter)
//       → Spline_EvalCubic(path+0x30, counter) → X
//       → Spline_EvalCubic(path+0x40, counter) → Z
//       Reads *(int*)(path+0x30+4) and *(int*)(path+0x40+4)
//       These are SPLINE DATA pointers — MUST be valid!
//     Gfx_RotateY(dir) + Gfx_ScaleZ(3.0)
//     Render via vtable[0x58]/[0x54]
//     Ball proximity: Math_FastDistance2D to all balls
//       If within range → state = 1 (activate!)
//     Sound timer countdown → Sound_Play3D(App+0x4F0+toggle*4)
//       App+0x4F0 NULL on non-Toob → CRASH!
//
//   State 1 (falling, 0x1150!=0):
//     Y_offset(0x114C) decreases
//     On first entry (0x1151==0):
//       Sound_Play3D(App+0x4F8, ...) → NULL on non-Toob → CRASH!
//       Spawn 20 particles via ArenaScoreParticle_ctor
//       AthenaList_Append(board+0x3B00, particle)
//     Gfx_RotateY + Gfx_SetPosition
//     Render via vtable[0x58]/[0x54]
//
// CRASH ROOT CAUSES (3 issues):
//   1. path+0x30 and path+0x40 = NULL → Spline_EvalCubic reads
//      *(int*)(0x4) → ACCESS VIOLATION every frame in state 0
//   2. App+0x4F0 bark sound NULL on non-Toob → crash in SoundDevice_Play3DAll
//   3. App+0x4F8 falling sound NULL on non-Toob → crash when ball near
//
// FIXES:
//   1. Allocate spline data structures for path+0x30 and path+0x40
//      Each has +4 pointing to a 16-byte zeroed vertex array
//   2. Set sound_timer (0x1148) = 0x7FFFFFFF (never fires)
//   3. Set particle_flag (0x1151) = 1 (skip falling sound+particles)
// =====================================================

alloc(DawgCode, 4096)
alloc(SpawnDawg, 4)
alloc(saved_board, 4)
alloc(dawg_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x_hdr, 4)
alloc(spline_z_hdr, 4)
alloc(spline_x_data, 4)
alloc(spline_z_data, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)

registersymbol(SpawnDawg)

SpawnDawg:
  dd 0
saved_board:
  dd 0
dawg_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x_hdr:
  dd 0
spline_z_hdr:
  dd 0
spline_x_data:
  dd 0
spline_z_data:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0

label(original_code)
label(dawg_done)
label(skip_post)
label(activate_dawg)

DawgCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  cmp dword [SpawnDawg], 0
  je original_code
  mov dword [SpawnDawg], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz dawg_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz dawg_done
  mov edx, [eax+0x878]
  test edx, edx
  jz dawg_done
  mov edx, [edx+0x174]
  test edx, edx
  jz dawg_done

  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Blockdawg1 mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done

  push 004D0DF0               // "Levels\Level8-Blockdawg1"
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz dawg_done
  mov [our_mesh], eax

  // === Build dummy DAWGPATH with proper spline data ===
  // Path structure:
  //   +0x00: zeroed
  //   +0x04: vertex_start pointer (1 vertex, 4 bytes)
  //   +0x08: vertex_end pointer (start+4)
  //   +0x30: X spline header (struct, +4 = ptr to spline vertex data)
  //   +0x40: Z spline header (struct, +4 = ptr to spline vertex data)
  //
  // Spline_EvalCubic reads *(int*)(path+0x30+4) and *(int*)(path+0x40+4)
  // These MUST be valid pointers or crash with NULL deref!

  // Allocate path object (0x48 bytes, zeroed)
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // Allocate 1 vertex entry (4 bytes, value=0)
  push 4
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [vertex_arr], eax
  mov dword [eax], 0

  // path+4 = vertex_start, path+8 = vertex_end (start+4)
  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+4]
  mov [ecx+0x08], edx

  // === Allocate X spline vertex data (16 bytes, all zeros) ===
  // Spline vertex = 4 floats: c3*t³ + c2*t² + c1*t + c0
  // All zeros → returns 0.0 → no X movement
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_data], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  // === Allocate Z spline vertex data (16 bytes, all zeros) ===
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_data], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  // === Allocate X spline header (16 bytes) ===
  // +4 = pointer to spline_x_data
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_hdr], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  mov edx, [spline_x_data]
  mov [eax+0x04], edx

  // === Allocate Z spline header (16 bytes) ===
  // +4 = pointer to spline_z_data
  push 0x10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_hdr], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi

  mov edx, [spline_z_data]
  mov [eax+0x04], edx

  // === Link spline headers into path ===
  // path+0x30 = spline_x_hdr, path+0x40 = spline_z_hdr
  mov ecx, [path_obj]
  mov edx, [spline_x_hdr]
  mov [ecx+0x30], edx
  mov edx, [spline_z_hdr]
  mov [ecx+0x40], edx

  // === Allocate Blockdawg object (0x1154 bytes) ===
  push 0x1154
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [dawg_ptr], eax

  // === Call Blockdawg_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [dawg_ptr]
  call 0043C310

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [dawg_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [dawg_ptr]
  mov eax, [dawg_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [dawg_ptr]
  mov eax, [dawg_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_dawg

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_dawg

  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_dawg:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Initialize direction vector ===
  mov ecx, [dawg_ptr]
  mov dword [ecx+0x10E4], 0          // dir X = 0.0
  mov dword [ecx+0x10E8], 0          // dir Y = 0.0
  mov dword [ecx+0x10EC], 0x3F800000  // dir Z = 1.0 (facing forward)

  // === Fix path counter (CRITICAL) ===
  // Blockdawg_ctor calls random(0, count-2) for starting path index.
  // With dummy path (count=1): random(0, -1) → garbage value.
  // Spline_EvalCubic reads spline vertex data at offset [counter*0x10].
  // Garbage counter → negative index → buffer underflow → memory corruption.
  // Set counter (0x1138) = 0.0 to start at vertex 0 (safe).
  mov dword [ecx+0x1138], 0

  // === Prevent sound crashes on non-Toob levels ===
  mov dword [ecx+0x1148], 0x7FFFFFFF  // bark timer = max (never fires)
  mov byte [ecx+0x1151], 1             // particle_flag (skip falling sound)

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x_hdr], 0
  mov dword [spline_z_hdr], 0
  mov dword [spline_x_data], 0
  mov dword [spline_z_data], 0

dawg_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp DawgCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(DawgCode)
dealloc(SpawnDawg)
dealloc(saved_board)
dealloc(dawg_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x_hdr)
dealloc(spline_z_hdr)
dealloc(spline_x_data)
dealloc(spline_z_data)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnDawg)
