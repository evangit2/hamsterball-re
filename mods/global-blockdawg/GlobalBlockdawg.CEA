[ENABLE]

// =====================================================
// Global Blockdawg v14 — PopCylinder_ctor + Blockdawg vtable
// =====================================================
// Uses PopCylinder_ctor (0x436EE0) for safe mesh/collision/render
// initialization (doesn't crash like Blockdawg_ctor).
// Then rearranges fields to Blockdawg layout and swaps vtable
// so Blockdawg_Update (0x43C4E0) runs — giving movement,
// blade spin, ball proximity activation, and sounds.
// =====================================================

alloc(DawgCode, 4096)
alloc(SpawnMDawg, 4)
alloc(saved_board, 4)
alloc(dawg_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x_hdr, 4)
alloc(spline_z_hdr, 4)
alloc(spline_x_data, 4)
alloc(spline_z_data, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(float_40_sub, 4)
alloc(temp_val, 4)

registersymbol(SpawnMDawg)

SpawnMDawg:
  dd 0
saved_board:
  dd 0
dawg_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x_hdr:
  dd 0
spline_z_hdr:
  dd 0
spline_x_data:
  dd 0
spline_z_data:
  dd 0
playerX:
  dd 0
playerY:
  dd 0
playerZ:
  dd 0
float_40_sub:
  dd C2200000              // -40.0f (spawn height offset)
temp_val:
  dd 0

label(original_code)
label(dawg_done)
label(skip_col)
label(skip_render)

DawgCode:
  cmp dword [esi+18], 0
  jne original_code

  // Save player position
  mov eax, [esi+164]
  mov [playerX], eax
  fld dword [esi+168]
  fadd dword [float_40_sub]
  fstp dword [playerY]
  mov eax, [esi+16C]
  mov [playerZ], eax

  cmp dword [SpawnMDawg], 0
  je original_code
  cmp dword [dawg_ptr], 0
  jne original_code
  mov dword [SpawnMDawg], 0

  pushad

  mov eax, [esi+14]
  mov [saved_board], eax
  test eax, eax
  jz dawg_done
  mov edx, [eax+878]
  test edx, edx
  jz dawg_done
  mov edx, [edx+174]
  test edx, edx
  jz dawg_done

  // === Load Level8-Blockdawg1 mesh ===
  push 10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done

  mov edx, [saved_board]
  mov edx, [edx+878]
  mov edx, [edx+174]
  push 004D0DF0
  push edx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz dawg_done
  mov [our_mesh], eax

  // === Build dummy DAWGPATH (2 vertices + spline data) ===
  push 48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [path_obj], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 12
  rep stosd
  pop edi

  push 8
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [vertex_arr], eax
  mov dword [eax], 0
  mov dword [eax+4], 0

  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+04], edx
  lea edx, [edx+8]
  mov [ecx+08], edx

  // X spline data (32 bytes)
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_data], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // Z spline data
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_data], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // X spline header
  push 10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_hdr], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi
  mov edx, [spline_x_data]
  mov [eax+04], edx

  // Z spline header
  push 10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_hdr], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi
  mov edx, [spline_z_data]
  mov [eax+04], edx

  // Link splines into path
  mov ecx, [path_obj]
  mov edx, [spline_x_hdr]
  mov [ecx+30], edx
  mov edx, [spline_z_hdr]
  mov [ecx+40], edx

  // Set spline c0 = player position
  mov edx, [spline_x_data]
  mov eax, [playerX]
  mov [edx+0C], eax
  mov edx, [spline_z_data]
  mov eax, [playerZ]
  mov [edx+0C], eax

  // === Allocate Blockdawg object (0x1154 = Blockdawg size) ===
  push 1154
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [dawg_ptr], eax

  // === Call PopCylinder_ctor (safe init, doesn't crash) ===
  // PopCylinder_ctor(this, board, X, Y, Z, mesh)
  // PopCylinder layout: board@+0x10D0, X@+0x10D4, Y@+0x10D8,
  //   Z@+0x10DC, mesh_clone@+0x10E0, active@+0x10E4
  push dword [our_mesh]
  push dword [playerZ]
  push dword [playerY]
  push dword [playerX]
  push dword [saved_board]
  mov ecx, [dawg_ptr]
  call 00436EE0
  test eax, eax
  jz dawg_done

  // === Rearrange fields from PopCylinder to Blockdawg layout ===
  mov ecx, [dawg_ptr]

  // Save PopCylinder mesh clone (+0x10E0) and position (+0x10D4/10D8/10DC)
  mov eax, [ecx+0x10E0]
  mov [temp_val], eax           // save mesh clone ptr

  // Write Blockdawg layout:
  // +0x10D0 = board (already set by PopCylinder_ctor, same offset)
  // +0x10D4 = mesh clone (moved from +0x10E0)
  mov eax, [temp_val]
  mov [ecx+0x10D4], eax

  // +0x10D8 = X, +0x10DC = Y, +0x10E0 = Z
  mov eax, [playerX]
  mov [ecx+0x10D8], eax
  mov eax, [playerY]
  mov [ecx+0x10DC], eax
  mov eax, [playerZ]
  mov [ecx+0x10E0], eax

  // +0x10E4/10E8/10EC = direction vector
  mov dword [ecx+0x10E4], 0          // dir X = 0.0
  mov dword [ecx+0x10E8], 0          // dir Y = 0.0
  mov dword [ecx+0x10EC], 3F800000   // dir Z = 1.0

  // +0x10F0 = path
  mov eax, [path_obj]
  mov [ecx+0x10F0], eax

  // +0x10F4 = Timer (inline, 0x44 bytes)
  lea ecx, [ecx+0x10F4]
  call 00457AD0              // Timer_Init

  // === Override vtable to Blockdawg ===
  mov ecx, [dawg_ptr]
  mov dword [ecx], 004D5638  // Blockdawg vtable

  // === Set Blockdawg-specific fields ===
  mov dword [ecx+0x1138], 0          // path counter = 0.0
  mov dword [ecx+0x113C], 3F800000   // speed = 1.0f
  mov dword [ecx+0x1140], 0
  mov dword [ecx+0x1148], 7FFFFFFF    // bark timer (never fires)
  mov dword [ecx+0x114C], 41C80000   // Y offset = 25.0f
  mov byte [ecx+0x1150], 0           // state = 0 (active)
  mov byte [ecx+0x1151], 1           // particle_flag (skip falling sound)
  mov byte [ecx+0x1152], 0           // blockdawg3 flag
  mov byte [ecx+0x1144], 0           // sound toggle

  // === Register in board lists ===
  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, 2578
  call 00453810

  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, CD4
  call 00453810

  // Collision registration (use Blockdawg's mesh clone at +0x10D4)
  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz skip_col
  push ecx
  mov edx, [saved_board]
  add edx, 10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+8B0]
  test edx, edx
  jz skip_col
  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+18]
  call 00453810

skip_col:
  // Scene tree registration
  mov edx, [saved_board]
  mov edx, [edx+8AC]
  test edx, edx
  jz skip_render
  mov edx, [edx+480]
  test edx, edx
  jz skip_render
  push dword [dawg_ptr]
  lea ecx, [edx+1C]
  call 00453810

skip_render:
  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x_hdr], 0
  mov dword [spline_z_hdr], 0
  mov dword [spline_x_data], 0
  mov dword [spline_z_data], 0

dawg_done:
  popad

original_code:
  mov eax, [esi+0c5c]
  jmp 00405E28

00405E22:
  jmp DawgCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(DawgCode)
dealloc(SpawnMDawg)
dealloc(saved_board)
dealloc(dawg_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x_hdr)
dealloc(spline_z_hdr)
dealloc(spline_x_data)
dealloc(spline_z_data)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(float_40_sub)
dealloc(temp_val)
unregistersymbol(SpawnMDawg)
