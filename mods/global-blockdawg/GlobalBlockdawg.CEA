[ENABLE]

// =====================================================
// Global Blockdawg Spawner v10
// =====================================================
// Based on user's working v5 (Blockdawg_ctor doesn't crash).
// Fixes: rendering (add vtable calls), collision registration,
// and spline path with proper headers at +0x30/+0x40.
// =====================================================

alloc(DawgCode, 4096)
alloc(SpawnMDawg, 4)
alloc(saved_board, 4)
alloc(dawg_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x_hdr, 4)
alloc(spline_z_hdr, 4)
alloc(spline_x_data, 4)
alloc(spline_z_data, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)

registersymbol(SpawnMDawg)

SpawnMDawg:
  dd 0
saved_board:
  dd 0
dawg_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x_hdr:
  dd 0
spline_z_hdr:
  dd 0
spline_x_data:
  dd 0
spline_z_data:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0

label(original_code)
label(dawg_done)
label(skip_post)
label(activate_dawg)

DawgCode:
  mov eax, [esi+14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  cmp dword [SpawnMDawg], 0
  je original_code
  cmp dword [dawg_ptr], 0
  jne original_code
  mov dword [SpawnMDawg], 0

  pushad

  mov eax, [saved_board]
  test eax, eax
  jz dawg_done
  mov edx, [eax+8AC]
  test edx, edx
  jz dawg_done
  mov edx, [eax+878]
  test edx, edx
  jz dawg_done
  mov edx, [edx+174]
  test edx, edx
  jz dawg_done

  mov eax, [esi+164]
  mov [pos_x], eax
  mov eax, [esi+168]
  mov [pos_y], eax
  mov eax, [esi+16C]
  mov [pos_z], eax

  // === Load mesh ===
  push 10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done

  push 004D0DF0
  mov ecx, [saved_board]
  mov ecx, [ecx+878]
  mov ecx, [ecx+174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz dawg_done
  mov [our_mesh], eax

  // === Build dummy DAWGPATH ===
  push 48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [path_obj], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 12
  rep stosd
  pop edi

  // 2 vertex entries
  push 8
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [vertex_arr], eax
  mov dword [eax], 0
  mov dword [eax+4], 0

  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+04], edx
  lea edx, [edx+8]
  mov [ecx+08], edx

  // X spline data (32 bytes = 2 entries)
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_data], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // Z spline data
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_data], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 8
  rep stosd
  pop edi

  // X spline header (+4 = ptr to data)
  push 10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_x_hdr], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi
  mov edx, [spline_x_data]
  mov [eax+04], edx

  // Z spline header
  push 10
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [spline_z_hdr], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 4
  rep stosd
  pop edi
  mov edx, [spline_z_data]
  mov [eax+04], edx

  // Link spline headers into path (0x30 and 0x40, NOT 0x34/0x44)
  mov ecx, [path_obj]
  mov edx, [spline_x_hdr]
  mov [ecx+30], edx
  mov edx, [spline_z_hdr]
  mov [ecx+40], edx

  // Set spline c0 = player position
  mov edx, [spline_x_data]
  mov eax, [pos_x]
  mov [edx+0C], eax
  mov edx, [spline_z_data]
  mov eax, [pos_z]
  mov [edx+0C], eax

  // === Allocate Blockdawg ===
  push 1154
  call 004BA57B
  add esp, 4
  test eax, eax
  jz dawg_done
  mov [dawg_ptr], eax

  // === Call Blockdawg_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [dawg_ptr]
  call 0043C310

  // === Post-init fixes ===
  mov ecx, [dawg_ptr]
  mov dword [ecx+10E4], 0
  mov dword [ecx+10E8], 0
  mov dword [ecx+10EC], 3F800000
  mov dword [ecx+1138], 0
  mov dword [ecx+1148], 7FFFFFFF
  mov byte [ecx+1151], 1

  // === SpeedCylinder post-processing ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, CD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+8AC]
  mov edx, [edx+480]
  test edx, edx
  jz skip_post

  push dword [dawg_ptr]
  lea ecx, [edx+1C]
  call 00453810

  // vtable[0x58] = SceneObject_CallUpdate (REQUIRED for rendering)
  mov ecx, [dawg_ptr]
  mov eax, [dawg_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  // vtable[0x54] = SceneObject_CallRender (REQUIRED for rendering)
  push ebx
  mov ecx, [dawg_ptr]
  mov eax, [dawg_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_dawg

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_dawg

  mov ecx, [dawg_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_dawg:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [dawg_ptr]
  mov ecx, [saved_board]
  add ecx, 2578
  call 00453810

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x_hdr], 0
  mov dword [spline_z_hdr], 0
  mov dword [spline_x_data], 0
  mov dword [spline_z_data], 0

dawg_done:
  popad

original_code:
  mov eax, [esi+0c5c]
  jmp 00405E28

00405E22:
  jmp DawgCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(DawgCode)
dealloc(SpawnMDawg)
dealloc(saved_board)
dealloc(dawg_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x_hdr)
dealloc(spline_z_hdr)
dealloc(spline_x_data)
dealloc(spline_z_data)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnMDawg)
