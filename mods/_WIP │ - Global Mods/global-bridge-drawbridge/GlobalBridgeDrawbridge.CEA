[ENABLE]

// =============================================================
// Global Bridge + Drawbridge Spawn
// =============================================================
// Bridge: the bridge platform from Intermediate Race (Level2-Bridge mesh)
// Drawbridge: the drawbridge from Tower Race (Level4-Drawbridge mesh)
// Both use BreakBridge_ctor which calls SceneObject_ctor → clones SpatialTree
// → has real 3D geometry → renders through normal SceneObject path.
//
// Usage: Set SpawnBridge or SpawnDrawbridge to 1 via CE address list.
//       Object spawns at P1 position on next frame.
// =============================================================

alloc(SpawnCode, 8192)
alloc(SpawnBridge, 4)
alloc(SpawnDrawbridge, 4)
alloc(saved_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(float_20, 4)
alloc(bridge_mesh_str, 32)
alloc(drawbridge_mesh_str, 32)
alloc(bridge_mesh, 4)
alloc(drawbridge_mesh, 4)
alloc(bridge_mesh_loaded, 4)
alloc(drawbridge_mesh_loaded, 4)
alloc(last_board, 4)

registersymbol(SpawnBridge)
registersymbol(SpawnDrawbridge)

SpawnBridge:
  dd 0

SpawnDrawbridge:
  dd 0

saved_board:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

float_20:
  dd 0x41A00000

bridge_mesh_str:
  db 'Levels\Level2-Bridge',0

drawbridge_mesh_str:
  db 'Levels\Level4-Drawbridge',0

bridge_mesh:
  dd 0

drawbridge_mesh:
  dd 0

bridge_mesh_loaded:
  dd 0

drawbridge_mesh_loaded:
  dd 0

last_board:
  dd 0

label(original_code)
label(save_pos)
label(check_bridge)
label(check_drawbridge)
label(load_bridge_mesh)
label(bridge_mesh_done)
label(do_bridge_spawn)
label(bridge_register)
label(bridge_done)
label(drawbridge_mesh_check)
label(load_drawbridge_mesh)
label(drawbridge_mesh_done)
label(do_drawbridge_spawn)
label(drawbridge_register)
label(drawbridge_done)
label(spawn_object)
label(done_spawn)

SpawnCode:
  // Reset mesh cache when board changes
  mov eax, [esi+0x14]
  test eax, eax
  jz save_pos
  cmp eax, [last_board]
  je save_pos
  mov [last_board], eax
  mov dword [bridge_mesh_loaded], 0
  mov dword [drawbridge_mesh_loaded], 0

save_pos:
  cmp dword [esi+0x18], 0
  jne check_bridge
  mov eax, [esi+0x164]
  mov [playerX], eax
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax

check_bridge:
  cmp dword [SpawnBridge], 0
  je check_drawbridge
  cmp dword [esi+0x18], 0
  jne check_drawbridge
  mov dword [SpawnBridge], 0
  pushad

  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz done_spawn

  // Safety: board→app→gfx must be valid
  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx+0x174]
  test edx, edx
  jz done_spawn
  // Safety: board+0x8AC (scene/collision level) must exist
  mov edx, [eax+0x8AC]
  test edx, edx
  jz done_spawn

  // === Load Level2-Bridge mesh if not cached ===
load_bridge_mesh:
  cmp dword [bridge_mesh_loaded], 0
  jne bridge_mesh_done

  // Check if board already has a bridge mesh at +0x436C (Intermediate Race)
  mov edx, [saved_board]
  mov edx, [edx+0x436C]
  test edx, edx
  jz load_bridge_fresh
  // Reuse existing bridge mesh
  mov [bridge_mesh], edx
  mov dword [bridge_mesh_loaded], 1
  jmp bridge_mesh_done

load_bridge_fresh:
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn
  mov ebx, eax

  // MeshWorld_ctor(this=alloc, gfx=board→app→+0x174, path=bridge_mesh_str)
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push bridge_mesh_str
  push edx
  mov ecx, ebx
  call 00461510
  test eax, eax
  jz done_spawn
  mov [bridge_mesh], eax
  mov dword [bridge_mesh_loaded], 1

bridge_mesh_done:
  // === Allocate BreakBridge object (0x1100 bytes) ===
  push 0x1100
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn
  mov edi, eax

  // BreakBridge_ctor(this, board, x, y, z, mesh_ptr)
  // __thiscall: ECX=this, stack: mesh, z, y, x, board → ret 0x14
  push dword [bridge_mesh]     // param_5: mesh_ptr
  push dword [playerZ]          // param_4: z
  push dword [playerY]          // param_3: y
  push dword [playerX]          // param_2: x
  push dword [saved_board]      // param_1: board
  mov ecx, edi
  call 00436D70                 // BreakBridge_ctor

  // Set position explicitly (ctor already sets it, but ensure)
  mov edx, [playerX]
  mov [edi+0x10D4], edx
  mov edx, [playerY]
  mov [edi+0x10D8], edx
  mov edx, [playerZ]
  mov [edi+0x10DC], edx

bridge_register:
  // AthenaList_Append(board+0x2578, obj) — active objects
  push edi
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // AthenaList_Append(board+0xCD4, obj) — render list
  push edi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  // AthenaList_Append(board+0x8AC→+0x480→+0x1C, obj) — post-alpha render
  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  test edx, edx
  jz bridge_call_update
  mov edx, [edx+0x480]
  test edx, edx
  jz bridge_call_update
  push edi
  lea ecx, [edx+0x1C]
  call 00453810

bridge_call_update:
  // Call vtable[0x58] (SceneObject_CallUpdate) — initialize the object
  mov ecx, edi
  mov eax, [edi]
  call dword [eax+0x58]

  // Call vtable[0x54] (SceneObject_CallRender) — no stack params
  mov ecx, edi
  mov eax, [edi]
  call dword [eax+0x54]

  // Register collision sub-object at +0x10E0
  mov eax, [edi+0x10E0]
  test eax, eax
  jz bridge_done
  push eax
  mov ecx, [saved_board]
  add ecx, 0x10EC
  call 00453810

  // Register in collision mesh list
  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz bridge_done
  mov eax, [edi+0x10E0]
  push eax
  lea ecx, [edx+0x18]
  call 00453810

bridge_done:
  popad
  jmp check_drawbridge

check_drawbridge:
  cmp dword [SpawnDrawbridge], 0
  je original_code
  cmp dword [esi+0x18], 0
  jne original_code
  mov dword [SpawnDrawbridge], 0
  pushad

  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz done_spawn

  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn
  mov edx, [edx+0x174]
  test edx, edx
  jz done_spawn
  mov edx, [eax+0x8AC]
  test edx, edx
  jz done_spawn

  // === Load Level4-Drawbridge mesh if not cached ===
drawbridge_mesh_check:
  cmp dword [drawbridge_mesh_loaded], 0
  jne drawbridge_mesh_done

  // Check if board already has drawbridge mesh at +0x4370 (Tower Race)
  mov edx, [saved_board]
  mov edx, [edx+0x4370]
  test edx, edx
  jz load_drawbridge_fresh
  // Reuse existing drawbridge mesh
  mov [drawbridge_mesh], edx
  mov dword [drawbridge_mesh_loaded], 1
  jmp drawbridge_mesh_done

load_drawbridge_fresh:
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn
  mov ebx, eax

  // MeshWorld_ctor(this=alloc, gfx, path=drawbridge_mesh_str)
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push drawbridge_mesh_str
  push edx
  mov ecx, ebx
  call 00461510
  test eax, eax
  jz done_spawn
  mov [drawbridge_mesh], eax
  mov dword [drawbridge_mesh_loaded], 1

drawbridge_mesh_done:
  // === Allocate BreakBridge object (0x1100 bytes) ===
  push 0x1100
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn
  mov edi, eax

  // BreakBridge_ctor(this, board, x, y, z, mesh_ptr)
  // Raise Y by 20 so it sits slightly above ball
  fld dword [playerY]
  fadd dword [float_20]
  fstp dword [playerY]

  push dword [drawbridge_mesh]  // param_5: mesh_ptr
  push dword [playerZ]          // param_4: z
  push dword [playerY]          // param_3: y
  push dword [playerX]          // param_2: x
  push dword [saved_board]      // param_1: board
  mov ecx, edi
  call 00436D70                 // BreakBridge_ctor

  // Set position explicitly
  mov edx, [playerX]
  mov [edi+0x10D4], edx
  mov edx, [playerY]
  mov [edi+0x10D8], edx
  mov edx, [playerZ]
  mov [edi+0x10DC], edx

drawbridge_register:
  // AthenaList_Append(board+0x2578, obj)
  push edi
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // AthenaList_Append(board+0xCD4, obj)
  push edi
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  // AthenaList_Append(board+0x8AC→+0x480→+0x1C, obj)
  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  test edx, edx
  jz drawbridge_call_update
  mov edx, [edx+0x480]
  test edx, edx
  jz drawbridge_call_update
  push edi
  lea ecx, [edx+0x1C]
  call 00453810

drawbridge_call_update:
  // Call vtable[0x58] (SceneObject_CallUpdate)
  mov ecx, edi
  mov eax, [edi]
  call dword [eax+0x58]

  // Call vtable[0x54] (SceneObject_CallRender) — no stack params
  mov ecx, edi
  mov eax, [edi]
  call dword [eax+0x54]

  // Register collision sub-object at +0x10E0
  mov eax, [edi+0x10E0]
  test eax, eax
  jz drawbridge_done
  push eax
  mov ecx, [saved_board]
  add ecx, 0x10EC
  call 00453810

  // Register in collision mesh list
  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz drawbridge_done
  mov eax, [edi+0x10E0]
  push eax
  lea ecx, [edx+0x18]
  call 00453810

drawbridge_done:
  popad
  jmp original_code

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SpawnCode
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnBridge)
dealloc(SpawnDrawbridge)
dealloc(saved_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(float_20)
dealloc(bridge_mesh_str)
dealloc(drawbridge_mesh_str)
dealloc(bridge_mesh)
dealloc(drawbridge_mesh)
dealloc(bridge_mesh_loaded)
dealloc(drawbridge_mesh_loaded)
dealloc(last_board)
unregistersymbol(SpawnBridge)
unregistersymbol(SpawnDrawbridge)
