[ENABLE]

alloc(SpawnCode, 8192)
alloc(SpawnNeon, 4)
alloc(saved_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(float_20, 4)
alloc(meshes_loaded, 4)
alloc(mesh_neonplatform, 4)
alloc(mesh_dfloor1, 4)
alloc(mesh_dfloor2, 4)
alloc(mesh_dfloor3, 4)
alloc(mesh_dfloor4, 4)
alloc(mesh_trode, 4)

registersymbol(SpawnNeon)

SpawnNeon:
  dd 0

saved_board:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

float_20:
  dd 0x41A00000

meshes_loaded:
  dd 0

mesh_neonplatform:
  dd 0

mesh_dfloor1:
  dd 0

mesh_dfloor2:
  dd 0

mesh_dfloor3:
  dd 0

mesh_dfloor4:
  dd 0

mesh_trode:
  dd 0

label(original_code)
label(done_spawn)
label(skip_neonplatform)
label(skip_dfloor1)
label(skip_dfloor2)
label(skip_dfloor3)
label(skip_dfloor4)
label(skip_trode)
label(load_meshes)

SpawnCode:
  cmp dword [SpawnNeon], 0
  je original_code

  // Clear flag immediately
  mov dword [SpawnNeon], 0

  pushad

  // esi = ball pointer (from Ball_Update context)
  // Get Board from ball+0x14
  mov eax, [esi+0x14]
  test eax, eax
  jz done_spawn
  mov [saved_board], eax

  // Get player position
  mov ecx, [esi+0x164]
  mov [playerX], ecx
  mov ecx, [esi+0x168]
  mov [playerY], ecx
  mov ecx, [esi+0x16C]
  mov [playerZ], ecx

  // Get App from Board+0x878
  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn

  // Get D3D device from App+0x174
  mov edx, [edx+0x174]
  test edx, edx
  jz done_spawn

  // ==========================================
  // LOAD MESHES (only once, cached)
  // ==========================================
  cmp dword [meshes_loaded], 1
  je load_meshes_done

load_meshes:
  // --- NEONPLATFORM ---
  push 004D1D9C               // "Levels\LevelDark-NeonPlatform"
  push edx                    // D3D device
  push 10D0                   // alloc size
  call 004BA57B               // operator_new
  add esp, 4
  push edx                    // D3D device (reload — operator_new may have clobbered it)
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D9C
  mov ecx, eax               // ecx = alloc
  call 00461510               // MeshWorld_ctor  ret 8
  mov [mesh_neonplatform], eax

  // --- DFLOOR1 ---
  push 10D0
  call 004BA57B
  add esp, 4
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D80
  mov ecx, eax
  call 00461510
  mov [mesh_dfloor1], eax

  // --- DFLOOR2 ---
  push 10D0
  call 004BA57B
  add esp, 4
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D64
  mov ecx, eax
  call 00461510
  mov [mesh_dfloor2], eax

  // --- DFLOOR3 ---
  push 10D0
  call 004BA57B
  add esp, 4
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D48
  mov ecx, eax
  call 00461510
  mov [mesh_dfloor3], eax

  // --- DFLOOR4 ---
  push 10D0
  call 004BA57B
  add esp, 4
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D2C
  mov ecx, eax
  call 00461510
  mov [mesh_dfloor4], eax

  // --- TRODE ---
  push 10D0
  call 004BA57B
  add esp, 4
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]
  push edx
  push 004D1D14
  mov ecx, eax
  call 00461510
  mov [mesh_trode], eax

  mov dword [meshes_loaded], 1

load_meshes_done:
  // Get Board pointer
  mov ebx, [saved_board]
  test ebx, ebx
  jz done_spawn

  // ==========================================
  // SPAWN NEONPLATFORM (alloc 0x10EC, ctor 0x43E110)
  // ==========================================
  push 10EC
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_neonplatform

  push [mesh_neonplatform]    // param_5: mesh
  sub esp, 0C                 // allocate pos XYZ
  mov ecx, [playerX]
  mov [esp], ecx              // pos_X
  mov ecx, [playerY]
  mov [esp+4], ecx            // pos_Y
  mov ecx, [playerZ]
  mov [esp+8], ecx            // pos_Z
  push ebx                    // param_1: Board
  mov ecx, eax                // ecx = alloc (this)
  call 0043E110               // Stands_CtorRotator  ret 0x14

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810               // AthenaList_Append  ret 4

skip_neonplatform:

  // ==========================================
  // SPAWN DFLOOR1 (alloc 0x1104, ctor 0x43E450)
  // ==========================================
  push 1104
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_dfloor1

  push [mesh_dfloor1]
  sub esp, 0C
  mov ecx, [playerX]
  mov [esp], ecx
  mov ecx, [playerY]
  add ecx, [float_20]         // Y + 20
  mov [esp+4], ecx
  mov ecx, [playerZ]
  mov [esp+8], ecx
  push ebx
  mov ecx, eax
  call 0043E450               // DFloor/Trode ctor  ret 0x14

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810

skip_dfloor1:

  // ==========================================
  // SPAWN DFLOOR2
  // ==========================================
  push 1104
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_dfloor2

  push [mesh_dfloor2]
  sub esp, 0C
  mov ecx, [playerX]
  add ecx, [float_20]         // X + 20
  mov [esp], ecx
  mov ecx, [playerY]
  mov [esp+4], ecx
  mov ecx, [playerZ]
  mov [esp+8], ecx
  push ebx
  mov ecx, eax
  call 0043E450

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810

skip_dfloor2:

  // ==========================================
  // SPAWN DFLOOR3
  // ==========================================
  push 1104
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_dfloor3

  push [mesh_dfloor3]
  sub esp, 0C
  mov ecx, [playerX]
  add ecx, [float_20]
  add ecx, [float_20]         // X + 40
  mov [esp], ecx
  mov ecx, [playerY]
  mov [esp+4], ecx
  mov ecx, [playerZ]
  mov [esp+8], ecx
  push ebx
  mov ecx, eax
  call 0043E450

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810

skip_dfloor3:

  // ==========================================
  // SPAWN DFLOOR4
  // ==========================================
  push 1104
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_dfloor4

  push [mesh_dfloor4]
  sub esp, 0C
  mov ecx, [playerX]
  add ecx, [float_20]
  add ecx, [float_20]
  add ecx, [float_20]         // X + 60
  mov [esp], ecx
  mov ecx, [playerY]
  mov [esp+4], ecx
  mov ecx, [playerZ]
  mov [esp+8], ecx
  push ebx
  mov ecx, eax
  call 0043E450

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810

skip_dfloor4:

  // ==========================================
  // SPAWN TRODE
  // ==========================================
  push 1104
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_trode

  push [mesh_trode]
  sub esp, 0C
  mov ecx, [playerX]
  mov [esp], ecx
  mov ecx, [playerY]
  mov [esp+4], ecx
  mov ecx, [playerZ]
  add ecx, [float_20]         // Z + 20
  mov [esp+8], ecx
  push ebx
  mov ecx, eax
  call 0043E450

  push eax
  lea ecx, [ebx+0x2578]
  call 00453810

skip_trode:

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SpawnCode
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnNeon)
dealloc(saved_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(float_20)
dealloc(meshes_loaded)
dealloc(mesh_neonplatform)
dealloc(mesh_dfloor1)
dealloc(mesh_dfloor2)
dealloc(mesh_dfloor3)
dealloc(mesh_dfloor4)
dealloc(mesh_trode)
unregistersymbol(SpawnNeon)
