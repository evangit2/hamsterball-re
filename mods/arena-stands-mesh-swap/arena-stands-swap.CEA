// Arena Stands Mesh Swap
// Replaces "levels\arena-stands" mesh with "Levels\Level2-Bridge" mesh.
//
// The bridge string already exists in the binary at 0x4D055C.
// We just redirect the PUSH at 0x41330C from 0x4CFF2C to 0x4D055C.
//
// Original: 68 2C FF 4C 00  =  PUSH 0x004CFF2C ("levels\arena-stands")
// Patched:  68 5C 05 4D 00  =  PUSH 0x004D055C ("Levels\Level2-Bridge")

[ENABLE]
0041330C:
    push 004D055C

[DISABLE]
0041330C:
    push 004CFF2C
