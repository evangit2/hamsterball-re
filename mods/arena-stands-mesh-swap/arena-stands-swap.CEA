[ENABLE]

alloc(BridgeCave, 4096)

0041330C:
db 68 5C 05 4D 00

0041334B:
jmp BridgeCave

BridgeCave:
// Only run if App is initialized
cmp dword [005341E0], 0
je just_return

pushad
mov edi,esi

lea ebx,[PositionTable]
mov ecx,9

SpawnLoop:
push ecx
push ebx

push 10D0
call 004BA57B
add esp,4
test eax,eax
jz SkipBridge

mov ecx,eax
mov edx,[edi+878]
mov edx,[edx+174]
push 004D055C
push edx
call 00461510

// EAX = mesh object
// Store mesh ptr on stack for position patching
mov esi,eax

// Patch MeshBuffer positions directly (skip Level_AssignTextures)
// mesh+0x08 = MeshWorld
// MeshWorld+0x2C = AthenaList (MeshBuffer list)
mov edx,[esi+08]
test edx,edx
jz SkipBridge

mov edx,[edx+2C]
test edx,edx
jz SkipBridge

mov ecx,[edx+04]
test ecx,ecx
jz SkipBridge

mov eax,[edx+40C]
test eax,eax
jz SkipBridge

pop ebx
push ebx

mov edx,0

PatchLoop:
mov esi,[eax+edx*4]
test esi,esi
jz NextMB

fld dword [esi+04]
fadd dword [ebx]
fstp dword [esi+04]

fld dword [esi+08]
fadd dword [ebx+4]
fstp dword [esi+08]

fld dword [esi+0C]
fadd dword [ebx+8]
fstp dword [esi+0C]

NextMB:
inc edx
cmp edx,ecx
jb PatchLoop

mov esi,edi

SkipBridge:
pop ebx
add ebx,12
pop ecx
dec ecx
jnz SpawnLoop

popad

just_return:
call 0040B090
jmp 00413350

PositionTable:
dd 43FA0000 42C80000 00000000
dd 43CA8000 42C80000 43930000
dd 431B0000 42C80000 43EE0000
dd C31B0000 42C80000 43EE0000
dd C3CA8000 42C80000 43930000
dd C3FA0000 42C80000 00000000
dd C3CA8000 42C80000 C3930000
dd C31B0000 42C80000 C3EE0000
dd 431B0000 42C80000 C3EE0000
dd 43CA8000 42C80000 C3930000

[DISABLE]

0041330C:
db 68 2C FF 4C 00

0041334B:
db E8 40 7D FF FF

dealloc(BridgeCave)
