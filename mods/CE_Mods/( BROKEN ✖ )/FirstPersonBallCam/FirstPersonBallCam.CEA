{ ============================================================
  First-Person Ball Cam for Hamsterball — v5
  ============================================================

  HOOK: Scene_SetCamera epilogue at 0x41A254
  JUMP-BACK: 0x41A25E (let original SetPosition/SetDirection run)

  APPROACH: Modify the INPUTS the original camera code uses:
  1. Overwrite camera target (stack locals) with ball position
  2. Set orbit distance (scene+0x29C0) to fpCamDist
  3. Set orbit angle (scene+0x29BC) to ball's travel angle (ball+0x198)
  Then let the original SetPosition + SetDirection calls run unmodified.

  The game's own Ball_Update computes the travel angle at ball+0x198
  using Math_Atan2Angle(dx, dz). The camera's orbit code uses
  sin(angle), cos(angle) for direction. So writing ball+0x198 to
  scene+0x29BC makes the camera face the ball's travel direction.

  Adjustable via CE address table:
  - fpCamDist: orbit distance (default 130.0)
  - fpCamHeight: extra height above ball (default 0.0)
  ============================================================ }

[ENABLE]
alloc(fpCamHeight, 4)
alloc(fpCamDist, 4)
alloc(newmem, 256)

registersymbol(fpCamHeight)
registersymbol(fpCamDist)

fpCamHeight:
  dd 0
fpCamDist:
  dd 43020000    // 130.0

newmem:
  push eax

  // --- Overwrite camera target with ball position ---
  mov eax, [edi+164]
  mov [esp+10], eax
  mov eax, [edi+168]
  mov [esp+14], eax
  mov eax, [edi+16C]
  mov [esp+18], eax

  // --- Set orbit distance ---
  mov eax, [fpCamDist]
  mov [esi+29C0], eax

  // --- Set orbit angle to ball's travel direction ---
  // ball+0x198 is computed by Ball_Update via Math_Atan2Angle(deltaX, deltaZ)
  // The camera orbit code uses sin(angle), cos(angle) for direction
  mov eax, [edi+198]
  mov [esi+29BC], eax

  pop eax

  // Execute the original instructions we overwrote
  mov eax, [esp+14]
  mov ecx, [esi+87C]

  jmp 0041A25E

0041A254:
  jmp newmem

[DISABLE]
0041A254:
  db 8B 44 24 14 8B 8E 7C 08 00 00

dealloc(newmem)
dealloc(fpCamHeight)
dealloc(fpCamDist)
unregistersymbol(fpCamHeight)
unregistersymbol(fpCamDist)
