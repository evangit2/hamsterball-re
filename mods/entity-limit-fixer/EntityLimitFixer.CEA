// ============================================================
// EntityLimitFixer v3 — CE AutoAssembler Script
// Prevents freezes/crashes with many entities in arenas
//
// ROOT CAUSE (verified via GhidraMCP decompilation):
//   Ball_AI_ChaseNearsest (0x408390) has TWO O(N²) loops that
//   iterate the entire ball list (Scene+0x29D4) per AI ball.
//   Loop 1 (0x4083D9): "near ball bonus" — checks every ball
//     for proximity, awards score. N balls × N checks = N².
//   Loop 2 (0x408548): "find nearest target" — scans every
//     ball to find closest chase target. N balls × N = N².
//
//   At N=30+, each frame takes 900+ distance calcs per AI ball.
//   At N=50+, the frame budget overflows → freeze.
//   At N=100+, operator_new fails from CollisionNode (0x14) +
//   trail particle (0x28) allocations → crash.
//
// FIX: 4 patches that cap processing when ball count > MAX_BALLS.
//   Balls still exist, render, and have physics — they just skip
//   AI search loops and per-frame allocations when overcrowded.
//
// ADDRESSES VERIFIED against GhidraMCP disassembly:
//   Scene pointer: Ball+0x14 ([ESI+0x14])
//   Ball list: Scene+0x29D4 (AthenaList)
//   Ball count: Scene+0x29D8 (AthenaList.size, int32)
//   operator_new: 0x004BA57B (malloc wrapper)
//   AthenaList_NextIndex: 0x004532B0
//
// v1/v2 were FABRICATED without real decompilation. This v3 is
// built from actual GhidraMCP output for every patch point.
// ============================================================

define(MAX_BALLS, 30)  // Adjust: 20=conservative, 30=balanced, 50=aggressive

[ENABLE]

alloc(aiLoop1Cave, 128)
alloc(aiLoop2Cave, 128)
alloc(trailCave, 128)
alloc(collisionCave, 128)
label(aiLoop1Skip)
label(aiLoop2Skip)
label(trailSkip)
label(collisionSkip)

// ============================================================
// PATCH 1: AI Loop 1 — "near ball bonus" search
// Address: 0x4083D9 in Ball_AI_ChaseNearest (0x408390)
// Disassembly:
//   004083D9: MOV ECX,[ESI+0x14]       ; Scene ptr
//   004083DC: ADD ECX,0x29D4           ; ball list
//   004083E2: CALL 0x004532B0           ; AthenaList_NextIndex
// Loop body 0x408412-0x4084EF iterates all balls, does
// Math_FastDistance2D per ball. Jumps to 0x4084F5 when done.
// If count > MAX: JMP 004084F5 (skip loop entirely)
// ============================================================
aiLoop1Cave:
  MOV EAX,[ESI+0x14]        // Scene pointer (Ball+0x14)
  MOV EAX,[EAX+0x29D8]      // Ball count (AthenaList.size)
  CMP EAX,#MAX_BALLS
  JG aiLoop1Skip
  // Original instructions (9 bytes)
  MOV ECX,[ESI+0x14]
  ADD ECX,0x29D4
  JMP 004083E2              // -> CALL AthenaList_NextIndex
aiLoop1Skip:
  JMP 004084F5              // Skip to post-loop (FSTP float)

004083D9:
  JMP aiLoop1Cave
  nop
  nop
  nop
  nop

// ============================================================
// PATCH 2: AI Loop 2 — "find nearest target" search
// Address: 0x408548 in Ball_AI_ChaseNearest (0x408390)
// Disassembly:
//   00408541: MOV ECX,[ESI+0x14]       ; Scene ptr (before patch)
//   00408544: FSTP float [ESP+0x14]    ; store float (before patch)
//   00408548: ADD ECX,0x29D4           ; ball list <- PATCH HERE
//   0040854E: MOV [ESP+0x10],0x497423f0
//   00408556: XOR EDI,EDI
//   00408558: XOR EBX,EBX
//   0040855A: CALL 0x004532B0           ; AthenaList_NextIndex
// Loop body 0x408590-0x40865D checks each ball's flags + distance.
// This is the BIGGEST bottleneck — 6 flag checks + distance per ball.
// If count > MAX: JMP 00408663 (skip loop, EBX=0 = no target)
// ============================================================
aiLoop2Cave:
  // ECX = [ESI+0x14] = Scene (set at 0x408541, before our patch)
  MOV EAX,[ECX+0x29D8]      // Ball count
  CMP EAX,#MAX_BALLS
  JG aiLoop2Skip
  // Original instruction (6 bytes)
  ADD ECX,0x29D4
  JMP 0040854E              // -> MOV [ESP+0x10],0x497423f0
aiLoop2Skip:
  XOR EBX,EBX               // No target found (prevents chasing garbage)
  JMP 00408663              // Skip to post-loop (LEA ECX,[ESP+0x1c])

00408548:
  JMP aiLoop2Cave
  nop

// ============================================================
// PATCH 3: Trail particle allocation cap
// Address: 0x405ECB in Ball_Update (0x405E00)
// Disassembly:
//   00405ECB: PUSH 0x28                 ; alloc 40 bytes
//   00405ECD: CALL 0x004BA57B           ; operator_new
//   00405ED2: ADD ESP,0x4
//   00405ED5: MOV [ESP+0x10],EAX        ; store result
//   00405ED9: CMP EAX,EBX               ; check NULL
//   00405EDB: MOV [ESP+0x944],EBX
//   00405EE2: JZ 0x00405EF9             ; if NULL, skip init
// Game already handles NULL (jumps to 0x405EF9). Safe to return 0.
// ============================================================
trailCave:
  MOV EAX,[ESI+0x14]        // Scene pointer
  MOV EAX,[EAX+0x29D8]      // Ball count
  CMP EAX,#MAX_BALLS
  JG trailSkip
  // Original (10 bytes)
  PUSH 28
  CALL 004BA57B
  ADD ESP,4
  JMP 00405ED5              // -> MOV [ESP+0x10],EAX
trailSkip:
  XOR EAX,EAX               // NULL — game skips particle init
  JMP 00405ED5              // -> MOV [ESP+0x10],0 then JZ skip

00405ECB:
  JMP trailCave
  nop
  nop
  nop
  nop
  nop

// ============================================================
// PATCH 4: CollisionNode allocation cap
// Address: 0x4068F5 in Ball_Update (0x405E00)
// Disassembly:
//   004068F5: PUSH 0x14                 ; alloc 20 bytes
//   004068F7: CALL 0x004BA57B           ; operator_new
//   004068FC: ADD ESP,0x4
//   004068FF: MOV [ESP+0x10],EAX        ; store result
//   00406903: CMP EAX,EBX               ; check NULL
//   0040690D: JZ 0x00406922             ; if NULL -> XOR EAX,EAX
//   0040690F: MOV ECX,[ESI+0x14]
//   00406912: ADD ECX,0x29D4
//   00406918: PUSH ECX
//   00406919: MOV ECX,EAX
//   0040691B: CALL 0x00466CF0           ; CollisionNode_ctor
// Game already handles NULL (jumps to 0x406922, sets EAX=0).
// ============================================================
collisionCave:
  MOV EAX,[ESI+0x14]        // Scene pointer
  MOV EAX,[EAX+0x29D8]      // Ball count
  CMP EAX,#MAX_BALLS
  JG collisionSkip
  // Original (10 bytes)
  PUSH 14
  CALL 004BA57B
  ADD ESP,4
  JMP 004068FF              // -> MOV [ESP+0x10],EAX
collisionSkip:
  XOR EAX,EAX               // NULL — game takes NULL path at 0x406922
  JMP 004068FF              // -> MOV [ESP+0x10],0 then CMP/JZ

004068F5:
  JMP collisionCave
  nop
  nop
  nop
  nop
  nop

[DISABLE]

// Restore original bytes (verified from disassembly)
004083D9:
  MOV ECX,[ESI+0x14]
  ADD ECX,0x29D4

00408548:
  ADD ECX,0x29D4

00405ECB:
  PUSH 28
  CALL 004BA57B
  ADD ESP,4

004068F5:
  PUSH 14
  CALL 004BA57B
  ADD ESP,4

dealloc(aiLoop1Cave)
dealloc(aiLoop2Cave)
dealloc(trailCave)
dealloc(collisionCave)
