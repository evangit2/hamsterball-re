// ============================================================
// Hamsterball Entity Limit Fixer v9 — CE AutoAssembler Script
// Prevents freezes AND crashes when many entities are active.
//
// v8→v9 FIX: Patch A only checked bad_balls_list count (Scene+0x29D8).
// Player clones are added to all_balls_list (Scene+0x2DEC), NOT bad_balls!
// So SKIP_COLLISIONS never activated for player clones → freeze.
// v9 Patch A now checks BOTH lists and uses the larger count.
//
// v7→v8 FIX: Player clones freeze because Ball_FallUpdate (0x408830)
// builds its OWN SpatialTree directly via SpatialTree_ctor (0x463330),
// BYPASSING Mesh_FindClosestCollision entirely! v7 Patch B doesn't catch it.
//
// v8 adds Patch F: hook SpatialTree_ctor ENTRY directly. This catches:
//   - Ball_Update (0x4068BC) — direct SpatialTree_ctor call
//   - Ball_FallUpdate (0x4088FC) — direct SpatialTree_ctor call (FALLEN balls!)
//   - Mesh_FindClosestCollision (0x465DF9) — internal call (already covered by Patch B)
//
// ALL PATCHES:
//   A  0x41B540  Hook Scene_UpdateBallsAndState → set SKIP_COLLISIONS flag
//   B  0x465D90  Hook Mesh_FindClosestCollision → skip if flag set (covers 5 call sites)
//   C  0x4BA58D  operator_new → return NULL (crash protection)
//   D  0x4083D9  Skip AI O(N²) loop 1 when flag set
//   E  0x408548  Skip AI O(N²) loop 2 when flag set
//   F  0x463330  Hook SpatialTree_ctor → skip tree build if flag set
//
// ADJUSTABLE PARAMETERS (add to CE address list):
//   MAX_BALLS (default 5): ball count threshold for skipping collision
//   SKIP_COLLISIONS: runtime flag (1=skip, 0=normal), set automatically
// ============================================================

[ENABLE]

alloc(GlobalState, 16)
alloc(CaveScene, 128)
alloc(CaveMesh, 128)
alloc(CaveSTree, 128)
alloc(CaveAI1, 64)
alloc(CaveAI2, 64)

label(MAX_BALLS)
label(SKIP_COLLISIONS)

label(scene_check)
label(scene_check_bad)
label(scene_set)
label(scene_clear)
label(scene_done)

label(mesh_skip)
label(mesh_original)

label(stree_skip)
label(stree_original)

label(ai1_skip)
label(ai1_orig)

label(ai2_skip)
label(ai2_orig)

registersymbol(MAX_BALLS)
registersymbol(SKIP_COLLISIONS)

// ============================================================
// Global state
// ============================================================
GlobalState:
  MAX_BALLS:
    dd #5          // Ball count threshold (adjustable in CE)
  SKIP_COLLISIONS:
    dd 0           // Runtime flag: 1=skip collision, 0=normal

// ============================================================
// PATCH C: operator_new → return NULL instead of bad_alloc crash
// ============================================================
0x4BA58D:
  xor eax,eax
  pop esi
  ret
  nop

// ============================================================
// PATCH A: Hook Scene_UpdateBallsAndState entry (0x41B540)
// Sets SKIP_COLLISIONS based on ball count vs MAX_BALLS.
// v9: Checks BOTH bad_balls (Scene+0x29D8) AND all_balls (Scene+0x2DF0).
// Uses the larger count so player clones (in all_balls) trigger the flag.
// Original 5 bytes: 53 55 56 8B D9
// ============================================================
CaveScene:
  push ebx
  push ebp
  push esi
  mov ebx,ecx
  // Check bad_balls_list count first (Scene+0x29D4 is AthenaList, count at +0x04 = +0x29D8)
  mov eax, [ebx+0x29D8]
  // Check all_balls_list count (Scene+0x2DEC is AthenaList, count at +0x04 = +0x2DF0)
  mov esi, [ebx+0x2DF0]
  // Use the larger of the two
  cmp esi, eax
  jle scene_check_bad
  mov eax, esi
  jmp scene_check
scene_check_bad:
  mov eax, [ebx+0x29D8]
scene_check:
  cmp eax, [MAX_BALLS]
  jle scene_clear

scene_set:
  mov dword ptr [SKIP_COLLISIONS], 1
  jmp scene_done

scene_clear:
  mov dword ptr [SKIP_COLLISIONS], 0

scene_done:
  jmp 0x41B545

0x41B540:
  jmp CaveScene

// ============================================================
// PATCH B: Hook Mesh_FindClosestCollision entry (0x465D90)
// __thiscall, RET 0x20. [ESP+4] = output pointer (3 floats).
// Original 6 bytes: 64 A1 00 00 00 00 (MOV EAX, FS:[0])
// ============================================================
CaveMesh:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je mesh_original

mesh_skip:
  mov eax, [esp+4]
  mov dword ptr [eax], 47C34F80
  mov dword ptr [eax+4], 47C34F80
  mov dword ptr [eax+8], 47C34F80
  xor eax, eax
  ret 0x20

mesh_original:
  mov eax, fs:[0]
  jmp 0x465D96

0x465D90:
  jmp CaveMesh
  nop

// ============================================================
// PATCH F (NEW in v8): Hook SpatialTree_ctor entry (0x463330)
//
// __thiscall: ECX = this (allocated memory), 1 stack param, RET 0x4.
// Original first 7 bytes: 6A FF 68 48 D1 4C 00
//   PUSH -1; PUSH 0x4CD148  (SEH prolog)
//
// When SKIP_COLLISIONS=1: set vtable pointer at [ECX] and return ECX.
// The tree has no triangles → all collision checks find nothing (no hit).
// SpatialTree_Free works because it just sets vtable + CollisionObj_Init.
//
// Caller writes [EAX+0x10]=type and [EAX+0xC]=field — works on our
// minimally-initialized memory (just vtable ptr at offset 0).
// ============================================================
CaveSTree:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je stree_original

stree_skip:
  // Minimal init: just set vtable pointer so Free works
  mov dword ptr [ecx], 004D9038    // SpatialTree vtable
  mov eax, ecx                     // return this pointer
  ret 0x4                          // callee cleans 1 param (4 bytes)

stree_original:
  // Execute original 7 bytes: PUSH -1; PUSH 0x4CD148
  push -1
  push 004CD148
  jmp 0x463337                     // Continue to MOV EAX, FS:[0]

0x463330:
  jmp CaveSTree
  nop
  nop

// ============================================================
// PATCH D: Skip AI O(N²) loop 1 in Ball_AI_ChaseNearest
// Original 9 bytes at 0x4083D9: 8B 4E 14 81 C1 D4 29 00 00
// Skip target: 0x4084F5
// ============================================================
CaveAI1:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je ai1_orig

ai1_skip:
  jmp 0x4084F5

ai1_orig:
  mov ecx, [esi+0x14]
  add ecx, 0x29D4
  jmp 0x4083E2

0x4083D9:
  jmp CaveAI1
  nop
  nop
  nop
  nop

// ============================================================
// PATCH E: Skip AI O(N²) loop 2 in Ball_AI_ChaseNearest
// Original 6 bytes at 0x408548: 81 C1 D4 29 00 00
// Skip target: 0x408663
// ============================================================
CaveAI2:
  cmp dword ptr [SKIP_COLLISIONS], 0
  je ai2_orig

ai2_skip:
  jmp 0x408663

ai2_orig:
  add ecx, 0x29D4
  jmp 0x40854E

0x408548:
  jmp CaveAI2

[DISABLE]

// Patch C: operator_new CALL CRT_ThrowBadAlloc
0x4BA58D:
  db E8 0B 01 00 00

// Patch A: Scene_UpdateBallsAndState entry (5 bytes)
0x41B540:
  db 53 55 56 8B D9

// Patch B: Mesh_FindClosestCollision entry (6 bytes)
0x465D90:
  db 64 A1 00 00 00 00

// Patch F: SpatialTree_ctor entry (7 bytes)
0x463330:
  db 6A FF 68 48 D1 4C 00

// Patch D: AI loop 1 (9 bytes)
0x4083D9:
  db 8B 4E 14 81 C1 D4 29 00 00

// Patch E: AI loop 2 (6 bytes)
0x408548:
  db 81 C1 D4 29 00 00

dealloc(CaveAI2)
dealloc(CaveAI1)
dealloc(CaveSTree)
dealloc(CaveMesh)
dealloc(CaveScene)
dealloc(GlobalState)
unregistersymbol(MAX_BALLS)
unregistersymbol(SKIP_COLLISIONS)
