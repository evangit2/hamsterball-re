[ENABLE]

// =====================================================
// Global Saw Spawner v9 — Simple Activated Saw
// =====================================================
// Spawns a saw at player 1's position that:
// - Does NOT move horizontally (stays in place)
// - Does up/down motion (original descend/ascend FSM)
// - Spins blade (Gfx_ScaleZ 180.0)
// - Plays saw sound (sawspeedy on state 0→2 transition)
// - Has collision (N:SAWTEETH → balls get dizzy)
// - Renders properly (no position override, no path hacks)
//
// HOW IT WORKS:
// - Dummy path has 1 vertex (count=1, count-1=0)
// - Saw_Update: counter(0.02) < count-1(0) → FALSE
// - Path_GetPosition SKIPPED → no horizontal movement
// - FSM runs normally: Y descends -2.75/frame to -100,
//   pauses, ascends +3.75/frame, pauses, repeats
// - On Toob Race: real SAWPATH used (original behavior)
// =====================================================

alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)

registersymbol(SpawnSaw)

SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0

label(original_code)
label(saw_done)
label(have_path)
label(no_path)
label(skip_post)
label(activate_saw)

SawCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz saw_done
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done

  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Saw mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done

  push 004D0E24
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz saw_done
  mov [our_mesh], eax

  // === Try to find SAWPATH (Toob Race) ===
  mov ecx, [saved_board]
  mov ecx, [ecx+0x8AC]
  test ecx, ecx
  jz no_path
  push 004CFD20
  call 00460530
  test eax, eax
  jz no_path
  mov [path_obj], eax
  jmp have_path

no_path:
  // === Build dummy path (1 vertex, no movement) ===
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // 1 vertex entry (4 bytes)
  push 4
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [vertex_arr], eax
  mov dword [eax], 0

  // path+4 = vertex_start, path+8 = vertex_end (start+4)
  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+4]
  mov [ecx+0x08], edx

  // path+0x34 and path+0x44 need spline data pointers
  // Even though Path_GetPosition is skipped, Spline_EvalCubic
  // might still be called if count check passes.
  // With count=1, count-1=0, counter(0.02) < 0 → FALSE.
  // So Path_GetPosition is skipped. Splines never accessed.
  // But set them to NULL just in case (already zeroed above).

have_path:
  // === Allocate Saw object ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax

  // === Call Saw_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [saw_ptr]
  call 0043B780

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [saw_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_saw

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_saw

  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_saw:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Activate saw ===
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1      // active = 1
  mov dword [ecx+0x10F4], 0     // FSM state = 0 (descend)
  mov dword [ecx+0x10F0], 0     // Y offset = 0 (start at surface)
  mov dword [ecx+0x10EC], 0     // path counter = 0

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0

saw_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SawCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnSaw)
