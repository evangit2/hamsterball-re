[ENABLE]

// =====================================================
// Global Saw Spawner v6 — Fixed Circular Motion
// =====================================================
// v5 problems:
//   1. Spline values absolute (±80 from origin) → saw circled
//      world origin, not player. Now player-relative.
//   2. Y descend/ascend FSM (states 1,3) don't call render →
//      saw disappeared during pause. Now forced to state 0.
//   3. Y offset -100 wrong for non-Toob levels → saw underground.
//      Now Y offset forced to 0 every frame.
//   4. Collision active during invisible states → ball stuck.
//      Fixed by keeping saw always visible (state 0).
//
// CIRCULAR PATH (radius 80 around player):
//   5 vertex entries, 4 linear segments
//   X: px+R → px → px-R → px → px+R
//   Z: pz → pz+R → pz → pz-R → pz
//   Speed: 0.02/frame, wraps at 4.0 → 0.0
// =====================================================

alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x, 4)
alloc(spline_z, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)
alloc(float_R, 4)
alloc(float_nR, 4)

registersymbol(SpawnSaw)

SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x:
  dd 0
spline_z:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0
float_R:
  dd 0x42A00000       // +80.0
float_nR:
  dd 0xC2A00000       // -80.0

label(original_code)
label(saw_done)
label(have_path)
label(no_path)
label(skip_post)
label(activate_saw)
label(do_spawn)

SawCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  // === Per-frame fixes for existing saw ===
  mov ecx, [saw_ptr]
  test ecx, ecx
  jz check_spawn

  // Fix 1: Wrap path counter at 4.0 → 0.0
  fld dword [ecx+0x10EC]
  fld dword [float_4_0]
  fcomip st(1)
  fstp st(0)
  jae check_spawn
  mov dword [ecx+0x10EC], 0

check_spawn:
  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz saw_done
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done

do_spawn:
  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Saw mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done

  push 004D0E24
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz saw_done
  mov [our_mesh], eax

  // === Try to find SAWPATH ===
  mov ecx, [saved_board]
  mov ecx, [ecx+0x8AC]
  test ecx, ecx
  jz no_path
  push 004CFD20
  call 00460530
  test eax, eax
  jz no_path
  mov [path_obj], eax
  jmp have_path

no_path:
  // === Build circular path (player-relative) ===
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // Vertex array: 5 entries (20 bytes)
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [vertex_arr], eax
  mov dword [eax+0], 0
  mov dword [eax+4], 1
  mov dword [eax+8], 2
  mov dword [eax+12], 3
  mov dword [eax+16], 4

  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+20]
  mov [ecx+0x08], edx

  // === X spline: 5 control points (80 bytes) ===
  // Format per point: [b=0][a=0][c=delta][d=start]
  // d = px+R, px, px-R, px, px+R
  // c = -R, -R, +R, +R, 0
  push 80
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [spline_x], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 20
  rep stosd
  pop edi

  // Compute px+R and px-R using FPU
  fld dword [pos_x]
  fadd dword [float_R]
  fstp dword [temp_pxR]
  fld dword [pos_x]
  fsub dword [float_R]
  fstp dword [temp_pxR2]

  mov eax, [spline_x]
  // CP0: d=px+R, c=-R
  mov dword [eax+8], 0xC2A00000   // c = -80.0
  mov edx, [temp_pxR]
  mov [eax+12], edx                // d = px+R
  // CP1: d=px, c=-R
  mov dword [eax+24], 0xC2A00000   // c = -80.0
  mov edx, [pos_x]
  mov [eax+28], edx                // d = px
  // CP2: d=px-R, c=+R
  mov dword [eax+40], 0x42A00000   // c = +80.0
  mov edx, [temp_pxR2]
  mov [eax+44], edx                // d = px-R
  // CP3: d=px, c=+R
  mov dword [eax+56], 0x42A00000   // c = +80.0
  mov edx, [pos_x]
  mov [eax+60], edx                // d = px
  // CP4: d=px+R, c=0
  mov dword [eax+72], 0x00000000   // c = 0.0
  mov edx, [temp_pxR]
  mov [eax+76], edx                // d = px+R

  // === Z spline: 5 control points (80 bytes) ===
  // d = pz, pz+R, pz, pz-R, pz
  // c = +R, -R, -R, +R, 0
  push 80
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [spline_z], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 20
  rep stosd
  pop edi

  // Compute pz+R and pz-R
  fld dword [pos_z]
  fadd dword [float_R]
  fstp dword [temp_pzR]
  fld dword [pos_z]
  fsub dword [float_R]
  fstp dword [temp_pzR2]

  mov eax, [spline_z]
  // CP0: d=pz, c=+R
  mov dword [eax+8], 0x42A00000    // c = +80.0
  mov edx, [pos_z]
  mov [eax+12], edx                // d = pz
  // CP1: d=pz+R, c=-R
  mov dword [eax+24], 0xC2A00000   // c = -80.0
  mov edx, [temp_pzR]
  mov [eax+28], edx                // d = pz+R
  // CP2: d=pz, c=-R
  mov dword [eax+40], 0xC2A00000   // c = -80.0
  mov edx, [pos_z]
  mov [eax+44], edx                // d = pz
  // CP3: d=pz-R, c=+R
  mov dword [eax+56], 0x42A00000   // c = +80.0
  mov edx, [temp_pzR2]
  mov [eax+60], edx                // d = pz-R
  // CP4: d=pz, c=0
  mov dword [eax+72], 0x00000000   // c = 0.0
  mov edx, [pos_z]
  mov [eax+76], edx                // d = pz

  // path+0x34 = X spline ptr, path+0x44 = Z spline ptr
  mov ecx, [path_obj]
  mov edx, [spline_x]
  mov [ecx+0x34], edx
  mov edx, [spline_z]
  mov [ecx+0x44], edx

have_path:
  // === Allocate Saw object ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax

  // === Call Saw_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [saw_ptr]
  call 0043B780

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [saw_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_saw

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_saw

  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_saw:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Initialize saw state for continuous motion ===
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1      // active = 1
  mov dword [ecx+0x10F4], 0     // FSM state = 0 (always moving)
  mov dword [ecx+0x10F0], 0      // Y offset = 0 (no descend/ascend)
  mov dword [ecx+0x10EC], 0      // path counter = 0.0

  // Clear temp pointers
  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x], 0
  mov dword [spline_z], 0

saw_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

float_4_0:
  dd 0x40800000

temp_pxR:
  dd 0
temp_pxR2:
  dd 0
temp_pzR:
  dd 0
temp_pzR2:
  dd 0

00405E22:
  jmp SawCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x)
dealloc(spline_z)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
dealloc(float_R)
dealloc(float_nR)
unregistersymbol(SpawnSaw)
