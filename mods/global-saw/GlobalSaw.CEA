[ENABLE]

// =====================================================
// Global Saw Spawner v5 — Circular Motion
// =====================================================
// v4 worked but saw moved erratically (random speed/distance).
// v5: Builds a proper 4-segment circular path and wraps the
//     path counter (saw+0x10EC) so the saw circles forever.
//
// CIRCULAR PATH:
//   5 vertex entries → 4 segments → count-1 = 4
//   Radius = 80 units around player position
//   Speed = 0.02/frame (original Toob value)
//   = 50 frames/segment × 4 = 200 frames/loop = 8s at 25fps
//   Counter wraps at 4.0 → 0.0 for infinite loop
//
// POST-PROCESSING (from SpeedCylinder pattern):
//   SpatialTree, render list, scene tree, vtable calls,
//   collision list, collision tree, cleanup
// =====================================================

alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(spline_x, 4)
alloc(spline_z, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)

registersymbol(SpawnSaw)

SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
spline_x:
  dd 0
spline_z:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0

label(original_code)
label(saw_done)
label(have_path)
label(no_path)
label(skip_post)
label(activate_saw)

SawCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  // === Counter wrap for circular motion ===
  // Check if saw exists and wrap its path counter
  mov ecx, [saw_ptr]
  test ecx, ecx
  jz check_spawn

  // Read saw+0x10EC (path counter, float)
  fld dword [ecx+0x10EC]
  // Compare with 4.0 (0x40800000)
  fld dword [float_4_0]
  fcomip st(1)
  fstp st(0)
  jae check_spawn
  // Counter >= 4.0 → reset to 0.0
  mov dword [ecx+0x10EC], 0

check_spawn:
  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0

  pushad

  // Verify board + App + gfx
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz saw_done
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done

  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Saw mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done

  push 004D0E24
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz saw_done
  mov [our_mesh], eax

  // === Try to find SAWPATH ===
  mov ecx, [saved_board]
  mov ecx, [ecx+0x8AC]
  test ecx, ecx
  jz no_path
  push 004CFD20
  call 00460530
  test eax, eax
  jz no_path
  mov [path_obj], eax
  jmp have_path

no_path:
  // === Build circular path (5 vertices, 4 segments) ===
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // Vertex array: 5 int32 entries (indices 0-4)
  push 20
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [vertex_arr], eax
  mov dword [eax+0], 0
  mov dword [eax+4], 1
  mov dword [eax+8], 2
  mov dword [eax+12], 3
  mov dword [eax+16], 4

  // path+4 = vertex_start, path+8 = vertex_end (start + 20)
  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+20]
  mov [ecx+0x08], edx

  // === X spline: 5 control points (80 bytes) ===
  // Circular path around player X with radius 80:
  // P0=+R, P1=0, P2=-R, P3=0, P4=+R
  // Linear segments: c=delta per segment, d=start value
  push 80
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [spline_x], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 20
  rep stosd
  pop edi
  // Fill X control points: [b=0, a=0, c=delta, d=value] per segment
  // Seg0: d=+R(px), c=-R  (from +R to 0)
  // Seg1: d=0(px),  c=-R  (from 0 to -R)
  // Seg2: d=-R(px), c=+R  (from -R to 0)
  // Seg3: d=0(px),  c=+R  (from 0 to +R)
  // Seg4: d=+R(px), c=0   (endpoint, no movement)
  mov eax, [spline_x]
  mov edx, [pos_x]
  // Seg0: d=pos_x+R, c=-R
  mov [eax+12], edx        // d = pos_x (base offset, saw adds R via Gfx_SetPosition)
  mov dword [eax+8], 0xBF42C800 // c = -80.0 wait no, let me use proper encoding
  // Actually: pos_x is the player position. The saw's Path_GetPosition
  // returns X/Z offsets. The saw adds these to its base position.
  // So spline values should be RELATIVE to center (0-based).
  // Seg0: d=+R, c=-R
  mov dword [eax+0], 0     // b=0
  mov dword [eax+4], 0     // a=0
  mov dword [eax+8], 0xC2A00000  // c = -80.0
  mov dword [eax+12], 0x42A00000 // d = +80.0
  // Seg1: d=0, c=-R
  mov dword [eax+16], 0
  mov dword [eax+20], 0
  mov dword [eax+24], 0xC2A00000 // c = -80.0
  mov dword [eax+28], 0x00000000 // d = 0.0
  // Seg2: d=-R, c=+R
  mov dword [eax+32], 0
  mov dword [eax+36], 0
  mov dword [eax+40], 0x42A00000  // c = +80.0
  mov dword [eax+44], 0xC2A00000  // d = -80.0
  // Seg3: d=0, c=+R
  mov dword [eax+48], 0
  mov dword [eax+52], 0
  mov dword [eax+56], 0x42A00000  // c = +80.0
  mov dword [eax+60], 0x00000000 // d = 0.0
  // Seg4: d=+R, c=0 (endpoint)
  mov dword [eax+64], 0
  mov dword [eax+68], 0
  mov dword [eax+72], 0x00000000  // c = 0.0
  mov dword [eax+76], 0x42A00000  // d = +80.0

  // === Z spline: 5 control points (80 bytes) ===
  // P0=0, P1=+R, P2=0, P3=-R, P4=0
  push 80
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [spline_z], eax
  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 20
  rep stosd
  pop edi
  mov eax, [spline_z]
  // Seg0: d=0, c=+R
  mov dword [eax+0], 0
  mov dword [eax+4], 0
  mov dword [eax+8], 0x42A00000  // c = +80.0
  mov dword [eax+12], 0x00000000 // d = 0.0
  // Seg1: d=+R, c=-R
  mov dword [eax+16], 0
  mov dword [eax+20], 0
  mov dword [eax+24], 0xC2A00000 // c = -80.0
  mov dword [eax+28], 0x42A00000 // d = +80.0
  // Seg2: d=0, c=-R
  mov dword [eax+32], 0
  mov dword [eax+36], 0
  mov dword [eax+40], 0xC2A00000 // c = -80.0
  mov dword [eax+44], 0x00000000 // d = 0.0
  // Seg3: d=-R, c=+R
  mov dword [eax+48], 0
  mov dword [eax+52], 0
  mov dword [eax+56], 0x42A00000  // c = +80.0
  mov dword [eax+60], 0xC2A00000 // d = -80.0
  // Seg4: d=0, c=0 (endpoint)
  mov dword [eax+64], 0
  mov dword [eax+68], 0
  mov dword [eax+72], 0x00000000  // c = 0.0
  mov dword [eax+76], 0x00000000  // d = 0.0

  // path+0x34 = X spline ptr, path+0x44 = Z spline ptr
  mov ecx, [path_obj]
  mov edx, [spline_x]
  mov [ecx+0x34], edx
  mov edx, [spline_z]
  mov [ecx+0x44], edx

have_path:
  // === Allocate Saw object ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax

  // === Call Saw_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [saw_ptr]
  call 0043B780

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [saw_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_saw

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_saw

  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_saw:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // Activate saw
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0
  mov dword [spline_x], 0
  mov dword [spline_z], 0

saw_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

float_4_0:
  dd 0x40800000

00405E22:
  jmp SawCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(spline_x)
dealloc(spline_z)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnSaw)
