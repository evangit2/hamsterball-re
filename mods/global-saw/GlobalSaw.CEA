[ENABLE]

// =====================================================
// Global Saw Spawner v10 — Always at P1 + Dizzy Collision
// =====================================================
// v9b fixes:
// 1. Always uses dummy path (no SAWPATH search)
//    → Saw stays at player 1 position on ALL levels including Toob
// 2. Per-frame proximity dizzy check
//    → When any ball is near the saw, set ball dizzy timer
//    → Works on ALL levels (bypasses per-board collision handlers)
//
// Dizzy mechanism: ball+0x808 = timer (10 = ~0.4s at 25fps)
// When > 0, ball can't be controlled (same as N:NOCONTROL event).
// =====================================================

alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(vertex_arr, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)
alloc(saw_radius_sq, 4)

registersymbol(SpawnSaw)

SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
vertex_arr:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0
saw_radius_sq:
  dd 0x47200000       // 100.0^2 = 10000.0 (dizzy range)

label(original_code)
label(saw_done)
label(skip_post)
label(activate_saw)
label(check_dizzy)
label(dizzy_done)

SawCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  // === Per-frame: check if ball is near saw → make dizzy ===
  mov ecx, [saw_ptr]
  test ecx, ecx
  jz check_spawn

  // Read saw position
  fld dword [ecx+0x10DC]       // saw X
  fsub dword [esi+0x164]       // saw X - ball X
  fmul st(0), st(0)             // (sawX - ballX)^2

  fld dword [ecx+0x10E4]       // saw Z
  fsub dword [esi+0x16C]       // saw Z - ball Z
  fmul st(0), st(0)             // (sawZ - ballZ)^2

  faddp                        // dist_sq = dx^2 + dz^2
  fld dword [saw_radius_sq]    // 10000.0
  fcomip st(1)                 // compare 10000.0 with dist_sq
  fstp st(0)                   // pop dist_sq
  jb check_spawn               // if 10000.0 < dist_sq (ball is far), skip dizzy

  // Ball is near saw → set dizzy timers (refresh every frame while in range)
  // ball+0x7DC = stun/dizzy timer (50 frames = 2s, shows stars + sound)
  // ball+0x808 = no-control timer (10 frames, disables input)
  // No cooldown — ball stays dizzy while near saw, recovers when it moves away
  mov dword [esi+0x7DC], 50    // dizzy stun timer
  mov dword [esi+0x808], 10    // no-control timer

check_spawn:
  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz saw_done
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done

  // Get player position
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax

  // === Load fresh Level8-Saw mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done

  push 004D0E24
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz saw_done
  mov [our_mesh], eax

  // === Always build dummy path (1 vertex, no movement) ===
  // Never search for SAWPATH — saw stays at player 1 position on ALL levels
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi

  // 1 vertex entry (4 bytes)
  push 4
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [vertex_arr], eax
  mov dword [eax], 0

  // path+4 = vertex_start, path+8 = vertex_end (start+4)
  mov ecx, [path_obj]
  mov edx, [vertex_arr]
  mov [ecx+0x04], edx
  lea edx, [edx+4]
  mov [ecx+0x08], edx

  // === Allocate Saw object ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax

  // === Call Saw_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [saw_ptr]
  call 0043B780

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [saw_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_saw

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_saw

  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_saw:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Initialize saw state ===
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1      // active = 1
  mov dword [ecx+0x10F4], 0     // FSM state = 0 (descend)
  mov dword [ecx+0x10F0], 0     // Y offset = 0 (start at surface)
  mov dword [ecx+0x10EC], 0     // path counter = 0

  // Initialize direction vector
  mov dword [ecx+0x1100], 0          // dir X = 0.0
  mov dword [ecx+0x1104], 0          // dir Y = 0.0
  mov dword [ecx+0x1108], 0x3F800000  // dir Z = 1.0 (facing forward)

  mov dword [our_mesh], 0
  mov dword [path_obj], 0
  mov dword [vertex_arr], 0

saw_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SawCode
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(vertex_arr)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
dealloc(saw_radius_sq)
unregistersymbol(SpawnSaw)
