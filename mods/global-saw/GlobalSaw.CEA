[ENABLE]
 
// =====================================================
// Global Saw Spawner v1
// =====================================================
// Spawns a working Saw (from Toob Race / Level8) on any level.
//
// HOW THE SAW WORKS (traced via Ghidra):
//   1. LevelBoard_Toob_ctor (0x41F4B0) loads the Saw mesh:
//      "Levels\Level8-Saw" -> board+0x4370
//   2. FUN_0040fc29 creates the Saw by calling:
//      a. Level_FindObjectByName(scene, "SAWPATH") -> path
//      b. Saw_ctor (0x43B780): calls Stands_ctor, sets vtable
//         0x4D5578, stores board at +0x10D0, position at +0x10DC,
//         path at +0x10D8, clones mesh, calls Update+Render once.
//      c. AthenaList_Append(board+0x2578, saw)
//      d. board+0x4380 = saw (Saw1 slot)
//   3. Saw_Update (vtable[0x0B] = 0x43B8E0) — movement FSM:
//      Checks saw+0x110C (active flag). If set, 4-state cycle:
//        State 0: moving forward, decrement Y, when done -> state 1
//        State 1: pause (countdown timer), when done -> state 2
//        State 2: moving forward, increment Y, play sawsoundy, -> state 3
//        State 3: pause (countdown timer), when done -> state 0
//      Movement follows SAWPATH via Path_GetPosition (0x467BF0).
//      Blade rotation via Gfx_ScaleZ(180.0) + Gfx_RotateY.
//   4. Activation: Toob Race collision handler (0x410020) directly sets
//      saw+0x110C = 1 (byte) via E:BRANCH(A) event. This is the flag
//      Saw_Update checks. NOTE: Saw_Activate (0x434A50) sets a DIFFERENT
//      flag (saw+0x1114) used by Expert Race — NOT Toob Race.
//   5. Collision: N:SAWTEETH triggers knockback in ToobBoard's
//      collision handler (0x410020). Knockback velocity from
//      saw+0x1100 (break direction), magnitude 3.0.
//
// NOTE: The Saw needs a SAWPATH (path from MESHWORLD) to move.
// Non-Toob levels don't have SAWPATH — the saw will still render
// and spin, but won't move along a track.
//
// HOOK: Ball_Update at 0x405E22
//   Original: 8B 86 5C 0C 00 00 = mov eax, [esi+0x0C5C]
//   ESI = player ball pointer
//
// HOTKEY: Set [SpawnSaw] to 1 via CE to spawn a saw
// =====================================================
 
alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(mesh_ptr, 4)
alloc(path_result, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)
 
registersymbol(SpawnSaw)
 
SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
mesh_ptr:
  dd 0
path_result:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0
 
label(original_code)
label(saw_done)
label(skip_mesh)
label(no_path)
label(have_path)
label(mesh_resolved)
label(spawn_complete)
 
SawCode:
  // Save board pointer from ball+0x14
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code
 
  // Check spawn flag
  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0
 
  pushad
 
  // Verify board
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
 
  // Verify App pointer (board+0x878)
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
 
  // Verify gfx_device (App+0x174)
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done
 
  // === Get player position ===
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax
 
  // === Load Saw mesh if not already at board+0x4370 ===
  mov edx, [saved_board]
  mov eax, [edx+0x4370]
  test eax, eax
  jnz skip_mesh
 
  // Allocate mesh object (0x10D0 bytes)
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
 
  // FUN_00461510(mesh, gfx_device, filename)
  // __thiscall: ECX=mesh, push filename then gfx_device
  push 004D0E24               // "Levels\Level8-Saw"
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]       // gfx_device
  push ecx
  mov ecx, eax               // this = new mesh
  call 00461510
  test eax, eax
  jz saw_done
 
  // Store mesh in board+0x4370
  mov edx, [saved_board]
  mov [edx+0x4370], eax
 
skip_mesh:
  // === Find SAWPATH in scene ===
  // Level_FindObjectByName(scene, "SAWPATH")
  // __thiscall: ECX=scene, push name
  mov ecx, [saved_board]
  mov ecx, [ecx+0x8AC]
  test ecx, ecx
  jz no_path
  push 004CFD20               // "SAWPATH"
  call 00460530               // Level_FindObjectByName
  mov [path_result], eax
  test eax, eax
  jz no_path
  jmp have_path
 
no_path:
  mov dword [path_result], 0
 
have_path:
  // === Allocate Saw object (0x1118 bytes) ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax
 
  // === Resolve mesh pointer ===
  // Use mesh_ptr if set, otherwise use board+0x4370
  mov edx, [saved_board]
  mov edx, [edx+0x4370]
  mov [mesh_ptr], edx
  test edx, edx
  jz saw_done                 // can't spawn without mesh
 
  // === Call Saw_ctor ===
  // Saw_ctor(this=ECX, board, posX, posY, posZ, mesh, path)
  // __thiscall: ECX=this, push params right-to-left:
  //   push path, push mesh, push Z, push Y, push X, push board
  push dword [path_result]    // param_6 = path (SAWPATH or 0)
  push dword [mesh_ptr]       // param_5 = mesh
  push dword [pos_z]          // param_4 = Z
  push dword [pos_y]          // param_3 = Y
  push dword [pos_x]          // param_2 = X
  push dword [saved_board]    // param_1 = board
  mov ecx, [saw_ptr]         // ECX = this
  call 0043B780               // Saw_ctor
 
  // === Store saw in board+0x4380 (Saw1 slot) ===
  mov edx, [saved_board]
  mov eax, [saw_ptr]
  mov [edx+0x4380], eax
 
  // === Register in board's update list (board+0x2578) ===
  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810               // AthenaList_Append
 
  // === Activate the saw (Toob Race method) ===
  // In Toob Race, the collision handler (0x410020) activates the saw
  // by directly setting saw+0x110C = 1 (byte). This is the flag that
  // Saw_Update (0x43B8E0) checks at the top of its function.
  // NOTE: Saw_Activate (0x434A50) sets saw+0x1114 — a DIFFERENT flag
  // used by Expert Race, NOT Toob Race. We set the correct flag.
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1
 
spawn_complete:
  mov dword [mesh_ptr], 0
 
saw_done:
  popad
 
original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28
 
00405E22:
  jmp SawCode
  nop
 
[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00
 
dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(mesh_ptr)
dealloc(path_result)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
unregistersymbol(SpawnSaw)
