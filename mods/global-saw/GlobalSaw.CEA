[ENABLE]

// =====================================================
// Global Saw Spawner v8 — Direct Position Override
// =====================================================
// v7 still glitchy because the game's path system fights
// our counter wrap. Path_GetPosition stutters when the
// counter is near count-1, causing teleporting.
//
// v8 SOLUTION: Bypass the game's path system ENTIRELY.
// - Dummy path has 0 vertices → Saw_Update skips Path_GetPosition
// - Every frame, directly compute circular X/Z using FSINCOS
// - Write to saw+0x10DC (X) and saw+0x10E4 (Z) directly
// - Saw_Update still runs (spins blade, renders) but doesn't
//   modify position because Path_GetPosition is skipped
// - Y offset patches (NOP FSUB/FADD) keep Y at player level
//
// MOTION: Perfect circle, radius 80, centered on player 1
// Speed: 0.02 counter/frame = 200 frames/loop = 8s at 25fps
// =====================================================

alloc(SawCode, 4096)
alloc(SpawnSaw, 4)
alloc(saved_board, 4)
alloc(saw_ptr, 4)
alloc(our_mesh, 4)
alloc(path_obj, 4)
alloc(pos_x, 4)
alloc(pos_y, 4)
alloc(pos_z, 4)
alloc(angle, 4)
alloc(center_x, 4)
alloc(center_z, 4)
alloc(float_R, 4)
alloc(float_speed, 4)
alloc(float_4_0, 4)

registersymbol(SpawnSaw)

SpawnSaw:
  dd 0
saved_board:
  dd 0
saw_ptr:
  dd 0
our_mesh:
  dd 0
path_obj:
  dd 0
pos_x:
  dd 0
pos_y:
  dd 0
pos_z:
  dd 0
angle:
  dd 0
center_x:
  dd 0
center_z:
  dd 0
float_R:
  dd 0x42A00000       // 80.0
float_speed:
  dd 0x3CA3D70A       // 0.02
float_4_0:
  dd 0x40800000       // 4.0

label(original_code)
label(saw_done)
label(have_path)
label(no_path)
label(skip_post)
label(activate_saw)
label(do_spawn)
label(update_saw)

SawCode:
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code

  // === PER-FRAME SAW POSITION OVERRIDE ===
  mov ecx, [saw_ptr]
  test ecx, ecx
  jz check_spawn

update_saw:
  // Increment angle counter
  fld dword [angle]
  fadd dword [float_speed]
  fstp dword [angle]

  // Wrap at 4.0 → 0.0
  fld dword [angle]
  fld dword [float_4_0]
  fcomip st(1)
  fstp st(0)
  jbe check_spawn
  mov dword [angle], 0

check_spawn:
  // === Write saw position from angle ===
  mov ecx, [saw_ptr]
  test ecx, ecx
  jz do_spawn_check

  // Compute X = center_x + R * cos(angle * pi/2)
  // Compute Z = center_z + R * sin(angle * pi/2)
  fld dword [angle]          // ST(0) = angle counter
  fldpi                      // ST(0) = pi, ST(1) = angle
  fmulp st(1), st(0)         // ST(0) = angle * pi
  fld1                       // ST(0) = 1.0, ST(1) = angle*pi
  fadd st(0), st(0)          // ST(0) = 2.0, ST(1) = angle*pi
  fdivp st(1), st(0)         // ST(0) = angle*pi/2 (radians)
  fsincos                     // ST(0) = cos, ST(1) = sin
  fmul dword [float_R]       // ST(0) = cos*R
  fadd dword [center_x]     // ST(0) = center_x + cos*R = saw_x
  fstp dword [ecx+0x10DC]   // saw->X = saw_x
  fmul dword [float_R]       // ST(0) = sin*R
  fadd dword [center_z]     // ST(0) = center_z + sin*R = saw_z
  fstp dword [ecx+0x10E4]   // saw->Z = saw_z

  // Force Y to player level
  mov edx, [pos_y]
  mov [ecx+0x10E0], edx

do_spawn_check:
  cmp dword [SpawnSaw], 0
  je original_code
  mov dword [SpawnSaw], 0

  pushad

  // Verify board + App + gfx + scene
  mov eax, [saved_board]
  test eax, eax
  jz saw_done
  mov edx, [eax+0x8AC]
  test edx, edx
  jz saw_done
  mov edx, [eax+0x878]
  test edx, edx
  jz saw_done
  mov edx, [edx+0x174]
  test edx, edx
  jz saw_done

do_spawn:
  // Get player position as circle center
  mov eax, [esi+0x164]
  mov [pos_x], eax
  mov [center_x], eax
  mov eax, [esi+0x168]
  mov [pos_y], eax
  mov eax, [esi+0x16C]
  mov [pos_z], eax
  mov [center_z], eax
  mov dword [angle], 0

  // === Load fresh Level8-Saw mesh ===
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done

  push 004D0E24
  mov ecx, [saved_board]
  mov ecx, [ecx+0x878]
  mov ecx, [ecx+0x174]
  push ecx
  mov ecx, eax
  call 00461510
  test eax, eax
  jz saw_done
  mov [our_mesh], eax

  // === Try to find SAWPATH (for Toob Race compatibility) ===
  mov ecx, [saved_board]
  mov ecx, [ecx+0x8AC]
  test ecx, ecx
  jz no_path
  push 004CFD20
  call 00460530
  test eax, eax
  jz no_path
  mov [path_obj], eax
  jmp have_path

no_path:
  // === Build dummy path (0 vertices, so Path_GetPosition is skipped) ===
  push 0x48
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [path_obj], eax

  push edi
  mov edi, eax
  xor eax, eax
  mov ecx, 0x12
  rep stosd
  pop edi
  // path+4=0, path+8=0 → count=0, count-1=-1
  // Saw_Update: fVar1 < -1 → FALSE → Path_GetPosition skipped

have_path:
  // === Allocate Saw object ===
  push 0x1118
  call 004BA57B
  add esp, 4
  test eax, eax
  jz saw_done
  mov [saw_ptr], eax

  // === Call Saw_ctor ===
  push dword [path_obj]
  push dword [our_mesh]
  push dword [pos_z]
  push dword [pos_y]
  push dword [pos_x]
  push dword [saved_board]
  mov ecx, [saw_ptr]
  call 0043B780

  // === POST-PROCESSING (SpeedCylinder pattern) ===
  sub esp, 68
  mov ebx, esp
  mov ecx, ebx
  call 00457AD0

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0xCD4
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8AC]
  mov edx, [edx+0x480]
  test edx, edx
  jz skip_post

  push dword [saw_ptr]
  lea ecx, [edx+0x1C]
  call 00453810

  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x58]

  push ebx
  mov ecx, [saw_ptr]
  mov eax, [saw_ptr]
  mov eax, [eax]
  call dword [eax+0x54]

skip_post:
  // Collision registration
  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  test ecx, ecx
  jz activate_saw

  push ecx
  mov edx, [saved_board]
  add edx, 0x10EC
  mov ecx, edx
  call 00453810

  mov edx, [saved_board]
  mov edx, [edx+0x8B0]
  test edx, edx
  jz activate_saw

  mov ecx, [saw_ptr]
  mov ecx, [ecx+0x10D4]
  push ecx
  lea ecx, [edx+0x18]
  call 00453810

activate_saw:
  mov ecx, ebx
  call 00457A40
  add esp, 68

  push dword [saw_ptr]
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810

  // === Initialize saw state ===
  mov ecx, [saw_ptr]
  mov byte [ecx+0x110C], 1      // active = 1
  mov dword [ecx+0x10F4], 0     // FSM state = 0
  mov dword [ecx+0x10F0], 0      // Y offset = 0
  mov dword [ecx+0x10EC], 0      // path counter = 0

  // Write initial position
  fld dword [center_x]
  fstp dword [ecx+0x10DC]       // saw X = center_x
  mov edx, [pos_y]
  mov [ecx+0x10E0], edx          // saw Y = player Y
  fld dword [center_z]
  fstp dword [ecx+0x10E4]       // saw Z = center_z

  mov dword [our_mesh], 0
  mov dword [path_obj], 0

saw_done:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SawCode
  nop

// === Patch Saw_Update: NOP Y offset FSUB and FADD ===
// Keeps Y at 0.0, prevents descending/ascending
0043BA66:
  db 90 90 90 90 90 90

0043BA9D:
  db 90 90 90 90 90 90

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00

0043BA66:
  db DC 25 90 5C 4D 00

0043BA9D:
  db DC 05 78 01 4D 00

dealloc(SawCode)
dealloc(SpawnSaw)
dealloc(saved_board)
dealloc(saw_ptr)
dealloc(our_mesh)
dealloc(path_obj)
dealloc(pos_x)
dealloc(pos_y)
dealloc(pos_z)
dealloc(angle)
dealloc(center_x)
dealloc(center_z)
dealloc(float_R)
dealloc(float_speed)
dealloc(float_4_0)
unregistersymbol(SpawnSaw)
