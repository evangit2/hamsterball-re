[ENABLE]

alloc(SpawnCode, 4096)
alloc(SpawnBonk, 4)
alloc(saved_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)

registersymbol(SpawnBonk)

SpawnBonk:
  dd 0

saved_board:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

label(original_code)
label(done_spawn)

SpawnCode:
  cmp dword [SpawnBonk], 0
  je original_code

  mov dword [SpawnBonk], 0

  pushad

  // esi = ball pointer (from Ball_Update context)
  mov eax, [esi+0x14]
  test eax, eax
  jz done_spawn
  mov [saved_board], eax

  // Get player position
  mov ecx, [esi+0x164]
  mov [playerX], ecx
  mov ecx, [esi+0x168]
  mov [playerY], ecx
  mov ecx, [esi+0x16C]
  mov [playerZ], ecx

  // Get Board
  mov ebx, [saved_board]
  test ebx, ebx
  jz done_spawn

  // Check App is valid
  mov edx, [ebx+0x878]
  test edx, edx
  jz done_spawn

  // ==========================================
  // SPAWN BONK (Hammer)
  // alloc 0x1200, ctor 0x438850, ret 0x10
  // The constructor loads its OWN mesh ("levels\level5-bonk")
  // via MeshWorld_ctor(0x461510) internally.
  // It also creates its own CollisionLevel.
  // No external mesh loading or AthenaList init needed!
  // ==========================================
  push 1200
  call 004BA57B               // operator_new
  add esp, 4
  test eax, eax
  jz done_spawn

  sub esp, 0C                 // pos XYZ on stack
  mov ecx, [playerX]
  mov [esp], ecx
  mov ecx, [playerY]
  mov [esp+4], ecx
  mov ecx, [playerZ]
  mov [esp+8], ecx
  push ebx                    // Board (param_1)
  mov ecx, eax                // this
  call 00438850               // BONK_ctor  ret 0x10

  // Append to Board+0x2578 (general list — always init'd by Board_ctor)
  push eax
  lea ecx, [ebx+0x2578]
  call 00453810               // AthenaList_Append  ret 4

  // Store at Board+0x436C (for E:CALLHAMMER collision event)
  mov [ebx+0x436C], eax

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SpawnCode
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnBonk)
dealloc(saved_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
unregistersymbol(SpawnBonk)
