// ################################# │    E V E N T S    │ #################################
// trigger_type: 0 = every touch (default), 1 = once, 2 = level start + loop, 3 = once at level start.
// pause: true = silent while paused (default), false = keeps playing.
[
    // Sound Effects
    "E:sfx_bell", { "trigger_type": 2, "loop_delay": 200, "sound1": "Testrand1", "sound2": "Testrand2", "sound3": "Testrand3" }
]
