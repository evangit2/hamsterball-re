// ═══════════════════════════════════════════════════════════════════════
// SHAPESHIFT MOD v2 — Transform Player 1 into 8-Ball / BadBall
// Fixes: black ball, dark lighting, wrong size/speed, crash on disable
//
// ROOT CAUSE OF ISSUES (traced from binary):
//   1. BLACK BALL: Ball_Render_AI (0x402DE0) checks ball+0xC80 (dark mode
//      flag). When set to 1, it reads ball+0xC88/C8C/C90 (viewport clip
//      matrix) to set ambient color. Player balls DON'T have these fields
//      initialized (only Ball_ctor sets them, not Ball_ctor2) → garbage
//      values → ambient=black → ball renders invisible/dark.
//      FIX: Don't set +0xC80 on player ball. The AI render function works
//      fine without it — it just renders the 8Ball mesh normally.
//
//   2. DARK LIGHTING: Same root cause. +0xC80=1 triggers the dark mode
//      path which sets ambient=black after rendering. Removing +0xC80
//      fixes both issues.
//
//   3. WRONG SIZE/SPEED: Player balls have radius=26.0, max_speed=5.0.
//      AI 8-balls have radius=35.0, max_speed=6.0 (Ball_InitPhysicsDefaults).
//      FIX: Swap these values when transforming.
//
//   4. CRASH ON DISABLE: When the CEA script is disabled, the hook code
//      is removed and g_CustomVtable is freed. But ball+0x00 still points
//      to the freed custom vtable → crash on next vtable call.
//      FIX: In DISABLE, restore ball+0x00 to 0x4CF314 BEFORE freeing memory.
//
// PHYSICS VALUES:
//   Player (Ball_ctor2):    radius(+0x284)=26.0 (0x41D00000), max_speed(+0x188)=5.0 (0x40A00000)
//   AI 8Ball (Ball_InitPhysicsDefaults 0x405100): radius=35.0 (0x420C0000), max_speed=6.0 (0x40C00000)
//
// HOOK POINT: Ball_Update entry at 0x00405E22
//   Original: MOV EAX, [ESI+0xC5C] (6 bytes)
//   ESI = ball pointer (set at 0x00405E20: MOV ESI,ECX)
// ═══════════════════════════════════════════════════════════════════════

[ENABLE]

// ── AOB scan ───────────────────────────────────────────────────────────
aobscanmodule(Ball_Update_Entry, Hamsterball.exe, 8B 86 5C 0C 00 00 D9 86 50 0C 00 00 48 D8 0D 40 F5 4C 00 33)

// ── Allocs ─────────────────────────────────────────────────────────────
alloc(g_PlayerBall, 4)
alloc(g_ShapeState, 4)
alloc(g_CustomVtable, 84)
alloc(shapeshift_hook, 256)

registersymbol(g_PlayerBall)
registersymbol(g_ShapeState)
registersymbol(g_CustomVtable)

// ── Custom vtable: player vtable copy with vtable[2] = AI render ──────
g_CustomVtable:
  dd 00402A50                    // [0] dtor (player)
  dd 004015B0                    // [1] SetupCollisionRender (player)
  dd 00402DE0                    // [2] Ball Render = AI 8-BALL RENDER ← PATCHED
  dd 00402A70                    // [3] GetTransform (shared)
  dd 00405E00                    // [4] Ball_Update (player) ← KEEPS INPUT
  dd 00401590                    // [5] sub (shared)
  dd 004016F0                    // [6] ApplyForce (player)
  dd 00402C10                    // [7] RenderWithCollision (shared)
  dd 00409050                    // [8] SplitAndExplode (player)
  dd 00401640                    // [9]
  dd 00457B10                    // [10]
  dd 00457B50                    // [11]
  dd 00457A70                    // [12]
  dd 00457A50                    // [13]
  dd 00401000                    // [14]
  dd 00457B80                    // [15]
  dd 00457BB0                    // [16]
  dd 00457C60                    // [17]
  dd 00457C90                    // [18]
  dd 00457CC0                    // [19]
  dd 00457CF0                    // [20]

// ── Init globals ───────────────────────────────────────────────────────
g_PlayerBall:
  dd 00000000

g_ShapeState:
  dd 00000000

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update entry (0x00405E22)
// Original: MOV EAX, [ESI+0xC5C] (6 bytes)
// ESI = ball pointer
// ═══════════════════════════════════════════════════════════════════════
shapeshift_hook:
  push eax

  // Check if this is player 1: ball+0x18 == 0
  mov eax, [esi+0x18]
  test eax, eax
  jnz shapeshift_done

  // P1 ball — save pointer
  mov [g_PlayerBall], esi

  // Check shapeshift state
  mov eax, [g_ShapeState]
  test eax, eax
  jz shapeshift_revert

  // ═════════════════════════════════════════════════════════════════════
  // SHAPESHIFT ON: transform to 8-Ball
  // ═════════════════════════════════════════════════════════════════════

  // 1. Swap vtable to custom (AI render + player update)
  mov eax, g_CustomVtable
  mov [esi], eax

  // 2. Set AI physics: radius(+0x284) = 35.0 (0x420C0000)
  mov dword ptr [esi+0x284], 420C0000

  // 3. Set AI physics: max_speed(+0x188) = 6.0 (0x40C00000)
  mov dword ptr [esi+0x188], 40C00000

  // 4. DO NOT set ball+0xC80 — it causes black ball + dark lighting
  //    The AI render works fine without it

  jmp shapeshift_done

shapeshift_revert:
  // ═════════════════════════════════════════════════════════════════════
  // SHAPESHIFT OFF: revert to normal player ball
  // ═════════════════════════════════════════════════════════════════════

  // 1. Restore player vtable
  mov dword ptr [esi], 004CF314

  // 2. Restore player physics: radius(+0x284) = 26.0 (0x41D00000)
  mov dword ptr [esi+0x284], 41D00000

  // 3. Restore player physics: max_speed(+0x188) = 5.0 (0x40A00000)
  mov dword ptr [esi+0x188], 40A00000

shapeshift_done:
  pop eax

  // Original instruction: MOV EAX, [ESI+0xC5C]
  mov eax, [esi+0x00000C5C]

  // Jump back to 0x405E28
  jmp Ball_Update_Entry+6

// ── Install hook ───────────────────────────────────────────────────────
Ball_Update_Entry:
  jmp shapeshift_hook
  nop

[DISABLE]

// ── Restore original code ──────────────────────────────────────────────
Ball_Update_Entry:
  db 8B 86 5C 0C 00 00

// ── CRASH FIX: restore ball vtable BEFORE freeing memory ──────────────
// g_PlayerBall holds the last known P1 ball pointer.
// We must write 0x4CF314 back to ball+0x00 before deallocating g_CustomVtable,
// otherwise the game crashes when it tries to call through the freed vtable.
alloc(neon_cleanup, 64)
neon_cleanup:
  mov eax, [g_PlayerBall]
  test eax, eax
  jz neon_cleanup_done
  mov dword ptr [eax], 004CF314
  // Also restore player physics values
  mov dword ptr [eax+0x284], 41D00000
  mov dword ptr [eax+0x188], 40A00000
neon_cleanup_done:
  ret

call neon_cleanup

dealloc(neon_cleanup)

// ── Cleanup ────────────────────────────────────────────────────────────
unregistersymbol(g_PlayerBall)
unregistersymbol(g_ShapeState)
unregistersymbol(g_CustomVtable)

dealloc(shapeshift_hook)
dealloc(g_CustomVtable)
dealloc(g_ShapeState)
dealloc(g_PlayerBall)

// ═══════════════════════════════════════════════════════════════════════
// HOTKEYS — set in Cheat Engine table:
//   Numpad 1 → Set g_ShapeState = 1 (transform to 8-Ball)
//   Numpad 0 → Set g_ShapeState = 0 (revert to hamster ball)
//
// When ON:  vtable[2]=AI render (8Ball mesh), radius=35.0, max_speed=6.0
// When OFF: vtable[2]=player render (Sphere+hamster), radius=26.0, max_speed=5.0
// Player 1 retains FULL CONTROL at all times (vtable[4]=Ball_Update, player_index=0)
// ═══════════════════════════════════════════════════════════════════════
