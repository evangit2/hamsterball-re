[ENABLE]

alloc(g_PlayerBall, 4)
alloc(g_CustomVtable, 84)
alloc(g_WhiteMaterial, 68)
alloc(shapeshift_hook, 256)
alloc(shapeshift_render_wrapper, 512)

registersymbol(g_PlayerBall)

g_PlayerBall:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(shapeshift_done)

// ═══════════════════════════════════════════════════════════════════════
// RENDER WRAPPER v7
// CRASH FIX: D3D __stdcall calls clobber EAX/ECX/EDX. Must reload
//   device + vtable after EVERY D3D call.
// BLACK BALL FIX: SetMaterial(white emissive) + LIGHTING=0 before render.
//   With LIGHTING=0: FinalColor = Emissive = white. No normals needed.
// ═══════════════════════════════════════════════════════════════════════
shapeshift_render_wrapper:
  push ebx
  push esi
  push edi
  mov esi, ecx                    // ESI = ball

  // EBX = gfx (preserved across stdcall calls)
  mov ebx, [esi+0x10]
  mov ebx, [ebx+0x174]           // EBX = gfx

  // --- SetMaterial(white) ---
  mov eax, [ebx+0x154]           // EAX = D3D device
  mov ecx, [eax]                 // ECX = D3D vtable
  push g_WhiteMaterial           // param: material
  push eax                       // param: device
  call dword ptr [ecx+0xA8]     // SetMaterial — clobbers EAX/ECX/EDX

  // --- SetRenderState(AMBIENT, white) ---
  mov eax, [ebx+0x154]           // reload D3D device
  mov ecx, [eax]                 // reload vtable
  push FFFFFFFF                  // value = white
  push 8B                        // state = D3DRS_AMBIENT
  push eax                       // device
  call dword ptr [ecx+0xC8]     // SetRenderState — clobbers

  // --- SetRenderState(LIGHTING, 0) ---
  mov eax, [ebx+0x154]           // reload
  mov ecx, [eax]
  push 0                         // value = disable
  push 89                        // state = D3DRS_LIGHTING
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState — clobbers

  // --- Save ambient, set cached to white ---
  push dword ptr [ebx+0x730]     // save on stack
  mov dword ptr [ebx+0x730], FFFFFFFF

  // --- Call Ball_Render_AI ---
  mov ecx, esi
  mov eax, 00402DE0
  call eax

  // --- Restore cached ambient ---
  pop dword ptr [ebx+0x730]

  // --- SetRenderState(AMBIENT, original) ---
  mov eax, [ebx+0x154]           // reload
  mov ecx, [eax]
  push dword ptr [ebx+0x730]     // original value
  push 8B
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState — clobbers

  // --- SetRenderState(LIGHTING, 1) ---
  mov eax, [ebx+0x154]           // reload
  mov ecx, [eax]
  push 1                         // value = enable
  push 89                        // state = D3DRS_LIGHTING
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState — clobbers

  pop edi
  pop esi
  pop ebx
  ret

g_CustomVtable:
  dd 00402A50
  dd 004015B0
  dd shapeshift_render_wrapper
  dd 00402A70
  dd 00405E00
  dd 00401590
  dd 004016F0
  dd 00402C10
  dd 00409050
  dd 00401640
  dd 00457B10
  dd 00457B50
  dd 00457A70
  dd 00457A50
  dd 00401000
  dd 00457B80
  dd 00457BB0
  dd 00457C60
  dd 00457C90
  dd 00457CC0
  dd 00457CF0

shapeshift_hook:
  push eax

  mov eax, [esi+18]
  test eax, eax
  jnz shapeshift_done

  mov [g_PlayerBall], esi

  mov [esi], g_CustomVtable
  mov dword ptr [esi+284], 420C0000
  mov dword ptr [esi+188], 40C00000

shapeshift_done:
  pop eax
  mov eax, [esi+0c5c]
  jmp 00405E28

00405E22:
  jmp shapeshift_hook
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00
