[ENABLE]

alloc(g_PlayerBall, 4)
alloc(g_CustomVtable, 84)
alloc(g_WhiteMaterial, 68)
alloc(shapeshift_hook, 256)
alloc(shapeshift_render_wrapper, 512)

registersymbol(g_PlayerBall)

g_PlayerBall:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

// ═══════════════════════════════════════════════════════════════════════
// RENDER WRAPPER v10
// ROOT CAUSE: v9 called Ball_RenderAI (0x402DE0 = AI render) instead of
//   Ball_Render (0x403DC0 = player render). AI render uses
//   App+0x244[ball+0x754] for mesh (Sphere, not 8Ball). Player render
//   uses App+0x268 (8Ball directly).
// FIX: Call Ball_Render (0x403DC0), NOT Ball_RenderAI (0x402DE0).
//   No SetMaterial or LIGHTING changes needed — Ball_Render already
//   renders the 8Ball mesh properly with normal lighting.
// ═══════════════════════════════════════════════════════════════════════
shapeshift_render_wrapper:
  // Simply call the player ball render function
  // ECX = ball (this pointer, __thiscall)
  mov eax, 00403DC0
  jmp eax

g_CustomVtable:
  dd 00402A50
  dd 004015B0
  dd shapeshift_render_wrapper
  dd 00402A70
  dd 00405E00
  dd 00401590
  dd 004016F0
  dd 00402C10
  dd 00409050
  dd 00401640
  dd 00457B10
  dd 00457B50
  dd 00457A70
  dd 00457A50
  dd 00401000
  dd 00457B80
  dd 00457BB0
  dd 00457C60
  dd 00457C90
  dd 00457CC0
  dd 00457CF0

label(shapeshift_skip)

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update (0x405E22) — ESI = ball
// Only swap player balls (vtable == 0x4CF314).
// ═══════════════════════════════════════════════════════════════════════
shapeshift_hook:
  mov eax, [esi]
  cmp eax, 004CF314
  jne shapeshift_skip

  mov [g_PlayerBall], esi
  mov [esi], g_CustomVtable
  mov dword ptr [esi+284], 420C0000
  mov dword ptr [esi+188], 40C00000

shapeshift_skip:
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

00405E22:
  jmp shapeshift_hook
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00
