[ENABLE]

alloc(g_PlayerBall, 4)
alloc(g_CustomVtable, 84)
alloc(g_WhiteMaterial, 68)
alloc(shapeshift_hook, 256)
alloc(shapeshift_render_wrapper, 256)

registersymbol(g_PlayerBall)

g_PlayerBall:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + white ambient
// Diffuse  (1.0, 1.0, 1.0, 1.0) — reflects all direct light
// Ambient  (1.0, 1.0, 1.0, 1.0) — reflects all ambient light
// Specular (0, 0, 0, 0)
// Emissive (0, 0, 0, 0)
// Power    0
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000
  dd 3F800000 3F800000 3F800000 3F800000
  dd 00000000 00000000 00000000 00000000
  dd 00000000 00000000 00000000 00000000
  dd 00000000

label(shapeshift_done)

// ═══════════════════════════════════════════════════════════════════════
// RENDER WRAPPER
// Fixes: black ball (SetMaterial) + dark lighting (restore D3D ambient)
//
// BLACK BALL: Ball_Render_AI doesn't call SetMaterial. Without a material,
// D3D lighting produces 0 (Material.Diffuse × Light = 0). We call
// SetMaterial(white) before rendering so the mesh is fully lit.
//
// DARK LIGHTING: The old wrapper saved/restored gfx+0x730 (cached value)
// but never called SetRenderState to restore the actual D3D device state.
// Ball_Render_AI changes D3D render states directly via the D3D device.
// After it returns, the device ambient is wrong. We now save/restore the
// actual D3D device ambient via SetRenderState.
// ═══════════════════════════════════════════════════════════════════════
shapeshift_render_wrapper:
  push ebx
  push esi
  mov esi, ecx                    // ESI = ball

  // Get gfx: gfx = *(*(ball+0x10) + 0x174)
  mov ebx, [esi+0x10]            // EBX = App
  mov ebx, [ebx+0x174]           // EBX = gfx

  // --- Set white material (fixes black ball) ---
  // d3d = *(gfx+0x154)
  mov eax, [ebx+0x154]           // EAX = D3D device
  mov ecx, [eax]                 // ECX = D3D vtable
  push g_WhiteMaterial           // param: material pointer
  push eax                       // this: D3D device
  call dword ptr [ecx+0xA8]     // SetMaterial(d3d, &material)

  // --- Set white ambient on D3D device (fixes dark lighting) ---
  push dword ptr [ebx+0x730]    // save cached ambient on stack
  mov dword ptr [ebx+0x730], FFFFFFFF  // write white to cached

  // SetRenderState(d3d, 0x8B, 0xFFFFFFFF) — white ambient on device
  mov eax, [ebx+0x154]           // EAX = D3D device
  mov ecx, [eax]                 // ECX = D3D vtable
  push FFFFFFFF                  // value = white
  push 8B                        // state = D3DRS_AMBIENT
  push eax                       // this = D3D device
  call dword ptr [ecx+0xC8]     // SetRenderState(AMBIENT, white)

  // --- Call Ball_Render_AI (0x402DE0) ---
  mov ecx, esi
  mov eax, 00402DE0
  call eax

  // --- Restore D3D ambient (fixes dark lighting for subsequent renders) ---
  pop dword ptr [ebx+0x730]     // restore cached ambient

  // SetRenderState(d3d, 0x8B, gfx+0x730) — restore original on device
  mov eax, [ebx+0x154]           // EAX = D3D device
  mov ecx, [eax]                 // ECX = D3D vtable
  push dword ptr [ebx+0x730]     // value = original ambient
  push 8B                        // state = D3DRS_AMBIENT
  push eax                       // this = D3D device
  call dword ptr [ecx+0xC8]     // SetRenderState(AMBIENT, original)

  pop esi
  pop ebx
  ret

g_CustomVtable:
  dd 00402A50
  dd 004015B0
  dd shapeshift_render_wrapper
  dd 00402A70
  dd 00405E00
  dd 00401590
  dd 004016F0
  dd 00402C10
  dd 00409050
  dd 00401640
  dd 00457B10
  dd 00457B50
  dd 00457A70
  dd 00457A50
  dd 00401000
  dd 00457B80
  dd 00457BB0
  dd 00457C60
  dd 00457C90
  dd 00457CC0
  dd 00457CF0

shapeshift_hook:
  push eax

  mov eax, [esi+18]
  test eax, eax
  jnz shapeshift_done

  mov [g_PlayerBall], esi

  mov [esi], g_CustomVtable
  mov dword ptr [esi+284], 420C0000
  mov dword ptr [esi+188], 40C00000

shapeshift_done:
  pop eax
  mov eax, [esi+0c5c]
  jmp 00405E28

00405E22:
  jmp shapeshift_hook
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00
