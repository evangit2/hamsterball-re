[ENABLE]

alloc(g_PlayerBall, 4)
alloc(g_CustomVtable, 84)
alloc(g_WhiteMaterial, 68)
alloc(shapeshift_hook, 256)
alloc(shapeshift_render_wrapper, 512)

registersymbol(g_PlayerBall)

g_PlayerBall:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

// ═══════════════════════════════════════════════════════════════════════
// RENDER WRAPPER v9
// SetMaterial(white emissive) + LIGHTING=0 → FinalColor = Emissive = white
// Reload EAX/ECX after every __stdcall D3D call (clobbers EAX/ECX/EDX)
// ═══════════════════════════════════════════════════════════════════════
shapeshift_render_wrapper:
  push ebx
  push esi
  push edi
  mov esi, ecx

  // EBX = gfx (preserved across stdcall calls)
  mov ebx, [esi+0x10]
  mov ebx, [ebx+0x174]

  // --- SetMaterial(white) ---
  mov eax, [ebx+0x154]
  mov ecx, [eax]
  push g_WhiteMaterial
  push eax
  call dword ptr [ecx+0xA8]     // SetMaterial

  // --- SetRenderState(AMBIENT, white) ---
  mov eax, [ebx+0x154]
  mov ecx, [eax]
  push FFFFFFFF
  push 8B
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState

  // --- SetRenderState(LIGHTING, 0) ---
  mov eax, [ebx+0x154]
  mov ecx, [eax]
  push 0
  push 89
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState

  // --- Save + set cached ambient ---
  push dword ptr [ebx+0x730]
  mov dword ptr [ebx+0x730], FFFFFFFF

  // --- Call Ball_Render_AI ---
  mov ecx, esi
  mov eax, 00402DE0
  call eax

  // --- Restore cached ambient ---
  pop dword ptr [ebx+0x730]

  // --- SetRenderState(AMBIENT, original) ---
  mov eax, [ebx+0x154]
  mov ecx, [eax]
  push dword ptr [ebx+0x730]
  push 8B
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState

  // --- SetRenderState(LIGHTING, 1) ---
  mov eax, [ebx+0x154]
  mov ecx, [eax]
  push 1
  push 89
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState

  pop edi
  pop esi
  pop ebx
  ret

// Custom vtable = player vtable with vtable[2] replaced
g_CustomVtable:
  dd 00402A50
  dd 004015B0
  dd shapeshift_render_wrapper
  dd 00402A70
  dd 00405E00
  dd 00401590
  dd 004016F0
  dd 00402C10
  dd 00409050
  dd 00401640
  dd 00457B10
  dd 00457B50
  dd 00457A70
  dd 00457A50
  dd 00401000
  dd 00457B80
  dd 00457BB0
  dd 00457C60
  dd 00457C90
  dd 00457CC0
  dd 00457CF0

label(shapeshift_skip)

// ═══════════════════════════════════════════════════════════════════════
// HOOK: Ball_Update (0x405E22) — ESI = ball
// PLAYER-ONLY FIX: Check ball+0x00 == 0x4CF314 (player vtable).
//   Player vtable = 0x4CF314 → swap to custom.
//   AI vtable = 0x4CF3A0 → skip.
//   Already swapped (g_CustomVtable) → skip.
// ═══════════════════════════════════════════════════════════════════════
shapeshift_hook:
  // Check: is this a player ball? (vtable == 0x4CF314)
  mov eax, [esi]
  cmp eax, 004CF314
  jne shapeshift_skip

  // Player ball — swap vtable + physics
  mov [g_PlayerBall], esi
  mov [esi], g_CustomVtable
  mov dword ptr [esi+284], 420C0000
  mov dword ptr [esi+188], 40C00000

shapeshift_skip:
  // Original instruction
  mov eax, [esi+0x00000C5C]
  jmp 00405E28

00405E22:
  jmp shapeshift_hook
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00
