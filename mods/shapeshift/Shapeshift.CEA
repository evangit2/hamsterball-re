[ENABLE]

alloc(g_PlayerBall, 4)
alloc(g_CustomVtable, 84)
alloc(g_WhiteMaterial, 68)
alloc(shapeshift_hook, 256)
alloc(shapeshift_render_wrapper, 256)

registersymbol(g_PlayerBall)

g_PlayerBall:
  dd 00000000

// D3DMATERIAL8 (68 bytes): white diffuse + ambient + emissive
g_WhiteMaterial:
  dd 3F800000 3F800000 3F800000 3F800000    // Diffuse: 1,1,1,1
  dd 3F800000 3F800000 3F800000 3F800000    // Ambient: 1,1,1,1
  dd 00000000 00000000 00000000 00000000    // Specular: 0,0,0,0
  dd 3F800000 3F800000 3F800000 3F800000    // Emissive: 1,1,1,1
  dd 00000000                                // Power: 0

label(shapeshift_done)

// ═══════════════════════════════════════════════════════════════════════
// RENDER WRAPPER v6
// Fixes black ball by: SetMaterial + DISABLE LIGHTING + white ambient
//
// Root cause: Ball_Render_AI renders the 8Ball mesh via DrawSubset.
// DrawSubset uses current D3D material + lighting states.
// With LIGHTING=1, D3D needs normals + lights to compute diffuse color.
// If the mesh lacks proper normals or the lights don't illuminate it
// correctly, the result is black (Diffuse×Light=0).
//
// Fix: Disable LIGHTING before mesh render. With LIGHTING=0:
//   FinalColor = Emissive (our white) + vertex color
// The emissive white makes the mesh fully bright regardless of normals.
// After render, restore LIGHTING=1 for other scene objects.
// ═══════════════════════════════════════════════════════════════════════
shapeshift_render_wrapper:
  push ebx
  push esi
  mov esi, ecx                    // ESI = ball

  // Get gfx: gfx = *(*(ball+0x10) + 0x174)
  mov ebx, [esi+0x10]
  mov ebx, [ebx+0x174]           // EBX = gfx

  // Get D3D device
  mov eax, [ebx+0x154]           // EAX = D3D device
  mov ecx, [eax]                 // ECX = D3D vtable

  // SetMaterial(white) — emissive makes ball self-illuminated
  push g_WhiteMaterial
  push eax
  call dword ptr [ecx+0xA8]     // SetMaterial

  // SetRenderState(AMBIENT, white)
  push FFFFFFFF
  push 8B
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState(AMBIENT, white)

  // SetRenderState(LIGHTING, 0) — disable D3D lighting for mesh render
  push 0
  push 89
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState(LIGHTING, 0)

  // Save original ambient on stack
  push dword ptr [ebx+0x730]
  mov dword ptr [ebx+0x730], FFFFFFFF

  // Call Ball_Render_AI
  mov ecx, esi
  mov eax, 00402DE0
  call eax

  // Restore ambient
  pop dword ptr [ebx+0x730]

  // Restore D3D device states
  mov eax, [ebx+0x154]
  mov ecx, [eax]

  // SetRenderState(AMBIENT, original)
  push dword ptr [ebx+0x730]
  push 8B
  push eax
  call dword ptr [ecx+0xC8]

  // SetRenderState(LIGHTING, 1) — restore for other renders
  push 1
  push 89
  push eax
  mov ecx, [eax]
  push eax
  call dword ptr [ecx+0xC8]     // SetRenderState(LIGHTING, 1)

  pop esi
  pop ebx
  ret

g_CustomVtable:
  dd 00402A50
  dd 004015B0
  dd shapeshift_render_wrapper
  dd 00402A70
  dd 00405E00
  dd 00401590
  dd 004016F0
  dd 00402C10
  dd 00409050
  dd 00401640
  dd 00457B10
  dd 00457B50
  dd 00457A70
  dd 00457A50
  dd 00401000
  dd 00457B80
  dd 00457BB0
  dd 00457C60
  dd 00457C90
  dd 00457CC0
  dd 00457CF0

shapeshift_hook:
  push eax

  mov eax, [esi+18]
  test eax, eax
  jnz shapeshift_done

  mov [g_PlayerBall], esi

  mov [esi], g_CustomVtable
  mov dword ptr [esi+284], 420C0000
  mov dword ptr [esi+188], 40C00000

shapeshift_done:
  pop eax
  mov eax, [esi+0c5c]
  jmp 00405E28

00405E22:
  jmp shapeshift_hook
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00
