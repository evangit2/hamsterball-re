{Global Object Functions Loader - bumper + speedcylinder globally}

[ENABLE]

alloc(BumperCave1, 1024)
alloc(BumperCave2, 1024)
alloc(saved_collObj, 4)
alloc(saved_meshname, 4)
alloc(str_bumper, 16)
alloc(str_speedcyl, 32)
alloc(float_12, 4)
alloc(float_65, 4)
alloc(float_neg90, 4)

str_bumper:
  db 'N:BUMPER',0

str_speedcyl:
  db 'N:SPEEDCYLINDER',0

float_12:
  dd 41400000

float_65:
  dd 42820000

float_neg90:
  dd C2460000

BumperCave1:
  mov [saved_collObj], edx

  push edx
  push esi
  call dword [eax+0x74]

  pushad

  mov edi, [esi+0x14]
  test edi, edi
  jz cave1_done

  mov eax, [edi+0x878]
  test eax, eax
  jz cave1_sound_done
  mov ecx, [eax+0x22C]
  test ecx, ecx
  jz cave1_sound_done

  mov edx, [eax+0x448]
  test edx, edx
  jnz cave1_check_speedcyl_sound

  push 0A
  push 004D2F44
  lea edx, [eax+0x448]
  push edx
  mov edx, [ecx]
  call dword [edx+0x60]

  mov eax, [edi+0x878]
  test eax, eax
  jz cave1_sound_done
  mov ecx, [eax+0x22C]
  test ecx, ecx
  jz cave1_sound_done

cave1_check_speedcyl_sound:
  mov edx, [eax+0x508]
  test edx, edx
  jnz cave1_sound_done

  push 2
  push 004D2C00
  lea edx, [eax+0x508]
  push edx
  mov edx, [ecx]
  call dword [edx+0x60]

cave1_sound_done:

  mov edx, [saved_collObj]
  test edx, edx
  jz cave1_done
  mov eax, [edx+4]
  test eax, eax
  jz cave1_done
  mov eax, [eax+0x864]
  test eax, eax
  jz cave1_done
  mov [saved_meshname], eax

  push 8
  push str_bumper
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jz cave1_bumper

  mov eax, [saved_meshname]
  push 0E
  push str_speedcyl
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jnz cave1_done

cave1_speedcyl:
  mov eax, [edi+0x878]
  test eax, eax
  jz cave1_scyl_spin
  mov ecx, [eax+0x508]
  test ecx, ecx
  jz cave1_scyl_spin

  fninit
  push 3F800000
  push [esi+0x16C]
  push [esi+0x168]
  push [esi+0x164]
  call 00459860

cave1_scyl_spin:
  mov byte [esi+0x31D], 01
  mov byte [esi+0x31E], 01
  fninit
  fld dword [float_neg90]
  fstp dword [esi+0x314]
  mov dword [esi+0x320], 64

cave1_scyl_vel:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_scyl_done

  fninit
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt
  fldz
  fcomip st(0), st(1)
  je cave1_scyl_zero

  fdivr dword [float_65]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  jmp cave1_scyl_done

cave1_scyl_zero:
  fstp st(0)

cave1_scyl_done:
  mov byte [esi+0x31E], 00
  mov dword [esi+0x808], 0A
  jmp cave1_done

cave1_bumper:
  mov eax, [edi+0x878]
  test eax, eax
  jz cave1_bump_vel
  mov ecx, [eax+0x448]
  test ecx, ecx
  jz cave1_bump_vel

  fninit
  push 3F800000
  push [esi+0x16C]
  push [esi+0x168]
  push [esi+0x164]
  call 00459860

cave1_bump_vel:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_done

  fninit
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt
  fldz
  fcomip st(0), st(1)
  je cave1_bump_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  jmp cave1_done

cave1_bump_zero:
  fstp st(0)

cave1_done:
  popad
  jmp 00407294

0040728F:
  jmp BumperCave1

BumperCave2:
  mov [saved_collObj], edx

  push edx
  push esi
  call dword [eax+0x74]

  pushad

  mov edi, [esi+0x14]
  test edi, edi
  jz cave2_done

  mov eax, [edi+0x878]
  test eax, eax
  jz cave2_sound_done
  mov ecx, [eax+0x22C]
  test ecx, ecx
  jz cave2_sound_done

  mov edx, [eax+0x448]
  test edx, edx
  jnz cave2_check_speedcyl_sound

  push 0A
  push 004D2F44
  lea edx, [eax+0x448]
  push edx
  mov edx, [ecx]
  call dword [edx+0x60]

  mov eax, [edi+0x878]
  test eax, eax
  jz cave2_sound_done
  mov ecx, [eax+0x22C]
  test ecx, ecx
  jz cave2_sound_done

cave2_check_speedcyl_sound:
  mov edx, [eax+0x508]
  test edx, edx
  jnz cave2_sound_done

  push 2
  push 004D2C00
  lea edx, [eax+0x508]
  push edx
  mov edx, [ecx]
  call dword [edx+0x60]

cave2_sound_done:

  mov edx, [saved_collObj]
  test edx, edx
  jz cave2_done
  mov eax, [edx+4]
  test eax, eax
  jz cave2_done
  mov eax, [eax+0x864]
  test eax, eax
  jz cave2_done
  mov [saved_meshname], eax

  push 8
  push str_bumper
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jz cave2_bumper

  mov eax, [saved_meshname]
  push 0E
  push str_speedcyl
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jnz cave2_done

cave2_speedcyl:
  mov eax, [edi+0x878]
  test eax, eax
  jz cave2_scyl_spin
  mov ecx, [eax+0x508]
  test ecx, ecx
  jz cave2_scyl_spin

  fninit
  push 3F800000
  push [esi+0x16C]
  push [esi+0x168]
  push [esi+0x164]
  call 00459860

cave2_scyl_spin:
  mov byte [esi+0x31D], 01
  mov byte [esi+0x31E], 01
  fninit
  fld dword [float_neg90]
  fstp dword [esi+0x314]
  mov dword [esi+0x320], 64

cave2_scyl_vel:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave2_scyl_done

  fninit
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt
  fldz
  fcomip st(0), st(1)
  je cave2_scyl_zero

  fdivr dword [float_65]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  jmp cave2_scyl_done

cave2_scyl_zero:
  fstp st(0)

cave2_scyl_done:
  mov byte [esi+0x31E], 00
  mov dword [esi+0x808], 0A
  jmp cave2_done

cave2_bumper:
  mov eax, [edi+0x878]
  test eax, eax
  jz cave2_bump_vel
  mov ecx, [eax+0x448]
  test ecx, ecx
  jz cave2_bump_vel

  fninit
  push 3F800000
  push [esi+0x16C]
  push [esi+0x168]
  push [esi+0x164]
  call 00459860

cave2_bump_vel:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave2_done

  fninit
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt
  fldz
  fcomip st(0), st(1)
  je cave2_bump_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  jmp cave2_done

cave2_bump_zero:
  fstp st(0)

cave2_done:
  popad
  jmp 00408B8A

00408B85:
  jmp BumperCave2

[DISABLE]

0040728F:
  db 52 56 FF 50 74

00408B85:
  db 52 56 FF 50 74

dealloc(BumperCave1)
dealloc(BumperCave2)
dealloc(saved_collObj)
dealloc(saved_meshname)
dealloc(str_bumper)
dealloc(str_speedcyl)
dealloc(float_12)
dealloc(float_65)
dealloc(float_neg90)
