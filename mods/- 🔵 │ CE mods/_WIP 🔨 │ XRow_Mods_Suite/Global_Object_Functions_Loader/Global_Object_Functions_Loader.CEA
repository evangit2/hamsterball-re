{Global Object Functions Loader - bumper + speedcylinder globally}

[ENABLE]

alloc(BumperCave1, 1024)
alloc(BumperCave2, 1024)
alloc(saved_collObj, 4)
alloc(saved_meshname, 4)
alloc(str_bumper, 16)
alloc(str_speedcyl, 32)
alloc(float_12, 4)
alloc(float_15, 4)

str_bumper:
  db 'N:BUMPER',0

str_speedcyl:
  db 'N:SPEEDCYLINDER',0

float_12:
  dd 41400000

float_15:
  dd 3FC00000

BumperCave1:
  mov [saved_collObj], edx

  push edx
  push esi
  call dword [eax+0x74]

  pushad

  mov edx, [saved_collObj]
  test edx, edx
  jz cave1_done
  mov eax, [edx+4]
  test eax, eax
  jz cave1_done
  mov eax, [eax+0x864]
  test eax, eax
  jz cave1_done
  mov [saved_meshname], eax

  push 8
  push str_bumper
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jz cave1_bumper

  mov eax, [saved_meshname]
  push 0E
  push str_speedcyl
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jnz cave1_done

cave1_speedcyl:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_done

  mov [ebx+0x808], 0A

  fld dword [ebx+0xCA4]
  fmul dword [float_15]
  fstp dword [ebx+0xCA4]

  fld dword [ebx+0xCAC]
  fmul dword [float_15]
  fstp dword [ebx+0xCAC]

  jmp cave1_done

cave1_bumper:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_done

  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt

  fldz
  fcomip st(0), st(1)
  je cave1_bumper_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  fstp st(0)
  jmp cave1_done

cave1_bumper_zero:
  fstp st(0)

cave1_done:
  popad
  jmp 00407294

0040728F:
  jmp BumperCave1

BumperCave2:
  mov [saved_collObj], edx

  push edx
  push esi
  call dword [eax+0x74]

  pushad

  mov edx, [saved_collObj]
  test edx, edx
  jz cave2_done
  mov eax, [edx+4]
  test eax, eax
  jz cave2_done
  mov eax, [eax+0x864]
  test eax, eax
  jz cave2_done
  mov [saved_meshname], eax

  push 8
  push str_bumper
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jz cave2_bumper

  mov eax, [saved_meshname]
  push 0E
  push str_speedcyl
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jnz cave2_done

cave2_speedcyl:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave2_done

  mov [ebx+0x808], 0A

  fld dword [ebx+0xCA4]
  fmul dword [float_15]
  fstp dword [ebx+0xCA4]

  fld dword [ebx+0xCAC]
  fmul dword [float_15]
  fstp dword [ebx+0xCAC]

  jmp cave2_done

cave2_bumper:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave2_done

  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt

  fldz
  fcomip st(0), st(1)
  je cave2_bumper_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  fstp st(0)
  jmp cave2_done

cave2_bumper_zero:
  fstp st(0)

cave2_done:
  popad
  jmp 00408B8A

00408B85:
  jmp BumperCave2

[DISABLE]

0040728F:
  db 52 56 FF 50 74

00408B85:
  db 52 56 FF 50 74

dealloc(BumperCave1)
dealloc(BumperCave2)
dealloc(saved_collObj)
dealloc(saved_meshname)
dealloc(str_bumper)
dealloc(str_speedcyl)
dealloc(float_12)
dealloc(float_15)
