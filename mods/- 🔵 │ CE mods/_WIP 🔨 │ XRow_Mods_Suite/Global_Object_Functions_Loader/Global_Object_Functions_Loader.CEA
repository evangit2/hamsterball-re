cave2_play_scyl_sound:
  push ebp
  mov ebp, [esi+0x14]
  test ebp, ebp
  jz cave2_pss_ret
  mov ebp, [ebp+0x878]
  test ebp, ebp
  jz cave2_pss_ret

  cmp dword [sound_loaded], 0
  jne cave2_pss_loaded

  mov ecx, [ebp+0x22C]
  test ecx, ecx
  jz cave2_pss_loaded
  mov eax, [ecx]
  test eax, eax
  jz cave2_pss_loaded

  lea edx, [ebp+0x448]
  push edx
  push 0A
  push str_bumper_snd
  call dword [eax+0x60]

  lea edx, [ebp+0x508]
  push edx
  push 2
  push str_scyl_snd
  mov ecx, [ebp+0x22C]
  mov eax, [ecx]
  call dword [eax+0x60]

  mov dword [sound_loaded], 1

cave2_pss_loaded:
  mov ecx, [ebp+0x508]
  test ecx, ecx
  jz cave2_pss_ret

  push float_1
  push dword [esi+0x16C]
  push dword [esi+0x168]
  push dword [esi+0x164]
  call 00459860

cave2_pss_ret:
  pop ebp
  ret

cave2_bumper:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave2_done

  call cave2_play_bumper_sound

  mov eax, [saved_meshname]
  add eax, 8
  push eax
  call 004BAE3E
  add esp, 4

  mov edi, [esi+0x14]
  test edi, edi
  jz cave2_bump_norm
  test eax, eax
  js cave2_bump_norm
  cmp eax, 0C
  jg cave2_bump_norm
  mov dword [edi+eax*4+0x6448], 3F800000

cave2_bump_norm:
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt

  fldz
  fcomip st(0), st(1)
  je cave2_bump_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  fstp st(0)
  jmp cave2_done

cave2_bump_zero:
  fstp st(0)

cave2_done:
  popad
  jmp 00408B8A

00408B85:
  jmp BumperCave2

[DISABLE]

0040728F:
  db 52 56 FF 50 74

00408B85:
  db 52 56 FF 50 74

dealloc(BumperCave1)
dealloc(BumperCave2)
dealloc(saved_collObj)
dealloc(saved_meshname)
dealloc(str_bumper)
dealloc(str_speedcyl)
dealloc(str_bumper_snd)
dealloc(str_scyl_snd)
dealloc(float_12)
dealloc(float_65)
dealloc(float_1)
dealloc(sound_loaded)
