{Global Object Functions Loader - bumper + speedcylinder globally}

[ENABLE]

alloc(BumperCave1, 2048)
alloc(BumperCave2, 2048)
alloc(saved_collObj, 4)
alloc(saved_meshname, 4)
alloc(str_bumper, 16)
alloc(str_speedcyl, 32)
alloc(str_bumper_snd, 32)
alloc(str_scyl_snd, 32)
alloc(float_12, 4)
alloc(float_65, 4)
alloc(float_1, 4)
alloc(sound_loaded, 4)

str_bumper:
  db 'N:BUMPER',0

str_speedcyl:
  db 'N:SPEEDCYLINDER',0

str_bumper_snd:
  db 'sounds\bumper',0

str_scyl_snd:
  db 'sounds\speedcylinder',0

float_12:
  dd 41400000

float_65:
  dd 42820000

float_1:
  dd 3F800000

sound_loaded:
  dd 00000000

BumperCave1:
  mov [saved_collObj], edx

  push edx
  push esi
  call dword [eax+0x74]

  pushad

  mov edx, [saved_collObj]
  test edx, edx
  jz cave1_done
  mov eax, [edx+4]
  test eax, eax
  jz cave1_done
  mov eax, [eax+0x864]
  test eax, eax
  jz cave1_done
  mov [saved_meshname], eax

  push 8
  push str_bumper
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jz cave1_bumper

  mov eax, [saved_meshname]
  push 0E
  push str_speedcyl
  push eax
  call 004C7677
  add esp, 0C
  test eax, eax
  jnz cave1_done

cave1_speedcyl:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_done

  mov [ebx+0x808], 0A
  mov byte [ebx+0x31D], 01
  mov byte [ebx+0x31E], 01

  call cave1_play_scyl_sound

  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt

  fldz
  fcomip st(0), st(1)
  je cave1_scyl_zero

  fdivr dword [float_65]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  fstp st(0)
  jmp cave1_done

cave1_scyl_zero:
  fstp st(0)
  jmp cave1_done

cave1_play_scyl_sound:
  push ebp
  mov ebp, [esi+0x14]
  test ebp, ebp
  jz cave1_pss_ret
  mov ebp, [ebp+0x878]
  test ebp, ebp
  jz cave1_pss_ret

  cmp dword [sound_loaded], 0
  jne cave1_pss_loaded

  mov ecx, [ebp+0x22C]
  test ecx, ecx
  jz cave1_pss_loaded
  mov eax, [ecx]
  test eax, eax
  jz cave1_pss_loaded

  lea edx, [ebp+0x448]
  push edx
  push 0A
  push str_bumper_snd
  call dword [eax+0x60]

  lea edx, [ebp+0x508]
  push edx
  push 2
  push str_scyl_snd
  mov ecx, [ebp+0x22C]
  mov eax, [ecx]
  call dword [eax+0x60]

  mov dword [sound_loaded], 1

cave1_pss_loaded:
  mov ecx, [ebp+0x508]
  test ecx, ecx
  jz cave1_pss_ret

  push float_1
  push dword [esi+0x16C]
  push dword [esi+0x168]
  push dword [esi+0x164]
  call 00459860

cave1_pss_ret:
  pop ebp
  ret

cave1_bumper:
  mov ebx, [esi+0x1A4]
  test ebx, ebx
  jz cave1_done

  call cave1_play_bumper_sound

  mov eax, [saved_meshname]
  add eax, 8
  push eax
  call 004BAE3E
  add esp, 4

  mov edi, [esi+0x14]
  test edi, edi
  jz cave1_bump_norm
  test eax, eax
  js cave1_bump_norm
  cmp eax, 0C
  jg cave1_bump_norm
  mov dword [edi+eax*4+0x6448], 3F800000

cave1_bump_norm:
  fld dword [ebx+0xCA4]
  fmul st(0), st(0)
  fld dword [ebx+0xCAC]
  fmul st(0), st(0)
  faddp
  fsqrt

  fldz
  fcomip st(0), st(1)
  je cave1_bump_zero

  fdivr dword [float_12]
  fld st(0)
  fmul dword [ebx+0xCA4]
  fstp dword [ebx+0xCA4]
  fmul dword [ebx+0xCAC]
  fstp dword [ebx+0xCAC]
  fldz
  fstp dword [ebx+0xCA8]
  fstp st(0)
  jmp cave1_done

cave1_bump_zero:
  fstp st(0)

cave1_done:
  popad
  jmp 00407294

0040728F:
  jmp BumperCave1

cave1_play_bumper_sound:
  push ebp
  mov ebp, [esi+0x14]
  test ebp, ebp
  jz cave1_pbs_ret
  mov ebp, [ebp+0x878]
  test ebp, ebp
  jz cave1_pbs_ret

  cmp dword [sound_loaded], 0
  jne cave1_pbs_loaded

  mov ecx, [ebp+0x22C]
  test ecx, ecx
  jz cave1_pbs_loaded
  mov eax, [ecx]
  test eax, eax
  jz cave1_pbs_loaded

  lea edx, [ebp+0x448]
  push edx
  push 0A
  push str_bumper_snd
  call dword [eax+0x60]

  lea edx, [ebp+0x508]
  push edx
  push 2
  push str_scyl_snd
  mov ecx, [ebp+0x22C]
  mov eax, [ecx]
  call dword [eax+0x60]

  mov dword [sound_loaded], 1

cave1_pbs_loaded:
  mov ecx, [ebp+0x448]
  test ecx, ecx
  jz cave1_pbs_ret

  push float_1
  push dword [esi+0x16C]
  push dword [esi+0x168]
  push dword [esi+0x164]
  call 00459860

cave1_pbs_ret:
  pop ebp
  ret

