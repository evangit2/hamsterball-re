[ENABLE]
alloc(newmem, 1024)
alloc(spawnBad, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(ballCount, 4)
alloc(spawnNow, 4)
alloc(meshName, 64)
alloc(meshNodePtr, 4)
alloc(appPtr, 4)
alloc(meshSlotSaved, 4)
registersymbol(spawnBad)

meshName:
  db 4D 65 73 68 65 73 5C 53 70 68 65 72 65 00

meshNodePtr:
  dd 00000000

appPtr:
  dd 00000000

meshSlotSaved:
  dd 00000000

newmem:
  cmp dword ptr [esi+0x18], 0
  jne @f
  mov eax, [esi+0x164]
  mov [playerX], eax
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax
@@:
  cmp dword ptr [spawnBad], 0
  je check_mesh
  cmp dword ptr [esi+0x18], 0
  jne check_mesh

  mov dword ptr [spawnBad], 0
  mov dword ptr [spawnNow], 1

  push ecx
  push edx
  push ebx
  push edi

  push 18
  call 004BA57B
  add esp, 4
  test eax, eax
  jz skip_mesh
  mov [meshNodePtr], eax
  mov edi, eax

  mov dword ptr [edi], 004D9C48
  mov dword ptr [edi+04], 0
  mov dword ptr [edi+08], 0
  mov dword ptr [edi+0C], 0
  mov dword ptr [edi+10], 0

  push meshName
  push 0
  push meshName
  mov ecx, edi
  call 00471750

  mov edi, [meshNodePtr]
  mov eax, [edi+08]
  test eax, eax
  jz skip_mesh

  mov edx, [005341E0]
  test edx, edx
  jz skip_mesh
  mov [appPtr], edx

  mov ecx, [edx+248]
  mov [meshSlotSaved], ecx
  mov ecx, [edi+08]
  mov [edx+248], ecx

skip_mesh:
  mov ecx, [esi+0x14]
  mov edx, [ecx+0x29d8]
  mov [ballCount], edx

  mov ecx, [esi+0x14]
  call 0040BCA0

  mov ecx, [esi+0x14]
  mov edx, [ecx+0x29d8]
  cmp edx, [ballCount]
  jle no_new

  mov ebx, [ecx+0x2DE0]
  test ebx, ebx
  jz no_new
  mov ebx, [ebx+edx*4-4]
  test ebx, ebx
  jz no_new

  cmp dword ptr [ebx+0x18], -1
  jne no_new

  mov eax, [playerX]
  mov [ebx+0x164], eax
  mov eax, [playerY]
  mov [ebx+0x168], eax
  mov eax, [playerZ]
  mov [ebx+0x16C], eax
  mov dword ptr [ebx+0x170], 0
  mov dword ptr [ebx+0x174], 0
  mov dword ptr [ebx+0x178], 0

  mov dword ptr [ebx+0x754], 1
  mov dword ptr [ebx+0x2FC], 0

  mov dword ptr [ebx+0xC6C], 0x49742400
  mov dword ptr [ebx+0xC70], 0x49742400
  mov dword ptr [ebx+0xC7C], 0

no_new:
  mov dword ptr [spawnNow], 0
  pop edi
  pop ebx
  pop edx
  pop ecx

check_mesh:
  cmp dword ptr [meshNodePtr], 0
  je original

  mov edx, [005341E0]
  test edx, edx
  je original

  mov edx, [edx+248]
  test edx, edx
  je original

  mov dword ptr [meshNodePtr], 0

original:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

alloc(spawnHook, 1000)
spawnHook:
  cmp dword ptr [spawnNow], 0
  je normal_check
  cmp dword ptr [spawnNow], 2
  je stop_spawn
  inc dword ptr [spawnNow]
  jmp 0040BD2D

stop_spawn:
  jmp 0040BEFE

normal_check:
  push 0x7
  push 004CF74C
  push dword ptr [edi]
  call 004C7677
  add esp, 0xC
  test eax, eax
  jnz 0040BEFE
  jmp 0040BD2D

0040BD27:
  jmp spawnHook
  nop

00405E22:
  jmp newmem
  nop

[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00
0040BD27:
  db 0F 85 D1 01 00 00

  cmp dword ptr [meshSlotSaved], 0
  je @f
  mov edx, [005341E0]
  test edx, edx
  je @f
  mov ecx, [meshSlotSaved]
  mov [edx+248], ecx
@@:

unregistersymbol(spawnBad)
dealloc(newmem)
dealloc(spawnHook)
dealloc(spawnBad)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(ballCount)
dealloc(spawnNow)
dealloc(meshName)
dealloc(meshNodePtr)
dealloc(appPtr)
dealloc(meshSlotSaved)
