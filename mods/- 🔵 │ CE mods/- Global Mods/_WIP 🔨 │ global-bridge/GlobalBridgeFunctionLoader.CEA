[ENABLE]

// =============================================================
// Global Bridge Function Loader v2.2
// Safe translate-only version. Avoids calling game render/sound
// functions from Ball_Update hook.
//
// Hook: 0x00405E28 (after the spawner's Ball_Update hook)
// Detection: scans board+0x2578 for PopCylinder objects (vtable=0x4D58F0)
// Action: runs native-like bridge state machine per spawned bridge
//
// Native Intermediate bridge state machine (from 0x41CC90):
//   state 0: idle, wait 0x4B frames, then check ball proximity
//   state 1: falling, moves bridge down
//   state 2: wait 0x7D frames
//   state 3: rising, moves bridge back up
//
// Addresses:
//   Ball_Update hook point 2 = 0x00405E28  (FLD [ESI+0xC50], 6 bytes)
//   PopCylinder vtable       = 0x004D58F0
//   PopCylinder position     = +0x10D4 X, +0x10D8 Y, +0x10DC Z
//   PopCylinder render flag  = +0x10E4
// =============================================================

alloc(BridgeCode, 8192)
alloc(saved_board, 4)
alloc(last_board, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(prox_radius_sq, 4)

// Up to 8 bridges. Each entry: 24 bytes
//   +0x00 PopCylinder pointer
//   +0x04 original X
//   +0x08 original Y
//   +0x0C original Z
//   +0x10 current drop (0 = up, 200 = down)
//   +0x14 state
//   +0x18 timer
alloc(bridge_table, 192)

saved_board:
  dd 0

last_board:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

prox_radius_sq:
  dd 45C80000      // 80.0 * 80.0 = 6400.0

bridge_table:
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0
  dd 0 0 0 0 0 0 0

label(original_code)
label(no_clear)
label(clear_loop)
label(clear_done)
label(scan_start)
label(scan_loop)
label(scan_next)
label(scan_done)
label(process_loop)
label(process_done)
label(process_next)
label(process_return)
label(find_bridge)
label(find_return)
label(find_done_add)
label(find_return_add)
label(state_machine)
label(state_0)
label(state_0_wait)
label(state_1)
label(state_2)
label(state_3)
label(state_done)

BridgeCode:
  // ESI = ball pointer. Only run for player ball.
  cmp dword [esi+0x18], 0
  jne original_code

  mov eax, [esi+0x14]
  test eax, eax
  jz original_code
  mov [saved_board], eax

  // Reset bridge table when board changes
  cmp eax, [last_board]
  je no_clear
  mov [last_board], eax
  pushad
  xor ecx, ecx
clear_loop:
  cmp ecx, 8
  jae clear_done
  mov ebx, 24
  imul ebx, ecx
  mov dword [bridge_table+ebx], 0
  inc ecx
  jmp clear_loop
clear_done:
  popad

no_clear:
  // Save player position
  mov eax, [esi+0x164]
  mov [playerX], eax
  mov eax, [esi+0x168]
  mov [playerY], eax
  mov eax, [esi+0x16C]
  mov [playerZ], eax

  pushad

scan_start:
  // Scan board+0x2578 for PopCylinder bridges
  mov edx, [saved_board]
  add edx, 0x2578
  mov ecx, [edx+0x04]
  test ecx, ecx
  jle scan_done
  mov ebp, [edx+0x40C]
  test ebp, ebp
  jz scan_done
  xor ebx, ebx

scan_loop:
  cmp ebx, ecx
  jge scan_done
  mov edi, [ebp+ebx*4]
  test edi, edi
  jz scan_next

  // Check vtable = PopCylinder
  mov eax, [edi]
  cmp eax, 0x004D58F0
  jne scan_next

  // Check if already in bridge table
  push ebx
  push ecx
  push edi
  jmp find_bridge

find_return:
  pop edi
  pop ecx
  pop ebx
  test eax, eax
  jns scan_next

  // Not in table - add it
  push ebx
  push ecx
  push edi
  jmp find_done_add

find_return_add:
  pop edi
  pop ecx
  pop ebx

scan_next:
  inc ebx
  jmp scan_loop

scan_done:
  // Process all bridges in table
  xor ebx, ebx
process_loop:
  cmp ebx, 8
  jge process_done
  mov eax, 24
  imul eax, ebx
  mov edi, [bridge_table+eax]
  test edi, edi
  jz process_next
  mov ebp, eax
  jmp state_machine

process_return:
  mov eax, ebp

process_next:
  inc ebx
  jmp process_loop

process_done:
  popad

original_code:
  FLD dword ptr [ESI+0xC50]
  jmp 00405E2E

00405E28:
  jmp BridgeCode
  nop

// =============================================================
// Helper: find bridge in table
// =============================================================

find_bridge:
  xor eax, eax
find_loop:
  cmp eax, 8
  jge find_not_found
  mov edx, 24
  imul edx, eax
  mov ecx, [bridge_table+edx]
  cmp ecx, edi
  je find_found
  inc eax
  jmp find_loop
find_not_found:
  mov eax, -1
find_found:
  jmp find_return

// =============================================================
// Helper: add bridge to table
// =============================================================

find_done_add:
  xor eax, eax
find_add_loop:
  cmp eax, 8
  jge find_add_full
  mov edx, 24
  imul edx, eax
  mov ecx, [bridge_table+edx]
  test ecx, ecx
  jz find_add_slot
  inc eax
  jmp find_add_loop
find_add_slot:
  mov [bridge_table+edx], edi
  mov ecx, [edi+0x10D4]
  mov [bridge_table+edx+4], ecx
  mov ecx, [edi+0x10D8]
  mov [bridge_table+edx+8], ecx
  mov ecx, [edi+0x10DC]
  mov [bridge_table+edx+12], ecx
  mov dword [bridge_table+edx+16], 0      // drop = 0
  mov dword [bridge_table+edx+20], 0      // state = 0
  mov dword [bridge_table+edx+24], 0x4B   // timer = 75
find_add_full:
  jmp find_return_add

// =============================================================
// State machine for one bridge
// EDI = PopCylinder pointer
// EBP = table offset
// =============================================================

state_machine:
  // Keep render flag set so PopCylinder update runs and renders at new position
  mov byte [edi+0x10E4], 1

  mov eax, [bridge_table+ebp+20]
  cmp eax, 0
  je state_0
  cmp eax, 1
  je state_1
  cmp eax, 2
  je state_2
  cmp eax, 3
  je state_3
  jmp state_done

state_0:
  // Wait timer, then check ball proximity
  mov eax, [bridge_table+ebp+24]
  test eax, eax
  jg state_0_wait

  // Proximity check: dist^2 <= radius^2
  fld dword [edi+0x10D4]
  fsub dword [playerX]
  fmul st(0), st(0)
  fld dword [edi+0x10DC]
  fsub dword [playerZ]
  fmul st(0), st(0)
  faddp
  fld dword [edi+0x10D8]
  fsub dword [playerY]
  fmul st(0), st(0)
  faddp
  fld dword [prox_radius_sq]  // st0=radius_sq, st1=dist^2
  fcompp                      // compare and pop both, FPU empty
  fnstsw ax
  test ah, 0x41
  jp state_done               // radius >= dist -> continue (trigger)
                              // dist > radius -> skip

  // Ball is close - trigger fall
  mov dword [bridge_table+ebp+20], 1
  jmp state_done

state_0_wait:
  dec eax
  mov [bridge_table+ebp+24], eax
  jmp state_done

state_1:
  // Falling: drop += 3.0 per frame
  fld dword [bridge_table+ebp+16]
  fadd dword [const_3_0]
  fstp dword [bridge_table+ebp+16]
  fld dword [bridge_table+ebp+16]
  fcomp dword [const_200_0]
  fnstsw ax
  test ah, 0x41
  jp state_done

  // Reached drop >= 200
  mov dword [bridge_table+ebp+16], 0x43480000  // 200.0
  mov dword [bridge_table+ebp+20], 2
  mov dword [bridge_table+ebp+24], 0x7D        // 125
  jmp state_done

state_2:
  // Wait timer
  mov eax, [bridge_table+ebp+24]
  dec eax
  mov [bridge_table+ebp+24], eax
  jg state_done
  mov dword [bridge_table+ebp+20], 3
  jmp state_done

state_3:
  // Rising: drop -= 0.5 per frame
  fld dword [bridge_table+ebp+16]
  fsub dword [const_0_5]
  fstp dword [bridge_table+ebp+16]
  fld dword [bridge_table+ebp+16]
  fcomp dword [const_0_0]
  fnstsw ax
  test ah, 0x41
  jpe state_done

  // Reached drop <= 0
  mov dword [bridge_table+ebp+16], 0
  mov dword [bridge_table+ebp+20], 0
  mov dword [bridge_table+ebp+24], 0x4B  // 75
  jmp state_done

state_done:
  // Apply position: Y = original_Y - drop
  fld dword [bridge_table+ebp+8]
  fsub dword [bridge_table+ebp+16]
  fstp dword [edi+0x10D8]
  jmp process_return

// =============================================================
// Constants
// =============================================================

const_0_0:
  dd 0x00000000

const_3_0:
  dd 0x40400000

const_0_5:
  dd 0x3F000000

const_200_0:
  dd 0x43480000

[DISABLE]

00405E28:
  db D9 86 50 0C 00 00

dealloc(BridgeCode)
dealloc(saved_board)
dealloc(last_board)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(prox_radius_sq)
dealloc(bridge_table)
