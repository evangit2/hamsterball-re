[ENABLE]

// Player Clone System v13
// Based on V8 stable baseline with fixes for:
// 1. Clones "going home" — clear 0x2E8 (respawn flag) every frame
// 2. Clones not chasing — clear ALL force guards (0x2F9, 0x2CC, 0x808, 0x2F0) every frame
// 3. "All black" in arenas — copy render context index (0x154) and render flags from source
// 4. P2-4 spawning without originals — P1 fallback works, clone gets requested player_idx
// 5. "Nothing spawned" in races — clear all guard flags at spawn time

alloc(CloneCode, 8192)
alloc(scene_saved, 4)
alloc(spawnP1, 4)
alloc(spawnP2, 4)
alloc(spawnP3, 4)
alloc(spawnP4, 4)
alloc(player_idx, 4)
alloc(src_ball, 4)
alloc(new_ball, 4)
alloc(clone_count, 4)
alloc(clone_ptrs, 32)
alloc(clone_pidx, 32)
alloc(force_buf, 12)
alloc(saved_ball_ptr, 4)
alloc(saved_ctrl_mode, 4)
alloc(tmp_val, 4)

scene_saved:
  dd 0
spawnP1:
  dd 0
spawnP2:
  dd 0
spawnP3:
  dd 0
spawnP4:
  dd 0
player_idx:
  dd 0
src_ball:
  dd 0
new_ball:
  dd 0
clone_count:
  dd 0
clone_ptrs:
  dd 0 0 0 0 0 0 0 0
clone_pidx:
  dd 0 0 0 0 0 0 0 0
force_buf:
  dd 0 0 0
saved_ball_ptr:
  dd 0
saved_ctrl_mode:
  dd 0
tmp_val:
  dd 0

registersymbol(scene_saved)
registersymbol(spawnP1)
registersymbol(spawnP2)
registersymbol(spawnP3)
registersymbol(spawnP4)

label(original_code)
label(check_p2)
label(check_p3)
label(check_p4)
label(done_spawn)
label(spawn_skip)
label(spawn_found)
label(ai_loop)
label(ai_next)
label(ai_done)
label(ai_skip_dead)
label(not_stale)
label(no_respawn_reset)
label(has_target)
label(restore_table)
label(phase2)
label(use_p1_fallback)
label(no_fallback)
label(compact_loop)
label(compact_done)
label(compact_skip)

CloneCode:
  mov [scene_saved], ecx

  // Phase 1: Check spawn requests
  mov eax, [spawnP1]
  or eax, [spawnP2]
  or eax, [spawnP3]
  or eax, [spawnP4]
  test eax, eax
  jz phase2

  pushad

  cmp [spawnP1], 0
  je check_p2
  mov [spawnP1], 0
  mov [player_idx], 0
  call SpawnClone

check_p2:
  cmp [spawnP2], 0
  je check_p3
  mov [spawnP2], 0
  mov [player_idx], 1
  call SpawnClone

check_p3:
  cmp [spawnP3], 0
  je check_p4
  mov [spawnP3], 0
  mov [player_idx], 2
  call SpawnClone

check_p4:
  cmp [spawnP4], 0
  je done_spawn
  mov [spawnP4], 0
  mov [player_idx], 3
  call SpawnClone

done_spawn:
  popad

phase2:
  // Phase 2: AI update loop
  cmp [clone_count], 0
  je original_code

  pushad

  xor esi, esi

ai_loop:
  cmp esi, [clone_count]
  jae ai_done

  // Get clone pointer
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]
  test eax, eax
  jz ai_next

  // Staleness check: clone+0x14 (scene ptr) must match scene_saved
  mov ecx, [eax+0x14]
  cmp ecx, [scene_saved]
  je not_stale
  // Stale — nullify and skip
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov dword [eax], 0
  jmp ai_next

not_stale:
  // Alive check: clone+0x768 must be nonzero
  cmp byte [eax+0x768], 0
  je ai_skip_dead

  // === CLEAR ALL FORCE GUARDS EVERY FRAME ===
  // This prevents "going home" (respawn teleport) and "not chasing" (blocked forces)
  // 0x2E8 = respawn needed flag (triggers Ball_FindClosestRespawnPoint teleport)
  // 0x2E9 = sticky limit flag
  // 0x2F8 = respawn in progress
  // 0x2F9 = falling flag (prevents force application)
  // 0x2CC = block flag (prevents force application)
  // 0x808 = state value (must be 0 for AI to process)
  // 0x2F0 = impact count (must be < 0x51 for force to apply)
  mov byte [eax+0x2E8], 0
  mov byte [eax+0x2E9], 0
  mov byte [eax+0x2F8], 0
  mov byte [eax+0x2F9], 0
  mov byte [eax+0x2CC], 0
  mov dword [eax+0x808], 0
  cmp dword [eax+0x2F0], 0x51
  jl skip_impact_reset
  mov dword [eax+0x2F0], 0
skip_impact_reset:

  // Set CHASE and HOME to huge values (99999999.0 = 0x4CBEBC20)
  // These are used by the 8ball AI path if activated
  mov dword [eax+0xC6C], 0x4CBEBC20
  mov dword [eax+0xC70], 0x4CBEBC20
  // Force multiplier
  mov dword [eax+0xC7C], 0x42480000
  // Clear velocity zeroing (don't interfere with AI velocity)
  mov dword [eax+0xC78], 0

  // Get clone pointer again (eax may have been clobbered)
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]

  // Get player index for this clone
  mov ecx, esi
  shl ecx, 2
  add ecx, clone_pidx
  mov edi, [ecx]

  // Ball swap trick: temporarily put clone in player table
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz ai_skip_dead
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [ecx+edx+0x5DC]
  mov [saved_ball_ptr], ebx

  // Put clone pointer into player table
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]
  mov [ecx+edx+0x5DC], eax

  // Set control mode to 0x63 (AI) for this player slot
  mov edx, edi
  shl edx, 2
  mov ebx, [ecx+edx+0xB28]
  mov [saved_ctrl_mode], ebx
  mov dword [ecx+edx+0xB28], 0x63

  // Call computer AI function: ecx=scene, push player_idx, push force_buf
  push edi
  mov eax, force_buf
  push eax
  mov ecx, [scene_saved]
  call 004222D0

  // Restore player table entry
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov edx, edi
  imul edx, edx, 0xA0
  mov ebx, [saved_ball_ptr]
  mov [ecx+edx+0x5DC], ebx

  // Restore control mode
  mov edx, edi
  shl edx, 2
  mov ebx, [saved_ctrl_mode]
  mov [ecx+edx+0xB28], ebx

  // Get clone pointer
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]

  // If AI found no target (0x288 == 0), zero the force
  cmp dword [eax+0x288], 0
  jne has_target
  mov dword [force_buf], 0
  mov dword [force_buf+4], 0
  mov dword [force_buf+8], 0
  jmp restore_table

has_target:
  // Apply the AI-computed force via vtable[5] (Ball_ApplyForceWithMultipliers)
  // Guards were already cleared above, so force WILL apply

restore_table:
  // Get clone pointer
  mov eax, esi
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]
  mov ecx, eax
  mov edx, [eax]
  push dword [force_buf+8]
  push dword [force_buf+4]
  push dword [force_buf]
  call dword [edx+0x14]

ai_skip_dead:
ai_next:
  inc esi
  jmp ai_loop

ai_done:
  // Phase 3: Compaction — remove dead/stale clones
  pushad
  xor ecx, ecx
  xor edx, edx

compact_loop:
  cmp ecx, [clone_count]
  jae compact_done
  mov eax, ecx
  shl eax, 2
  add eax, clone_ptrs
  mov eax, [eax]
  test eax, eax
  jz compact_skip
  mov ebx, [eax+0x14]
  cmp ebx, [scene_saved]
  jne compact_skip
  // Valid — move to position edx
  mov eax, ecx
  shl eax, 2
  add eax, clone_ptrs
  mov ebx, [eax]
  mov eax, edx
  shl eax, 2
  add eax, clone_ptrs
  mov [eax], ebx
  mov eax, ecx
  shl eax, 2
  add eax, clone_pidx
  mov ebx, [eax]
  mov eax, edx
  shl eax, 2
  add eax, clone_pidx
  mov [eax], ebx
  inc edx
compact_skip:
  inc ecx
  jmp compact_loop

compact_done:
  mov [clone_count], edx
  popad
  popad

original_code:
  push ebx
  push ebp
  push esi
  mov ebx, ecx
  push edi
  jmp 0041B546

// ==========================================
// SpawnClone Function
// ==========================================
SpawnClone:
  mov dword [src_ball], 0

  // Get scene
  mov ecx, [scene_saved]
  test ecx, ecx
  jz spawn_skip

  // Get player table
  mov ecx, [ecx+0x878]
  test ecx, ecx
  jz spawn_skip

  // Try to get the requested player's ball
  mov edx, [player_idx]
  imul edx, edx, 0xA0
  mov eax, [ecx+edx+0x5DC]
  test eax, eax
  jz use_p1_fallback

  // Check if source ball is alive
  cmp byte [eax+0x768], 0
  jz use_p1_fallback

  mov [src_ball], eax
  jmp spawn_found

use_p1_fallback:
  // Fall back to Player 1's ball (always exists in races/arenas)
  mov ecx, [scene_saved]
  mov ecx, [ecx+0x878]
  mov eax, [ecx+0x5DC]
  test eax, eax
  jz no_fallback

  cmp byte [eax+0x768], 0
  jz no_fallback

  mov [src_ball], eax
  jmp spawn_found

no_fallback:
  jmp spawn_skip

spawn_found:
  // Check clone limit
  mov eax, [clone_count]
  cmp eax, 8
  jae spawn_skip

  // Allocate 0xC98 bytes for new ball
  push 0xC98
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_skip
  mov [new_ball], eax

  // Zero-fill the ball (0x326 dwords = 0xC98 bytes)
  mov edi, eax
  xor eax, eax
  mov ecx, 0x326
  cld
  rep stosd

  // Call Ball_ctor2(new_ball, scene)
  mov ecx, [new_ball]
  mov edx, [scene_saved]
  push edx
  call 004039E0

  // Call vtable[1] (SetupCollisionRender — initializes render state)
  mov ecx, [new_ball]
  mov edx, [ecx]
  call dword [edx+4]

  // Set player index
  mov edx, [new_ball]
  mov eax, [player_idx]
  mov [edx+0x18], eax

  // Set physics properties (same as original player)
  mov dword [edx+0x284], 0x41D00000    // radius = 26.0
  mov dword [edx+0x188], 0x40A00000     // max_speed = 5.0
  mov dword [edx+0x278], 0x3F000000     // gravity_scale = 0.5
  mov dword [edx+0x27C], 0x3DCCCCCD     // friction = 0.1
  mov dword [edx+0x1A0], 0x3F866666     // scale = 1.05

  // Set CHASE/HOME to huge values (99999999.0)
  mov dword [edx+0xC6C], 0x4CBEBC20
  mov dword [edx+0xC70], 0x4CBEBC20
  mov dword [edx+0xC7C], 0x42480000     // force multiplier = 50.0
  mov dword [edx+0xC78], 0

  // Copy render context index from source ball (FIX: "all black" in arenas)
  // Without this, the clone gets a random render context that may not be initialized
  mov eax, [src_ball]
  mov ecx, [eax+0x154]
  mov [edx+0x154], ecx

  // Copy render mode flags from source (needed for proper rendering)
  mov ecx, [eax+0x748]
  mov [edx+0x748], ecx
  mov cl, [eax+0x182]
  mov [edx+0x182], cl

  // Verify source ball is valid
  mov eax, [src_ball]
  test eax, eax
  jz spawn_skip

  // Copy position from source ball (with small offset so clone doesn't overlap)
  fld dword [eax+0x164]
  fadd dword [004CF55C]
  fstp dword [edx+0x164]
  fld dword [eax+0x168]
  fadd dword [eax+0x284]
  fstp dword [edx+0x168]
  fld dword [eax+0x16C]
  fadd dword [004CF55C]
  fstp dword [edx+0x16C]

  // Copy velocity from source
  mov ebx, [eax+0x170]
  mov [edx+0x170], ebx
  mov ebx, [eax+0x174]
  mov [edx+0x174], ebx
  mov ebx, [eax+0x178]
  mov [edx+0x178], ebx

  // Copy appearance block (render contexts + materials) from source
  // 0x29 dwords (0xA4 bytes) from src+0x1B8 to dst+0x1B8
  mov esi, eax
  mov edi, [new_ball]
  add esi, 0x1B8
  add edi, 0x1B8
  mov ecx, 0x29
  cld
  rep movsd

  // Copy additional appearance fields (render_ctx2 internals)
  mov esi, eax
  mov edi, [new_ball]
  mov ebx, [esi+0x1BC]
  mov [edi+0x1BC], ebx
  mov ebx, [esi+0x1C0]
  mov [edi+0x1C0], ebx
  mov ebx, [esi+0x1C4]
  mov [edi+0x1C4], ebx
  mov ebx, [esi+0x1C8]
  mov [edi+0x1C8], ebx
  mov ebx, [esi+0x204]
  mov [edi+0x204], ebx

  // Copy acceleration fields
  mov esi, eax
  mov edi, [new_ball]
  mov ebx, [esi+0x2AC]
  mov [edi+0x2AC], ebx
  mov ebx, [esi+0x2B0]
  mov [edi+0x2B0], ebx
  mov ebx, [esi+0x2B4]
  mov [edi+0x2B4], ebx
  mov ebx, [esi+0x2B8]
  mov [edi+0x2B8], ebx

  // Copy render state flags (prevents "all black" by telling system render state is valid)
  mov esi, eax
  mov edi, [new_ball]
  mov ebx, [esi+0x6FC]
  mov [edi+0x6FC], ebx
  mov ebx, [esi+0x700]
  mov [edi+0x700], ebx
  mov ebx, [esi+0x708]
  mov [edi+0x708], ebx
  mov bl, [esi+0x70D]
  mov [edi+0x70D], bl
  mov bl, [esi+0x734]
  mov [edi+0x734], bl

  // Cache spawn position
  mov eax, [new_ball]
  mov ebx, [eax+0x164]
  mov [eax+0xC60], ebx
  mov ebx, [eax+0x168]
  mov [eax+0xC64], ebx
  mov ebx, [eax+0x16C]
  mov [eax+0xC68], ebx

  // Set material to 0xFFFFFFFF (triggers render state setup on first frame)
  mov edx, [new_ball]
  mov dword [edx+0xC38], 0xFFFFFFFF

  // Set alive + active flags
  mov byte [edx+0x768], 1
  mov byte [edx+0x769], 1

  // === CLEAR ALL GUARD FLAGS AT SPAWN ===
  // This prevents immediate respawn/fall-through issues
  mov byte [edx+0x2E8], 0      // respawn needed
  mov byte [edx+0x2E9], 0      // sticky limit
  mov byte [edx+0x2F8], 0      // respawn in progress
  mov byte [edx+0x2F9], 0      // falling
  mov byte [edx+0x2CC], 0      // block
  mov byte [edx+0x324], 0      // render skip
  mov dword [edx+0x808], 0     // state
  mov dword [edx+0x288], 0     // target ptr (no target yet)
  mov dword [edx+0x2F0], 0     // impact count
  mov dword [edx+0x310], 1     // manual control flag (prevents respawn behavior)
  mov dword [edx+0x29C], 0x3F800000  // timer = 1.0

  // Register clone in scene lists (required for update + render)
  mov ecx, [scene_saved]
  add ecx, 0x29D4
  push edx
  call 00453810

  mov ecx, [scene_saved]
  add ecx, 0x2DEC
  push edx
  call 00453810

  // Store clone pointer and player index
  mov eax, [clone_count]
  shl eax, 2
  mov ecx, [new_ball]
  mov [clone_ptrs+eax], ecx
  mov ecx, [player_idx]
  mov [clone_pidx+eax], ecx
  inc dword [clone_count]

spawn_skip:
  ret

0041B540:
  jmp CloneCode
  nop

[DISABLE]

0041B540:
  db 53 55 56 8B D9 57

dealloc(CloneCode)
dealloc(scene_saved)
dealloc(spawnP1)
dealloc(spawnP2)
dealloc(spawnP3)
dealloc(spawnP4)
dealloc(player_idx)
dealloc(src_ball)
dealloc(new_ball)
dealloc(clone_count)
dealloc(clone_ptrs)
dealloc(clone_pidx)
dealloc(force_buf)
dealloc(saved_ball_ptr)
dealloc(saved_ctrl_mode)
dealloc(tmp_val)

unregistersymbol(scene_saved)
unregistersymbol(spawnP1)
unregistersymbol(spawnP2)
unregistersymbol(spawnP3)
unregistersymbol(spawnP4)
