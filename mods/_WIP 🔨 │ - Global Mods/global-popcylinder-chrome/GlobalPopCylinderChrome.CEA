[ENABLE]
 
// =====================================================
// Global Chrome (BadBall) Spawner v8
// =====================================================
// PROBLEM: v7 spawned PopCylinders (Sky Race decorative
//   objects) and called their Update. But PopCylinders
//   DON'T create chromes — they're just pop-up cylinders.
//
// ROOT CAUSE (traced via Ghidra):
//   Chromes in Odd Race are BadBalls (enemy balls), NOT
//   PopCylinders. The OddBoard_Update function (vtable[1]
//   = 0x41EE80) spawns them:
//     1. Scene_SetupLevel6 (0x40EA90) loads LAUNCH01/02/03
//        positions from the Odd Race MESHWORLD.
//     2. OddBoard_Update picks a random LAUNCH position via
//        the game's PRNG (CPUID_CheckProcessorFeature at
//        0x45DD60 — NOT real CPUID, it's a Fibonacci LCG).
//        Then: allocate BadBall (0xC64), BadBall_ctor
//        (0x405D90), call vtable[1] (0x40A040) to init
//        physics, set position + velocity, add to ball list
//        (board+0x29D4 = AthenaList).
//     3. chrome.png/chromeshadow.png textures are loaded
//        globally in TimerDisplay (0x4298C0) at App+0xDA0
//        and +0xDA4. They're used as ball textures when
//        rendering BadBalls — no special "chrome object"
//        exists. The chrome IS a BadBall.
//
// FIX: Replicate the BadBall spawning logic from
//   OddBoard_Update, using the player's position as the
//   launch point (non-Odd levels have no LAUNCH positions).
//
// HOOK: Ball_Update at 0x405E22
//   Original: 8B 86 5C 0C 00 00 = mov eax, [esi+0x0C5C]
//   ESI = player ball pointer
//
// HOTKEY: Set [SpawnChrome] to 1 via CE to spawn a chrome
// =====================================================
 
alloc(ChromeCode, 4096)
alloc(SpawnChrome, 4)
alloc(saved_board, 4)
alloc(launch_x, 4)
alloc(launch_y, 4)
alloc(launch_z, 4)
alloc(badball_ptr, 4)
alloc(physics_ptr, 4)
alloc(vel_x, 4)
alloc(vel_y, 4)
alloc(vel_z, 4)
alloc(dir_counter, 4)
 
registersymbol(SpawnChrome)
 
SpawnChrome:
  dd 0
saved_board:
  dd 0
launch_x:
  dd 0
launch_y:
  dd 0
launch_z:
  dd 0
badball_ptr:
  dd 0
physics_ptr:
  dd 0
vel_x:
  dd 0
vel_y:
  dd 0
vel_z:
  dd 0
dir_counter:
  dd 0
 
label(original_code)
label(spawn_done)
label(skip_velocity)
label(dir1)
label(dir2)
label(dir3)
label(vel_done)
label(add_to_list)
 
ChromeCode:
  // Save board pointer from ball+0x14
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz original_code
 
  // Check spawn flag
  cmp dword [SpawnChrome], 0
  je original_code
  mov dword [SpawnChrome], 0
 
  pushad
 
  // Verify board pointers
  mov eax, [saved_board]
  test eax, eax
  jz spawn_done
 
  // Verify App pointer (board+0x878)
  mov edx, [eax+0x878]
  test edx, edx
  jz spawn_done
 
  // === Get player position as launch point ===
  // ball+0x164 = X, ball+0x168 = Y, ball+0x16C = Z
  mov eax, [esi+0x164]
  mov [launch_x], eax
  mov eax, [esi+0x168]
  mov [launch_y], eax
  mov eax, [esi+0x16C]
  mov [launch_z], eax
 
  // === Allocate BadBall (0xC64 bytes) ===
  // operator_new is __cdecl at 0x4BA57B
  push 0xC64
  call 004BA57B
  add esp, 4
  test eax, eax
  jz spawn_done
  mov [badball_ptr], eax
 
  // === Call BadBall_ctor(badball, board) ===
  // __thiscall: ECX=badball, stack: board
  push dword [saved_board]
  mov ecx, eax
  call 00405D90
 
  // === Call vtable[1] (init physics) ===
  // __thiscall: ECX=badball, no params
  // vtable[1] = *(vtable + 0x04) = 0x40A040
  mov ecx, [badball_ptr]
  mov eax, [ecx]              // vtable ptr
  call dword [eax+0x04]
 
  // === Set playerID = -1 (marks as badball/enemy) ===
  // OddBoard_Update sets this_00[6] = -1, which is badball+0x18
  mov ecx, [badball_ptr]
  mov dword [ecx+0x18], -1
 
  // === Set position to player position ===
  // badball+0x164 = X, +0x168 = Y, +0x16C = Z
  mov ecx, [badball_ptr]
  mov eax, [launch_x]
  mov [ecx+0x164], eax
  mov eax, [launch_y]
  mov [ecx+0x168], eax
  // Offset Z slightly so ball doesn't spawn inside player
  mov eax, [launch_z]
  mov [ecx+0x16C], eax
 
  // === Set ball properties (from OddBoard_Update) ===
  // badball+0x278 = gravity_scale = 0.5f
  mov dword [ecx+0x278], 3F000000
  // badball+0x27C = 0.1f
  mov dword [ecx+0x27C], 3DCCCCCD
  // badball+0x284 = radius = 24.0f
  mov dword [ecx+0x284], 41C00000
  // badball+0x188 = max_speed = 5.0f
  mov dword [ecx+0x188], 40A00000
 
  // === Set velocity via Ball_SetVec3AtOffset ===
  // physics struct pointer = badball+0x1A4
  mov ecx, [badball_ptr]
  mov eax, [ecx+0x1A4]
  test eax, eax
  jz skip_velocity
  mov [physics_ptr], eax
 
  // Pick direction using simple counter (0-3 cycling)
  mov eax, [dir_counter]
  inc eax
  and eax, 3
  mov [dir_counter], eax
 
  // 4 directions: +X+Z, -X+Z, +X-Z, -X-Z
  // velocity magnitude = 2.5f (from OddBoard_Update)
  // 2.5f = 0x40200000, -2.5f = 0xC0200000
  cmp eax, 0
  jne dir1
  // +X, +Z
  mov dword [vel_x], 40200000    // 2.5f
  mov dword [vel_z], 40200000    // 2.5f
  jmp vel_done
dir1:
  cmp eax, 1
  jne dir2
  // -X, +Z
  mov dword [vel_x], C0200000    // -2.5f
  mov dword [vel_z], 40200000    // 2.5f
  jmp vel_done
dir2:
  cmp eax, 2
  jne dir3
  // +X, -Z
  mov dword [vel_x], 40200000    // 2.5f
  mov dword [vel_z], C0200000    // -2.5f
  jmp vel_done
dir3:
  // -X, -Z
  mov dword [vel_x], C0200000    // -2.5f
  mov dword [vel_z], C0200000    // -2.5f
vel_done:
  // Y velocity = 12.0f (upward launch, from OddBoard_Update)
  mov dword [vel_y], 41400000    // 12.0f
 
  // Ball_SetVec3AtOffset(physics_ptr, &vel_x)
  // __thiscall: ECX=physics_ptr, push &vel_x
  lea eax, [vel_x]
  push eax
  mov ecx, [physics_ptr]
  call 00402A20
 
  // Call physics vtable[4] — apply velocity
  // __thiscall: ECX=physics_ptr, no params
  // offset 0x10 = 5th entry (index 4)
  mov ecx, [physics_ptr]
  mov eax, [ecx]              // physics vtable ptr
  call dword [eax+0x10]
 
skip_velocity:
  // === Play spawn sound (sounds\ting at App+0x4D0) ===
  // Sound_Play3D is __fastcall: ECX=sound, push z, y, x
  // Actually it's: ECX=sound_ptr, EDX=x, push y, push z
  // Simplified: just skip sound for now, focus on spawn
 
add_to_list:
  // === Add BadBall to board's ball list (board+0x29D4) ===
  // AthenaList_Append(list, item)
  // __thiscall: ECX=&list, push item
  push dword [badball_ptr]
  mov ecx, [saved_board]
  add ecx, 0x29D4
  call 00453810                // AthenaList_Append
 
spawn_done:
  popad
 
original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28
 
00405E22:
  jmp ChromeCode
  nop
 
[DISABLE]
00405E22:
  db 8B 86 5C 0C 00 00
 
dealloc(ChromeCode)
dealloc(SpawnChrome)
dealloc(saved_board)
dealloc(launch_x)
dealloc(launch_y)
dealloc(launch_z)
dealloc(badball_ptr)
dealloc(physics_ptr)
dealloc(vel_x)
dealloc(vel_y)
dealloc(vel_z)
dealloc(dir_counter)
unregistersymbol(SpawnChrome)
