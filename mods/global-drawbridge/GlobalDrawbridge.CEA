[ENABLE]

alloc(SpawnCode, 4096)
alloc(SpawnDrawbridge, 4)
alloc(saved_board, 4)
alloc(temp_mesh, 4)
alloc(playerX, 4)
alloc(playerY, 4)
alloc(playerZ, 4)
alloc(float_20, 4)
alloc(mesh_loaded, 4)
alloc(list_inited, 4)

registersymbol(SpawnDrawbridge)

SpawnDrawbridge:
  dd 0

saved_board:
  dd 0

temp_mesh:
  dd 0

playerX:
  dd 0

playerY:
  dd 0

playerZ:
  dd 0

float_20:
  dd 0x41A00000

mesh_loaded:
  dd 0

list_inited:
  dd 0

label(original_code)
label(check_spawn)
label(load_mesh)
label(init_list)
label(do_spawn)
label(done_spawn)

SpawnCode:
  cmp dword [esi+0x18], 0
  jne check_spawn

  mov eax, [esi+0x164]
  mov [playerX], eax
  fld dword [esi+0x168]
  fsub dword [float_20]
  fstp dword [playerY]
  mov eax, [esi+0x16C]
  mov [playerZ], eax

check_spawn:
  cmp dword [SpawnDrawbridge], 0
  je original_code

  cmp dword [esi+0x18], 0
  jne original_code

  mov dword [SpawnDrawbridge], 0

  pushad

  // Get Board from ball+0x14
  mov eax, [esi+0x14]
  mov [saved_board], eax
  test eax, eax
  jz done_spawn

  // Safety: Board+0x8AC must be valid (collision level)
  mov edx, [eax+0x8AC]
  test edx, edx
  jz done_spawn

  // Safety: Board+0x878 → App must be valid
  mov edx, [eax+0x878]
  test edx, edx
  jz done_spawn

  // === STEP 1: Load Drawbridge mesh if not already loaded ===
load_mesh:
  cmp dword [mesh_loaded], 0
  jne init_list

  // Check if Board+0x4370 already has a valid mesh (Tower Race)
  mov edx, [saved_board]
  mov edx, [edx+0x4370]
  test edx, edx
  jnz init_list

  // Allocate 0x10D0 for MeshWorld
  push 0x10D0
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn

  mov ebx, eax

  // Get App+0x174 (D3D device)
  mov edx, [saved_board]
  mov edx, [edx+0x878]
  mov edx, [edx+0x174]

  // MeshWorld_ctor(this=alloc, App+0x174, "Levels\Level4-Drawbridge")
  push 004D099C
  push edx
  mov ecx, ebx
  call 00461510            // ret 8
  test eax, eax
  jz done_spawn

  // Store mesh at Board+0x4370
  mov edx, [saved_board]
  mov [edx+0x4370], eax
  mov [temp_mesh], eax
  mov dword [mesh_loaded], 1

  // === STEP 2: Init AthenaList at Board+0x4BE8 if needed ===
init_list:
  cmp dword [list_inited], 0
  jne do_spawn

  // Check if already initialized (vtable == AthenaList vtable 0x4D875C)
  mov edx, [saved_board]
  mov edx, [edx+0x4BE8]
  cmp edx, 0x4D875C
  je do_spawn

  // AthenaList_Init(Board+0x4BE8, 0)
  mov edx, [saved_board]
  lea ecx, [edx+0x4BE8]
  push 0
  call 00453210            // ret 4

  mov dword [list_inited], 1

  // === STEP 3: Allocate and construct Drawbridge ===
do_spawn:
  // Allocate 0x113C bytes
  push 0x113C
  call 004BA57B
  add esp, 4
  test eax, eax
  jz done_spawn

  mov ebx, eax             // ebx = new object

  // Glass_Level_ctor(this=alloc, Board, Board+0x4370)
  // thiscall: ecx=alloc, push Board, push mesh → ret 8
  mov edx, [saved_board]
  mov edx, [edx+0x4370]    // mesh ptr
  push edx                 // param_2 = mesh
  mov edx, [saved_board]
  push edx                 // param_1 = Board
  mov ecx, ebx             // this = alloc
  call 004384A0            // Glass_Level_ctor — ret 8

  // Set position at obj+0x10D8 (X), +0x10DC (Y), +0x10E0 (Z)
  mov edx, [playerX]
  mov [ebx+0x10D8], edx
  mov edx, [playerY]
  mov [ebx+0x10DC], edx
  mov edx, [playerZ]
  mov [ebx+0x10E0], edx

  // AthenaList_Append(Board+0x2578, obj)
  push ebx
  mov ecx, [saved_board]
  add ecx, 0x2578
  call 00453810            // ret 4

  // AthenaList_Append(Board+0x4BE8, obj)
  push ebx
  mov ecx, [saved_board]
  add ecx, 0x4BE8
  call 00453810            // ret 4

done_spawn:
  popad

original_code:
  mov eax, [esi+0x0c5c]
  jmp 00405E28

00405E22:
  jmp SpawnCode
  nop

[DISABLE]

00405E22:
  db 8B 86 5C 0C 00 00

dealloc(SpawnCode)
dealloc(SpawnDrawbridge)
dealloc(saved_board)
dealloc(temp_mesh)
dealloc(playerX)
dealloc(playerY)
dealloc(playerZ)
dealloc(float_20)
dealloc(mesh_loaded)
dealloc(list_inited)
unregistersymbol(SpawnDrawbridge)
